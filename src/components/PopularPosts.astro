---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

// SSR 폴백: 최신 5글 (분석 데이터 로드 전/실패 시)
const fallbackPosts = allPosts.slice(0, 5);

// slug(id) → {제목, 카테고리} 매핑 (클라이언트에서 대시보드 조회수와 결합)
const SLUG_META: Record<string, { t: string; c: string }> = Object.fromEntries(
  allPosts.map((p) => [p.id, { t: p.data.title, c: p.data.category.toLowerCase() }])
);

// 대시보드와 동일한 Supabase 분석 소스 (public anon key)
const SUPABASE_URL = 'https://xyprbsmagtlzebxyxsvj.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5cHJic21hZ3RsemVieHl4c3ZqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA0NjY4NTQsImV4cCI6MjA4NjA0Mjg1NH0.dajN0n0IWzOgYOSCglxVLzddg7jJFRHNCHwTWMG62uU';

const catLabel = (c: string) => ({ ai: 'AI', dev: 'Dev', review: 'Review', game: 'Game' } as Record<string, string>)[c] || c.toUpperCase();
---

<aside class="popular-posts-widget">
  <h3 class="popular-posts-title">인기 글 TOP 5</h3>
  <ol class="popular-posts-list" id="popular-list">
    {fallbackPosts.map((post, index) => (
      <li class="popular-post-item">
        <span class="popular-post-rank">{index + 1}</span>
        <div class="popular-post-content">
          <a href={`/blog/${post.id}/`} class="popular-post-link">{post.data.title}</a>
          <div class="popular-post-meta">
            <span class="popular-post-category" data-cat={post.data.category.toLowerCase()}>{catLabel(post.data.category.toLowerCase())}</span>
          </div>
        </div>
      </li>
    ))}
  </ol>
</aside>

<script define:vars={{ SUPABASE_URL, SUPABASE_ANON_KEY, SLUG_META }}>
  (function () {
    const headers = {
      apikey: SUPABASE_ANON_KEY,
      Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
      'Content-Type': 'application/json',
    };
    const esc = (s) => String(s).replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m]));
    const fmtViews = (n) => (n >= 10000 ? (n / 10000).toFixed(1) + '만' : n >= 1000 ? (n / 1000).toFixed(1) + '천' : String(n)) + '회';
    const label = (c) => ({ ai: 'AI', dev: 'Dev', review: 'Review', game: 'Game' }[c] || (c || '').toUpperCase());

    fetch(`${SUPABASE_URL}/rest/v1/rpc/get_top_pages`, {
      method: 'POST', headers, body: JSON.stringify({ p_limit: 80 }),
    })
      .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
      .then((rows) => {
        if (!Array.isArray(rows)) return;
        const seen = new Set();
        const ranked = [];
        for (const p of rows) {
          const raw = (p.slug || p.path || '').replace(/^\/blog\//, '').replace(/\/$/, '');
          let slug = raw;
          try { slug = decodeURIComponent(raw); } catch (e) {}
          const meta = SLUG_META[slug] || SLUG_META[raw];
          if (!meta || seen.has(slug)) continue;   // TechFlow 글만, 중복 제거
          seen.add(slug);
          ranked.push({ slug, title: meta.t, cat: meta.c, views: Number(p.views) || 0 });
          if (ranked.length >= 5) break;
        }
        if (ranked.length === 0) return;            // 데이터 없으면 SSR 폴백 유지
        const ol = document.getElementById('popular-list');
        if (ol) {
          // Astro scoped 스타일이 동적 요소에도 적용되도록 scope 속성 복사
          const sample = ol.querySelector('.popular-post-item');
          const cid = sample ? Array.from(sample.attributes).map((a) => a.name).find((n) => n.indexOf('data-astro-cid-') === 0) : null;
          ol.innerHTML = ranked.map((p, i) => `
            <li class="popular-post-item">
              <span class="popular-post-rank">${i + 1}</span>
              <div class="popular-post-content">
                <a href="/blog/${p.slug}/" class="popular-post-link">${esc(p.title)}</a>
                <div class="popular-post-meta">
                  <span class="popular-post-category" data-cat="${p.cat}">${label(p.cat)}</span>
                  <span class="popular-post-views">${fmtViews(p.views)}</span>
                </div>
              </div>
            </li>`).join('');
          if (cid) ol.querySelectorAll('*').forEach((el) => el.setAttribute(cid, ''));
        }
      })
      .catch(() => {});
  })();
</script>

<style>
  .popular-posts-widget {
    margin: 2.5rem 0;
    padding: 1.75rem;
    background: var(--glass-bg);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    box-shadow: var(--glass-shadow, 0 4px 20px rgba(0,0,0,0.06));
    position: relative;
    overflow: hidden;
  }
  .popular-posts-widget::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient-aurora, linear-gradient(90deg, #22d3ee, #6366f1, #a855f7, #ec4899));
  }
  .popular-posts-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 1.25rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
    text-align: center;
  }
  .popular-posts-list {
    list-style: none;
    padding: 0; margin: 0;
    display: flex; flex-direction: column;
    gap: 0.75rem;
  }
  .popular-post-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.8rem 0.875rem;
    background: var(--glass-hi);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .popular-post-item:hover {
    transform: translateX(4px);
    border-color: color-mix(in srgb, var(--color-primary) 45%, transparent);
    box-shadow: var(--shadow-glow, 0 4px 12px rgba(109,92,240,0.15));
  }
  .popular-post-rank {
    display: flex; align-items: center; justify-content: center;
    width: 28px; height: 28px; flex-shrink: 0;
    background: var(--gradient-primary, linear-gradient(135deg, #6366f1, #a855f7));
    color: white;
    font-size: 0.85rem; font-weight: 800;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(109, 92, 240, 0.3);
    font-family: ui-monospace, Menlo, monospace;
  }
  .popular-post-content { flex: 1; display: flex; flex-direction: column; gap: 0.375rem; min-width: 0; }
  .popular-post-link {
    font-size: 0.9rem; font-weight: 600;
    color: var(--color-text); text-decoration: none; line-height: 1.4;
    display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    transition: color 0.2s;
  }
  .popular-post-link:hover { color: var(--color-primary); }
  .popular-post-meta { display: flex; align-items: center; gap: 0.5rem; }
  .popular-post-category {
    display: inline-block; align-self: flex-start;
    padding: 0.125rem 0.5rem; border-radius: 5px;
    font-size: 0.65rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;
  }
  .popular-post-category[data-cat="ai"] { background: rgba(99,102,241,0.16); color: #6366f1; }
  .popular-post-category[data-cat="dev"] { background: rgba(34,211,238,0.18); color: #0e93a8; }
  .popular-post-category[data-cat="review"] { background: rgba(236,72,153,0.16); color: #db2777; }
  .popular-post-category[data-cat="game"] { background: rgba(168,85,247,0.18); color: #9333ea; }
  :root.dark .popular-post-category[data-cat="ai"] { color: #a5b4fc; }
  :root.dark .popular-post-category[data-cat="dev"] { color: #67e8f9; }
  :root.dark .popular-post-category[data-cat="review"] { color: #f9a8d4; }
  :root.dark .popular-post-category[data-cat="game"] { color: #d8b4fe; }
  .popular-post-views {
    font-size: 0.68rem; font-weight: 700; color: var(--color-text-muted);
    font-family: ui-monospace, Menlo, monospace;
  }
  @media (max-width: 640px) {
    .popular-posts-widget { padding: 1.25rem 1rem; margin: 1.5rem 0; }
    .popular-posts-title { font-size: 1rem; }
    .popular-post-rank { width: 24px; height: 24px; font-size: 0.75rem; }
    .popular-post-link { font-size: 0.85rem; }
  }
</style>
