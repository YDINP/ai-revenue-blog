---
// 전역 커맨드 팔레트(⌘K) — 모든 페이지에서 글 검색·필터·정렬·키보드 이동.
// 홈에는 로컬 팔레트(#list-overlay)가 있으므로, 그게 존재하면 전역은 양보(가드).
//
// ⚡ 성능: 전체 글 목록을 페이지마다 DOM으로 인라인하면 HTML이 수백 KB로 불어나
// 모바일에서 파싱/스크롤 렉을 유발한다. 목록은 /search-index.json 으로 분리하고
// 팔레트를 "열 때" 한 번만 fetch → 렌더한다(칩 카운트만 서버에서 계산).
import { getCollection } from 'astro:content';

const posts = await getCollection('blog', ({ data }) => !data.draft);
const catMap: Record<string, number> = {};
posts.forEach((p) => { const k = p.data.category.toLowerCase(); catMap[k] = (catMap[k] || 0) + 1; });
const cats = Object.entries(catMap).sort((a, b) => b[1] - a[1]).map(([slug, count]) => ({ slug, label: slug.toUpperCase(), count }));
---

<div class="list-overlay" id="gp-overlay" hidden>
  <div class="list-modal" role="dialog" aria-modal="true" aria-label="글 검색">
    <div class="palette-searchbar">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5" />
        <path d="M13 13L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <input id="gp-input" type="text" placeholder="제목·내용·태그로 검색…" aria-label="글 검색" autocomplete="off" />
      <span class="palette-hint" id="gp-count">{posts.length}</span>
      <button class="list-close" id="gp-close" aria-label="닫기">Esc</button>
    </div>
    <div class="palette-controls">
      <div class="palette-chips" id="gp-chips" role="tablist">
        <button class="pchip active" data-cat="all">전체</button>
        {cats.map((c) => (<button class="pchip" data-cat={c.slug}>{c.label} <i>{c.count}</i></button>))}
      </div>
      <div class="palette-sort" id="gp-sort">
        <button class="psort active" data-sort="date">최신순</button>
        <button class="psort" data-sort="title">제목순</button>
      </div>
    </div>
    <div class="list-body" id="gp-body" role="listbox" aria-label="검색 결과">
      <div class="palette-empty" id="gp-loading">불러오는 중…</div>
      <div class="palette-empty" id="gp-empty" hidden>검색 결과가 없어요.</div>
    </div>
    <div class="palette-foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
      <span><kbd>Enter</kbd> 열기</span>
      <span><kbd>Esc</kbd> 닫기</span>
      <span class="palette-kbd-open"><kbd>⌘</kbd><kbd>K</kbd> 어디서나 열기</span>
    </div>
  </div>
</div>

<script>
  (function () {
    const overlay = document.getElementById('gp-overlay') as HTMLElement | null;
    if (!overlay) return;
    const input = document.getElementById('gp-input') as HTMLInputElement | null;
    const chips = document.getElementById('gp-chips');
    const sortEl = document.getElementById('gp-sort');
    const countEl = document.getElementById('gp-count');
    const body = document.getElementById('gp-body') as HTMLElement | null;
    const loadingEl = document.getElementById('gp-loading') as HTMLElement | null;
    let empty = document.getElementById('gp-empty') as HTMLElement | null;
    const closeBtn = document.getElementById('gp-close');
    let query = '', cat = 'all', sortKey: 'date' | 'title' = 'date', active = -1, lastFocus: HTMLElement | null = null;
    const isHomeLocal = () => !!document.getElementById('list-overlay');   // 홈 로컬 팔레트가 있으면 전역은 양보

    type Row = { id: string; t: string; c: string; d: string; g: string; p: number; i: string; a: string };
    let DATA: Row[] | null = null;
    let rows: HTMLElement[] = [];
    let rendered = false, loading = false;

    const esc = (s: string) => s.replace(/[&<>"]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[m] as string));
    const fmtDate = (ms: number) => new Date(ms).toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' });

    function rowHtml(o: Row) {
      const catL = (o.c || '').toLowerCase();
      const media = o.i
        ? `<img src="${esc(o.i)}" alt="${esc(o.a)}" width="320" height="180" loading="lazy" decoding="async">`
        : `<span class="ph" data-cat="${catL}">${esc(o.c)}</span>`;
      const search = esc(`${o.t} ${o.d} ${o.g}`.toLowerCase());
      return `<a class="list-row" href="/blog/${o.id}/" role="option" data-cat="${catL}" data-title="${esc(o.t.toLowerCase())}" data-search="${search}" data-date="${o.p}">`
        + `<div class="list-row-media">${media}</div>`
        + `<div class="list-row-text"><div class="list-row-top"><span class="list-row-cat" data-cat="${catL}">${esc(o.c)}</span></div>`
        + `<h4 data-orig="${esc(o.t)}">${esc(o.t)}</h4><p>${esc(o.d)}</p>`
        + `<time datetime="${new Date(o.p).toISOString()}">${fmtDate(o.p)}</time></div></a>`;
    }

    async function ensure() {
      if (DATA || loading) return !!DATA;
      loading = true;
      try {
        const r = await fetch('/search-index.json');
        DATA = await r.json();
      } catch (e) { DATA = null; }
      loading = false;
      return !!DATA;
    }
    function renderAll() {
      if (!DATA || !body) return;
      body.innerHTML = DATA.map(rowHtml).join('') + '<div class="palette-empty" id="gp-empty" hidden>검색 결과가 없어요.</div>';
      rows = Array.from(body.querySelectorAll('.list-row')) as HTMLElement[];
      empty = document.getElementById('gp-empty') as HTMLElement | null;
      rendered = true;
    }

    function highlight(el: HTMLElement | null, q: string) {
      if (!el) return;
      const orig = el.getAttribute('data-orig') || el.textContent || '';
      if (!q) { el.textContent = orig; return; }
      const i = orig.toLowerCase().indexOf(q);
      if (i < 0) { el.textContent = orig; return; }
      el.innerHTML = esc(orig.slice(0, i)) + '<mark>' + esc(orig.slice(i, i + q.length)) + '</mark>' + esc(orig.slice(i + q.length));
    }
    const visible = () => rows.filter((r) => !r.hidden);
    function apply() {
      if (!rendered) return;
      const vis: HTMLElement[] = [];
      rows.forEach((r) => {
        const ok = (cat === 'all' || r.dataset.cat === cat) && (!query || (r.dataset.search || '').includes(query));
        r.hidden = !ok; r.classList.remove('active');
        if (ok) { vis.push(r); highlight(r.querySelector('h4'), query); }
      });
      vis.sort((a, b) => sortKey === 'title'
        ? (a.dataset.title || '').localeCompare(b.dataset.title || '')
        : Number(b.dataset.date) - Number(a.dataset.date));
      vis.forEach((r) => body?.appendChild(r));
      if (empty) { body?.appendChild(empty); empty.hidden = vis.length > 0; }
      if (countEl) countEl.textContent = String(vis.length);
      active = -1; if (body) body.scrollTop = 0;
    }
    function setActive(i: number) {
      const vis = visible(); rows.forEach((r) => r.classList.remove('active'));
      if (!vis.length) { active = -1; return; }
      active = (i + vis.length) % vis.length;
      vis[active].classList.add('active'); vis[active].scrollIntoView({ block: 'nearest' });
    }
    async function open() {
      lastFocus = document.activeElement as HTMLElement;
      overlay.hidden = false; document.body.classList.add('list-open');
      requestAnimationFrame(() => { overlay.classList.add('open'); input?.focus(); input?.select(); });
      const ok = await ensure();
      if (loadingEl) loadingEl.hidden = true;
      if (ok && !rendered) { renderAll(); apply(); }
    }
    function close() {
      overlay.classList.remove('open'); document.body.classList.remove('list-open');
      setTimeout(() => { overlay.hidden = true; }, 260); lastFocus?.focus();
    }
    closeBtn?.addEventListener('click', close);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
    input?.addEventListener('input', () => { query = (input.value || '').trim().toLowerCase(); apply(); });
    chips?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.pchip') as HTMLElement | null; if (!b) return;
      chips.querySelectorAll('.pchip').forEach((x) => x.classList.remove('active')); b.classList.add('active');
      cat = b.dataset.cat || 'all'; apply();
    });
    sortEl?.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('.psort') as HTMLElement | null; if (!b) return;
      sortEl.querySelectorAll('.psort').forEach((x) => x.classList.remove('active')); b.classList.add('active');
      sortKey = (b.dataset.sort as 'date' | 'title') || 'date'; apply();
    });
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
        if (isHomeLocal()) return;              // 홈에선 로컬 팔레트가 처리
        e.preventDefault();
        if (overlay.hidden) open(); else close();
        return;
      }
      if (overlay.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') {
        const vis = visible(); const el = active >= 0 ? vis[active] : vis[0];
        if (el) { window.location.href = (el as HTMLAnchorElement).href; }
      }
      else if (e.key === 'Tab') {
        const f = Array.from(overlay.querySelectorAll('a[href],button:not([disabled]),input,[tabindex]:not([tabindex="-1"])')).filter((el) => (el as HTMLElement).offsetParent !== null) as HTMLElement[];
        if (!f.length) return; const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    // 외부(예: /blog 페이지 버튼)에서 열 수 있도록 전역 노출
    (window as any).openCommandPalette = () => { if (!isHomeLocal()) open(); };
  })();
</script>
