---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterCTA from '../components/NewsletterCTA.astro';
import PopularPosts from '../components/PopularPosts.astro';
import PaperdocBanner from '../components/PaperdocBanner.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

// Featured = latest post
const featured = sortedPosts[0];
// Feed = the rest (bento)
const feedPosts = sortedPosts.slice(1, 19);

// Live stats
const totalPosts = allPosts.length;
const categoryMap: Record<string, number> = {};
allPosts.forEach((p) => {
  const key = p.data.category.toLowerCase();
  categoryMap[key] = (categoryMap[key] || 0) + 1;
});
const catCount = Object.keys(categoryMap).length;

// Filter rail counts reflect the visible feed subset
const feedCatMap: Record<string, number> = {};
feedPosts.forEach((p) => {
  const key = p.data.category.toLowerCase();
  feedCatMap[key] = (feedCatMap[key] || 0) + 1;
});
const categories = Object.entries(feedCatMap)
  .sort((a, b) => b[1] - a[1])
  .map(([slug, count]) => ({ slug, label: slug.toUpperCase(), count }));
const latestDate = new Date(featured.data.pubDate).toLocaleDateString('ko-KR', {
  month: 'short',
  day: 'numeric',
});

// 커맨드 팔레트용 전체 카테고리 집계
const paletteCatMap: Record<string, number> = {};
sortedPosts.forEach((p) => {
  const k = p.data.category.toLowerCase();
  paletteCatMap[k] = (paletteCatMap[k] || 0) + 1;
});
const paletteCats = Object.entries(paletteCatMap)
  .sort((a, b) => b[1] - a[1])
  .map(([slug, count]) => ({ slug, label: slug.toUpperCase(), count }));

const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title="TechFlow - AI & 테크 인사이트"
  description="AI, 개발, 테크 트렌드에 대한 실용적인 인사이트와 리뷰를 제공합니다."
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    "itemListElement": [featured, ...feedPosts].map((post, i) => ({
      "@type": "ListItem",
      "position": i + 1,
      "url": `https://ai-revenue-blog.vercel.app/blog/${post.id}/`
    }))
  })} />

  <PaperdocBanner />

  <!-- ══ Signal Deck ══ -->
  <section class="deck" aria-label="사이트 소개">
    <span class="deck-eyebrow"><span class="pulse"></span> LIVE · 매일 업데이트</span>
    <h1 class="deck-title">첨단 기술을 <span class="grad">한눈에 읽는</span> 인텔리전스 덱</h1>
    <p class="deck-sub">
      AI 도구·개발 트렌드·테크 제품 리뷰를 한 화면에서 탐색하세요. 검색하고, 필터링하고, 바로 깊이 들어갑니다.
    </p>

    <div class="deck-stats">
      <div class="stat-chip"><span class="stat-num">{totalPosts}</span><span class="stat-label">Articles</span></div>
      <div class="stat-chip"><span class="stat-num">{catCount}</span><span class="stat-label">Topics</span></div>
      <div class="stat-chip"><span class="stat-num">{latestDate}</span><span class="stat-label">Updated</span></div>
    </div>

    <form class="deck-search" action="/blog/" method="get" role="search">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5" />
        <path d="M13 13L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <input type="text" name="q" placeholder="무엇을 찾고 계신가요? (예: Claude, RAG, 모니터)" aria-label="사이트 검색" />
      <button type="submit">탐색</button>
    </form>
  </section>

  <!-- ══ Spotlight (featured) ══ -->
  <a class="spotlight" href={`/blog/${featured.id}/`} aria-label={`추천 글: ${featured.data.title}`}>
    <div class="spotlight-media">
      {featured.data.image && (
        <img src={featured.data.image.url} alt={featured.data.image.alt} width="1200" height="675" fetchpriority="high" />
      )}
    </div>
    <div class="spotlight-body">
      <span class="spotlight-tag">◆ Featured · {featured.data.category}</span>
      <h3>{featured.data.title}</h3>
      <p>{featured.data.description}</p>
      <div class="spotlight-meta">
        <time datetime={new Date(featured.data.pubDate).toISOString()}>{fmtDate(featured.data.pubDate)}</time>
        <span class="spotlight-cta">자세히 읽기 &rarr;</span>
      </div>
    </div>
  </a>

  <!-- ══ Explore Stream (가로 슬라이드) ══ -->
  <section class="stream-section" aria-label="글 탐색 스트림">
    <div class="section-header stream-head">
      <h2>탐색 스트림</h2>
      <div class="stream-tools">
        <button class="list-open-btn" id="list-open" aria-haspopup="dialog">▦ 전체보기</button>
        <div class="stream-nav">
          <span class="stream-counter"><b id="stream-idx">01</b> / {feedPosts.length}</span>
          <button class="stream-arrow" id="stream-prev" aria-label="이전 글">&larr;</button>
          <button class="stream-arrow" id="stream-next" aria-label="다음 글">&rarr;</button>
        </div>
      </div>
    </div>

    <div class="filter-rail" id="filter-rail" role="tablist">
      <button class="filter-pill active" data-cat="all" role="tab">전체 <span class="cnt">{feedPosts.length}</span></button>
      {categories.map((c) => (
        <button class="filter-pill" data-cat={c.slug} role="tab">{c.label} <span class="cnt">{c.count}</span></button>
      ))}
    </div>

    <div class="stream-viewport at-start" id="stream-viewport">
      <div class="stream" id="stream" tabindex="0" role="list" aria-label="블로그 글 가로 스트림">
        <div class="stream-spacer" aria-hidden="true"></div>
        {feedPosts.map((post, i) => (
          <article
            class="stream-card"
            role="listitem"
            data-cat={post.data.category.toLowerCase()}
            data-search={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase()}
          >
            <a href={`/blog/${post.id}/`}>
              <div class="stream-card-media">
                {post.data.image ? (
                  <img src={post.data.image.url} alt={post.data.image.alt} width="640" height="400" loading="lazy" decoding="async" />
                ) : (
                  <span class="ph">{post.data.category}</span>
                )}
                <span class="stream-index">{String(i + 1).padStart(2, '0')}</span>
                <span class="stream-cat" data-cat={post.data.category.toLowerCase()}>{post.data.category}</span>
              </div>
              <div class="stream-card-body">
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
                <div class="stream-card-foot">
                  <time datetime={new Date(post.data.pubDate).toISOString()}>{fmtDate(post.data.pubDate)}</time>
                  <span class="go">읽기 &rarr;</span>
                </div>
              </div>
            </a>
          </article>
        ))}
        <div class="stream-empty" id="stream-empty" style="display:none;">해당 주제의 글이 아직 없어요.</div>
        <div class="stream-spacer" aria-hidden="true"></div>
      </div>
    </div>

    <div class="stream-progress"><div class="stream-progress-bar" id="stream-bar"></div></div>
    <p class="stream-hint">&larr; 드래그 · 휠 · 방향키로 넘겨보세요 &rarr;</p>
  </section>

  <!-- Popular Posts -->
  <section aria-label="인기 글">
    <PopularPosts />
  </section>

  <!-- Newsletter CTA -->
  <section aria-label="뉴스레터 구독">
    <NewsletterCTA />
  </section>

  <!-- ══ List Modal (전체보기 리스트 팝업) ══ -->
  <div class="list-overlay" id="list-overlay" hidden>
    <div class="list-modal" role="dialog" aria-modal="true" aria-label="전체 글 검색">
      <div class="palette-searchbar">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="9" cy="9" r="5.5" stroke="currentColor" stroke-width="1.5" />
          <path d="M13 13L17 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <input id="palette-input" type="text" placeholder="제목·내용·태그로 검색…" aria-label="글 검색" autocomplete="off" />
        <span class="palette-hint" id="palette-count">{sortedPosts.length}</span>
        <button class="list-close" id="list-close" aria-label="닫기">Esc</button>
      </div>
      <div class="palette-controls">
        <div class="palette-chips" id="palette-chips" role="tablist">
          <button class="pchip active" data-cat="all">전체</button>
          {paletteCats.map((c) => (
            <button class="pchip" data-cat={c.slug}>{c.label} <i>{c.count}</i></button>
          ))}
        </div>
        <div class="palette-sort" id="palette-sort">
          <button class="psort active" data-sort="date">최신순</button>
          <button class="psort" data-sort="views">조회수</button>
        </div>
      </div>
      <div class="list-body" id="list-body" role="listbox" aria-label="검색 결과">
        {sortedPosts.map((post, i) => (
          <a
            class="list-row"
            href={`/blog/${post.id}/`}
            role="option"
            data-cat={post.data.category.toLowerCase()}
            data-title={post.data.title.toLowerCase()}
            data-search={`${post.data.title} ${post.data.description} ${(post.data.tags || []).join(' ')}`.toLowerCase()}
            data-date={new Date(post.data.pubDate).getTime()}
            data-slug={post.id}
            data-idx={i}
          >
            <div class="list-row-media">
              {post.data.image ? (
                <img src={post.data.image.url} alt={post.data.image.alt} width="320" height="180" loading="lazy" decoding="async" />
              ) : (
                <span class="ph" data-cat={post.data.category.toLowerCase()}>{post.data.category}</span>
              )}
            </div>
            <div class="list-row-text">
              <div class="list-row-top">
                <span class="list-row-cat" data-cat={post.data.category.toLowerCase()}>{post.data.category}</span>
                <span class="list-row-views" hidden></span>
              </div>
              <h4 data-orig={post.data.title}>{post.data.title}</h4>
              <p>{post.data.description}</p>
              <time datetime={new Date(post.data.pubDate).toISOString()}>{fmtDate(post.data.pubDate)}</time>
            </div>
          </a>
        ))}
        <div class="palette-empty" id="palette-empty" hidden>검색 결과가 없어요.</div>
      </div>
      <div class="palette-foot">
        <span><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
        <span><kbd>Enter</kbd> 열기</span>
        <span><kbd>Esc</kbd> 닫기</span>
        <span class="palette-kbd-open"><kbd>⌘</kbd><kbd>K</kbd> 어디서나 열기</span>
      </div>
    </div>
  </div>

  <!-- ══ Quick-view Modal (글 팝업) ══ -->
  <div class="qv-overlay" id="qv-overlay" hidden>
    <div class="qv-modal" role="dialog" aria-modal="true" aria-label="글 미리보기">
      <button class="qv-close" id="qv-close" aria-label="닫기">✕</button>
      <div class="qv-content" id="qv-content"></div>
      <div class="qv-foot"><a class="qv-full" id="qv-full" href="#" rel="bookmark">전체 페이지로 열기 &rarr;</a></div>
    </div>
  </div>

  <script>
    (function () {
      const stream = document.getElementById('stream') as HTMLElement | null;
      const viewport = document.getElementById('stream-viewport') as HTMLElement | null;
      const rail = document.getElementById('filter-rail') as HTMLElement | null;
      const prev = document.getElementById('stream-prev') as HTMLButtonElement | null;
      const next = document.getElementById('stream-next') as HTMLButtonElement | null;
      const idxEl = document.getElementById('stream-idx');
      const bar = document.getElementById('stream-bar') as HTMLElement | null;
      const empty = document.getElementById('stream-empty');
      if (!stream || !viewport) return;

      const cards = Array.from(stream.querySelectorAll('.stream-card')) as HTMLElement[];
      // ── 원형 3D 카루셀 상태 ──
      let cardW = 300, R = 340, pos = 0, target = 0, raf: number | null = null;
      let vis = cards.slice();
      const STEP = 20;    // 인접 카드 각도(deg)
      const MAXVIS = 3;   // 앞쪽 ±3장만 노출, 나머지는 원 뒤로 순환

      // ── 보기 모드(카루셀 ↔ 전체보기 그리드) ──
      const modeBtns = Array.from(document.querySelectorAll('#stream-modes .mode-btn')) as HTMLElement[];
      const section = document.querySelector('.stream-section') as HTMLElement | null;
      let mode: 'carousel' | 'grid' = 'carousel';
      const clearCardStyles = () => cards.forEach((c) => {
        c.style.transform = ''; c.style.opacity = ''; c.style.marginLeft = ''; c.style.zIndex = ''; c.style.pointerEvents = '';
      });
      function setMode(m: 'carousel' | 'grid') {
        mode = m;
        modeBtns.forEach((b) => { const on = b.dataset.mode === m; b.classList.toggle('active', on); b.setAttribute('aria-selected', String(on)); });
        const grid = m === 'grid';
        stream.classList.toggle('grid-mode', grid);
        viewport?.classList.toggle('grid-mode', grid);
        section?.classList.toggle('grid-mode', grid);
        if (grid) { if (raf != null) { cancelAnimationFrame(raf); raf = null; } clearCardStyles(); }
        else { measure(); target = Math.round(pos); render(); }
      }

      function measure() {
        cardW = cards.find((c) => !c.classList.contains('hide'))?.offsetWidth || 300;
        cards.forEach((c) => { c.style.marginLeft = (-cardW / 2) + 'px'; });
        R = Math.round(cardW * 1.45);
      }
      const refreshVis = () => { vis = cards.filter((c) => !c.classList.contains('hide')); };

      function hud() {
        const N = vis.length;
        if (!N) return;
        const cur = ((Math.round(pos) % N) + N) % N;
        if (idxEl) idxEl.textContent = String(cur + 1).padStart(2, '0');
        if (bar) { bar.style.width = (100 / N) + '%'; bar.style.marginLeft = (cur / N) * 100 + '%'; }
        if (prev) prev.disabled = false;
        if (next) next.disabled = false;
      }

      // 각 카드를 원(circle) 위 각도에 배치 → pos 회전으로 순환
      function render() {
        const N = vis.length;
        cards.forEach((c) => { if (c.classList.contains('hide')) { c.style.opacity = '0'; c.style.pointerEvents = 'none'; } });
        if (!N) return;
        vis.forEach((card, j) => {
          let rel = ((j - pos) % N + N) % N;
          if (rel > N / 2) rel -= N;
          const a = rel * STEP;
          const ar = (a * Math.PI) / 180;
          const ad = Math.abs(a);
          if (Math.abs(rel) > MAXVIS + 0.5) {
            card.style.opacity = '0';
            card.style.pointerEvents = 'none';
            card.style.transform = 'translateZ(-1400px)';
            card.style.zIndex = '0';
            return;
          }
          const x = R * Math.sin(ar);
          const z = R * Math.cos(ar) - R;
          const sc = 0.6 + 0.4 * Math.max(Math.cos(ar), 0);
          card.style.transform = `translateX(${x}px) translateZ(${z}px) rotateY(${-a}deg) scale(${sc})`;
          card.style.opacity = String(Math.max(0.2, Math.cos(ar) * 0.9 + 0.1));
          card.style.pointerEvents = 'auto';
          card.style.zIndex = String(200 - Math.round(ad));
        });
        hud();
      }

      function tick() {
        pos += (target - pos) * 0.2;
        if (Math.abs(target - pos) < 0.0008) { pos = target; render(); raf = null; return; }
        render();
        raf = requestAnimationFrame(tick);
      }
      function animateTo(t: number) { target = t; if (raf == null) raf = requestAnimationFrame(tick); }
      const go = (dir: number) => { if (mode !== 'carousel') return; animateTo(Math.round(target) + dir); };

      prev?.addEventListener('click', () => go(-1));
      next?.addEventListener('click', () => go(1));

      stream.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight') { e.preventDefault(); go(1); }
        else if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      });

      let wheelLock = false;
      stream.addEventListener('wheel', (e) => {
        if (mode !== 'carousel') return;
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;
        e.preventDefault();
        if (wheelLock) return;
        wheelLock = true; setTimeout(() => { wheelLock = false; }, 160);
        go(e.deltaY > 0 ? 1 : -1);
      }, { passive: false });

      // ── 드래그로 원형 회전 (임계값 넘을 때만 → 단순 클릭 통과) ──
      const DRAG_MIN = 6;
      let down = false, startX = 0, startPos = 0, moved = 0, dragging = false;
      stream.addEventListener('pointerdown', (e) => {
        if (mode !== 'carousel') return;
        if (e.button !== undefined && e.button !== 0) return;
        down = true; moved = 0; dragging = false;
        startX = e.clientX;
        if (raf != null) { cancelAnimationFrame(raf); raf = null; }
        startPos = pos;
      });
      window.addEventListener('pointermove', (e) => {
        if (!down) return;
        const dx = e.clientX - startX;
        moved = Math.abs(dx);
        if (!dragging && moved > DRAG_MIN) { dragging = true; stream.classList.add('dragging'); }
        if (dragging) { pos = startPos - dx / (cardW * 0.9); target = pos; render(); }
      });
      window.addEventListener('pointerup', () => {
        if (!down) return;
        down = false;
        if (dragging) { stream.classList.remove('dragging'); animateTo(Math.round(pos)); }
      });

      // ── 카드 클릭 → 팝업(모달)로 글 표시 ──
      const overlay = document.getElementById('qv-overlay') as HTMLElement | null;
      const qvContent = document.getElementById('qv-content');
      const qvFull = document.getElementById('qv-full') as HTMLAnchorElement | null;
      const qvClose = document.getElementById('qv-close');
      const cache: Record<string, string> = {};

      function openModal(href: string) {
        if (!overlay || !qvContent) return;
        if (qvFull) qvFull.href = href;
        overlay.hidden = false;
        document.body.classList.add('qv-open');
        requestAnimationFrame(() => overlay.classList.add('open'));
        qvContent.scrollTop = 0;
        if (cache[href]) { qvContent.innerHTML = cache[href]; return; }
        qvContent.innerHTML = '<div class="qv-loading"><span class="spin"></span><br>글을 불러오는 중…</div>';
        fetch(href)
          .then((r) => r.text())
          .then((html) => {
            const doc = new DOMParser().parseFromString(html, 'text/html');
            const article = doc.querySelector('.blog-post') || doc.querySelector('article') || doc.querySelector('main');
            if (!article) throw new Error('no content');
            // 불필요 요소 제거(광고/댓글/네비 등)
            article.querySelectorAll('.ad-slot, .comments-section, .post-navigation, .newsletter-cta, script, .breadcrumb, .share-buttons, .toc-sidebar, .pd-promo-link, .paperdoc-banner-link, .coupang-banner, .related-posts').forEach((n) => n.remove());
            const out = article.innerHTML;
            cache[href] = out;
            qvContent.innerHTML = out;
            qvContent.scrollTop = 0;
          })
          .catch(() => {
            qvContent.innerHTML = '<div class="qv-error">미리보기를 불러오지 못했어요.<br>“전체 페이지로 열기”를 눌러주세요.</div>';
          });
      }
      function closeModal() {
        if (!overlay) return;
        overlay.classList.remove('open');
        document.body.classList.remove('qv-open');
        setTimeout(() => { overlay.hidden = true; }, 260);
      }
      qvClose?.addEventListener('click', closeModal);
      overlay?.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && overlay && !overlay.hidden) closeModal(); });

      // ── 커맨드 팔레트(전체보기: 검색·필터·정렬·키보드·⌘K) ──
      const listOpenBtn = document.getElementById('list-open');
      const listOverlay = document.getElementById('list-overlay') as HTMLElement | null;
      const listClose = document.getElementById('list-close');
      const pInput = document.getElementById('palette-input') as HTMLInputElement | null;
      const pChips = document.getElementById('palette-chips');
      const pSort = document.getElementById('palette-sort');
      const pCount = document.getElementById('palette-count');
      const pEmpty = document.getElementById('palette-empty') as HTMLElement | null;
      const listBody = document.getElementById('list-body') as HTMLElement | null;
      const rows = Array.from(listOverlay?.querySelectorAll('.list-row') || []) as HTMLElement[];
      let pQuery = '', pCat = 'all', pSortKey: 'date' | 'views' = 'date', activeIdx = -1;
      const viewsMap: Record<string, number> = {};
      const ANON = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Inh5cHJic21hZ3RsemVieHl4c3ZqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzA0NjY4NTQsImV4cCI6MjA4NjA0Mjg1NH0.dajN0n0IWzOgYOSCglxVLzddg7jJFRHNCHwTWMG62uU';

      function highlight(el: HTMLElement | null, q: string) {
        if (!el) return;
        const orig = el.getAttribute('data-orig') || el.textContent || '';
        if (!q) { el.textContent = orig; return; }
        const i = orig.toLowerCase().indexOf(q);
        if (i < 0) { el.textContent = orig; return; }
        const esc = (s: string) => s.replace(/[&<>]/g, (m) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[m] as string));
        el.innerHTML = esc(orig.slice(0, i)) + '<mark>' + esc(orig.slice(i, i + q.length)) + '</mark>' + esc(orig.slice(i + q.length));
      }
      const getVisible = () => rows.filter((r) => !r.hidden);

      function applyPalette() {
        const visible: HTMLElement[] = [];
        rows.forEach((row) => {
          const okCat = pCat === 'all' || row.dataset.cat === pCat;
          const okQ = !pQuery || (row.dataset.search || '').includes(pQuery);
          const show = okCat && okQ;
          row.hidden = !show;
          row.classList.remove('active');
          if (show) { visible.push(row); highlight(row.querySelector('h4'), pQuery); }
        });
        visible.sort((a, b) => pSortKey === 'views'
          ? (viewsMap[b.dataset.slug || ''] || 0) - (viewsMap[a.dataset.slug || ''] || 0)
          : Number(b.dataset.date) - Number(a.dataset.date));
        visible.forEach((row) => listBody?.appendChild(row));
        if (pEmpty) { listBody?.appendChild(pEmpty); pEmpty.hidden = visible.length > 0; }
        if (pCount) pCount.textContent = String(visible.length);
        activeIdx = -1;
        if (listBody) listBody.scrollTop = 0;
      }

      function setActive(i: number) {
        const vis = getVisible();
        rows.forEach((r) => r.classList.remove('active'));
        if (!vis.length) { activeIdx = -1; return; }
        activeIdx = (i + vis.length) % vis.length;
        const el = vis[activeIdx];
        el.classList.add('active');
        el.scrollIntoView({ block: 'nearest' });
      }

      function openPalette() {
        if (!listOverlay) return;
        listOverlay.hidden = false;
        document.body.classList.add('list-open');
        requestAnimationFrame(() => { listOverlay.classList.add('open'); pInput?.focus(); pInput?.select(); });
      }
      function closePalette() {
        if (!listOverlay) return;
        listOverlay.classList.remove('open');
        document.body.classList.remove('list-open');
        setTimeout(() => { listOverlay.hidden = true; }, 260);
      }
      listOpenBtn?.addEventListener('click', openPalette);
      listClose?.addEventListener('click', closePalette);
      listOverlay?.addEventListener('click', (e) => { if (e.target === listOverlay) closePalette(); });

      pInput?.addEventListener('input', () => { pQuery = pInput.value.trim().toLowerCase(); applyPalette(); });
      pChips?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.pchip') as HTMLElement | null;
        if (!btn) return;
        pChips.querySelectorAll('.pchip').forEach((x) => x.classList.remove('active'));
        btn.classList.add('active');
        pCat = btn.dataset.cat || 'all';
        applyPalette();
      });
      pSort?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.psort') as HTMLElement | null;
        if (!btn) return;
        pSort.querySelectorAll('.psort').forEach((x) => x.classList.remove('active'));
        btn.classList.add('active');
        pSortKey = (btn.dataset.sort as 'date' | 'views') || 'date';
        applyPalette();
      });

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && (e.key === 'k' || e.key === 'K')) {
          e.preventDefault();
          if (listOverlay && listOverlay.hidden) openPalette(); else closePalette();
          return;
        }
        if (!listOverlay || listOverlay.hidden) return;
        if (overlay && !overlay.hidden) return;   // 글 팝업이 위에 있으면 무시
        if (e.key === 'Escape') { e.preventDefault(); closePalette(); }
        else if (e.key === 'ArrowDown') { e.preventDefault(); setActive(activeIdx + 1); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(activeIdx - 1); }
        else if (e.key === 'Enter') {
          const vis = getVisible();
          const el = activeIdx >= 0 ? vis[activeIdx] : vis[0];
          if (el) { e.preventDefault(); openModal(el.getAttribute('href') || (el as HTMLAnchorElement).href); }
        }
      });

      rows.forEach((row) => {
        row.addEventListener('click', (e) => {
          e.preventDefault();
          openModal(row.getAttribute('href') || (row as HTMLAnchorElement).href);
        });
      });

      // 조회수(대시보드) → 조회수 정렬·행별 표시
      fetch('https://xyprbsmagtlzebxyxsvj.supabase.co/rest/v1/rpc/get_top_pages', {
        method: 'POST',
        headers: { apikey: ANON, Authorization: `Bearer ${ANON}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({ p_limit: 200 }),
      })
        .then((r) => (r.ok ? r.json() : Promise.reject()))
        .then((data) => {
          if (!Array.isArray(data)) return;
          data.forEach((p) => {
            const raw = (p.slug || p.path || '').replace(/^\/blog\//, '').replace(/\/$/, '');
            let slug = raw; try { slug = decodeURIComponent(raw); } catch (err) {}
            viewsMap[slug] = Number(p.views) || 0;
          });
          rows.forEach((row) => {
            const v = viewsMap[row.dataset.slug || ''];
            const el = row.querySelector('.list-row-views') as HTMLElement | null;
            if (v && el) { el.textContent = (v >= 1000 ? (v / 1000).toFixed(1) + '천' : String(v)) + '회'; el.hidden = false; }
          });
        })
        .catch(() => {});

      applyPalette();

      cards.forEach((card) => {
        const a = card.querySelector('a') as HTMLAnchorElement | null;
        if (!a) return;
        a.addEventListener('click', (e) => {
          e.preventDefault();
          if (dragging || moved > DRAG_MIN) return;
          if (mode === 'grid') { openModal(a.getAttribute('href') || a.href); return; }
          const N = vis.length;
          const j = vis.indexOf(card);
          if (j < 0) return;
          const cur = ((Math.round(pos) % N) + N) % N;
          let d = ((j - cur) % N + N) % N;
          if (d > N / 2) d -= N;
          // 정면 카드 → 팝업 / 옆 카드 → 그 카드로 회전
          if (Math.abs(d) < 0.5) openModal(a.getAttribute('href') || a.href);
          else animateTo(Math.round(target) + d);
        });
      });

      // ── 필터 ──
      rail?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.filter-pill') as HTMLElement | null;
        if (!btn) return;
        const cat = btn.dataset.cat;
        rail.querySelectorAll('.filter-pill').forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');
        let visible = 0;
        cards.forEach((c) => {
          const match = cat === 'all' || c.dataset.cat === cat;
          c.classList.toggle('hide', !match);
          if (match) visible++;
        });
        if (empty) empty.style.display = visible === 0 ? 'flex' : 'none';
        refreshVis();
        if (mode === 'grid') { clearCardStyles(); }
        else { pos = 0; target = 0; measure(); render(); }
      });

      // 모드 토글
      modeBtns.forEach((b) => b.addEventListener('click', () => setMode((b.dataset.mode as 'carousel' | 'grid') || 'carousel')));

      window.addEventListener('resize', () => { if (mode === 'carousel') { measure(); render(); } });
      window.addEventListener('load', () => { if (mode === 'carousel') { measure(); render(); } });
      measure();
      requestAnimationFrame(() => { measure(); render(); });
    })();
  </script>
</BaseLayout>
