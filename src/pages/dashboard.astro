            <div class="recent-list">
              {tfRecentPosts.map((p, i) => (
                <div class="recent-item">
                  <span class="recent-rank">{i + 1}</span>
                  <span class="recent-title">{p.title}</span>
                  <span class={`cat-badge cat-${p.category.toLowerCase()}`}>{p.category}</span>
                  <span class="recent-date">{p.pubDate}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Tab: LifeFlow -->
      <div class="tab-content" id="tab-lifeflow">
        <div class="summary-grid">
          <div class="summary-card accent-green">
            <div class="label">LifeFlow Posts</div>
            <div class="value" id="lf-post-count">{lfPostCount}</div>
            <div class="sub">{lfCategoryCount} 카테고리</div>
          </div>
          <div class="summary-card accent-purple">
            <div class="label">조회수</div>
            <div class="value" id="lf-tab-views">--</div>
            <div class="sub" id="lf-tab-views-sub">로딩 중...</div>
          </div>
          <div class="summary-card accent-yellow">
            <div class="label">쿠팡 클릭</div>
            <div class="value" id="lf-tab-clicks">--</div>
