            <div class="label">전환율</div>
            <div class="value" id="lf-tab-cvr">--</div>
            <div class="sub">클릭 / 조회</div>
          </div>
        </div>

        <div class="blog-section">
          <div class="section-header">
            <div class="section-title">LifeFlow 콘텐츠</div>
            <span class="section-badge badge-lf"><span id="lf-badge-count">{lfPostCount}</span>편</span>
          </div>
          <div class="section-body">
            <div class="cat-donut-wrap" id="lf-donut-wrap">
              <div class="cat-donut" style={`background: conic-gradient(${lfCategories.map((c, i) => {
                const pctBefore = lfCategories.slice(0, i).reduce((s, x) => s + x.count, 0) / lfPostCount * 100;
                const pct = c.count / lfPostCount * 100;
