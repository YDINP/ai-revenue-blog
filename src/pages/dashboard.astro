---
import '../styles/global.css';
import { getCollection } from 'astro:content';

// TechFlow 실제 블로그 포스트 파일 기반 통계 (빌드 타임)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const tfPostCount = allPosts.length;

// TechFlow 카테고리별 포스트 수
const tfCategoryMap: Record<string, number> = {};
for (const post of allPosts) {
  const cat = post.data.category;
  tfCategoryMap[cat] = (tfCategoryMap[cat] || 0) + 1;
}

// 카테고리 고정 색상 (엔티티 기준 — 정렬 순서가 바뀌어도 색은 따라가지 않음)
// 다크 서피스(#1e293b) 대비 검증 통과 팔레트
const TF_CAT_COLORS: Record<string, string> = {
  AI: '#3b82f6',
  Dev: '#16a34a',
  Review: '#bf8700',
  Game: '#a855f7',
};
const CAT_FALLBACK_COLORS = ['#ea580c', '#ec4899', '#0891b2'];

const tfCategoryStats = Object.entries(tfCategoryMap)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

// 고정 매핑에 없는 카테고리는 이름순으로 폴백 색상 할당 (결정적)
{
  const unknown = tfCategoryStats
    .filter(c => !TF_CAT_COLORS[c.name])
    .map(c => c.name)
    .sort();
  unknown.forEach((name, i) => {
    TF_CAT_COLORS[name] = CAT_FALLBACK_COLORS[i % CAT_FALLBACK_COLORS.length];
  });
}
const tfCatColor = (name: string) => TF_CAT_COLORS[name] || '#94a3b8';

// TechFlow 최근 포스트 (최신 5개)
const tfRecentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5)
  .map(p => ({
    title: p.data.title,
    category: p.data.category,
    pubDate: p.data.pubDate.toISOString().split('T')[0],
    slug: p.id,
  }));

// LifeFlow 데이터: RSS 피드에서 가져오기 (클라이언트 사이드)
// 빌드 타임에는 기본값 사용, 브라우저에서 실시간 로드
const lfCategories = [
  { name: 'Lifestyle', count: 4, icon: 'sparkles', color: '#ec4899' },
  { name: 'Finance', count: 4, icon: 'banknotes', color: '#3b82f6' },
  { name: 'Health', count: 3, icon: 'heart', color: '#16a34a' },
  { name: 'Education', count: 3, icon: 'book', color: '#a855f7' },
  { name: 'Travel', count: 3, icon: 'plane', color: '#ea580c' },
];
const lfPostCount = 17; // RSS에서 동적 로드
const lfCategoryCount = lfCategories.length;

// 통합 통계
const totalPosts = tfPostCount + lfPostCount;
const totalCategories = tfCategoryStats.length + lfCategoryCount;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Dashboard | TechFlow + LifeFlow</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" rel="stylesheet" />
    <style is:global>
      /* ============================================================
         Dashboard 스타일 시스템 — 2026 리모델 (단일 패스)
         원칙: 뉴트럴 다크 / 헤어라인 보더 / 플랫(그라데이션·섀도 없음)
               애니메이션 없음(스피너 제외) / KPI 우선 계층 / tabular-nums
         팔레트: 다크 서피스(#131316) 대비 validator 통과본
         ============================================================ */
      :root {
        --bg: #0a0a0c;
        --surface: #131316;
        --surface-2: #1b1b20;
        --border: rgba(255, 255, 255, 0.08);
        --border-strong: rgba(255, 255, 255, 0.14);
        --text: #ededf0;
        --text-2: #a1a1aa;
        --text-3: #7c7c87;
        --accent: #3b82f6;
        --tf: #3b82f6;
        --lf: #16a34a;
        --good: #22c55e;
        --warn: #eab308;
        --bad: #ef4444;
        --like: #e11d48;
        --r: 12px;
        --r-sm: 8px;
        /* 구형 변수명 호환 (인라인 스타일에서 참조) */
        --dash-bg: var(--bg);
        --dash-surface: var(--surface);
        --dash-surface-hover: var(--surface-2);
        --dash-border: var(--border);
        --dash-text: var(--text);
        --dash-text-dim: var(--text-2);
        --dash-accent: var(--accent);
        --dash-green: var(--lf);
        --dash-yellow: var(--warn);
        --dash-red: var(--bad);
        --dash-purple: #a855f7;
        --dash-orange: #ea580c;
        --dash-pink: #ec4899;
        --dash-cyan: #0891b2;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        flex-direction: column; /* global.css의 body{display:flex} 대응 */
      }

      ::selection { background: rgba(59, 130, 246, 0.35); }

      button { font-family: inherit; }

      button:focus-visible, a:focus-visible, input:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* ── 헤더 ─────────────────────────────────────────── */
      .dash-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 10, 12, 0.88);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
        padding: 0.875rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-width: 0;
        width: 100%;
      }

      .dash-header h1 {
        font-size: 1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        letter-spacing: -0.01em;
      }

      .logo-tf { color: var(--tf); }
      .logo-lf { color: #4ade80; }
      .logo-sep { color: var(--text-3); font-weight: 400; }

      .dash-header .meta {
        font-size: 0.8125rem;
        color: var(--text-2);
        display: flex;
        align-items: center;
        gap: 0.875rem;
      }

      .live-dot {
        width: 7px;
        height: 7px;
        background: var(--good);
        border-radius: 50%;
      }

      /* ── 레이아웃 ─────────────────────────────────────── */
      .dash-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem;
        min-width: 0;
        width: 100%;
      }

      /* ── 배너 ─────────────────────────────────────────── */
      .data-banner {
        padding: 0.875rem 1.125rem;
        border-radius: var(--r-sm);
        margin-bottom: 1.25rem;
        font-size: 0.8125rem;
        line-height: 1.6;
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        border: 1px solid;
      }

      .data-banner.info {
        background: rgba(59, 130, 246, 0.08);
        border-color: rgba(59, 130, 246, 0.25);
        color: #93bbfd;
      }

      .data-banner.warning {
        background: rgba(234, 179, 8, 0.08);
        border-color: rgba(234, 179, 8, 0.25);
        color: #fde68a;
      }

      .data-banner .banner-icon { flex-shrink: 0; margin-top: 1px; }

      /* ── 메인 탭 ──────────────────────────────────────── */
      .main-tabs {
        display: flex;
        gap: 0.375rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0;
      }

      .main-tab {
        padding: 0.5rem 0.875rem 0.625rem;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        background: transparent;
        color: var(--text-2);
      }

      .main-tab:hover { color: var(--text); }

      .main-tab.active,
      .main-tab.active-tf,
      .main-tab.active-lf,
      .main-tab.active-coupang,
      .main-tab.active-comments {
        color: var(--text);
        border-bottom-color: var(--accent);
      }

      .tab-content { display: none; }
      .tab-content.active { display: block; }

      /* ── 카드 공통 ────────────────────────────────────── */
      .summary-card,
      .blog-section,
      .trend-section,
      .traffic-section,
      .status-section,
      .links-section,
      .coupang-card,
      .auth-box,
      .metric-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
      }

      /* ── KPI 요약 카드 ────────────────────────────────── */
      .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.875rem;
        margin-bottom: 1.25rem;
      }

      .summary-card { padding: 1.125rem 1.25rem; }

      .summary-card .label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-2);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.625rem;
      }

      .summary-card .value {
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        margin-bottom: 0.375rem;
      }

      .summary-card .sub {
        font-size: 0.75rem;
        color: var(--text-2);
        font-variant-numeric: tabular-nums;
      }

      .source-split-bar {
        display: flex;
        height: 6px;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 0.625rem;
        background: var(--surface-2);
      }

      .split-tf { background: var(--tf); }
      .split-lf { background: var(--lf); margin-left: 2px; }

      .split-legend {
        display: flex;
        justify-content: space-between;
        font-size: 0.6875rem;
        color: var(--text-2);
        margin-top: 0.375rem;
        font-variant-numeric: tabular-nums;
      }

      /* ── 섹션 카드 공통 헤더 ──────────────────────────── */
      .trend-section { padding: 1.125rem 1.25rem; margin-bottom: 1.25rem; }

      .trend-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
      }

      .trend-header h3 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text);
      }

      .trend-total {
        font-size: 0.75rem;
        color: var(--text-2);
        font-variant-numeric: tabular-nums;
      }

      .trend-total b { color: var(--text); font-size: 0.9375rem; }

      /* ── 7일 트렌드 차트 ──────────────────────────────── */
      .trend-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 140px;
        padding: 0 0.25rem;
      }

      .trend-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        height: 100%;
      }

      .trend-bar-wrap {
        flex: 1;
        width: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: center;
      }

      .trend-bar-stack {
        width: 60%;
        max-width: 44px;
        border-radius: 4px 4px 0 0;
        overflow: hidden;
      }

      .trend-bar-today {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .trend-bar-tf { background: var(--tf); }
      .trend-bar-lf { background: var(--lf); }

      /* 스택 세그먼트 사이 2px 서피스 갭 */
      .trend-bar-stack > div + div,
      .chart-bar-stack > div + div {
        box-shadow: inset 0 2px 0 var(--surface);
      }

      .trend-bar-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        flex-shrink: 0;
      }

      .trend-bar-date { font-size: 0.6875rem; color: var(--text-2); }

      .trend-bar-count {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text);
        font-variant-numeric: tabular-nums;
      }

      .trend-bar-split { font-size: 0.625rem; font-variant-numeric: tabular-nums; }

      .trend-legend {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 0.625rem;
        font-size: 0.6875rem;
        color: var(--text-2);
      }

      .trend-legend span { display: flex; align-items: center; gap: 0.3125rem; }

      .trend-legend span::before {
        content: '';
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 2px;
      }

      .trend-legend .leg-tf::before { background: var(--tf); }
      .trend-legend .leg-lf::before { background: var(--lf); }

      .dot-tf { width: 7px; height: 7px; border-radius: 50%; background: var(--tf); display: inline-block; }
      .dot-lf { width: 7px; height: 7px; border-radius: 50%; background: var(--lf); display: inline-block; }

      /* ── 날짜별 상세 테이블 ───────────────────────────── */
      .daily-detail-wrap {
        max-height: 340px;
        overflow-y: auto;
        overflow-x: auto;
        border-radius: var(--r-sm);
        border: 1px solid var(--border);
      }

      .daily-detail-table {
        width: 100%;
        min-width: 560px;
        border-collapse: collapse;
        font-size: 0.8125rem;
        font-variant-numeric: tabular-nums;
      }

      .daily-detail-table thead th {
        position: sticky;
        top: 0;
        background: var(--surface-2);
        color: var(--text-2);
        text-align: right;
        padding: 8px 12px;
        font-weight: 600;
        font-size: 0.75rem;
        z-index: 1;
      }

      .daily-detail-table thead th:first-child { text-align: left; }

      .daily-detail-table tbody td {
        padding: 7px 12px;
        text-align: right;
        border-top: 1px solid var(--border);
        color: var(--text);
        white-space: nowrap;
      }

      .daily-detail-table tbody td:first-child { text-align: left; color: var(--text-2); }
      .daily-detail-table tbody tr:hover td { background: rgba(59, 130, 246, 0.06); }
      .daily-detail-table tr.dd-today td { background: rgba(59, 130, 246, 0.10); font-weight: 700; }
      .dd-views { color: #60a5fa; font-weight: 600; }
      .dd-visitors { color: #4ade80; font-weight: 600; }
      .dd-minibar { display: inline-block; height: 6px; background: var(--tf); border-radius: 3px; min-width: 2px; }
      .dd-bar-col { width: 120px; }
      .dd-note { margin: 8px 2px 0; font-size: 0.72rem; color: var(--text-3); }

      /* ── 히트맵 ───────────────────────────────────────── */
      .heatmap-wrap { overflow-x: auto; padding-bottom: 6px; }
      .heatmap-grid { display: inline-block; min-width: 100%; }
      .hm-row { display: flex; align-items: center; gap: 2px; margin-bottom: 2px; }
      .hm-rowlabel {
        width: 44px; flex: 0 0 44px;
        font-size: 0.6875rem; color: var(--text-2);
        text-align: right; padding-right: 6px;
        font-variant-numeric: tabular-nums;
      }
      .hm-hourhead { display: flex; gap: 2px; margin: 0 0 4px 50px; }
      .hm-cell {
        width: 15px; height: 15px; flex: 0 0 15px;
        border-radius: 3px;
        display: inline-block;
      }
      /* 단일 색상(블루) 순차 램프 — 밝기 단조 증가 */
      .hm-cell.l0 { background: var(--surface-2); }
      .hm-cell.l1 { background: #1e3a8a; }
      .hm-cell.l2 { background: #1d4ed8; }
      .hm-cell.l3 { background: #3b82f6; }
      .hm-cell.l4 { background: #93c5fd; }
      .hm-hourlabel {
        width: 15px; flex: 0 0 15px;
        font-size: 0.625rem; color: var(--text-3);
        text-align: center;
      }
      .heatmap-legend {
        display: flex; align-items: center; gap: 3px;
        font-size: 0.72rem; color: var(--text-2);
      }
      .heatmap-legend .hm-cell { width: 13px; height: 13px; flex: 0 0 13px; }

      /* ── 실시간 트래픽 ────────────────────────────────── */
      .traffic-section { margin-bottom: 1.25rem; overflow: hidden; }

      .traffic-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      .traffic-header h3 {
        font-size: 0.875rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .refresh-btn {
        background: transparent;
        border: 1px solid var(--border-strong);
        color: var(--text-2);
        padding: 0.3125rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        cursor: pointer;
      }

      .refresh-btn:hover { border-color: var(--accent); color: var(--text); }

      .traffic-body { padding: 1.25rem; }

      .metric-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
      }

      .metric-box {
        background: var(--surface-2);
        border: none;
        border-radius: var(--r-sm);
        padding: 0.875rem;
        text-align: center;
      }

      .metric-box .metric-label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-2);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.375rem;
      }

      .metric-box .metric-value {
        font-size: 1.375rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        margin-bottom: 0.25rem;
      }

      .metric-box .metric-delta { font-size: 0.6875rem; font-variant-numeric: tabular-nums; }
      .metric-delta.up { color: var(--good); }
      .metric-delta.down { color: var(--bad); }
      .metric-delta.neutral { color: var(--text-2); }

      .metric-breakdown {
        display: flex;
        justify-content: center;
        gap: 0.625rem;
        margin-top: 0.375rem;
        font-size: 0.6875rem;
        color: var(--text-2);
        font-variant-numeric: tabular-nums;
      }

      .metric-breakdown span { display: flex; align-items: center; gap: 0.25rem; }

      /* ── 시간대별 차트 ────────────────────────────────── */
      .hourly-chart { margin-bottom: 1.25rem; }

      .hourly-chart h4 {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.75rem;
      }

      /* .hourly-chart 스코프로 특이도 상향 — global.css의 블로그용
         .chart-bars{flex-direction:column} 충돌을 번들 순서와 무관하게 이김 */
      .hourly-chart .chart-bars {
        display: flex;
        flex-direction: row;
        align-items: flex-end;
        gap: 2px;
        height: 100px;
        padding: 0 0 1.5rem;
        position: relative;
      }

      .chart-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        position: relative;
      }

      .chart-bar-stack {
        display: flex;
        flex-direction: column;
        width: 100%;
        border-radius: 3px 3px 0 0;
        overflow: hidden;
      }

      .bar-tf { background: var(--tf); }
      .bar-lf { background: var(--lf); }

      .chart-bar-label {
        position: absolute;
        bottom: -1.25rem;
        font-size: 0.625rem;
        color: var(--text-3);
      }

      .chart-bar-tooltip {
        display: none;
        position: absolute;
        top: -1.75rem;
        background: var(--surface-2);
        border: 1px solid var(--border-strong);
        padding: 0.1875rem 0.5rem;
        border-radius: 4px;
        font-size: 0.6875rem;
        white-space: nowrap;
        z-index: 10;
        font-variant-numeric: tabular-nums;
      }

      .chart-bar-col:hover .chart-bar-tooltip { display: block; }

      /* ── Top Pages / Live Feed ────────────────────────── */
      .traffic-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }

      .traffic-panel h4 {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
      }

      .source-tabs { display: flex; gap: 0.375rem; margin-bottom: 0.75rem; }

      .source-tab {
        padding: 0.3125rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--text-2);
      }

      .source-tab:hover { color: var(--text); }
      .source-tab.active { background: var(--surface-2); border-color: var(--border-strong); color: var(--text); }
      .source-tab.active-tf { background: rgba(59, 130, 246, 0.15); border-color: var(--tf); color: #93bbfd; }
      .source-tab.active-lf { background: rgba(22, 163, 74, 0.15); border-color: var(--lf); color: #6ee7a5; }

      .top-page-list, .event-feed { display: flex; flex-direction: column; }

      .top-page-item, .like-top-item, .event-item, .recent-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.375rem;
        margin: 0 -0.375rem;
        border-radius: 6px;
        border-bottom: 1px solid var(--border);
        font-size: 0.8125rem;
      }

      .top-page-item:last-child, .like-top-item:last-child,
      .event-item:last-child, .recent-item:last-child { border-bottom: none; }

      .top-page-item:hover, .like-top-item:hover,
      .event-item:hover, .recent-item:hover { background: var(--surface-2); }

      .top-page-rank, .recent-rank {
        font-weight: 700;
        color: var(--text-3);
        width: 20px;
        text-align: center;
        flex-shrink: 0;
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
      }

      .top-page-title, .top-page-slug, .recent-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.75rem;
      }

      .recent-title { font-size: 0.8125rem; }

      .top-page-views {
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--text);
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .recent-date {
        font-size: 0.6875rem;
        color: var(--text-3);
        white-space: nowrap;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .src-badge {
        display: inline-block;
        padding: 0.0625rem 0.375rem;
        border-radius: 3px;
        font-size: 0.625rem;
        font-weight: 700;
        flex-shrink: 0;
        letter-spacing: 0.02em;
      }

      .src-badge.tf { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .src-badge.lf { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }

      /* ── 추천 TOP ─────────────────────────────────────── */
      .like-top-panel { margin-top: 1.25rem; }

      .like-top-total {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--text-2);
        margin-left: 0.25rem;
        font-variant-numeric: tabular-nums;
      }

      .like-bar-wrap {
        flex: 1;
        height: 5px;
        background: var(--surface-2);
        border-radius: 3px;
        overflow: hidden;
      }

      .like-bar-fill { height: 100%; background: var(--like); border-radius: 3px; }

      .like-top-count {
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--text);
        flex-shrink: 0;
        min-width: 48px;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }

      /* ── 이벤트 피드 ──────────────────────────────────── */
      .event-item { min-height: 36px; font-size: 0.75rem; }

      .event-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6875rem;
        flex-shrink: 0;
      }

      .event-icon.pageview { background: rgba(59, 130, 246, 0.15); }
      .event-icon.like { background: rgba(225, 29, 72, 0.15); }
      .event-icon.coupang_click { background: rgba(234, 88, 12, 0.15); }
      .event-icon.newsletter_subscribe { background: rgba(22, 163, 74, 0.15); }

      .event-content {
        flex: 1;
        overflow: hidden;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .event-action {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.3;
      }

      .event-page-title {
        font-size: 0.6875rem;
        color: var(--text-2);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.3;
      }

      .event-time {
        font-size: 0.6875rem;
        color: var(--text-3);
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .no-data {
        text-align: center;
        padding: 2rem;
        color: var(--text-3);
        font-size: 0.8125rem;
      }

      /* ── 블로그 섹션 (도넛/최근 글) ───────────────────── */
      .blog-sections {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
      }

      .blog-section { overflow: hidden; }

      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      .section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
      }

      .section-badge {
        font-size: 0.6875rem;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .badge-tf { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .badge-lf { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }

      .section-body { padding: 1.125rem 1.25rem; }

      .cat-donut-wrap {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 1rem;
      }

      .cat-donut {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        position: relative;
        flex-shrink: 0;
      }

      .cat-donut-hole {
        position: absolute;
        inset: 22%;
        border-radius: 50%;
        background: var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
      }

      .cat-donut-hole .donut-num {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1;
        font-variant-numeric: tabular-nums;
      }

      .cat-donut-hole .donut-label { font-size: 0.625rem; color: var(--text-2); }

      .cat-legend { display: flex; flex-direction: column; gap: 0.3125rem; flex: 1; }

      .cat-legend-item {
        display: flex;
        align-items: center;
        gap: 0.4375rem;
        font-size: 0.75rem;
      }

      .cat-legend-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
      .cat-legend-name { flex: 1; }
      .cat-legend-count { font-weight: 700; min-width: 20px; text-align: right; font-variant-numeric: tabular-nums; }
      .cat-legend-pct { color: var(--text-2); font-size: 0.6875rem; min-width: 32px; text-align: right; font-variant-numeric: tabular-nums; }

      /* 카테고리 배지 (텍스트 칩) */
      .cat-badge {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        font-size: 0.625rem;
        font-weight: 600;
        flex-shrink: 0;
      }

      .cat-ai { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .cat-dev { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }
      .cat-review { background: rgba(191, 135, 0, 0.18); color: #f5cf5a; }
      .cat-game { background: rgba(168, 85, 247, 0.15); color: #c9a4f5; }
      .cat-lifestyle { background: rgba(236, 72, 153, 0.15); color: #f4a8cd; }
      .cat-finance { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .cat-health { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }
      .cat-education { background: rgba(168, 85, 247, 0.15); color: #c9a4f5; }
      .cat-travel { background: rgba(234, 88, 12, 0.18); color: #f2a172; }

      /* 카테고리별 트래픽 바 */
      .cat-traffic-section {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        margin-bottom: 1rem;
      }

      .cat-traffic-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.75rem;
      }

      .cat-traffic-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }

      .cat-traffic-name {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text);
        min-width: 64px;
        flex-shrink: 0;
      }

      .cat-traffic-bar-wrap {
        flex: 1;
        height: 12px;
        background: var(--surface-2);
        border-radius: 6px;
        overflow: hidden;
      }

      .cat-traffic-bar { height: 100%; border-radius: 6px; min-width: 4px; }

      .cat-traffic-value {
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--text);
        min-width: 48px;
        text-align: right;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .cat-traffic-share {
        font-size: 0.6875rem;
        color: var(--text-2);
        min-width: 28px;
        text-align: right;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .recent-list { display: flex; flex-direction: column; }

      /* ── 시스템 상태 ──────────────────────────────────── */
      .status-section, .links-section { padding: 1.125rem 1.25rem; margin-bottom: 1.25rem; }

      .status-section h3, .links-section h3 {
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text);
      }

      .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.625rem;
      }

      .status-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.625rem 0.75rem;
        background: var(--surface-2);
        border-radius: var(--r-sm);
        font-size: 0.8125rem;
      }

      .status-badge {
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.6875rem;
        font-weight: 600;
      }

      /* 상태 = 색 + 점 + 텍스트 (색 단독 의미 전달 금지) */
      .status-badge::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 0.375rem;
        vertical-align: middle;
        background: currentColor;
      }

      .status-badge.online { background: rgba(34, 197, 94, 0.15); color: #4ade80; }
      .status-badge.pending { background: rgba(234, 179, 8, 0.15); color: #facc15; }
      .status-badge.offline { background: rgba(239, 68, 68, 0.15); color: #f87171; }

      /* ── 바로가기 ─────────────────────────────────────── */
      .links-grid { display: flex; flex-wrap: wrap; gap: 0.625rem; }

      .link-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        border-radius: var(--r-sm);
        background: var(--surface-2);
        border: 1px solid var(--border);
        color: var(--text);
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
      }

      .link-btn:hover { border-color: var(--accent); }
      .link-btn .link-icon { font-size: 0.9375rem; }
      .link-btn .link-label { color: var(--text-2); font-size: 0.6875rem; margin-left: 0.25rem; }

      /* ── 쿠팡 탭 ──────────────────────────────────────── */
      .coupang-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.875rem;
        margin-bottom: 1.25rem;
      }

      .coupang-card { padding: 1.125rem 1.25rem; }

      .coupang-card h4 {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-2);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.625rem;
      }

      .conversion-rate {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        margin-bottom: 0.375rem;
      }

      .coupang-card .sub { font-size: 0.75rem; color: var(--text-2); }

      /* ── 댓글 탭 ──────────────────────────────────────── */
      .comment-auth-gate {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 300px;
      }

      .auth-box {
        padding: 2.5rem;
        text-align: center;
        max-width: 400px;
        width: 100%;
      }

      .auth-box h3 { font-size: 1.125rem; margin-bottom: 0.5rem; }

      .auth-box p {
        color: var(--text-2);
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
      }

      .auth-input-row { display: flex; gap: 0.5rem; }

      .auth-input-row input {
        flex: 1;
        padding: 0.625rem 1rem;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: var(--r-sm);
        color: var(--text);
        font-size: 0.875rem;
        outline: none;
      }

      .auth-input-row input:focus { border-color: var(--accent); }

      .auth-input-row button {
        padding: 0.625rem 1.25rem;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: var(--r-sm);
        font-weight: 600;
        cursor: pointer;
      }

      .auth-input-row button:hover { background: #2563eb; }

      .auth-error { color: var(--bad); font-size: 0.8125rem; margin-top: 0.75rem; }

      .comment-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.875rem;
      }

      .comment-filters { display: flex; gap: 0.375rem; }

      .filter-btn {
        padding: 0.3125rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--text-2);
      }

      .filter-btn:hover { color: var(--text); }
      .filter-btn.active { background: var(--surface-2); border-color: var(--accent); color: var(--text); }

      .comment-trend-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 160px;
        padding: 1rem 0;
      }

      .trend-bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        height: 100%;
        justify-content: flex-end;
      }

      .trend-bars {
        display: flex;
        gap: 2px;
        align-items: flex-end;
        width: 100%;
        justify-content: center;
      }

      .trend-bar {
        width: 14px;
        border-radius: 3px 3px 0 0;
        min-height: 4px;
      }

      .trend-bar.tf { background: var(--tf); }
      .trend-bar.lf { background: var(--lf); }

      .trend-label { font-size: 0.6875rem; color: var(--text-2); }
      .trend-count { font-size: 0.6875rem; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }

      .comment-list { max-height: 600px; overflow-y: auto; }

      .cm-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        border-bottom: 1px solid var(--border);
      }

      .cm-item:hover { background: var(--surface-2); }

      .cm-source {
        font-size: 0.625rem;
        font-weight: 700;
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
        white-space: nowrap;
        flex-shrink: 0;
        margin-top: 0.125rem;
      }

      .cm-source.tf { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .cm-source.lf { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }

      .cm-body { flex: 1; min-width: 0; }

      .cm-meta {
        font-size: 0.75rem;
        color: var(--text-2);
        margin-bottom: 0.25rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .cm-nickname { font-weight: 700; color: var(--text); }

      .cm-admin-badge {
        font-size: 0.625rem;
        background: var(--accent);
        color: #fff;
        padding: 0 0.375rem;
        border-radius: 4px;
        font-weight: 600;
      }

      .cm-report-badge {
        font-size: 0.625rem;
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        padding: 0 0.375rem;
        border-radius: 4px;
        font-weight: 600;
      }

      .cm-content {
        font-size: 0.875rem;
        color: var(--text);
        line-height: 1.5;
        word-break: break-word;
      }

      .cm-slug { font-size: 0.6875rem; color: var(--text-3); margin-top: 0.25rem; }

      .cm-actions {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        flex-shrink: 0;
      }

      .cm-btn {
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.6875rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--text-2);
        white-space: nowrap;
      }

      .cm-btn:hover { border-color: var(--accent); color: var(--text); }
      .cm-btn.danger { color: #f87171; }
      .cm-btn.danger:hover { background: rgba(239, 68, 68, 0.1); border-color: var(--bad); }

      .cm-reply-form { margin-top: 0.5rem; display: flex; gap: 0.375rem; }

      .cm-reply-form input {
        flex: 1;
        padding: 0.375rem 0.625rem;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        color: var(--text);
        font-size: 0.8125rem;
        outline: none;
      }

      .cm-reply-form input:focus { border-color: var(--accent); }

      .cm-reply-form button {
        padding: 0.375rem 0.75rem;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8125rem;
        cursor: pointer;
      }

      /* ── 로딩 (유일한 애니메이션 = 기능적 스피너) ─────── */
      .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60px;
        color: var(--text-2);
        font-size: 0.8125rem;
      }

      .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid var(--border-strong);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 0.5rem;
      }

      @keyframes spin { to { transform: rotate(360deg); } }

      /* ── 스크롤바 ─────────────────────────────────────── */
      .daily-detail-wrap, .comment-list, .heatmap-wrap, .main-tabs {
        scrollbar-width: thin;
        scrollbar-color: rgba(161, 161, 170, 0.3) transparent;
      }

      .daily-detail-wrap::-webkit-scrollbar,
      .comment-list::-webkit-scrollbar,
      .heatmap-wrap::-webkit-scrollbar,
      .main-tabs::-webkit-scrollbar { width: 8px; height: 8px; }

      .daily-detail-wrap::-webkit-scrollbar-thumb,
      .comment-list::-webkit-scrollbar-thumb,
      .heatmap-wrap::-webkit-scrollbar-thumb,
      .main-tabs::-webkit-scrollbar-thumb {
        background: rgba(161, 161, 170, 0.28);
        border-radius: 4px;
      }

      .daily-detail-wrap::-webkit-scrollbar-track,
      .comment-list::-webkit-scrollbar-track,
      .heatmap-wrap::-webkit-scrollbar-track,
      .main-tabs::-webkit-scrollbar-track { background: transparent; }

      /* ── 반응형 ───────────────────────────────────────── */
      @media (max-width: 1100px) and (min-width: 769px) {
        .summary-grid { grid-template-columns: repeat(2, 1fr); }
        .metric-row { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 768px) {
        .summary-grid { grid-template-columns: 1fr; }
        .blog-sections { grid-template-columns: 1fr; }
        .dash-header { flex-direction: column; gap: 0.5rem; align-items: flex-start; }
        .metric-row { grid-template-columns: 1fr 1fr; }
        .traffic-grid { grid-template-columns: 1fr; }
        .main-tabs {
          overflow-x: auto;
          flex-wrap: nowrap;
          -webkit-overflow-scrolling: touch;
        }
        .main-tab { white-space: nowrap; flex-shrink: 0; }
        .coupang-stats { grid-template-columns: 1fr; }
        .comment-stats-grid { grid-template-columns: 1fr; }
        .comment-filters { flex-wrap: wrap; }
        .cm-item { flex-direction: column; gap: 0.5rem; }
        .cm-actions { flex-direction: row; }
        .summary-card .value { font-size: 1.5rem; }
      }

      /* ── 벤토 그리드 (12컬럼 재구성) ───────────────────── */
      .dash-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1.25rem;
        margin-bottom: 1.25rem;
        align-items: stretch;
      }
      /* 그리드 셀은 자체 margin-bottom 제거(간격은 gap이 담당) + 축소 허용 */
      .dash-grid > * { margin-bottom: 0; min-width: 0; }

      .col-3 { grid-column: span 3; }
      .col-4 { grid-column: span 4; }
      .col-6 { grid-column: span 6; }
      .col-7 { grid-column: span 7; }
      .col-8 { grid-column: span 8; }
      .col-12 { grid-column: span 12; }

      /* 범용 패널 카드 — 독립 셀이 된 위젯에 카드 크롬 부여 */
      .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 1.125rem 1.25rem;
        display: flex;
        flex-direction: column;
      }

      .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }

      .panel-head h3, .panel-head h4 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text);
      }

      .panel > .source-tabs { margin-top: -0.25rem; }
      .panel .hourly-chart { margin-bottom: 0; }
      .panel .top-page-list, .panel .event-feed { flex: 1; }

      /* 오늘 현황 = 2x2 스탯 그리드 */
      .today-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        flex: 1;
      }

      .today-grid .metric-box {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* 태블릿(≤1100): 벤토 해제 → 단일 컬럼(가독성 우선) */
      @media (max-width: 1100px) {
        .col-3 { grid-column: span 6; }
        .col-4, .col-6, .col-7, .col-8 { grid-column: span 12; }
      }

      @media (max-width: 768px) {
        .dash-grid { grid-template-columns: 1fr; gap: 1rem; }
        .dash-grid > * { grid-column: 1 / -1; }
      }
    </style>
  </head>
  <body>
    <header class="dash-header">
      <h1>
        <span class="logo-tf">TechFlow</span>
        <span class="logo-sep">+</span>
        <span class="logo-lf">LifeFlow</span>
        Dashboard
      </h1>
      <div class="meta">
        <span class="live-dot"></span>
        <span id="last-updated">Loading...</span>
        <a href="/" style="color: var(--dash-accent); text-decoration: none; font-size: 0.8125rem;">Blog &rarr;</a>
      </div>
    </header>

    <div class="dash-container">
      <!-- Data Status Banner -->
      <div id="data-banner" class="data-banner" style="display:none;"></div>

      <!-- Main Tabs -->
      <div class="main-tabs">
        <button class="main-tab active" data-tab="all">전체 요약</button>
        <button class="main-tab" data-tab="techflow">TechFlow</button>
        <button class="main-tab" data-tab="lifeflow">LifeFlow</button>
        <button class="main-tab" data-tab="coupang">쿠팡</button>
        <button class="main-tab" data-tab="comments">댓글</button>
      </div>

      <!-- Tab: 전체 요약 -->
      <div class="tab-content active" id="tab-all">
      <!-- ══ Row 1: KPI 히어로 스트립 ══ -->
      <div class="summary-grid">
        <div class="summary-card accent-blue">
          <div class="label">Total Posts</div>
          <div class="value">{totalPosts}</div>
          <div class="sub">TechFlow {tfPostCount} + LifeFlow {lfPostCount}</div>
          <div class="source-split-bar" style="margin-top:0.5rem;">
            <div class="split-tf" style={`width:${Math.round(tfPostCount / totalPosts * 100)}%`}></div>
            <div class="split-lf" style={`width:${Math.round(lfPostCount / totalPosts * 100)}%`}></div>
          </div>
          <div class="split-legend">
            <span>TF {Math.round(tfPostCount / totalPosts * 100)}%</span>
            <span>LF {Math.round(lfPostCount / totalPosts * 100)}%</span>
          </div>
        </div>
        <div class="summary-card accent-green">
          <div class="label">Categories</div>
          <div class="value">{totalCategories}</div>
          <div class="sub">TechFlow {tfCategoryStats.length} + LifeFlow {lfCategoryCount}</div>
        </div>
        <div class="summary-card accent-purple">
          <div class="label">Page Views</div>
          <div class="value" id="total-views">--</div>
          <div class="sub" id="views-sub">Supabase 로딩 중...</div>
          <div class="source-split-bar" id="views-split-bar">
            <div class="split-tf" id="views-split-tf" style="width:50%"></div>
            <div class="split-lf" id="views-split-lf" style="width:50%"></div>
          </div>
          <div class="split-legend">
            <span>TF: <b id="tf-total-views">--</b></span>
            <span>LF: <b id="lf-total-views">--</b></span>
          </div>
        </div>
        <div class="summary-card accent-yellow">
          <div class="label">Coupang Clicks</div>
          <div class="value" id="total-clicks">--</div>
          <div class="sub" id="clicks-sub">추적 중...</div>
        </div>
      </div>

      <!-- ══ Row 2: 7일 트렌드(8) + 오늘 현황(4) ══ -->
      <div class="dash-grid">
        <div class="trend-section col-8">
          <div class="trend-header">
            <h3>7-Day Views Trend</h3>
            <div class="trend-total">7일 합계: <b id="trend-total-num">--</b></div>
          </div>
          <div class="trend-chart" id="trend-chart">
            <div class="no-data">Loading trend...</div>
          </div>
          <div class="trend-legend">
            <span class="leg-tf">TechFlow</span>
            <span class="leg-lf">LifeFlow</span>
          </div>
        </div>

        <div class="panel col-4">
          <div class="panel-head">
            <h3>오늘 현황</h3>
            <button class="refresh-btn" id="refresh-traffic">Refresh</button>
          </div>
          <div class="today-grid">
            <div class="metric-box">
              <div class="metric-label">Today Views</div>
              <div class="metric-value" id="t-today-views">--</div>
              <div class="metric-delta neutral" id="t-views-delta">loading...</div>
              <div class="metric-breakdown" id="t-views-breakdown">
                <span><i class="dot-tf"></i> TF: --</span>
                <span><i class="dot-lf"></i> LF: --</span>
              </div>
            </div>
            <div class="metric-box">
              <div class="metric-label">Coupang Clicks</div>
              <div class="metric-value" id="t-today-clicks">--</div>
              <div class="metric-delta neutral" id="t-clicks-delta">loading...</div>
              <div class="metric-breakdown" id="t-clicks-breakdown">
                <span><i class="dot-tf"></i> TF: --</span>
                <span><i class="dot-lf"></i> LF: --</span>
              </div>
            </div>
            <div class="metric-box">
              <div class="metric-label">Likes</div>
              <div class="metric-value" id="t-today-likes">--</div>
              <div class="metric-delta neutral" id="t-likes-total">total: --</div>
            </div>
            <div class="metric-box">
              <div class="metric-label">Subscribers</div>
              <div class="metric-value" id="t-subscribers">--</div>
              <div class="metric-delta neutral" id="t-subs-today">today: --</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ══ Row 3: 시간대별(4) + 히트맵(8) ══ -->
      <div class="dash-grid">
        <div class="panel col-4">
          <div class="panel-head"><h4>시간대별 조회 (오늘)</h4></div>
          <div class="hourly-chart">
            <div class="chart-bars" id="hourly-chart"></div>
          </div>
        </div>

        <div class="panel col-8">
          <div class="panel-head">
            <h4>날짜 × 시간대 히트맵 (14일, KST)</h4>
            <div class="heatmap-legend">
              <span>적음</span>
              <i class="hm-cell l0"></i><i class="hm-cell l1"></i><i class="hm-cell l2"></i><i class="hm-cell l3"></i><i class="hm-cell l4"></i>
              <span>많음</span>
            </div>
          </div>
          <div class="heatmap-wrap" id="heatmap-wrap">
            <div class="no-data">Loading...</div>
          </div>
        </div>
      </div>

      <!-- ══ Row 4: Top Pages(4) + Live(4) + 추천 TOP(4) ══ -->
      <div class="dash-grid">
        <div class="panel col-4">
          <div class="panel-head"><h4>Top Pages</h4></div>
          <div class="source-tabs" id="top-pages-tabs">
            <button class="source-tab active" data-filter="all">All</button>
            <button class="source-tab" data-filter="blog">TechFlow</button>
            <button class="source-tab" data-filter="lifeflow">LifeFlow</button>
          </div>
          <div class="top-page-list" id="top-pages">
            <div class="no-data">Loading...</div>
          </div>
        </div>

        <div class="panel col-4">
          <div class="panel-head"><h4>Live Activity</h4></div>
          <div class="source-tabs" id="event-tabs">
            <button class="source-tab active" data-filter="all">All</button>
            <button class="source-tab" data-filter="blog">TechFlow</button>
            <button class="source-tab" data-filter="lifeflow">LifeFlow</button>
          </div>
          <div class="event-feed" id="event-feed">
            <div class="no-data">Loading...</div>
          </div>
        </div>

        <div class="panel col-4">
          <div class="panel-head">
            <h4>&#10084;&#65039; 추천 TOP <span class="like-top-total" id="like-top-total"></span></h4>
          </div>
          <div class="top-page-list" id="top-liked-posts">
            <div class="no-data">Loading...</div>
          </div>
        </div>
      </div>

      <!-- ══ Row 5: 날짜별 상세 30일 (full) ══ -->
      <div class="trend-section">
        <div class="trend-header">
          <h3>날짜별 상세 (최근 30일, KST)</h3>
          <div class="trend-total">합계: <b id="daily-detail-total">--</b></div>
        </div>
        <div class="daily-detail-wrap">
          <table class="daily-detail-table">
            <thead>
              <tr><th>날짜</th><th>조회수</th><th>방문자</th><th>TF</th><th>LF</th><th class="dd-bar-col"></th></tr>
            </thead>
            <tbody id="daily-detail-body">
              <tr><td colspan="6" class="no-data">Loading...</td></tr>
            </tbody>
          </table>
        </div>
        <p class="dd-note">※ 방문자 = 고유 브라우저(User-Agent) 기준 추정치. 조회수 ≥ 방문자.</p>
      </div>

      <!-- ══ Row 6: TechFlow(6) + LifeFlow(6) 콘텐츠 구성 ══ -->
      <div class="blog-sections">
        <!-- TechFlow Section -->
        <div class="blog-section">
          <div class="section-header">
            <div class="section-title">
              TechFlow
            </div>
            <span class="section-badge badge-tf">{tfPostCount}편</span>
          </div>
          <div class="section-body">
            <div class="cat-donut-wrap">
              <div class="cat-donut" style={`background: conic-gradient(${tfCategoryStats.map((c, i) => {
                const pctBefore = tfCategoryStats.slice(0, i).reduce((s, x) => s + x.count, 0) / tfPostCount * 100;
                const pct = c.count / tfPostCount * 100;
                const g = tfCategoryStats.length > 1 ? Math.min(1, pct / 4) : 0;
                return `#1e293b ${pctBefore}% ${pctBefore + g}%, ${tfCatColor(c.name)} ${pctBefore + g}% ${pctBefore + pct}%`;
              }).join(', ')})`}>
                <div class="cat-donut-hole">
                  <span class="donut-num">{tfPostCount}</span>
                  <span class="donut-label">포스트</span>
                </div>
              </div>
              <div class="cat-legend">
                {tfCategoryStats.map((c) => (
                  <div class="cat-legend-item">
                    <span class="cat-legend-dot" style={`background:${tfCatColor(c.name)}`}></span>
                    <span class="cat-legend-name">{c.name}</span>
                    <span class="cat-legend-count">{c.count}</span>
                    <span class="cat-legend-pct">{Math.round(c.count / tfPostCount * 100)}%</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="recent-list">
              {tfRecentPosts.map((p, i) => (
                <div class="recent-item">
                  <span class="recent-rank">{i + 1}</span>
                  <span class="recent-title">{p.title}</span>
                  <span class={`cat-badge cat-${p.category.toLowerCase()}`}>{p.category}</span>
                  <span class="recent-date">{p.pubDate}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- LifeFlow Section -->
        <div class="blog-section">
          <div class="section-header">
            <div class="section-title">
              LifeFlow
            </div>
            <span class="section-badge badge-lf">{lfPostCount}편</span>
          </div>
          <div class="section-body">
            <div class="cat-donut-wrap">
              <div class="cat-donut" style={`background: conic-gradient(${lfCategories.map((c, i) => {
                const pctBefore = lfCategories.slice(0, i).reduce((s, x) => s + x.count, 0) / lfPostCount * 100;
                const pct = c.count / lfPostCount * 100;
                const g = lfCategories.length > 1 ? Math.min(1, pct / 4) : 0;
                return `#1e293b ${pctBefore}% ${pctBefore + g}%, ${c.color} ${pctBefore + g}% ${pctBefore + pct}%`;
              }).join(', ')})`}>
                <div class="cat-donut-hole">
                  <span class="donut-num">{lfPostCount}</span>
                  <span class="donut-label">포스트</span>
                </div>
              </div>
              <div class="cat-legend">
                {lfCategories.map(c => (
                  <div class="cat-legend-item">
                    <span class="cat-legend-dot" style={`background:${c.color}`}></span>
                    <span class="cat-legend-name">{c.name}</span>
                    <span class="cat-legend-count">{c.count}</span>
                    <span class="cat-legend-pct">{Math.round(c.count / lfPostCount * 100)}%</span>
                  </div>
                ))}
              </div>
            </div>
            <div class="recent-list" id="lf-recent-list">
              <div class="loading"><div class="spinner"></div>정적 데이터</div>
            </div>
          </div>
        </div>
      </div>

      <!-- ══ Row 7: 시스템 상태(8) + 바로가기(4) ══ -->
      <div class="dash-grid">
        <div class="status-section col-8">
          <h3>System Status</h3>
          <div class="status-grid">
            <div class="status-item">
              <span>TechFlow (Vercel)</span>
              <span class="status-badge online">Online</span>
            </div>
            <div class="status-item">
              <span>LifeFlow (Vercel)</span>
              <span class="status-badge pending">미배포</span>
            </div>
            <div class="status-item">
              <span>Supabase DB</span>
              <span class="status-badge" id="supabase-status">Checking...</span>
            </div>
            <div class="status-item">
              <span>Pageview Tracking</span>
              <span class="status-badge online">Active</span>
            </div>
            <div class="status-item">
