      function timeAgo(dateStr) {
        const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
        if (diff < 60) return `${Math.floor(diff)}s ago`;
        if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
        return `${Math.floor(diff / 86400)}d ago`;
      }

      function deltaText(today, yesterday) {
        if (yesterday === 0) return { text: today > 0 ? `+${today} new` : 'No data yet', cls: today > 0 ? 'up' : 'neutral' };
        const pct = Math.round(((today - yesterday) / yesterday) * 100);
        if (pct > 0) return { text: `+${pct}% vs yesterday`, cls: 'up' };
        if (pct < 0) return { text: `${pct}% vs yesterday`, cls: 'down' };
        return { text: 'Same as yesterday', cls: 'neutral' };
      }

      // 날짜별 상세 테이블 (최근 30일)
      function renderDailyDetail(data) {
        const body = document.getElementById('daily-detail-body');
        const totalEl = document.getElementById('daily-detail-total');
        if (!body) return;
        if (!data || data.length === 0) {
          body.innerHTML = '<tr><td colspan="6" class="no-data">데이터 없음</td></tr>';
          if (totalEl) totalEl.textContent = '0';
          return;
        }
        const todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().split('T')[0];
        const maxV = Math.max(...data.map(d => Number(d.views) || 0), 1);
        let sumViews = 0, sumVisitors = 0;
        body.innerHTML = data.map(d => {
          const views = Number(d.views) || 0;
          const visitors = Number(d.visitors) || 0;
          const tf = Number(d.tf_views) || 0;
          const lf = Number(d.lf_views) || 0;
          sumViews += views; sumVisitors += visitors;
          const dObj = new Date(d.day + 'T00:00:00');
          const wd = ['일','월','화','수','목','금','토'][dObj.getDay()];
          const label = `${dObj.getMonth()+1}/${dObj.getDate()} (${wd})`;
          const barW = Math.max(Math.round((views / maxV) * 110), 2);
          const isToday = d.day === todayKst;
          return `<tr class="${isToday ? 'dd-today' : ''}">
            <td>${label}${isToday ? ' ·오늘' : ''}</td>
            <td class="dd-views">${fmt(views)}</td>
            <td class="dd-visitors">${fmt(visitors)}</td>
            <td>${fmt(tf)}</td>
            <td>${fmt(lf)}</td>
            <td class="dd-bar-col"><span class="dd-minibar" style="width:${barW}px"></span></td>
          </tr>`;
        }).join('');
        if (totalEl) totalEl.textContent = `${fmt(sumViews)} 조회 / ${fmt(sumVisitors)} 방문자`;
      }

      // 날짜 x 시간대 히트맵 (최근 14일)
      let _heatmapData = [];
      let _heatmapMode = 'daily';   // 'daily'(14일) | 'weekly'(요일)

      function renderHeatmap(data) { _heatmapData = Array.isArray(data) ? data : []; drawHeatmap(); }

      function drawHeatmap() {
        const wrap = document.getElementById('heatmap-wrap');
        if (!wrap) return;
        const data = _heatmapData;
        if (!data.length) { wrap.innerHTML = '<div class="no-data">데이터 없음</div>'; return; }
        const level = (v, maxV) => { if (!v) return 0; const r = v / maxV; return r <= 0.15 ? 1 : r <= 0.4 ? 2 : r <= 0.7 ? 3 : 4; };
        let hourHead = '<div class="hm-hourhead">';
        for (let h = 0; h < 24; h++) hourHead += `<span class="hm-hourlabel">${h % 3 === 0 ? h : ''}</span>`;
        hourHead += '</div>';
        let rows = '';

        if (_heatmapMode === 'weekly') {
          // 요일 × 시간대 집계 (14일치 누적)
          const dow = {}; let maxV = 1;
          data.forEach(d => {
            const dt = new Date(d.day + 'T00:00:00'); const wd = dt.getDay(); const h = Number(d.hour); const v = Number(d.views) || 0;
            if (!dow[wd]) dow[wd] = {}; dow[wd][h] = (dow[wd][h] || 0) + v; if (dow[wd][h] > maxV) maxV = dow[wd][h];
          });
          const names = ['일', '월', '화', '수', '목', '금', '토'];
          for (let wd = 0; wd < 7; wd++) {
            let cells = '';
            for (let h = 0; h < 24; h++) {
              const v = (dow[wd] && dow[wd][h]) || 0;
              cells += `<i class="hm-cell l${level(v, maxV)}" data-lbl="${names[wd]}요일" data-h="${h}" data-v="${v}"></i>`;
            }
            rows += `<div class="hm-row"><span class="hm-rowlabel">${names[wd]}</span>${cells}</div>`;
          }
        } else {
          // 최근 14일 × 시간대
          const dayMap = {}; let maxV = 1;
          data.forEach(d => { const day = d.day, hour = Number(d.hour), v = Number(d.views) || 0; if (!dayMap[day]) dayMap[day] = {}; dayMap[day][hour] = v; if (v > maxV) maxV = v; });
          const todayKst = new Date(Date.now() + 9 * 3600 * 1000);
          const days = [];
          for (let i = 0; i < 14; i++) { const dt = new Date(todayKst.getTime() - i * 86400000); days.push(dt.toISOString().split('T')[0]); }
          days.forEach(day => {
            const dObj = new Date(day + 'T00:00:00');
            const label = `${dObj.getMonth() + 1}/${dObj.getDate()}`;
            let cells = '';
            for (let h = 0; h < 24; h++) {
              const v = (dayMap[day] && dayMap[day][h]) || 0;
              cells += `<i class="hm-cell l${level(v, maxV)}" data-lbl="${label}" data-h="${h}" data-v="${v}"></i>`;
            }
            rows += `<div class="hm-row"><span class="hm-rowlabel">${label}</span>${cells}</div>`;
          });
        }
        wrap.innerHTML = `<div class="heatmap-grid">${hourHead}${rows}</div>`;
      }


      let _hourlyViews = [];       // get_hourly_views {hour, views, tf_views, lf_views}
      let _hourlyVisitors = [];    // analytics 계산 {hour, tf, lf}

      // 오늘(KST) 시간대별 방문자(고유 UA) 소스별 집계 — RPC엔 시간별 방문자가 없어 계산
      function computeHourlyVisitors(rows) {
        const todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().split('T')[0];
        const byHour = {};
        (rows || []).forEach(r => {
          const t = new Date(new Date(r.created_at).getTime() + 9 * 3600 * 1000);
          if (t.toISOString().split('T')[0] !== todayKst) return;
          const h = t.getUTCHours();
          if (!byHour[h]) byHour[h] = { tf: new Set(), lf: new Set() };
          const ua = r.ua || '?';
          if (r.source === 'lifeflow') byHour[h].lf.add(ua); else byHour[h].tf.add(ua);
        });
        const arr = [];
        for (let h = 0; h < 24; h++) { const b = byHour[h]; arr.push({ hour: h, tf: b ? b.tf.size : 0, lf: b ? b.lf.size : 0 }); }
        return arr;
      }

      // 시간대 막대 — TF/LF 분리(그룹) + 조회수/방문자 + 핫한 시간대
      function renderHourlyChart() {
        const container = document.getElementById('hourly-chart');
        if (!container) return;
        const metric = _trafficMetric || 'views';
        const map = {};
        if (metric === 'visitors') {
          _hourlyVisitors.forEach(d => { map[d.hour] = { tf: d.tf || 0, lf: d.lf || 0, vip: d.vip || 0 }; });
        } else {
          _hourlyViews.forEach(d => { map[d.hour] = { tf: d.tf_views || 0, lf: d.lf_views || 0, vip: d.vip_views || 0 }; });
        }
        const hasData = Object.values(map).some(h => h.tf + h.lf + h.vip > 0);
        if (!hasData) {
          container.innerHTML = `<div class="no-data" style="width:100%">오늘 ${metric === 'visitors' ? '방문자' : '조회'} 데이터 없음</div>`;
          renderHourlyHot(map, metric);
          return;
        }
        const maxV = Math.max(1, ...Object.values(map).flatMap(h => [h.tf, h.lf, h.vip]));
        const unit = metric === 'visitors' ? '명' : '회';
        const rowHtml = (h0, h1) => {
          let html = '';
          for (let h = h0; h <= h1; h++) {
            const d = map[h] || { tf: 0, lf: 0, vip: 0 };
            const tfH = d.tf > 0 ? Math.max(d.tf / maxV * 82, 2) : 0;
            const lfH = d.lf > 0 ? Math.max(d.lf / maxV * 82, 2) : 0;
            const vipH = d.vip > 0 ? Math.max(d.vip / maxV * 82, 2) : 0;
            html += `<div class="chart-bar-col">
              <div class="chart-bar-tooltip">${h}:00 · TF ${fmt(d.tf)} · LF ${fmt(d.lf)} · VIP ${fmt(d.vip)} ${unit}</div>
              <div class="hbar-group">
                <div class="hbar bar-tf" style="height:${tfH}px"></div>
                <div class="hbar bar-lf" style="height:${lfH}px"></div>
                <div class="hbar bar-vip" style="height:${vipH}px"></div>
              </div>
              <span class="chart-bar-label">${h}</span>
            </div>`;
          }
          return `<div class="chart-bars hourly-grouped">${html}</div>`;
        };
        container.innerHTML = rowHtml(0, 11) + rowHtml(12, 23);
        renderHourlyHot(map, metric);
      }

      // 우측: 가장 핫한 시간대 랭킹
      function renderHourlyHot(map, metric) {
        const el = document.getElementById('hourly-hot');
        const lbl = document.getElementById('hot-metric-label');
        if (lbl) lbl.textContent = metric === 'visitors' ? '방문자' : '조회수';
        if (!el) return;
        const arr = [];
        for (let h = 0; h < 24; h++) { const d = map[h] || { tf: 0, lf: 0 }; arr.push({ h, tf: d.tf, lf: d.lf, total: d.tf + d.lf }); }
        const active = arr.filter(a => a.total > 0).sort((a, b) => b.total - a.total);
        if (!active.length) { el.innerHTML = '<div class="no-data">오늘 데이터 없음</div>'; return; }
        const max = active[0].total;
        const unit = metric === 'visitors' ? '명' : '회';
        el.innerHTML = active.slice(0, 8).map((a, i) => {
          const bw = Math.max(a.total / max * 100, 4);
          const medal = i === 0 ? '🔥' : `${i + 1}`;
          return `<div class="tl-row ${i === 0 ? 'tl-cur' : ''}">
            <div class="tl-top"><span class="tl-date">${medal} ${a.h}:00~${a.h}:59</span><span class="tl-val" style="color:#facc15">${fmt(a.total)}${unit}</span></div>
            <div class="tl-bar"><div class="tl-fill" style="width:${bw}%;background:linear-gradient(90deg,#ea580c,#facc15)"></div></div>
            <div class="tl-sub"><span style="color:#60a5fa">TF ${fmt(a.tf)}</span> · <span style="color:#4ade80">LF ${fmt(a.lf)}</span></div>
          </div>`;
        }).join('');
      }


      // KPI 델타 칩: 색+화살표 이중 인코딩. yesterday=null이면 override 텍스트 사용
      function setDeltaChip(id, today, yesterday, override) {
        const el = document.getElementById(id);
        if (!el) return;
        const up = '<svg class="ico" viewBox="0 0 24 24"><polyline points="18 15 12 9 6 15"/></svg>';
        const down = '<svg class="ico" viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>';
        if (override !== undefined) {
          el.className = 'delta-chip ' + (today > 0 ? 'up' : 'flat');
          el.innerHTML = (today > 0 ? up : '') + override;
          return;
        }
        if (!yesterday || yesterday === 0) {
          el.className = 'delta-chip flat';
          el.innerHTML = today > 0 ? up + `+${fmt(today)}` : '—';
          return;
        }
        const pct = Math.round(((today - yesterday) / yesterday) * 100);
        if (pct > 0) { el.className = 'delta-chip up'; el.innerHTML = up + `${pct}%`; }
        else if (pct < 0) { el.className = 'delta-chip down'; el.innerHTML = down + `${Math.abs(pct)}%`; }
        else { el.className = 'delta-chip flat'; el.innerHTML = '0%'; }
      }

      // ── 방문 추이 (일간/주간/월간 통합) ──
      let _trafficDetail = [];
      let _trafficPeriod = 'daily';
      let _trafficMetric = 'views';   // 'views' | 'visitors' — 웹/모바일은 두 메트릭 안에 병기
      let _deviceDataReady = false;   // get_daily_device_trend RPC 설치 여부

      function bucketDetail(rows, period) {
        const buckets = {};
        (rows || []).forEach(d => {
          if (!d.day) return;
          const date = new Date(d.day + 'T00:00:00');
          let key, label, sortKey;
          if (period === 'weekly') {
            const wd = (date.getDay() + 6) % 7;            // 0=월
            const mon = new Date(date); mon.setDate(date.getDate() - wd);
            key = mon.toISOString().split('T')[0];
            label = `${mon.getMonth()+1}/${mon.getDate()}~`;
            sortKey = key;
          } else if (period === 'monthly') {
            key = `${date.getFullYear()}-${String(date.getMonth()+1).padStart(2,'0')}`;
            label = `${String(date.getFullYear()).slice(2)}.${String(date.getMonth()+1).padStart(2,'0')}`;
            sortKey = key;
          } else {
            key = d.day;
            label = `${date.getMonth()+1}/${date.getDate()}`;
            sortKey = key;
          }
          if (!buckets[key]) buckets[key] = { key, label, views:0, visitors:0, tf:0, lf:0, vip:0, mg:0, mgV:0, web:0, mobile:0, webV:0, mobileV:0, sortKey };
          const b = buckets[key];
          // 뭉게는 analytics RPC 밖(GA4)이라 mergeMgIntoDetail 이 일자 행에 미리 얹어 둔다
          b.mg += Number(d.mg_views)||0;
          b.mgV += Number(d.mg_visitors)||0;
          b.views += (Number(d.views)||0) + (Number(d.mg_views)||0);
          b.visitors += (Number(d.visitors)||0) + (Number(d.mg_visitors)||0);
          b.tf += Number(d.tf_views)||0;
          b.lf += Number(d.lf_views)||0;
          b.vip += Number(d.vip_views)||0;
          b.web += Number(d.web_views)||0;
          b.mobile += Number(d.mobile_views)||0;
          b.webV += Number(d.web_visitors)||0;
          b.mobileV += Number(d.mobile_visitors)||0;
        });
        return Object.values(buckets).sort((a,b) => a.sortKey < b.sortKey ? -1 : 1);
      }

      // 방문자를 TF/LF로 안분(조회 비율 추정) — 방문자엔 소스별 원본이 없음
      // TF/LF 방문자는 조회 비율로 역산한다. b.views·b.visitors 에는 뭉게(GA4)가 합산돼
      // 있으므로 그대로 나누면 뭉게 방문자가 LF 로 흡수된다 → 블로그 몫만 떼어 계산.
      function splitVisitors(b) {
        const bViews = (b.views || 0) - (b.mg || 0);
        const bVis = (b.visitors || 0) - (b.mgV || 0);
        if (bViews <= 0 || bVis <= 0) return { tf: 0, lf: 0 };
        const tf = Math.round(bVis * b.tf / bViews);
        return { tf, lf: Math.max(0, bVis - tf) };
      }
      // VIP 방문자도 같은 이유로 블로그 몫 기준
      function vipVisitors(b) {
        const bViews = (b.views || 0) - (b.mg || 0);
        const bVis = (b.visitors || 0) - (b.mgV || 0);
        return bViews > 0 ? Math.round(bVis * b.vip / bViews) : 0;
      }

      let _chartHover = null;

      // 점선(dashed) 라인 차트 — 조회수/방문자 모두 TF·LF 2선 + 호버 툴팁
      function renderTrafficChart(buckets) {
        const container = document.getElementById('traffic-chart');
        const legend = document.getElementById('traffic-legend');
        if (!container) return;
        if (!buckets.length) { container.innerHTML = '<div class="no-data">데이터 없음</div>'; _chartHover = null; return; }

        const metric = _trafficMetric || 'views';
        // 뭉게는 GA4 에서 실제 방문자(totalUsers)를 그대로 받으므로 TF/LF/VIP 처럼
        // 조회 비율로 추정하지 않고 mgV 를 그대로 쓴다.
        const series = metric === 'visitors'
          ? [{ name: 'TechFlow', color: '#3b82f6', vals: buckets.map(b => splitVisitors(b).tf) },
             { name: 'LifeFlow', color: '#22c55e', vals: buckets.map(b => splitVisitors(b).lf) },
             { name: 'VIP', color: '#57e6c3', vals: buckets.map(vipVisitors) },
             { name: '뭉게', color: '#f59e0b', vals: buckets.map(b => b.mgV || 0) }]
          : [{ name: 'TechFlow', color: '#3b82f6', vals: buckets.map(b => b.tf) },
             { name: 'LifeFlow', color: '#22c55e', vals: buckets.map(b => b.lf) },
             { name: 'VIP', color: '#57e6c3', vals: buckets.map(b => b.vip) },
             { name: '뭉게', color: '#f59e0b', vals: buckets.map(b => b.mg || 0) }];
        if (legend) {
          legend.innerHTML = series.map(s =>
            `<span style="display:flex;align-items:center;gap:0.3rem"><i style="width:14px;height:0;border-top:2.5px dashed ${s.color};display:inline-block"></i>${s.name}</span>`
          ).join('');
        }

        const n = buckets.length;
        const W = 700, H = 232, padL = 10, padR = 10, padT = 26, padB = 30;
        const maxV = Math.max(1, ...series.flatMap(s => s.vals));
        const X = i => padL + (n === 1 ? (W - padL - padR) / 2 : i * (W - padL - padR) / (n - 1));
        const Y = v => H - padB - (v / maxV) * (H - padT - padB);

        let grid = '';
        [0, 0.5, 1].forEach(t => {
          const gy = (H - padB - t * (H - padT - padB)).toFixed(1);
          grid += `<line x1="${padL}" y1="${gy}" x2="${W - padR}" y2="${gy}" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>`;
        });
        grid += `<text x="${padL}" y="${padT - 9}" fill="#7c7c87" font-size="12">최대 ${fmt(maxV)}</text>`;
        // 호버 크로스헤어(숨김)
        grid += `<line id="chart-cross" x1="0" y1="${padT}" x2="0" y2="${H - padB}" stroke="rgba(255,255,255,0.28)" stroke-width="1" stroke-dasharray="3 3" style="display:none"/>`;

        let lines = '';
        series.forEach(s => {
          const pts = s.vals.map((v, i) => `${X(i).toFixed(1)},${Y(v).toFixed(1)}`).join(' ');
          lines += `<polyline points="${pts}" fill="none" stroke="${s.color}" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" stroke-dasharray="6 4"/>`;
          s.vals.forEach((v, i) => {
            lines += `<circle cx="${X(i).toFixed(1)}" cy="${Y(v).toFixed(1)}" r="3.6" fill="#131316" stroke="${s.color}" stroke-width="2"/>`;
          });
        });

        const step = n > 10 ? Math.ceil(n / 8) : 1;
        let xl = '';
        buckets.forEach((b, i) => {
          if (i % step === 0 || i === n - 1) {
            const anchor = i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle';
            xl += `<text x="${X(i).toFixed(1)}" y="${H - 9}" fill="#7c7c87" font-size="11.5" text-anchor="${anchor}">${b.label}</text>`;
          }
        });

        container.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%" preserveAspectRatio="xMidYMid meet" role="img" aria-label="${metric === 'visitors' ? '방문자' : '조회수'} 추이 선그래프">${grid}${lines}${xl}</svg>`;
        _chartHover = { buckets, series, n, W, padL, padR, metric };
      }

      // 우측 리스트 (표 → 읽기 쉬운 2줄 리스트)
      function renderTrafficList(buckets) {
        const el = document.getElementById('traffic-list');
        const col0 = document.getElementById('tl-col0');
        const mLabel = document.getElementById('tl-metric-label');
        const metric = _trafficMetric || 'views';
        if (col0) col0.textContent = _trafficPeriod === 'weekly' && !_trafficCustom ? '주' : _trafficPeriod === 'monthly' && !_trafficCustom ? '월' : '날짜';
        if (mLabel) mLabel.textContent = metric === 'visitors' ? '방문자' : '조회수';
        if (!el) return;
        if (!buckets.length) { el.innerHTML = '<div class="no-data">데이터 없음</div>'; return; }
        const primary = b => metric === 'visitors' ? b.visitors : b.views;
        const maxV = Math.max(1, ...buckets.map(primary));
        const lastKey = buckets[buckets.length - 1].key;
        const valColor = metric === 'visitors' ? '#c084fc' : '#7cb0fb';
        el.innerHTML = buckets.slice().reverse().map(b => {           // 최신 위로
          const val = primary(b);
          const barW = Math.max(Math.round(val / maxV * 100), 2);
          const cur = b.key === lastKey;
          const vis = splitVisitors(b);
          // 웹/모바일 병기 (RPC 설치 시) — 조회수엔 조회 기준, 방문자엔 방문자 기준
          const dw = metric === 'visitors' ? b.webV : b.web;
          const dm = metric === 'visitors' ? b.mobileV : b.mobile;
          const devSub = _deviceDataReady && (dw + dm) > 0
            ? ` <span style="color:var(--text-3)">·</span> <span style="color:#f59e0b">🖥 PC ${fmt(dw)}</span> <span style="color:#ec4899">📱 모바일 ${fmt(dm)}</span>`
            : '';
          const vipVis = vipVisitors(b);
          const mgPart = (metric === 'visitors' ? b.mgV : b.mg)
            ? ` · <span style="color:#fbbf24">뭉게 ${fmt(metric === 'visitors' ? b.mgV : b.mg)}</span>` : '';
          const sub = (metric === 'visitors'
            ? `<span style="color:#60a5fa">TF ${fmt(vis.tf)}</span> · <span style="color:#4ade80">LF ${fmt(vis.lf)}</span> · <span style="color:#57e6c3">VIP ${fmt(vipVis)}</span>${mgPart} <span style="color:var(--text-3)">· 조회 ${fmt(b.views)}</span>`
            : `<span style="color:#60a5fa">TF ${fmt(b.tf)}</span> · <span style="color:#4ade80">LF ${fmt(b.lf)}</span> · <span style="color:#57e6c3">VIP ${fmt(b.vip)}</span>${mgPart}`) + devSub;
          return `<div class="tl-row ${cur ? 'tl-cur' : ''}">
            <div class="tl-top">
              <span class="tl-date">${b.label}${cur ? ' ·현재' : ''}</span>
              <span class="tl-val" style="color:${valColor}">${fmt(val)}</span>
            </div>
            <div class="tl-bar"><div class="tl-fill" style="width:${barW}%;background:${valColor}"></div></div>
            <div class="tl-sub">${sub}</div>
          </div>`;
        }).join('');
      }

      // 차트 호버: 크로스헤어 + 툴팁(전 시리즈 수치)
      function initChartHover() {
        const wrap = document.querySelector('.traffic-chart-wrap');
        const tip = document.getElementById('chart-tip');
        if (!wrap || !tip) return;
        wrap.addEventListener('mousemove', (e) => {
          if (!_chartHover) return;
          const svg = wrap.querySelector('svg'); if (!svg) return;
          const { buckets, series, n, W, padL, padR } = _chartHover;
          const rect = svg.getBoundingClientRect();
          const scale = rect.width / W;
          const plotLeft = rect.left + padL * scale;
          const plotW = (W - padL - padR) * scale;
          let f = plotW > 0 ? (e.clientX - plotLeft) / plotW : 0;
          f = Math.max(0, Math.min(1, f));
          const idx = Math.round(f * (n - 1));
          const b = buckets[idx];
          const xv = padL + (n === 1 ? (W - padL - padR) / 2 : idx * (W - padL - padR) / (n - 1));
          const cross = document.getElementById('chart-cross');
          if (cross) { cross.setAttribute('x1', xv); cross.setAttribute('x2', xv); cross.style.display = ''; }
          const total = series.reduce((s, se) => s + (se.vals[idx] || 0), 0);
          // 웹/모바일 병기 (RPC 설치 + 데이터 있을 때)
          const metric = _chartHover.metric || 'views';
          const dw = metric === 'visitors' ? (b.webV || 0) : (b.web || 0);
          const dm = metric === 'visitors' ? (b.mobileV || 0) : (b.mobile || 0);
          const devRow = _deviceDataReady && (dw + dm) > 0
            ? `<div class="ct-row"><i style="background:#f59e0b"></i>🖥 PC<b>${fmt(dw)}</b></div><div class="ct-row"><i style="background:#ec4899"></i>📱 모바일<b>${fmt(dm)}</b></div>`
            : '';
          tip.innerHTML = `<div class="ct-date">${b.label}</div>` +
            series.map(se => `<div class="ct-row"><i style="background:${se.color}"></i>${se.name}<b>${fmt(se.vals[idx])}</b></div>`).join('') +
            (series.length > 1 ? `<div class="ct-row ct-total">합계<b>${fmt(total)}</b></div>` : '') +
            devRow;
          tip.style.display = 'block';
          const wr = wrap.getBoundingClientRect();
          let left = e.clientX - wr.left + 14;
          if (left > wr.width - 130) left = e.clientX - wr.left - 130;
          tip.style.left = Math.max(4, left) + 'px';
        });
        wrap.addEventListener('mouseleave', () => {
          tip.style.display = 'none';
          const cross = document.getElementById('chart-cross'); if (cross) cross.style.display = 'none';
        });
      }

      // 히트맵 셀 호버 팝업
      function initHeatmapHover() {
        const view = document.getElementById('tp-heatmap-view');
        const wrap = document.getElementById('heatmap-wrap');
        const tip = document.getElementById('hm-tip');
        if (!view || !wrap || !tip) return;
        wrap.addEventListener('mousemove', (e) => {
          const cell = e.target.closest && e.target.closest('.hm-cell');
          if (!cell || cell.dataset.h === undefined) { tip.style.display = 'none'; return; }
          tip.innerHTML = `<b>${cell.dataset.lbl} ${cell.dataset.h}시</b> · 조회 ${fmt(+cell.dataset.v)}회`;
          tip.style.display = 'block';
          const vr = view.getBoundingClientRect();
          let left = e.clientX - vr.left + 14; if (left > vr.width - 150) left = e.clientX - vr.left - 150;
          tip.style.left = Math.max(4, left) + 'px';
          tip.style.top = (e.clientY - vr.top + 16) + 'px';
        });
        wrap.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
      }

      // 드래그 스크롤(세로) — 방문추이 우측 리스트
      function enableDragScroll(el) {
        if (!el) return;
        let down = false, startY = 0, startTop = 0, moved = false;
        el.addEventListener('mousedown', (e) => {
          if (e.target.closest('a')) return;         // 링크는 방해 안 함
          down = true; moved = false; startY = e.clientY; startTop = el.scrollTop; el.classList.add('dragging');
        });
        window.addEventListener('mousemove', (e) => {
          if (!down) return;
          const dy = e.clientY - startY;
          if (Math.abs(dy) > 3) moved = true;
          el.scrollTop = startTop - dy;
        });
        window.addEventListener('mouseup', () => { if (down) { down = false; el.classList.remove('dragging'); } });
      }


      let _trafficBuckets = [];
      let _lastHeavy = 0;             // 오디언스/쿠팡/페이퍼닥 원시행 조회의 마지막 실행(ms) — 라이트/헤비 틱 분리
      let _trafficCustom = null;   // {from, to} 설정 시 커스텀 범위

      function renderTrafficPanel() {
        const limits = { daily: 14, weekly: 10, monthly: 6 };
        let buckets, prevSum = 0, currLabel;

        if (_trafficCustom) {
          // 커스텀 날짜 범위: [from, to] 일자 필터 → 일간 버킷
          const inRange = _trafficDetail.filter(d => d.day >= _trafficCustom.from && d.day <= _trafficCustom.to);
          buckets = bucketDetail(inRange, 'daily');
          // 이전 동기간(같은 일수만큼 앞) 합계
          const days = Math.max(1, Math.round((new Date(_trafficCustom.to) - new Date(_trafficCustom.from)) / 86400000) + 1);
          const pTo = new Date(new Date(_trafficCustom.from).getTime() - 86400000).toISOString().split('T')[0];
          const pFrom = new Date(new Date(_trafficCustom.from).getTime() - days * 86400000).toISOString().split('T')[0];
          prevSum = _trafficDetail.filter(d => d.day >= pFrom && d.day <= pTo).reduce((s, d) => s + (Number(d.views) || 0), 0);
          currLabel = `${days}일 (${_trafficCustom.from}~${_trafficCustom.to})`;
        } else if (_trafficPeriod === 'daily') {
          const raw = bucketDetail(_trafficDetail, 'daily');
          const map = {}; raw.forEach(b => map[b.key] = b);
          // KST(UTC+9) 기준 날짜키 — RPC의 d.day가 KST 일자이므로 로컬→UTC 변환 없이 맞춘다
          const kstDay = i => new Date(Date.now() + 9 * 3600000 - i * 86400000).toISOString().split('T')[0];
          const padded = [];
          for (let i = 13; i >= 0; i--) {
            const k = kstDay(i);
            const [, mo, da] = k.split('-');
            padded.push(map[k] || { key:k, label:`${+mo}/${+da}`, views:0, visitors:0, tf:0, lf:0, web:0, mobile:0, webV:0, mobileV:0, sortKey:k });
          }
          buckets = padded;
          for (let i = 27; i >= 14; i--) { prevSum += (map[kstDay(i)] || {}).views || 0; }
          currLabel = '14일';
        } else {
          const n = limits[_trafficPeriod];
          const all = bucketDetail(_trafficDetail, _trafficPeriod);
          buckets = all.slice(-n);
          prevSum = all.slice(-2 * n, -n).reduce((s, b) => s + b.views, 0);
          currLabel = `${buckets.length}${_trafficPeriod === 'weekly' ? '주' : '개월'}`;
        }

        _trafficBuckets = buckets;
        renderTrafficChart(buckets);
        renderTrafficList(buckets);

        const sv = buckets.reduce((s, b) => s + b.views, 0);
        const svis = buckets.reduce((s, b) => s + b.visitors, 0);
        const totalEl = document.getElementById('traffic-total');
        if (totalEl) totalEl.textContent = `${currLabel} 합계: ${fmt(sv)} 조회 / ${fmt(svis)} 방문`;
        // 이전 동기간 대비 델타
        setDeltaChip('traffic-compare', sv, prevSum);
      }


      // Slug을 읽기 좋은 제목으로 변환
      function decodeSlug(slug) {
        if (!slug) return '';
        try {
          let decoded = decodeURIComponent(slug);
          // 날짜 접두사 제거 (2026-02-13-)
          decoded = decoded.replace(/^\d{4}-\d{2}-\d{2}-/, '');
          // 하이픈을 공백으로
          decoded = decoded.replace(/-/g, ' ');
          // 카테고리 접두사 제거 (ai/, dev/ 등)
          decoded = decoded.replace(/^(ai|dev|review|game|lifestyle|finance|health|education|travel)\//i, '');
          return decoded;
        } catch {
          return slug;
        }
      }

      // 페이지 제목 가져오기: title 필드 우선, 없으면 slug 디코딩
      function getPageTitle(item) {
        // 현재 글 제목(빌드 시점 맵) 우선 — analytics에 저장된 옛 제목보다 정확
        const bare = String(item.slug || item.path || '').replace(/^\/blog\//, '').replace(/^\//, '').replace(/\/$/, '');
        if (bare && typeof SLUG_TITLES !== 'undefined' && SLUG_TITLES[bare]) return SLUG_TITLES[bare];
        if (item.title && item.title !== 'null' && !item.title.startsWith('TechFlow') && !item.title.startsWith('LifeFlow')) {
          // "포스트 제목 | TechFlow - AI & 테크 인사이트" 형태에서 제목만 추출
          return item.title.split(' | ')[0].split(' - ')[0];
        }
        const raw = decodeSlug(item.slug || item.path || '');
        // "/" 또는 빈 경로는 홈페이지로 표시
        if (!raw || raw === '/' || raw === '/blog' || raw === '/blog/') return '홈페이지';
        return raw;
      }

      function sourceBadge(source) {
        if (source === 'blog') return '<span class="src-badge tf">TF</span>';
        if (source === 'lifeflow') return '<span class="src-badge lf">LF</span>';
        if (source === 'gameflow') return '<span class="src-badge gf">GF</span>';
        if (source === 'vip') return '<span class="src-badge vip">VIP</span>';
        if (source === 'mg') return '<span class="src-badge mg">뭉게</span>';
        return '';
      }

      // === Top Pages 전역 데이터 & 필터 ===
      let _topPagesData = [];
      let _topPagesFilter = 'all';
      let _topPagesPeriod = 'all';   // 'all'|'day'|'week'|'month'

      // 기간별 인기 페이지: analytics 페이지뷰(_audienceRows)를 창(window)으로 집계
      function computeTopPagesByPeriod(period) {
        const nowMs = Date.now();
        const todayKst = new Date(nowMs + 9 * 3600 * 1000).toISOString().split('T')[0];
        const cutoff = period === 'week' ? nowMs - 7 * 86400000 : period === 'month' ? nowMs - 30 * 86400000 : null;
        const by = {};
        (_audienceRows || []).forEach(r => {
          if (!r.path) return;
          const t = new Date(r.created_at).getTime();
          if (period === 'day') {
            const day = new Date(t + 9 * 3600 * 1000).toISOString().split('T')[0];
            if (day !== todayKst) return;
          } else if (cutoff && t < cutoff) return;
          const key = r.path;
          if (!by[key]) by[key] = { path: r.path, source: r.source || 'blog', title: r.title || '', views: 0 };
          by[key].views++;
        });
        return Object.values(by).sort((a, b) => b.views - a.views);
      }

      // 같은 URL(슬러그)인데 제목 변경 등으로 여러 행으로 쪼개진 걸 합침 (조회수 합산)
      function dedupBySlug(rows) {
        const by = {};
        for (const r of (rows || [])) {
          const bare = String(r.slug || r.path || '').replace(/^\/blog\//, '').replace(/^\//, '').replace(/\/$/, '');
          const key = bare || String(r.title || '');
          if (!by[key]) by[key] = { ...r, views: 0 };
          by[key].views += Number(r.views) || 0;
        }
        return Object.values(by).sort((a, b) => (b.views || 0) - (a.views || 0));
      }

      function renderTopPages(data, filter, period) {
        if (data !== undefined) _topPagesData = dedupBySlug(data);
        if (filter !== undefined) _topPagesFilter = filter;
        if (period !== undefined) _topPagesPeriod = period;

        const container = document.getElementById('top-pages');
        if (!container) return;

        // 뭉게는 ga4_daily 에서 뽑아 여기서만 합친다 — _topPagesData 를 오염시키면
        // 이걸 재사용하는 VIP·카테고리 집계까지 틀어진다.
        const mgRows = (typeof mgTopPages === 'function' && Array.isArray(_ga4Rows)) ? mgTopPages(_topPagesPeriod) : [];
        let base = (_topPagesPeriod === 'all' ? _topPagesData : computeTopPagesByPeriod(_topPagesPeriod)).concat(mgRows)
          .sort((a, b) => (b.views || 0) - (a.views || 0));
        let filtered = base;
        if (_topPagesFilter !== 'all') {
          filtered = filtered.filter(p => p.source === _topPagesFilter);
        }

        if (filtered.length === 0) {
          container.innerHTML = `<div class="no-data">${_topPagesPeriod === 'all' ? 'No page data yet' : '해당 기간 데이터 없음'}</div>`;
          return;
        }

        container.innerHTML = filtered.slice(0, 8).map((p, i) => {
          const title = getPageTitle(p);
          const displayTitle = title.length > 40 ? title.substring(0, 40) + '…' : title;
          const path = p.path || (p.slug ? `/blog/${p.slug}` : '/');
          const href = p.source === 'vip' ? `https://virtual-in-playing.vercel.app${path}` : p.source === 'lifeflow' ? `https://life-revenue-blog.vercel.app${path}` : path;
          return `<a class="top-page-item" href="${escHtml(safeUrl(href))}" target="_blank" rel="noopener">
            <span class="top-page-rank">${i + 1}</span>
            ${sourceBadge(p.source)}
            <span class="top-page-title" title="${escHtml(title)}">${escHtml(displayTitle) || '(home)'}</span>
            <span class="top-page-views">${p.views}회 <span class="tp-go">↗</span></span>
          </a>`;
        }).join('');
      }

      // === 도구(LifeFlow 생활 계산기) 페이지별 방문 ===
      // slug → { emoji, name, cat } (life-revenue-blog/src/pages/tools/index.astro 기준, 26종)
      const TOOL_META = {
        'salary-calculator': { emoji: '💰', name: '연봉 실수령액 계산기', cat: '금융' },
        'severance-calculator': { emoji: '📤', name: '퇴직금 계산기', cat: '금융' },
        'hourly-wage-calculator': { emoji: '⏱️', name: '시급 계산기', cat: '금융' },
        'compound-interest-calculator': { emoji: '📈', name: '복리 계산기', cat: '금융' },
        'savings-calculator': { emoji: '🏦', name: '예·적금 계산기', cat: '금융' },
        'loan-calculator': { emoji: '📉', name: '대출 이자 계산기', cat: '금융' },
        'debt-payoff-calculator': { emoji: '💳', name: '부채 상환 계산기', cat: '금융' },
        'unemployment-benefit-calculator': { emoji: '🧑‍⚖️', name: '실업급여 계산기', cat: '금융' },
        'vat-calculator': { emoji: '🧮', name: '부가세 계산기', cat: '금융' },
        'gold-price-calculator': { emoji: '🪙', name: '금 시세 계산기', cat: '금융' },
        'annual-leave-calculator': { emoji: '🌴', name: '연차수당 계산기', cat: '금융' },
        'age-calculator': { emoji: '🎂', name: '만 나이 계산기', cat: '생활' },
        'dday-calculator': { emoji: '📅', name: 'D-day·날짜 계산기', cat: '생활' },
        'dutchpay-calculator': { emoji: '🧾', name: '더치페이 계산기', cat: '생활' },
        'electricity-bill-calculator': { emoji: '⚡', name: '전기요금 계산기', cat: '생활' },
        'discount-calculator': { emoji: '🏷️', name: '할인율 계산기', cat: '생활' },
        'unit-converter': { emoji: '📐', name: '단위 변환기', cat: '생활' },
        'time-calculator': { emoji: '⏳', name: '시간 계산기', cat: '생활' },
        'bmi-calorie-calculator': { emoji: '🩺', name: 'BMI·칼로리 계산기', cat: '건강' },
        'water-intake-calculator': { emoji: '💧', name: '물 섭취량 계산기', cat: '건강' },
        'sleep-calculator': { emoji: '😴', name: '수면 시간 계산기', cat: '건강' },
        'calorie-burn-calculator': { emoji: '🔥', name: '칼로리 소모 계산기', cat: '건강' },
        'character-count': { emoji: '✍️', name: '글자수 세기', cat: '교육' },
        'gpa-calculator': { emoji: '🎓', name: '학점(GPA) 계산기', cat: '교육' },
        'timezone-calculator': { emoji: '🌐', name: '세계 시차 계산기', cat: '여행' },
        'exchange-rate-calculator': { emoji: '💱', name: '환율 계산기', cat: '여행' },
      };
      const TOOL_TOTAL = Object.keys(TOOL_META).length;

      let _toolRows = null;          // fetchToolPageviews 결과(null=미로드)
      let _toolsPeriod = 'all';      // 'all'|'day'|'week'|'month'

      // path(/tools/<slug>/ 또는 /tools/<slug>)에서 slug 추출. 허브(/tools 또는 /tools/)는 제외.
      function toolSlugFromPath(p) {
        const m = String(p || '').match(/^\/tools\/([^/?#]+)/);
        return m ? m[1] : null;
      }

      // 도구 페이지뷰만 별도 조회 — 전체기간+타임스탬프(기간필터용). audience 5000행 캡과 무관.
      async function fetchToolPageviews() {
        try {
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/analytics?event_type=eq.pageview&metadata->>path=like./tools/*&metadata->>__probe=is.null&select=created_at,path:metadata->>path&order=created_at.desc&limit=20000`,
            { headers }
          );
          if (!res.ok) return [];
          return await res.json();
        } catch { return []; }
      }

      // 기간 창(window)으로 slug별 조회수 집계 → [{slug, views}] 내림차순
      function computeToolStats(period) {
        const nowMs = Date.now();
        const todayKst = new Date(nowMs + 9 * 3600 * 1000).toISOString().split('T')[0];
        const cutoff = period === 'week' ? nowMs - 7 * 86400000 : period === 'month' ? nowMs - 30 * 86400000 : null;
        const by = {};
        (_toolRows || []).forEach(r => {
          const slug = toolSlugFromPath(r.path);
          if (!slug) return;
          const t = new Date(r.created_at).getTime();
          if (period === 'day') {
            const day = new Date(t + 9 * 3600 * 1000).toISOString().split('T')[0];
            if (day !== todayKst) return;
          } else if (cutoff && t < cutoff) return;
          by[slug] = (by[slug] || 0) + 1;
        });
        return Object.entries(by).map(([slug, views]) => ({ slug, views })).sort((a, b) => b.views - a.views);
      }

      function renderTools(period) {
        if (period !== undefined) _toolsPeriod = period;
        const container = document.getElementById('tools-rank');
        if (!container) return;

        const totalViewsEl = document.getElementById('tools-total-views');
        const activeEl = document.getElementById('tools-active-count');
        const topNameEl = document.getElementById('tools-top-name');
        const topViewsEl = document.getElementById('tools-top-views');
        const rankTotalEl = document.getElementById('tools-rank-total');

        if (_toolRows === null) {
          container.innerHTML = '<div class="no-data">도구 방문 데이터 로딩 중...</div>';
          return;
        }

        const stats = computeToolStats(_toolsPeriod);
        const totalViews = stats.reduce((s, t) => s + t.views, 0);
        const maxViews = stats.length ? stats[0].views : 0;

        if (totalViewsEl) totalViewsEl.textContent = fmt(totalViews);
        if (activeEl) activeEl.textContent = `${stats.length} / ${TOOL_TOTAL}`;
        if (topNameEl) {
          const top = stats[0];
          topNameEl.textContent = top ? (TOOL_META[top.slug]?.name || top.slug) : '—';
          if (topViewsEl) topViewsEl.textContent = top ? `${fmt(top.views)}회 조회` : '최다 조회 도구';
        }
        if (rankTotalEl) rankTotalEl.textContent = stats.length ? `${stats.length}종 · ${fmt(totalViews)}회` : '';

        if (!stats.length) {
          container.innerHTML = `<div class="no-data">${_toolsPeriod === 'all' ? '아직 도구 방문 데이터가 없어요' : '해당 기간 도구 방문 없음'}</div>`;
          return;
        }

        container.innerHTML = stats.map((t, i) => {
          const meta = TOOL_META[t.slug] || { emoji: '🛠', name: t.slug, cat: '기타' };
          const href = `https://life-revenue-blog.vercel.app/tools/${t.slug}/`;
          const pct = maxViews ? Math.max(4, Math.round((t.views / maxViews) * 100)) : 0;
          const name = meta.name.length > 22 ? meta.name.slice(0, 22) + '…' : meta.name;
          return `<a class="top-page-item" href="${escHtml(safeUrl(href))}" target="_blank" rel="noopener">
            <span class="top-page-rank">${i + 1}</span>
            <span class="tool-emoji">${meta.emoji}</span>
            <span class="top-page-title" title="${escHtml(meta.name)}">${escHtml(name)}</span>
            <span class="tool-cat">${escHtml(meta.cat)}</span>
            <span class="tool-share"><i style="width:${pct}%"></i></span>
            <span class="top-page-views">${fmt(t.views)}회 <span class="tp-go">↗</span></span>
          </a>`;
        }).join('');
      }

      // === 오디언스: 유입경로 / 기기·브라우저·OS (analytics pageview 조회) ===
      let _audienceRows = [];
      let _funnelCounts = { pageviews: 0, coupang: 0, newsletter: 0, paperdoc: 0 };

      // GSC 검색 실적 (gsc_daily) — 애드블록에 안 막히는 Google 실측
      async function fetchGscStats() {
        try {
          const since = new Date(Date.now() - 8 * 864e5).toISOString().slice(0, 10);
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/gsc_daily?date=gte.${since}&select=date,source,page,clicks,impressions,ctr,position&limit=20000`,
            { headers }
          );
          if (!res.ok) return null;
          return await res.json();
        } catch { return null; }
      }

      // 메인 전체요약 KPI 카드에 GSC 요약을 다른 카드와 동일 규격으로 표시.
      // 값=최근 7일 총 클릭, 델타칩=최신일 vs 전일 클릭, sub=노출·CTR·평균순위.
      function renderGsc(rows) {
        const clicksEl = document.getElementById('gsc-sum-clicks');
        const deltaEl = document.getElementById('gsc-sum-delta');
        const subEl = document.getElementById('gsc-sum-sub');
        if (!clicksEl) return;
        const fmt = (n) => Number(n || 0).toLocaleString('en-US');
        if (!Array.isArray(rows) || !rows.length) {
          clicksEl.textContent = '0';
          if (subEl) subEl.textContent = '데이터 없음 — 동기화 대기';
          if (deltaEl) { deltaEl.className = 'delta-chip flat'; deltaEl.textContent = '–'; }
          return;
        }
        // _TOTAL_(소스별 일별 합계) 우선, 없으면 페이지행으로 폴백
        const totals = rows.filter((r) => r.page === '_TOTAL_');
        const src = totals.length ? totals : rows.filter((r) => r.page !== '_TOTAL_');
        let clicks = 0, impr = 0, posW = 0;
        const byDate = {};
        for (const r of src) {
          clicks += r.clicks || 0;
          impr += r.impressions || 0;
          posW += (r.position || 0) * (r.impressions || 0);
          const d = (byDate[r.date] ||= { clicks: 0 });
          d.clicks += r.clicks || 0;
        }
        const ctr = impr ? clicks / impr : 0;
        const pos = impr ? posW / impr : 0;
        clicksEl.textContent = fmt(clicks);
        if (subEl) subEl.innerHTML = `노출 ${fmt(impr)} · CTR ${(ctr * 100).toFixed(1)}% · 평균순위 ${pos.toFixed(1)}`;
        const dates = Object.keys(byDate).sort();
        if (deltaEl && dates.length >= 2) {
          const cur = byDate[dates[dates.length - 1]].clicks;
          const prev = byDate[dates[dates.length - 2]].clicks;
          const dd = cur - prev;
          deltaEl.className = 'delta-chip ' + (dd > 0 ? 'up' : (dd < 0 ? 'down' : 'flat'));
          deltaEl.textContent = dd === 0 ? '–' : `${dd > 0 ? '▲' : '▼'} ${fmt(Math.abs(dd))}`;
        } else if (deltaEl) {
          deltaEl.className = 'delta-chip flat';
          deltaEl.textContent = '–';
        }
      }

      // ═══════════════════════════════════════════════════════════
      // GSC 상세 탭 — 일별 추이 / 전날·당일 비교 / 소스별 / 페이지별
      // 데이터 소스: gsc_daily. _TOTAL_=소스별 일별 합계(추이/비교),
      // page!=_TOTAL_=페이지별(테이블/소스섹션). CTR·순위는 노출 가중.
      // ═══════════════════════════════════════════════════════════
      let _gscTotals = null;        // _TOTAL_ 90일 (소스별 일별 합계)
      let _gscPageCache = {};       // days → page-level rows (기간별 캐시)
      let _gscDays = 7;
      let _gscSrc = 'all';          // 'all' | 'blog' | 'lifeflow' | 'playcast'(VIP)
      let _gscMetric = 'clicks';    // clicks | impressions | ctr | position
      let _gscSort = { key: 'clicks', dir: -1 };
      let _gscSearch = '';
      let _gscInit = false;

      const GSC_SRC_META = { blog: 'TechFlow', lifeflow: 'LifeFlow', playcast: 'VIP' };
      const GSC_SRC_BADGE = { blog: 'TF', lifeflow: 'LF', playcast: 'VIP' };
      const gscFmt = (n) => Number(n || 0).toLocaleString('en-US');
      const gscPct = (v) => (Number(v || 0) * 100).toFixed(2) + '%';
      const gscPos = (v) => Number(v || 0).toFixed(1);
      const gscSlug = (p) => (p || '').replace(/^\/blog\//, '').replace(/\/$/, '');
      const gscTitle = (p) => (typeof SLUG_TITLES !== 'undefined' && SLUG_TITLES[gscSlug(p)]) || gscSlug(p) || p;
      const gscCut = (s, n) => { s = String(s || ''); return s.length > n ? s.slice(0, n) + '…' : s; };
      const gscEmpty = () => '<div style="color:var(--text-2);font-size:0.8rem;line-height:1.5;padding:0.5rem 0;">아직 GSC 데이터가 없습니다 — 매일 동기화 후 채워집니다.<br>즉시 채우려면 <code>/api/gsc-sync?days=30&amp;secret=CRON_SECRET</code> 를 호출하세요.</div>';

      async function loadGscDetail() {
        if (_gscInit) return;
        _gscInit = true;
        try {
          const since = new Date(Date.now() - 92 * 864e5).toISOString().slice(0, 10);
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/gsc_daily?page=eq._TOTAL_&date=gte.${since}&select=date,source,clicks,impressions,ctr,position&order=date.asc&limit=5000`,
            { headers }
          );
          _gscTotals = res.ok ? await res.json() : [];
        } catch { _gscTotals = []; }
        wireGscControls();
        await ensureGscPages(_gscDays);
        renderGscDetail();
      }

      async function ensureGscPages(days) {
        if (_gscPageCache[days]) return;
        try {
          const since = new Date(Date.now() - (days + 2) * 864e5).toISOString().slice(0, 10);
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/gsc_daily?page=neq._TOTAL_&date=gte.${since}&select=date,source,page,clicks,impressions,ctr,position&limit=50000`,
            { headers }
          );
          _gscPageCache[days] = res.ok ? await res.json() : [];
        } catch { _gscPageCache[days] = []; }
      }

      function wireGscControls() {
        const seg = (id, attr, curFn, cb) => {
          document.querySelectorAll(`#${id} button`).forEach((b) => {
            b.classList.toggle('active', b.dataset[attr] === String(curFn()));
            b.onclick = () => {
              document.querySelectorAll(`#${id} button`).forEach((x) => x.classList.remove('active'));
              b.classList.add('active');
              cb(b.dataset[attr]);
            };
          });
        };
        seg('gsc-period', 'days', () => _gscDays, async (v) => { _gscDays = +v; await ensureGscPages(_gscDays); renderGscDetail(); });
        seg('gsc-source', 'src', () => _gscSrc, (v) => { _gscSrc = v; renderGscDetail(); });
        seg('gsc-metric-tabs', 'm', () => _gscMetric, (v) => { _gscMetric = v; renderGscChart(); });
        const search = document.getElementById('gsc-page-search');
        if (search) search.oninput = () => { _gscSearch = search.value.trim().toLowerCase(); renderGscTable(); };
      }

      // _TOTAL_ 기반 일별 시계열 (source 필터·기간 반영). ctr/position=노출 가중.
      function gscDailySeries() {
        const cutoff = new Date(Date.now() - (_gscDays + 2) * 864e5).toISOString().slice(0, 10);
        const rows = (_gscTotals || []).filter((r) => r.date >= cutoff && (_gscSrc === 'all' || r.source === _gscSrc));
        const byDate = {};
        for (const r of rows) {
          const d = (byDate[r.date] ||= { date: r.date, clicks: 0, impressions: 0, posW: 0 });
          d.clicks += r.clicks || 0;
          d.impressions += r.impressions || 0;
          d.posW += (r.position || 0) * (r.impressions || 0);
        }
        return Object.values(byDate).sort((a, b) => (a.date < b.date ? -1 : 1)).map((d) => ({
          date: d.date, clicks: d.clicks, impressions: d.impressions,
          ctr: d.impressions ? d.clicks / d.impressions : 0,
          position: d.impressions ? d.posW / d.impressions : 0,
        })).slice(-_gscDays);
      }

      function renderGscKpi() {
        const el = document.getElementById('gsc-kpi'); if (!el) return;
        const s = gscDailySeries();
        const upd = document.getElementById('gsc-updated');
        if (!s.length) { el.innerHTML = gscEmpty(); if (upd) upd.textContent = ''; return; }
        const cur = s[s.length - 1];
        const prev = s.length >= 2 ? s[s.length - 2] : null;
        const allDates = [...new Set((_gscTotals || []).map((r) => r.date))].sort();
        const rangeTxt = allDates.length ? `보유 데이터 ${allDates[0]}~${allDates[allDates.length - 1]} (${allDates.length}일)` : '';
        const shortWarn = allDates.length && allDates.length < _gscDays ? ` · ⚠️ ${_gscDays}일 미만이라 구간 동일` : '';
        if (upd) upd.textContent = `${rangeTxt}${shortWarn} · 최신 ${cur.date}${prev ? ` · 전일(${prev.date}) 대비` : ''} · Google 실측(2~3일 지연)`;
        const cards = [
          { k: '클릭', v: gscFmt(cur.clicks), d: prev ? cur.clicks - prev.clicks : null, up: true, fd: (x) => gscFmt(Math.abs(x)) },
          { k: '노출', v: gscFmt(cur.impressions), d: prev ? cur.impressions - prev.impressions : null, up: true, fd: (x) => gscFmt(Math.abs(x)) },
          { k: 'CTR', v: gscPct(cur.ctr), d: prev ? cur.ctr - prev.ctr : null, up: true, fd: (x) => (Math.abs(x) * 100).toFixed(2) + '%p' },
          { k: '평균순위', v: gscPos(cur.position), d: prev ? cur.position - prev.position : null, up: false, fd: (x) => Math.abs(x).toFixed(1) },
        ];
        el.innerHTML = cards.map((c) => {
          let chip = '<span class="delta-chip flat">–</span>';
          if (c.d !== null && Math.abs(c.d) > 1e-9) {
            const good = c.up ? c.d > 0 : c.d < 0;
            chip = `<span class="delta-chip ${good ? 'up' : 'down'}">${c.d > 0 ? '▲' : '▼'} ${c.fd(c.d)}</span>`;
          }
          return `<div class="gsc-kpi-card"><div class="gsc-kpi-k">${c.k}</div><div class="gsc-kpi-v">${c.v}</div>${chip}</div>`;
        }).join('');
      }

      function renderGscChart() {
        const wrap = document.getElementById('gsc-chart'); if (!wrap) return;
        const s = gscDailySeries();
        const metaMap = { clicks: '클릭', impressions: '노출', ctr: 'CTR', position: '평균순위 (낮을수록 좋음)' };
        const lbl = document.getElementById('gsc-chart-metric-label');
        if (lbl) lbl.textContent = metaMap[_gscMetric] || '';
        if (!s.length) { wrap.innerHTML = ''; return; }
        const vals = s.map((d) => d[_gscMetric] || 0);
        const isPos = _gscMetric === 'position';
        const maxV = Math.max(...vals, isPos ? 0 : 1);
        const minV = isPos ? Math.max(0, Math.min(...vals) - 1) : 0;
        const span = (maxV - minV) || 1;
        const W = 720, H = 220, padL = 46, padR = 22, padT = 14, padB = 26, n = s.length;
        const x = (i) => padL + (n === 1 ? (W - padL - padR) / 2 : i * (W - padL - padR) / (n - 1));
        const y = (v) => padT + (H - padT - padB) * (1 - (v - minV) / span);
        const fmtV = _gscMetric === 'ctr' ? gscPct : (isPos ? gscPos : gscFmt);
        const grid = [0, 0.5, 1].map((t) => {
          const gv = minV + span * t, gy = y(gv);
          return `<line x1="${padL}" y1="${gy}" x2="${W - padR}" y2="${gy}" stroke="var(--border)" stroke-width="1"/><text x="${padL - 6}" y="${gy + 3}" text-anchor="end" font-size="10" fill="var(--text-3)">${fmtV(gv)}</text>`;
        }).join('');
        const pts = s.map((d, i) => `${x(i)},${y(vals[i])}`).join(' ');
        const area = `M ${x(0)},${y(minV)} L ` + s.map((d, i) => `${x(i)},${y(vals[i])}`).join(' L ') + ` L ${x(n - 1)},${y(minV)} Z`;
        const dots = s.map((d, i) => `<circle cx="${x(i)}" cy="${y(vals[i])}" r="2.6" fill="var(--accent)"/>`).join('');
        const xi = [...new Set([0, Math.floor((n - 1) / 2), n - 1])];
        const xlab = xi.map((i) => `<text x="${x(i)}" y="${H - 8}" text-anchor="middle" font-size="10" fill="var(--text-3)">${s[i].label || s[i].date}</text>`).join('');
        wrap.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block;height:auto" preserveAspectRatio="xMidYMid meet">
          ${grid}<path d="${area}" fill="var(--accent)" opacity="0.12"/>
          <polyline points="${pts}" fill="none" stroke="var(--accent)" stroke-width="2"/>
          <line class="gsc-cross" x1="0" y1="${padT}" x2="0" y2="${H - padB}" stroke="var(--text-3)" stroke-width="1" stroke-dasharray="3 3" style="display:none"/>
          <circle class="gsc-cross-dot" r="4" fill="var(--accent)" stroke="var(--surface)" stroke-width="2" style="display:none"/>
          ${dots}${xlab}</svg>
          <div class="gsc-tip" id="gsc-tip" style="display:none"></div>`;
        // 마우스 호버: 최근접 일자의 전 지표 상세값 표시
        const svgEl = wrap.querySelector('svg');
        const tip = wrap.querySelector('#gsc-tip');
        const cross = wrap.querySelector('.gsc-cross');
        const crossDot = wrap.querySelector('.gsc-cross-dot');
        const move = (e) => {
          const rect = svgEl.getBoundingClientRect();
          const px = (e.clientX - rect.left) * (W / rect.width);
          let idx = n <= 1 ? 0 : Math.round((px - padL) / ((W - padL - padR) / (n - 1)));
          idx = Math.max(0, Math.min(n - 1, idx));
          const d = s[idx], cx = x(idx);
          cross.setAttribute('x1', cx); cross.setAttribute('x2', cx); cross.style.display = '';
          crossDot.setAttribute('cx', cx); crossDot.setAttribute('cy', y(vals[idx])); crossDot.style.display = '';
          tip.innerHTML = `<div class="gsc-tip-d">${d.label || d.date}</div>
            <div class="gsc-tip-r"><span>클릭</span><b>${gscFmt(d.clicks)}</b></div>
            <div class="gsc-tip-r"><span>노출</span><b>${gscFmt(d.impressions)}</b></div>
            <div class="gsc-tip-r"><span>CTR</span><b>${gscPct(d.ctr)}</b></div>
            <div class="gsc-tip-r"><span>평균순위</span><b>${gscPos(d.position)}</b></div>`;
          tip.style.display = 'block';
          const wr = wrap.getBoundingClientRect();
          let left = e.clientX - wr.left + 14;
          if (left > wr.width - 140) left = e.clientX - wr.left - 140;
          tip.style.left = Math.max(4, left) + 'px';
          tip.style.top = '6px';
        };
        svgEl.addEventListener('mousemove', move);
        svgEl.addEventListener('mouseleave', () => { tip.style.display = 'none'; cross.style.display = 'none'; crossDot.style.display = 'none'; });
      }

      function renderGscSources() {
        const el = document.getElementById('gsc-source-sections'); if (!el) return;
        const rows = _gscPageCache[_gscDays] || [];
        const cutoff = new Date(Date.now() - _gscDays * 864e5).toISOString().slice(0, 10);
        let html = '';
        for (const src of ['blog', 'lifeflow', 'playcast']) {
          const rs = rows.filter((r) => r.source === src && r.date >= cutoff);
          const clicks = rs.reduce((a, r) => a + (r.clicks || 0), 0);
          const impr = rs.reduce((a, r) => a + (r.impressions || 0), 0);
          const posW = rs.reduce((a, r) => a + (r.position || 0) * (r.impressions || 0), 0);
          const byPage = {};
          for (const r of rs) {
            const a = (byPage[r.page] ||= { page: r.page, clicks: 0, impressions: 0 });
            a.clicks += r.clicks || 0; a.impressions += r.impressions || 0;
          }
          const top = Object.values(byPage).sort((a, b) => b.clicks - a.clicks || b.impressions - a.impressions).slice(0, 5);
          html += `<div class="gsc-src-card">
            <div class="gsc-src-head">${GSC_SRC_META[src]}
              <span>클릭 <b>${gscFmt(clicks)}</b> · 노출 <b>${gscFmt(impr)}</b> · CTR ${gscPct(impr ? clicks / impr : 0)} · 평균순위 ${gscPos(impr ? posW / impr : 0)}</span></div>
            ${top.length ? top.map((p) => `<div class="gsc-src-row"><span>${gscCut(gscTitle(p.page), 32)}</span><span>클릭 ${gscFmt(p.clicks)} · 노출 ${gscFmt(p.impressions)}</span></div>`).join('') : '<div class="gsc-src-row" style="color:var(--text-3)">데이터 없음</div>'}
          </div>`;
        }
        el.innerHTML = html;
      }

      // 페이지별 집계: 선택 기간 합계 + 전반/후반 클릭 델타(상승·하락).
      function gscPageAgg() {
        const rows = (_gscPageCache[_gscDays] || []).filter((r) => _gscSrc === 'all' || r.source === _gscSrc);
        const cutoff = new Date(Date.now() - _gscDays * 864e5).toISOString().slice(0, 10);
        const mid = new Date(Date.now() - Math.floor(_gscDays / 2) * 864e5).toISOString().slice(0, 10);
        const agg = {};
        for (const r of rows) {
          if (r.date < cutoff) continue;
          const a = (agg[r.page] ||= { page: r.page, source: r.source, clicks: 0, impressions: 0, posW: 0, firstC: 0, secondC: 0 });
          a.clicks += r.clicks || 0;
          a.impressions += r.impressions || 0;
          a.posW += (r.position || 0) * (r.impressions || 0);
          if (r.date >= mid) a.secondC += r.clicks || 0; else a.firstC += r.clicks || 0;
        }
        return Object.values(agg).map((a) => ({
          ...a, ctr: a.impressions ? a.clicks / a.impressions : 0,
          position: a.impressions ? a.posW / a.impressions : 0, delta: a.secondC - a.firstC,
        }));
      }

      function renderGscTable() {
        const el = document.getElementById('gsc-table'); if (!el) return;
        let rows = gscPageAgg();
        if (_gscSearch) rows = rows.filter((r) => (gscTitle(r.page) + ' ' + r.page).toLowerCase().includes(_gscSearch));
        const { key, dir } = _gscSort;
        rows.sort((a, b) => {
          if (key === 'page') { const r = gscTitle(a.page).localeCompare(gscTitle(b.page)); return dir < 0 ? -r : r; }
          return (b[key] - a[key]) * (dir < 0 ? 1 : -1);
        });
        rows = rows.slice(0, 100);
        const cols = [
          { k: 'page', t: '페이지', num: false }, { k: 'clicks', t: '클릭', num: true },
          { k: 'impressions', t: '노출', num: true }, { k: 'ctr', t: 'CTR', num: true },
          { k: 'position', t: '평균순위', num: true }, { k: 'delta', t: 'Δ클릭', num: true },
        ];
        const head = `<tr>${cols.map((c) => `<th data-k="${c.k}" class="${c.num ? 'num' : ''} ${key === c.k ? 'sorted' : ''}">${c.t}${key === c.k ? (dir < 0 ? ' ▾' : ' ▴') : ''}</th>`).join('')}</tr>`;
        const body = rows.length ? rows.map((r) => {
          const dChip = Math.abs(r.delta) < 1 ? '<span class="delta-chip flat">–</span>' : `<span class="delta-chip ${r.delta > 0 ? 'up' : 'down'}">${r.delta > 0 ? '▲' : '▼'} ${gscFmt(Math.abs(r.delta))}</span>`;
          const badge = _gscSrc === 'all' ? `<span class="gsc-badge gsc-badge-${r.source}">${GSC_SRC_BADGE[r.source] || r.source}</span>` : '';
          return `<tr><td class="gsc-page-cell">${badge}${gscCut(gscTitle(r.page), 40)}</td><td class="num">${gscFmt(r.clicks)}</td><td class="num">${gscFmt(r.impressions)}</td><td class="num">${gscPct(r.ctr)}</td><td class="num">${gscPos(r.position)}</td><td class="num">${dChip}</td></tr>`;
        }).join('') : '<tr><td colspan="6" style="color:var(--text-3);padding:0.75rem 0.5rem;">표시할 페이지 데이터가 없습니다.</td></tr>';
        el.innerHTML = head + body;
        el.querySelectorAll('th').forEach((th) => {
          th.onclick = () => {
            const k = th.dataset.k;
            if (_gscSort.key === k) _gscSort.dir *= -1;
            else _gscSort = { key: k, dir: k === 'position' ? 1 : -1 };
            renderGscTable();
          };
        });
      }

      function renderGscDetail() {
        const hasTot = Array.isArray(_gscTotals) && _gscTotals.length;
        const hasPage = ((_gscPageCache[_gscDays] || []).length) > 0;
        if (!hasTot && !hasPage) {
          const kpi = document.getElementById('gsc-kpi'); if (kpi) kpi.innerHTML = gscEmpty();
          ['gsc-chart', 'gsc-source-sections'].forEach((id) => { const e = document.getElementById(id); if (e) e.innerHTML = ''; });
          const tbl = document.getElementById('gsc-table'); if (tbl) tbl.innerHTML = '';
          return;
        }
        renderGscKpi();
        renderGscChart();
        renderGscSources();
        renderGscTable();
      }

      // ═══════════════════════════════════════════════════════════
      // 뭉게 유입경로 탭 (GA4) — 채널 / 소스·매체 / 랜딩페이지 / 일별 추이
      // 데이터 소스: ga4_daily (dim='total'|'channel'|'source_medium'|'page').
      // mungge 는 WordPress 라 자체 트래커가 없어 GA4 가 유일한 전체유입 통계다.
      // ═══════════════════════════════════════════════════════════
      let _ga4Rows = null;          // ga4_daily 90일 전체 (dim 구분 포함)
      let _ga4Days = 28;
      let _ga4Bucket = 'daily';     // daily | weekly | monthly
      let _ga4Metric = 'sessions';  // sessions | users | views
      let _ga4Sort = { key: 'sessions', dir: -1 };
      let _ga4Filter = null;        // {dim,key} — 유입경로로 랜딩 페이지 좁히기
      let _ga4Search = '';
      let _ga4Init = false;

      const ga4Fmt = (n) => Number(n || 0).toLocaleString('en-US');
      const ga4Pct = (v) => (Number(v || 0) * 100).toFixed(1) + '%';
      const ga4Cut = (s, n) => { s = String(s || ''); return s.length > n ? s.slice(0, n) + '…' : s; };
      const ga4Empty = () => '<div style="color:var(--text-2);font-size:0.8rem;line-height:1.5;padding:0.5rem 0;">아직 GA4 데이터가 없습니다 — 매일 09시 동기화 후 채워집니다.<br>즉시 채우려면 <code>/api/gsc-sync?ga4=sync&amp;days=90&amp;secret=CRON_SECRET</code> 를 호출하세요.</div>';

      // GA4 의 소스/매체 표기는 영어라 한눈에 안 들어온다 — 자주 나오는 것만 한글 병기
      const GA4_CH_KO = {
        'Organic Search': '검색(자연)', 'Direct': '직접 유입', 'Referral': '추천(외부링크)',
        'Organic Social': '소셜(자연)', 'Paid Search': '검색광고', 'Email': '이메일',
        'Organic Video': '동영상', 'AI Assistant': 'AI 어시스턴트', 'Unassigned': '미분류',
      };
      const ga4ChKo = (k) => GA4_CH_KO[k] || k;
      // GA4 deviceCategory 는 소문자 영어로 온다 — 그대로 두면 표 안에서 유독 튄다
      const GA4_DEV_KO = { desktop: 'PC', mobile: '모바일', tablet: '태블릿', smart_tv: 'TV' };
      const ga4DevKo = (k) => GA4_DEV_KO[k] || k;

      async function loadGa4Detail() {
        if (_ga4Init) return;
        _ga4Init = true;
        await ensureGa4Rows();   // 전체요약 통합과 같은 데이터를 공유(중복 요청 방지)
        wireGa4Controls();
        renderGa4Detail();
      }

      function wireGa4Controls() {
        const seg = (id, attr, curFn, cb) => {
          document.querySelectorAll(`#${id} button`).forEach((b) => {
            b.classList.toggle('active', b.dataset[attr] === String(curFn()));
            b.onclick = () => {
              document.querySelectorAll(`#${id} button`).forEach((x) => x.classList.remove('active'));
              b.classList.add('active');
              cb(b.dataset[attr]);
            };
          });
        };
        seg('ga4-period', 'days', () => _ga4Days, (v) => { _ga4Days = +v; renderGa4Detail(); });
        seg('ga4-bucket', 'b', () => _ga4Bucket, (v) => { _ga4Bucket = v; renderGa4Detail(); });
        seg('ga4-metric-tabs', 'm', () => _ga4Metric, (v) => { _ga4Metric = v; renderGa4Chart(); });
        const search = document.getElementById('ga4-page-search');
        if (search) search.oninput = () => { _ga4Search = search.value.trim().toLowerCase(); renderGa4Table(); };
        const syncBtn = document.getElementById('ga4-sync-now');
        if (syncBtn) syncBtn.onclick = () => syncGa4Now(syncBtn);
      }

      // GA4 오늘치 즉시 재동기화.
      // ga4_daily 는 매일 09시 배치로만 채워져서 오후에 보면 오늘 수치가 아침 시점에 멈춰 있다.
      // Site Kit 실시간 값과 어긋나 보이는 원인이 이것이라, 손으로 당길 수단을 둔다.
      // 인증은 대시보드 입장 비밀번호(x-admin-key) — 서버가 ga4=sync 모드에서만 받아준다.
      async function syncGa4Now(btn) {
        const label = btn.textContent;
        btn.disabled = true; btn.textContent = '동기화 중…';
        try {
          // days=2 = 어제·오늘. GA4 는 당일치를 몇 시간에 걸쳐 재집계하므로 어제까지 다시 덮는다.
          const r = await fetch('/api/gsc-sync?ga4=sync&days=2', { headers: { 'x-admin-key': adminKey } });
          const j = await r.json().catch(() => ({}));
          if (!r.ok) throw new Error(j.error || `HTTP ${r.status}`);
          _ga4Ready = null; _ga4Rows = null;   // 캐시된 프라미스를 버려야 새 값을 다시 읽는다
          await loadMunggeAll();               // 전체요약 쪽 뭉게 수치도 같은 데이터로 다시 그린다
          renderGa4Detail();
          btn.textContent = '갱신됨';
        } catch (e) {
          btn.textContent = '실패';
          console.error('ga4 sync', e);
        } finally {
          setTimeout(() => { btn.disabled = false; btn.textContent = label; }, 2500);
        }
      }

      const ga4Cutoff = () => new Date(Date.now() - (_ga4Days - 1) * 864e5).toISOString().slice(0, 10);
      const ga4Of = (dim) => (_ga4Rows || []).filter((r) => r.dim === dim && r.date >= ga4Cutoff());

      // GA4 랜딩 키는 쿼리스트링을 달고 온다. 뭉게는 캐시버스터(`/?v=…`)와 페이스북 fbclid 가
      // 붙어 같은 홈이 수십 행으로 쪼개지므로, 합산 전에 쿼리를 떼야 비중이 실제와 맞는다.
      const ga4Path = (k) => String(k || '/').split('?')[0] || '/';

      // 같은 key 를 기간 전체로 합산 (일별 행이 쌓여 있으므로)
      function ga4AggBy(dim) {
        const acc = {};
        const strip = dim === 'page' || dim === 'page_all';
        for (const r of ga4Of(dim)) {
          const key = strip ? ga4Path(r.key) : r.key;
          const a = (acc[key] ||= { key, sessions: 0, users: 0, views: 0, engaged: 0 });
          a.sessions += r.sessions || 0; a.users += r.users || 0;
          a.views += r.views || 0; a.engaged += r.engaged || 0;
        }
        return Object.values(acc).sort((a, b) => b.sessions - a.sessions);
      }

      // dim='total' 일별 시계열. 데이터 없는 날은 0 으로 채워야 추이가 끊기지 않는다.
      function ga4DailySeries() {
        const byDate = {};
        for (const r of ga4Of('total')) {
          const d = (byDate[r.date] ||= { date: r.date, sessions: 0, users: 0, views: 0, engaged: 0 });
          d.sessions += r.sessions || 0; d.users += r.users || 0;
          d.views += r.views || 0; d.engaged += r.engaged || 0;
        }
        const out = [];
        for (let i = _ga4Days - 1; i >= 0; i--) {
          const day = new Date(Date.now() - i * 864e5).toISOString().slice(0, 10);
          out.push(byDate[day] || { date: day, sessions: 0, users: 0, views: 0, engaged: 0 });
        }
        return out;
      }

      // 일간/주간/월간 버킷. 사용자(users)는 기간 내 중복 제거가 불가능한 값이라
      // 주·월로 묶으면 실제 순사용자보다 커진다 — 라벨에 '합산'임을 밝힌다.
      // 날짜 → 현재 버킷 키/라벨. 시계열과 '최다 유입경로'가 같은 기준으로 묶이도록 공유한다.
      function ga4BucketOf(date) {
        if (_ga4Bucket === 'daily') return { key: date, label: date.slice(5) };
        if (_ga4Bucket === 'monthly') {
          const k = date.slice(0, 7);
          return { key: k, label: `${k.slice(2, 4)}.${k.slice(5, 7)}` };
        }
        const dt = new Date(date + 'T00:00:00');
        const wd = (dt.getDay() + 6) % 7;                   // 0=월
        const mon = new Date(dt); mon.setDate(dt.getDate() - wd);
        const k = mon.toISOString().slice(0, 10);
        return { key: k, label: `${mon.getMonth() + 1}/${mon.getDate()}~` };
      }

      function ga4Series() {
        const days = ga4DailySeries();
        if (_ga4Bucket === 'daily') return days.map((d) => ({ ...d, label: d.date.slice(5) }));
        const acc = {};
        for (const d of days) {
          const { key, label } = ga4BucketOf(d.date);
          const a = (acc[key] ||= { date: key, label, sessions: 0, users: 0, views: 0, engaged: 0 });
          a.sessions += d.sessions; a.users += d.users; a.views += d.views; a.engaged += d.engaged;
        }
        return Object.values(acc).sort((a, b) => (a.date < b.date ? -1 : 1));
      }

      function renderGa4Kpi() {
        const el = document.getElementById('ga4-kpi'); if (!el) return;
        const s = ga4DailySeries();
        const sum = (k) => s.reduce((a, d) => a + (d[k] || 0), 0);
        const sessions = sum('sessions'), users = sum('users'), views = sum('views'), engaged = sum('engaged');
        // 기간 합계와 별개로 '오늘'을 항상 병기한다 — 기간을 바꾸지 않고도 당일치를 본다.
        const td = mgTotal(kstToday(), kstToday());
        const card = (k, v, sub) =>
          `<div class="gsc-kpi-card"><div class="gsc-kpi-k">${k}</div><div class="gsc-kpi-v">${v}</div><div class="gsc-kpi-k">${sub}</div></div>`;
        const per = _ga4Days === 1 ? '오늘' : `최근 ${_ga4Days}일`;
        el.innerHTML =
          card('세션', ga4Fmt(sessions), `${per} · 오늘 ${ga4Fmt(td.sessions)}`) +
          card('사용자', ga4Fmt(users), `중복 제거 · 오늘 ${ga4Fmt(td.users)}`) +
          card('페이지뷰', ga4Fmt(views), `세션당 ${sessions ? (views / sessions).toFixed(1) : '0.0'}쪽 · 오늘 ${ga4Fmt(td.views)}`) +
          card('참여율', ga4Pct(sessions ? engaged / sessions : 0), `참여 세션 ${ga4Fmt(engaged)} · 오늘 ${ga4Fmt(td.engaged)}`);
        const up = document.getElementById('ga4-updated');
        const last = (_ga4Rows || []).reduce((m, r) => (r.date > m ? r.date : m), '');
        const at = ga4SyncedLabel();
        // 오늘 행이 있어도 값은 마지막 동기화 시점 것이다 — 시각을 같이 적어야 Site Kit 과
        // 숫자가 다를 때 "지연"인지 "틀림"인지 구분된다
        if (up) up.textContent = last ? `최근 데이터: ${last}${at ? ` · 동기화 ${at}` : ''}` : '';
      }

      function renderGa4Chart() {
        const wrap = document.getElementById('ga4-chart'); if (!wrap) return;
        const s = ga4Series();
        const metaMap = { sessions: '세션', users: '사용자', views: '페이지뷰' };
        const lbl = document.getElementById('ga4-chart-metric-label');
        if (lbl) lbl.textContent = metaMap[_ga4Metric] || '';
        if (!s.length) { wrap.innerHTML = ''; return; }
        const vals = s.map((d) => d[_ga4Metric] || 0);
        const maxV = Math.max(...vals, 1);
        const W = 720, H = 220, padL = 46, padR = 22, padT = 14, padB = 26, n = s.length;
        const x = (i) => padL + (n === 1 ? (W - padL - padR) / 2 : i * (W - padL - padR) / (n - 1));
        const y = (v) => padT + (H - padT - padB) * (1 - v / maxV);
        const grid = [0, 0.5, 1].map((t) => {
          const gv = maxV * t, gy = y(gv);
          return `<line x1="${padL}" y1="${gy}" x2="${W - padR}" y2="${gy}" stroke="var(--border)" stroke-width="1"/><text x="${padL - 6}" y="${gy + 3}" text-anchor="end" font-size="10" fill="var(--text-3)">${ga4Fmt(Math.round(gv))}</text>`;
        }).join('');
        const pts = s.map((d, i) => `${x(i)},${y(vals[i])}`).join(' ');
        const area = `M ${x(0)},${y(0)} L ` + s.map((d, i) => `${x(i)},${y(vals[i])}`).join(' L ') + ` L ${x(n - 1)},${y(0)} Z`;
        const dots = s.map((d, i) => `<circle cx="${x(i)}" cy="${y(vals[i])}" r="2.6" fill="var(--accent)"/>`).join('');
        const xi = [...new Set([0, Math.floor((n - 1) / 2), n - 1])];
        const xlab = xi.map((i) => `<text x="${x(i)}" y="${H - 8}" text-anchor="middle" font-size="10" fill="var(--text-3)">${s[i].label || s[i].date}</text>`).join('');
        wrap.innerHTML = `<svg viewBox="0 0 ${W} ${H}" width="100%" style="display:block;height:auto" preserveAspectRatio="xMidYMid meet">
          ${grid}<path d="${area}" fill="var(--accent)" opacity="0.12"/>
          <polyline points="${pts}" fill="none" stroke="var(--accent)" stroke-width="2"/>
          <line class="ga4-cross" x1="0" y1="${padT}" x2="0" y2="${H - padB}" stroke="var(--text-3)" stroke-width="1" stroke-dasharray="3 3" style="display:none"/>
          <circle class="ga4-cross-dot" r="4" fill="var(--accent)" stroke="var(--surface)" stroke-width="2" style="display:none"/>
          ${dots}${xlab}</svg>
          <div class="gsc-tip" id="ga4-tip" style="display:none"></div>`;
        const svgEl = wrap.querySelector('svg');
        const tip = wrap.querySelector('#ga4-tip');
        const cross = wrap.querySelector('.ga4-cross');
        const crossDot = wrap.querySelector('.ga4-cross-dot');
        const move = (e) => {
          const rect = svgEl.getBoundingClientRect();
          const px = (e.clientX - rect.left) * (W / rect.width);
          let idx = n <= 1 ? 0 : Math.round((px - padL) / ((W - padL - padR) / (n - 1)));
          idx = Math.max(0, Math.min(n - 1, idx));
          const d = s[idx], cx = x(idx);
          cross.setAttribute('x1', cx); cross.setAttribute('x2', cx); cross.style.display = '';
          crossDot.setAttribute('cx', cx); crossDot.setAttribute('cy', y(vals[idx])); crossDot.style.display = '';
          tip.innerHTML = `<div class="gsc-tip-d">${d.label || d.date}</div>
            <div class="gsc-tip-r"><span>세션</span><b>${ga4Fmt(d.sessions)}</b></div>
            <div class="gsc-tip-r"><span>사용자</span><b>${ga4Fmt(d.users)}</b></div>
            <div class="gsc-tip-r"><span>페이지뷰</span><b>${ga4Fmt(d.views)}</b></div>
            <div class="gsc-tip-r"><span>참여율</span><b>${ga4Pct(d.sessions ? d.engaged / d.sessions : 0)}</b></div>`;
          tip.style.display = 'block';
          const wr = wrap.getBoundingClientRect();
          let left = e.clientX - wr.left + 14;
          if (left > wr.width - 140) left = e.clientX - wr.left - 140;
          tip.style.left = Math.max(4, left) + 'px';
          tip.style.top = '6px';
        };
        svgEl.addEventListener('mousemove', move);
        svgEl.addEventListener('mouseleave', () => { tip.style.display = 'none'; cross.style.display = 'none'; crossDot.style.display = 'none'; });
      }

      // 일별 집계 표 — 차트 호버로만 볼 수 있던 날짜별 수치를 숫자로 나열한다.
      // 세션 0인 날은 건너뛴다(차트와 달리 표에서는 빈 줄이 노이즈일 뿐).
      function renderGa4DailyTable() {
        const tbl = document.getElementById('ga4-daily-table'); if (!tbl) return;
        const days = ga4Series().filter((d) => d.sessions || d.views).slice().reverse();

        // 그 구간 최다 유입경로 — 시계열과 같은 버킷으로 묶고(일/주/월) 합산 후 1등만 뽑는다.
        // 일별 1등을 그대로 쓰면 주간·월간에서 키가 안 맞아 전부 '-' 로 비어 보인다.
        const sums = {};
        for (const r of ga4Of('source_medium')) {
          const k = ga4BucketOf(r.date).key;
          const m = (sums[k] ||= {});
          m[r.key] = (m[r.key] || 0) + (r.sessions || 0);
        }
        const topBy = {};
        for (const [k, m] of Object.entries(sums)) {
          const best = Object.entries(m).sort((a, b) => b[1] - a[1])[0];
          if (best) topBy[k] = { key: best[0], sessions: best[1] };
        }

        tbl.innerHTML = `<thead><tr>
            <th>날짜</th><th class="num">세션</th><th class="num">사용자</th><th class="num">페이지뷰</th>
            <th class="num">세션당</th><th class="num">참여율</th><th>최다 유입경로</th>
          </tr></thead><tbody>` +
          (days.length
            ? days.map((d) => {
                const t = topBy[d.date];
                return `<tr>
                  <td>${d.date}</td>
                  <td class="num">${ga4Fmt(d.sessions)}</td>
                  <td class="num">${ga4Fmt(d.users)}</td>
                  <td class="num">${ga4Fmt(d.views)}</td>
                  <td class="num">${d.sessions ? (d.views / d.sessions).toFixed(1) : '0.0'}</td>
                  <td class="num">${ga4Pct(d.sessions ? d.engaged / d.sessions : 0)}</td>
                  <td>${t ? `${ga4Cut(t.key, 32)} <span style="color:var(--text-3)">${ga4Fmt(t.sessions)}</span>` : '-'}</td>
                </tr>`;
              }).join('')
            : '<tr><td colspan="7" style="color:var(--text-3)">기간 내 방문 없음</td></tr>') +
          '</tbody>';
      }

      // ── 홈 vs 글 ──────────────────────────────────────────────────
      // "홈에 들어온 사람이 글까지 보고 가는가"를 세 각도로 본다.
      //  1) 진입(랜딩) 유형 — 홈으로 들어오는지, 검색으로 글에 직행하는지
      //  2) 세션당 쪽수 — GA4 는 세션의 전체 조회수를 '랜딩' 페이지에 귀속시키므로
      //     홈 랜딩의 views/sessions 가 1.00 이면 홈만 보고 나갔다는 뜻이다
      //  3) 조회 유형(dim='page_all') — 실제로 열린 페이지 구성. 진입보다 홈 비중이 낮으면
      //     홈을 발판 삼아 글로 넘어갔다는 뜻
      const MG_KIND_KO = { home: '홈', post: '글', tool: '도구', etc: '기타' };
      // 뭉게 글 URL 은 `/2026-07-27-…/` 처럼 접두어가 없어서 "글" 을 화이트리스트로 못 잡는다.
      // 반대로 아카이브·시스템 경로만 빼고 나머지를 글로 본다.
      const MG_NONPOST = /^\/(category|tag|author|search|page|feed|comments|wp-|amp|privacy|about|contact|sitemap|404)(\/|$)/i;
      function mgKindOf(rawKey) {
        const p = ga4Path(rawKey);
        if (!p.startsWith('/')) return 'etc';        // '(not set)' 등 경로가 아닌 값
        const norm = p.replace(/\/+$/, '') || '/';
        if (norm === '/') return 'home';
        if (/^\/tools(\/|$)/.test(norm)) return 'tool';
        if (MG_NONPOST.test(norm)) return 'etc';
        return 'post';
      }

      function ga4KindAgg(dim) {
        const acc = {};
        for (const k of Object.keys(MG_KIND_KO)) acc[k] = { kind: k, sessions: 0, users: 0, views: 0, engaged: 0 };
        for (const r of ga4Of(dim)) {
          const a = acc[mgKindOf(r.key)];
          a.sessions += r.sessions || 0; a.users += r.users || 0;
          a.views += r.views || 0; a.engaged += r.engaged || 0;
        }
        return acc;
      }

      function renderGa4Entry() {
        const entry = ga4KindAgg('page');
        const view = ga4KindAgg('page_all');
        const kpi = document.getElementById('ga4-entry-kpi');
        if (kpi) {
          const total = Object.values(entry).reduce((a, r) => a + r.sessions, 0);
          const home = entry.home, post = entry.post;
          const per = (r) => (r.sessions ? r.views / r.sessions : 0);
          const card = (k, v, sub) =>
            `<div class="gsc-kpi-card"><div class="gsc-kpi-k">${k}</div><div class="gsc-kpi-v">${v}</div><div class="gsc-kpi-k">${sub}</div></div>`;
          kpi.innerHTML =
            card('홈 진입', ga4Fmt(home.sessions), `전체 세션의 ${ga4Pct(total ? home.sessions / total : 0)}`) +
            card('글 직행', ga4Fmt(post.sessions), `검색·SNS로 글에 바로 도착 · ${ga4Pct(total ? post.sessions / total : 0)}`) +
            card('홈 진입 세션당', `${per(home).toFixed(2)}쪽`,
              home.sessions ? `1.00 = 홈만 보고 이탈 · 추가 열람 ${ga4Fmt(Math.max(0, home.views - home.sessions))}쪽` : '홈 진입 없음') +
            card('홈 참여율', ga4Pct(home.sessions ? home.engaged / home.sessions : 0),
              `글 직행 ${ga4Pct(post.sessions ? post.engaged / post.sessions : 0)} · 글 세션당 ${per(post).toFixed(2)}쪽`);
        }
        renderGa4KindList('ga4-entry-kind', entry, 'sessions', true);
        renderGa4KindList('ga4-view-kind', view, 'views', false);
        renderGa4InternalNav();
      }

      // 유형별 막대 — 채널 목록(renderGa4Breakdown)과 같은 마크업이라 CSS 를 그대로 쓴다
      function renderGa4KindList(elId, agg, metric, showPer) {
        const el = document.getElementById(elId); if (!el) return;
        const rows = Object.values(agg).filter((r) => r[metric] > 0).sort((a, b) => b[metric] - a[metric]);
        if (!rows.length) {
          // page_all 은 나중에 추가된 차원이라 동기화 전에는 비어 있다 — 원인을 적어야 오해가 없다
          el.innerHTML = metric === 'views'
            ? '<div style="color:var(--text-3);font-size:0.74rem;padding:0.3rem 0;line-height:1.5;">조회 유형은 <code>dim=page_all</code> 동기화 이후 채워집니다.<br><code>/api/gsc-sync?ga4=sync&amp;days=90&amp;secret=…</code></div>'
            : '<div style="color:var(--text-3);font-size:0.74rem;padding:0.3rem 0;">데이터 없음</div>';
          return;
        }
        const total = rows.reduce((a, r) => a + r[metric], 0) || 1;
        el.innerHTML = rows.map((r) => {
          const p = r[metric] / total;
          const per = showPer && r.sessions ? ` <span style="color:var(--text-3)">세션당 ${(r.views / r.sessions).toFixed(2)}쪽</span>` : '';
          return `<div class="gsc-src-row"><span>${MG_KIND_KO[r.kind]}${per}</span><span>${ga4Fmt(r[metric])} · ${ga4Pct(p)}</span></div>
          <div style="height:3px;background:var(--accent);opacity:0.35;border-radius:2px;width:${(p * 100).toFixed(1)}%;margin:0 0 0.25rem;"></div>`;
        }).join('');
      }

      // 홈 → 글 이동 실측. GA4 는 페이지 이동 시퀀스를 주지 않아 "홈에서 어느 글로 갔나"를 만들 수 없다.
      // 뭉게 자체 트래커(pageview_mg)는 referrer 를 원문 그대로 남기므로, referrer 가 뭉게 홈인
      // 조회가 곧 홈에서 눌러 들어간 클릭이다. _mgLive 는 최근 3일치라 기간 선택과 무관하다.
      function renderGa4InternalNav() {
        const tbl = document.getElementById('ga4-internal-table');
        const sum = document.getElementById('ga4-internal-sum');
        if (!tbl) return;
        if (!_mgLiveLoaded) {
          tbl.innerHTML = '<tbody><tr><td style="color:var(--text-3)">실시간 방문 기록 불러오는 중…</td></tr></tbody>';
          if (sum) sum.innerHTML = '';
          return;
        }
        const refPath = (ref) => {
          try {
            const u = new URL(ref);
            return /(^|\.)mungge\.com$/.test(u.hostname) ? (u.pathname || '/') : null;
          } catch { return null; }
        };
        let homeViews = 0, fromHome = 0;
        const acc = {};
        for (const e of (_mgLive || [])) {
          const path = ga4Path(e.path || '/');
          if (mgKindOf(path) === 'home') homeViews++;
          const rp = refPath(e.ref);
          if (rp && mgKindOf(rp) === 'home' && mgKindOf(path) !== 'home') {
            fromHome++;
            const a = (acc[path] ||= { path, title: e.title || '', n: 0 });
            a.n++;
          }
        }
        const rows = Object.values(acc).sort((a, b) => b.n - a.n).slice(0, 15);
        tbl.innerHTML = '<thead><tr><th>홈에서 눌러 들어간 페이지</th><th class="num">클릭</th></tr></thead><tbody>' +
          (rows.length
            ? rows.map((r) => `<tr>
                <td><a href="https://mungge.com${escHtml(r.path)}" target="_blank" rel="noopener" style="color:inherit">${escHtml(ga4Cut(r.title || r.path, 60))}</a>
                <div style="color:var(--text-3);font-size:0.7rem">${escHtml(ga4Cut(r.path, 60))}</div></td>
                <td class="num">${ga4Fmt(r.n)}</td></tr>`).join('')
            : '<tr><td colspan="2" style="color:var(--text-3)">최근 3일 동안 홈에서 다른 페이지로 넘어간 기록이 없습니다.</td></tr>') +
          '</tbody>';
        if (sum) {
          sum.innerHTML = homeViews
            ? `최근 3일 홈 조회 <b>${ga4Fmt(homeViews)}</b>건 → 글·도구로 이동 <b>${ga4Fmt(fromHome)}</b>건 (<b>${ga4Pct(fromHome / homeViews)}</b>)`
            : '최근 3일 홈 조회 기록 없음';
        }
      }

      // 채널·소스매체·기기 목록 — 비중을 막대로 같이 보여줘야 "어디가 주력인지"가 한눈에 들어온다
      // pickable=false: 기기·브라우저·OS 는 랜딩 페이지를 좁힐 수 없다(교차 차원이 page_source
      // 하나뿐이라 소스/매체만 가능). 클릭 가능하게 두면 눌러도 표가 안 바뀌어 고장으로 보인다.
      function renderGa4Breakdown(elId, dim, koFn, pickable = true) {
        const el = document.getElementById(elId); if (!el) return;
        const rows = ga4AggBy(dim);
        if (!rows.length) { el.innerHTML = '<div style="color:var(--text-3);font-size:0.74rem;padding:0.3rem 0;">데이터 없음</div>'; return; }
        const total = rows.reduce((a, r) => a + r.sessions, 0) || 1;
        // 행을 누르면 아래 랜딩 페이지 표가 그 유입경로로 좁혀진다 —
        // "네이버 블로그에서 온 사람이 어느 글을 봤나"를 여기서 확인한다.
        el.innerHTML = rows.slice(0, 12).map((r) => {
          const p = r.sessions / total;
          const on = pickable && _ga4Filter && _ga4Filter.dim === dim && _ga4Filter.key === r.key;
          const cls = pickable ? ` ga4-pick${on ? ' on' : ''}` : '';
          const tip = pickable ? ` title="클릭하면 이 경로로 들어온 랜딩 페이지만 봅니다 — ${escHtml(ga4Cut(r.key, 80))}"` : '';
          return `<div class="gsc-src-row${cls}" data-dim="${escHtml(dim)}" data-key="${escHtml(r.key)}"${tip}>
            <span>${on ? '▸ ' : ''}${ga4Cut(koFn ? koFn(r.key) : r.key, 32)}</span>
            <span>${ga4Fmt(r.sessions)} · ${ga4Pct(p)}</span>
          </div>
          <div style="height:3px;background:var(--accent);opacity:${on ? '0.9' : '0.35'};border-radius:2px;width:${(p * 100).toFixed(1)}%;margin:0 0 0.25rem;"></div>`;
        }).join('');
        el.querySelectorAll('.ga4-pick').forEach((row) => {
          row.onclick = () => {
            const k = row.dataset.key, d = row.dataset.dim;
            _ga4Filter = (_ga4Filter && _ga4Filter.dim === d && _ga4Filter.key === k) ? null : { dim: d, key: k };
            renderGa4Detail();
          };
        });
      }

      // 랜딩 페이지 목록. 유입경로 필터가 걸리면 page_source 교차 차원에서 뽑는다.
      function ga4PageRows() {
        // 기간='오늘' + 필터 없음이면 실시간 이벤트를 쓴다(GA4 배치는 몇 시간 지연)
        if (!_ga4Filter && _ga4Days === 1) {
          const live = mgLiveToday();
          if (live.length) return live;
        }
        if (!_ga4Filter) return ga4AggBy('page');
        const want = _ga4Filter.key;
        const acc = {};
        for (const r of ga4Of('page_source')) {
          const i = r.key.indexOf('\t');
          if (i < 0) continue;
          const page = r.key.slice(0, i), sm = r.key.slice(i + 1);
          // 채널(Organic Search 등)은 소스/매체와 값이 달라 교차 차원으로 좁힐 수 없다.
          // 그 경우엔 필터를 무시하고 전체를 보여주는 편이 빈 표보다 낫다.
          if (_ga4Filter.dim === 'source_medium' ? sm !== want : false) continue;
          const a = (acc[page] ||= { key: page, sessions: 0, users: 0, views: 0, engaged: 0 });
          a.sessions += r.sessions || 0; a.users += r.users || 0;
          a.views += r.views || 0; a.engaged += r.engaged || 0;
        }
        const out = Object.values(acc).sort((a, b) => b.sessions - a.sessions);
        return out.length ? out : ga4AggBy('page');
      }

      function renderGa4Table() {
        const tbl = document.getElementById('ga4-table'); if (!tbl) return;
        const cap = document.getElementById('ga4-table-filter');
        const isLive = !_ga4Filter && _ga4Days === 1 && mgLiveToday().length > 0;
        if (cap) {
          cap.innerHTML = _ga4Filter
            ? `<span class="ga4-chip">${escHtml(ga4Cut(_ga4Filter.key, 40))} <b>×</b></span>`
            : isLive ? '<span class="ga4-live">● 실시간</span>' : '';
          const x = cap.querySelector('.ga4-chip');
          if (x) x.onclick = () => { _ga4Filter = null; renderGa4Detail(); };
        }
        let rows = ga4PageRows();
        if (_ga4Search) rows = rows.filter((r) => r.key.toLowerCase().includes(_ga4Search));
        const { key, dir } = _ga4Sort;
        rows = rows.slice().sort((a, b) => (a[key] < b[key] ? -1 : a[key] > b[key] ? 1 : 0) * dir);
        const th = (k, label, cls) =>
          `<th class="${cls || ''}${key === k ? ' sorted' : ''}" data-k="${k}">${label}${key === k ? (dir < 0 ? ' ▾' : ' ▴') : ''}</th>`;
        tbl.innerHTML = `<thead><tr>
            ${th('key', '랜딩 페이지')}${th('sessions', '세션', 'num')}${th('users', '사용자', 'num')}${th('views', '조회', 'num')}${th('engaged', '참여', 'num')}
          </tr></thead><tbody>` +
          (rows.length
            ? rows.slice(0, 100).map((r) => `<tr>
                <td><a href="https://mungge.com${r.key.startsWith('/') ? r.key : '/' + r.key}" target="_blank" rel="noopener" style="color:inherit">${ga4Cut(r.key, 60)}</a></td>
                <td class="num">${ga4Fmt(r.sessions)}</td><td class="num">${ga4Fmt(r.users)}</td>
                <td class="num">${ga4Fmt(r.views)}</td><td class="num">${ga4Fmt(r.engaged)}</td></tr>`).join('')
            : '<tr><td colspan="5" style="color:var(--text-3)">해당 페이지 없음</td></tr>') +
          '</tbody>';
        tbl.querySelectorAll('th').forEach((h) => {
          h.onclick = () => {
            const k = h.dataset.k;
            _ga4Sort = { key: k, dir: _ga4Sort.key === k ? -_ga4Sort.dir : -1 };
            renderGa4Table();
          };
        });
      }

      function renderGa4Detail() {
        if (!Array.isArray(_ga4Rows) || !_ga4Rows.length) {
          const kpi = document.getElementById('ga4-kpi'); if (kpi) kpi.innerHTML = ga4Empty();
          ['ga4-chart', 'ga4-channel', 'ga4-sourcemedium', 'ga4-device', 'ga4-browser', 'ga4-os'].forEach((id) => { const e = document.getElementById(id); if (e) e.innerHTML = ''; });
          ['ga4-table', 'ga4-daily-table', 'ga4-internal-table'].forEach((id) => { const e = document.getElementById(id); if (e) e.innerHTML = ''; });
          ['ga4-entry-kpi', 'ga4-entry-kind', 'ga4-view-kind', 'ga4-internal-sum'].forEach((id) => { const e = document.getElementById(id); if (e) e.innerHTML = ''; });
          return;
        }
        renderGa4Kpi();
        renderGa4Entry();
        renderGa4Chart();
        renderGa4DailyTable();
        renderGa4Breakdown('ga4-channel', 'channel', ga4ChKo);
        renderGa4Breakdown('ga4-sourcemedium', 'source_medium', null);
        renderGa4Breakdown('ga4-device', 'device', ga4DevKo, false);
        renderGa4Breakdown('ga4-browser', 'browser', null, false);
        renderGa4Breakdown('ga4-os', 'os', null, false);
        renderGa4Table();
      }

      // ═══════════════════════════════════════════════════════════
      // 뭉게 → 전체 요약 통합
      // 뭉게는 이벤트 단위 데이터가 없다(WordPress+GA4 집계만). 그래서 이벤트가
      // 필요한 항목(Live Activity·추천 TOP·전환 퍼널·쿠팡/페이퍼닥)에는 넣을 수 없고,
      // 조회수/방문자/유입경로/기기/글 수처럼 집계로 표현되는 항목에만 합류시킨다.
      // GA4 screenPageViews 를 analytics 의 pageview 와 같은 단위로 취급한다.
      // ═══════════════════════════════════════════════════════════
      let _mgPosts = null;      // WP REST: { total, categories[], recent[] }
      let _gscMgRows = null;    // gsc_daily 의 뭉게(source='mg') 최근 7일 _TOTAL_ 행
      let _mgLikes = null;      // analytics 의 뭉게 추천(like) 이벤트
      // 뭉게 방문 이벤트(pageview_mg). GA4 는 하루 1회 배치라 '지금 뭘 보고 있나'를 못 준다 —
      // 오늘치는 이 이벤트로 실시간 집계한다.
      let _mgLive = [];
      // 아직 안 받아온 상태와 "이동 기록이 정말 없는" 상태는 화면에서 구분해야 한다 —
      // 탭을 일찍 누르면 로딩 중인데 '기록 없음'으로 읽혀 잘못된 결론이 나온다
      let _mgLiveLoaded = false;
      let _ga4Ready = null;     // ga4_daily 로드 프라미스 (탭·요약이 공유해 중복 요청 방지)
      let _ga4Synced = null;    // ga4_daily 최신 updated_at — "이 수치가 몇 시 기준인가"
      let _traffic = null;      // loadTraffic 이 계산한 analytics 측 수치 스냅샷

      const MG_URL = 'https://mungge.com';
      const kstToday = () => new Date(Date.now() + 9 * 3600e3).toISOString().slice(0, 10);
      const kstYday = () => new Date(Date.now() + 9 * 3600e3 - 864e5).toISOString().slice(0, 10);

      function ensureGa4Rows() {
        if (_ga4Ready) return _ga4Ready;
        const since = new Date(Date.now() - 92 * 864e5).toISOString().slice(0, 10);
        const rowsP = fetch(
          `${SUPABASE_URL}/rest/v1/ga4_daily?date=gte.${since}&select=date,dim,key,sessions,users,views,engaged&order=date.asc&limit=50000`,
          { headers }
        ).then((r) => (r.ok ? r.json() : [])).catch(() => []).then((rows) => { _ga4Rows = rows; return rows; });
        // "언제 가져온 값인가"는 날짜(date)로는 알 수 없다. 오늘 행이 있어도 그 값은 마지막
        // 동기화 시점에 멈춰 있어서, Site Kit 실시간 수치와 비교하면 대시보드가 틀린 것처럼 보인다.
        // 행 전체에 updated_at 을 실어 나르면 payload 만 커지므로 최신 1건만 따로 읽는다.
        const syncP = fetch(`${SUPABASE_URL}/rest/v1/ga4_daily?select=updated_at&order=updated_at.desc&limit=1`, { headers })
          .then((r) => (r.ok ? r.json() : []))
          .then((rows) => { _ga4Synced = rows[0]?.updated_at || null; })
          .catch(() => {});
        // 둘 다 끝난 뒤 resolve — 렌더가 시각 표시 없이 한 번 그려졌다 바뀌는 깜빡임을 막는다
        _ga4Ready = Promise.all([rowsP, syncP]).then(([rows]) => rows);
        return _ga4Ready;
      }

      // 마지막 동기화 시각(KST HH:MM). 배치는 하루 1회라 오후엔 몇 시간 전 값일 수 있다.
      const ga4SyncedLabel = () => {
        if (!_ga4Synced) return '';
        const d = new Date(new Date(_ga4Synced).getTime() + 9 * 3600e3);
        return `${String(d.getUTCHours()).padStart(2, '0')}:${String(d.getUTCMinutes()).padStart(2, '0')}`;
      };

      // dim 별 합계 — from(포함)~to(포함) 날짜 범위. 날짜 미지정이면 전 구간.
      function mgAgg(dim, from, to) {
        const acc = {};
        for (const r of (_ga4Rows || [])) {
          if (r.dim !== dim) continue;
          if (from && r.date < from) continue;
          if (to && r.date > to) continue;
          const a = (acc[r.key] ||= { key: r.key, sessions: 0, users: 0, views: 0, engaged: 0 });
          a.sessions += r.sessions || 0; a.users += r.users || 0;
          a.views += r.views || 0; a.engaged += r.engaged || 0;
        }
        return Object.values(acc).sort((a, b) => b.views - a.views);
      }
      const mgTotal = (from, to) => (mgAgg('total', from, to)[0] || { sessions: 0, users: 0, views: 0, engaged: 0 });

      // Top Pages 합류용 — analytics 행과 같은 모양으로 맞춘다
      function mgTopPages(period) {
        // '일'(오늘)은 GA4 배치(하루 1회)를 기다리지 않고 pageview_mg 이벤트로 실시간 집계.
        // 두 소스를 합치면 같은 방문이 두 번 세지므로 기간별로 하나만 쓴다.
        if (period === 'day') {
          const live = mgLiveToday();
          if (live.length) {
            return live.map((r) => ({ path: r.path, slug: r.path, source: 'mg', title: r.title || r.path, views: r.views }));
          }
        }
        const from = period === 'day' ? kstToday()
          : period === 'week' ? new Date(Date.now() - 7 * 864e5).toISOString().slice(0, 10)
          : period === 'month' ? new Date(Date.now() - 30 * 864e5).toISOString().slice(0, 10)
          : null;
        // GA4 landingPage 는 쿼리스트링을 붙여 준다. 뭉게는 캐시버스터(`/?v=…`)가 붙은
        // 방문이 많아 그대로 두면 같은 홈이 여러 행으로 쪼개져 Top Pages 를 잠식한다.
        const strip = (k) => k.split('?')[0] || '/';
        const merged = {};
        for (const r of mgAgg('page', from)) {
          if (!r.key || r.key === '(not set)') continue;
          const k = strip(r.key);
          const a = (merged[k] ||= { key: k, sessions: 0, views: 0 });
          a.sessions += r.sessions || 0; a.views += r.views || 0;
        }
        return Object.values(merged).sort((a, b) => b.views - a.views).map((r) => ({
          path: r.key.startsWith('/') ? r.key : '/' + r.key,
          slug: r.key,
          source: 'mg',
          title: r.key,
          views: r.views || r.sessions,
        }));
      }

      // WP REST — 글 수 / 카테고리 구성 / 최근 글. 뭉게는 빌드시점 데이터가 없다.
      async function loadMunggePosts() {
        try {
          const [pRes, cRes] = await Promise.all([
            fetch(`${MG_URL}/wp-json/wp/v2/posts?per_page=5&_fields=title,link,date,categories`),
            fetch(`${MG_URL}/wp-json/wp/v2/categories?per_page=100&orderby=count&order=desc&_fields=id,name,count`),
          ]);
          if (!pRes.ok) return null;
          const total = Number(pRes.headers.get('x-wp-total')) || 0;
          const posts = await pRes.json();
          const cats = cRes.ok ? await cRes.json() : [];
          const catById = {};
          cats.forEach((c) => { catById[c.id] = c.name; });
          const palette = ['#f59e0b', '#3b82f6', '#16a34a', '#a855f7', '#ef4444', '#06b6d4', '#eab308', '#ec4899'];
          _mgPosts = {
            total,
            categories: cats.filter((c) => c.count > 0).slice(0, 8)
              .map((c, i) => ({ name: c.name, count: c.count, color: palette[i % palette.length] })),
            recent: posts.map((p) => ({
              title: String(p.title?.rendered || '').replace(/<[^>]*>/g, ''),
              link: p.link,
              category: catById[(p.categories || [])[0]] || '기타',
              pubDate: String(p.date || '').slice(0, 10),
            })),
          };
          return _mgPosts;
        } catch { return null; }
      }

      // Row 6 — 뭉게 콘텐츠 구성 (TF/LF 섹션과 같은 도넛+범례+최근글 형식)
      function renderMunggeSection() {
        const badge = document.getElementById('mg-overview-badge');
        const wrap = document.getElementById('mg-overview-donut-wrap');
        const list = document.getElementById('mg-recent-list');
        if (!_mgPosts) {
          if (wrap) wrap.innerHTML = '<div class="no-data">WordPress 조회 실패</div>';
          return;
        }
        if (badge) badge.textContent = `${fmt(_mgPosts.total)}편`;
        const cats = _mgPosts.categories;
        const base = cats.reduce((s, c) => s + c.count, 0) || 1;
        if (wrap) {
          let before = 0;
          const stops = cats.map((c) => {
            const pct = c.count / base * 100;
            const g = cats.length > 1 ? Math.min(1, pct / 4) : 0;
            const s = `#1e293b ${before}% ${before + g}%, ${c.color} ${before + g}% ${before + pct}%`;
            before += pct;
            return s;
          }).join(', ');
          wrap.innerHTML = `
            <div class="cat-donut" style="background: conic-gradient(${stops})">
              <div class="cat-donut-hole">
                <span class="donut-num">${fmt(_mgPosts.total)}</span>
                <span class="donut-label">포스트</span>
              </div>
            </div>
            <div class="cat-legend">${cats.map((c) => `
              <div class="cat-legend-item">
                <span class="cat-legend-dot" style="background:${c.color}"></span>
                <span class="cat-legend-name">${c.name}</span>
                <span class="cat-legend-count">${c.count}</span>
                <span class="cat-legend-pct">${Math.round(c.count / base * 100)}%</span>
              </div>`).join('')}</div>`;
        }
        if (list) {
          list.innerHTML = _mgPosts.recent.map((p, i) => `
            <div class="recent-item">
              <span class="recent-rank">${i + 1}</span>
              <span class="recent-title"><a href="${p.link}" target="_blank" rel="noopener" style="color:inherit">${p.title}</a></span>
              <span class="cat-badge">${p.category}</span>
              <span class="recent-date">${p.pubDate}</span>
            </div>`).join('') || '<div class="no-data">글 없음</div>';
        }
      }

      // Row 1·3·7 — analytics 수치에 뭉게를 합류시킨다. loadTraffic 이 끝난 뒤 호출.
      function applyMungge() {
        if (!_traffic || !Array.isArray(_ga4Rows)) return;
        const t = _traffic;
        const today = mgTotal(kstToday(), kstToday());
        const yday = mgTotal(kstYday(), kstYday());
        const all = mgTotal();

        // Row 1 · 금일 방문자 / 금일 조회수 (뭉게 합산)
        const vis = t.todayVis + today.users, visY = t.ydayVis + yday.users;
        const vw = t.tv + today.views, vwY = t.yv + yday.views;
        const setEl = (id, txt) => { const e = document.getElementById(id); if (e) e.textContent = txt; };
        setEl('kpi-today-visitors', fmt(vis));
        setEl('kpi-today-visitors-sub', `어제 ${fmt(visY)}명 · 뭉게 +${fmt(today.users)} · KST`);
        setEl('kpi-today-views', fmt(vw));
        setEl('kpi-today-views-sub', `어제 ${fmt(vwY)}회 · 뭉게 +${fmt(today.views)} · KST`);
        t.setKpiDelta('kpi-tv-delta', vis, visY);
        t.setKpiDelta('kpi-tw-delta', vw, vwY);

        // Row 1 · 총 조회수 (누적) — 뭉게는 GA4 수집 시작일(2026-07-27) 이후만 존재
        const totalV = t.totalViews + all.views;
        setEl('total-views', fmt(totalV));
        setEl('mg-total-views', fmt(all.views) + (today.views ? ` (+${today.views})` : ''));
        const pct = (n) => Math.round(n / (totalV || 1) * 100) + '%';
        const setW = (id, n) => { const e = document.getElementById(id); if (e) e.style.width = pct(n); };
        setW('views-split-tf', t.tfTotal); setW('views-split-lf', t.lfTotal);
        setW('views-split-vip', t.vipTotal); setW('views-split-mg', all.views);

        // Row 1 · Total Posts
        if (_mgPosts) {
          const allPosts = t.postBase + _mgPosts.total;
          setEl('total-post-count', fmt(allPosts));
          const sub = document.getElementById('total-post-sub');
          if (sub) sub.textContent = `${sub.dataset.base || sub.textContent.split(' + 뭉게')[0]} + 뭉게 ${_mgPosts.total}`;
          if (sub && !sub.dataset.base) sub.dataset.base = sub.textContent.split(' + 뭉게')[0];
          const mgBar = document.getElementById('total-split-mg');
          if (mgBar) mgBar.style.width = Math.round(_mgPosts.total / allPosts * 100) + '%';
          setEl('total-split-mg-pct', `뭉게 ${Math.round(_mgPosts.total / allPosts * 100)}%`);
          ['tf', 'lf', 'vip'].forEach((k) => {
            const bar = document.getElementById(`total-split-${k}`);
            if (bar) bar.style.width = Math.round(t.postCounts[k] / allPosts * 100) + '%';
            const lab = document.getElementById(`total-split-${k}-pct`);
            if (lab) lab.textContent = `${k.toUpperCase()} ${Math.round(t.postCounts[k] / allPosts * 100)}%`;
          });
        }

        // Row 3 · Today Views 브레이크다운에 뭉게 추가
        const vbEl = document.getElementById('t-views-breakdown');
        if (vbEl) {
          setEl('t-today-views', fmt(vw));
          vbEl.innerHTML =
            `<span><i class="dot-tf"></i> TF: ${fmt(t.tfTv)}</span>` +
            `<span><i class="dot-lf"></i> LF: ${fmt(t.lfTv)}</span>` +
            `<span><i class="dot-vip"></i> VIP: ${fmt(t.vipTv)}</span>` +
            `<span><i class="dot-mg"></i> 뭉게: ${fmt(today.views)}</span>`;
        }

        // Row 1 · Categories — 뭉게 카테고리 수 합류
        if (_mgPosts) {
          const cEl = document.getElementById('total-cat-count');
          const cSub = document.getElementById('total-cat-sub');
          const mgCats = _mgPosts.categories.length;
          if (cEl) cEl.textContent = fmt((Number(cEl.dataset.base) || 0) + mgCats);
          if (cSub) cSub.textContent = `${cSub.dataset.base} + 뭉게 ${mgCats}`;
        }

        // Row 1 · Search Clicks (GSC) — 카드 값은 이미 전 소스 합계다(뭉게 포함).
        // 다만 뭉게 몫이 안 보여서 "포함됐는지" 알 수 없으므로 sub 에 병기한다.
        const gsub = document.getElementById('gsc-sum-sub');
        if (gsub && Array.isArray(_gscMgRows)) {
          const mgClicks = _gscMgRows.reduce((a, r) => a + (r.clicks || 0), 0);
          if (!/뭉게/.test(gsub.textContent)) gsub.innerHTML += ` · <span style="color:#fbbf24">뭉게 ${fmt(mgClicks)}</span>`;
        }

        // Row 1 · 뭉게 방문자/조회수 — 나머지 카드는 모두 합산값이라 뭉게 몫을 따로 못 봤다.
        // 방문자는 GA4 totalUsers(당일 중복 제거)라 날짜를 넘겨 합산하면 부풀려지므로
        // 누적은 조회수만 적는다.
        setEl('mg-sum-today', `${fmt(today.users)} / ${fmt(today.views)}`);
        t.setKpiDelta('mg-sum-delta', today.users, yday.users);
        const mgAt = ga4SyncedLabel();
        setEl('mg-sum-sub',
          `어제 ${fmt(yday.users)} / ${fmt(yday.views)} · 누적 조회 ${fmt(all.views)}` +
          (mgAt ? ` · 동기화 ${mgAt}` : ''));

        // Row 3 · Likes — 뭉게 추천 버튼(source='mg')이 생겨 분리 표시가 가능해졌다
        const likeBox = document.getElementById('t-likes-total');
        if (likeBox && Array.isArray(_mgLikes) && !/뭉게/.test(likeBox.textContent)) {
          likeBox.textContent += ` · 뭉게 ${fmt(_mgLikes.length)}`;
        }

        // Row 7 · GA4 동기화 상태 — 마지막 데이터가 이틀 이상 밀리면 경고
        const st = document.getElementById('mungge-ga4-status');
        if (st) {
          const last = (_ga4Rows || []).reduce((m, r) => (r.date > m ? r.date : m), '');
          const stale = !last || last < kstYday();
          const at = ga4SyncedLabel();
          st.textContent = last ? (stale ? `지연 (${last})` : `정상 (${last}${at ? ` ${at}` : ''})`) : '데이터 없음';
          st.className = 'status-badge ' + (last && !stale ? 'online' : 'pending');
        }
      }

      // Row 7 · 뭉게 사이트 응답 확인. WP REST 는 CORS 를 열어두므로 브라우저에서 직접 찔러본다.
      async function checkMungge() {
        const el = document.getElementById('mungge-status');
        if (!el) return;
        try {
          const r = await fetch(`${MG_URL}/wp-json/wp/v2/posts?per_page=1&_fields=id`);
          el.textContent = r.ok ? 'Online' : `HTTP ${r.status}`;
          el.className = 'status-badge ' + (r.ok ? 'online' : 'pending');
        } catch {
          el.textContent = 'Unreachable';
          el.className = 'status-badge pending';
        }
      }

      // Row 2 방문 추이용 — get_daily_detail 행에 뭉게 일별 수치를 얹는다.
      // bucketDetail 이 mg_views/mg_visitors 를 읽어 버킷의 mg·mgV 와 총합에 반영한다.
      // 여러 번 호출돼도 대입(=)이라 누적되지 않는다.
      function mergeMgIntoDetail() {
        if (!Array.isArray(_ga4Rows) || !_trafficDetail) return;
        const byDay = {};
        for (const r of _ga4Rows) {
          if (r.dim !== 'total') continue;
          const a = (byDay[r.date] ||= { views: 0, users: 0 });
          a.views += r.views || 0; a.users += r.users || 0;
        }
        const idx = {};
        _trafficDetail.forEach((d) => { if (d.day) idx[d.day] = d; });
        for (const [day, v] of Object.entries(byDay)) {
          if (idx[day]) { idx[day].mg_views = v.views; idx[day].mg_visitors = v.users; }
          else _trafficDetail.push({ day, views: 0, visitors: 0, tf_views: 0, lf_views: 0, mg_views: v.views, mg_visitors: v.users });
        }
        _trafficDetail.sort((a, b) => (a.day < b.day ? -1 : 1));
      }

      // naver_index 는 방문이 아니라 사이트 전체 색인 수 측정치다. get_recent_events RPC 는
      // metadata 를 평면 컬럼으로만 돌려줘 indexed 값을 못 준다 → REST 로 따로 읽어 붙인다.
      let _naverIdx = {};
      const naverIndexAt = (ts) => _naverIdx[String(ts || '').slice(0, 19)] || null;

      // 뭉게 실시간 방문 — 최근 3일치만. 30초 폴링으로 갱신한다.
      async function refreshMgLive() {
        const since = new Date(Date.now() - 3 * 864e5).toISOString();
        try {
          const r = await fetch(
            `${SUPABASE_URL}/rest/v1/analytics?event_type=eq.pageview_mg&created_at=gte.${since}` +
            `&select=created_at,path:metadata->>path,title:metadata->>title,ref:metadata->>referrer&order=created_at.desc&limit=3000`,
            { headers }
          );
          if (r.ok) { _mgLive = await r.json(); _mgLiveLoaded = true; }
        } catch {}
      }

      // 오늘(KST) 뭉게 방문을 경로별로 집계 — GA4 배치를 기다리지 않는 실시간 값
      function mgLiveToday() {
        const today = kstToday();
        const acc = {};
        for (const e of (_mgLive || [])) {
          const day = new Date(new Date(e.created_at).getTime() + 9 * 3600e3).toISOString().slice(0, 10);
          if (day !== today) continue;
          const path = (e.path || '/').split('?')[0] || '/';
          const a = (acc[path] ||= { key: path, path, title: e.title || '', sessions: 0, users: 0, views: 0, engaged: 0 });
          a.views++; a.sessions++; a.users++;
        }
        return Object.values(acc).sort((a, b) => b.views - a.views);
      }

      // 카드 병기용 보조 데이터 — GSC 뭉게 클릭(최근 7일), 뭉게 추천 이벤트, 네이버 색인 측정
      async function loadMunggeExtras() {
        const since = new Date(Date.now() - 8 * 864e5).toISOString().slice(0, 10);
        const get = (url) => fetch(url, { headers }).then((r) => (r.ok ? r.json() : [])).catch(() => []);
        const [gsc, likes, idx] = await Promise.all([
          get(`${SUPABASE_URL}/rest/v1/gsc_daily?source=eq.mg&page=eq._TOTAL_&date=gte.${since}&select=date,clicks,impressions&limit=200`),
          get(`${SUPABASE_URL}/rest/v1/analytics?event_type=eq.like&source=eq.mg&select=id&limit=5000`),
          get(`${SUPABASE_URL}/rest/v1/analytics?event_type=eq.naver_index&select=created_at,metadata&order=created_at.desc&limit=50`),
        ]);
        _gscMgRows = gsc; _mgLikes = likes;
        await refreshMgLive();
        _naverIdx = {};
        for (const r of idx) {
          const m = r.metadata || {};
          _naverIdx[String(r.created_at).slice(0, 19)] = {
            indexed: Number(m.indexed) || 0, site: m.site || '', blocked: !!m.blocked,
          };
        }
      }

      async function loadMunggeAll() {
        await Promise.all([ensureGa4Rows(), loadMunggePosts(), loadMunggeExtras()]);
        renderMunggeSection();
        applyMungge();
        mergeMgIntoDetail();
        if (typeof renderTrafficPanel === 'function' && _trafficDetail.length) renderTrafficPanel();
        renderTopPages();            // 뭉게 페이지를 Top Pages 에 합류
        renderEventFeed();           // naver_index 측정값(색인 N건) 반영
        if (_audienceRows) renderAudience(_audienceRows);   // 유입경로·기기 토글 반영
      }

      async function fetchAudience() {
        try {
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/analytics?event_type=eq.pageview&select=created_at,source,ref:metadata->>referrer,ua:metadata->>user_agent,utm:metadata->>utm_source,path:metadata->>path,title:metadata->>title&order=created_at.desc&limit=5000`,
            { headers }
          );
          if (!res.ok) return [];
          return await res.json();
        } catch { return []; }
      }

      async function fetchNewsletterCount() {
        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/analytics?event_type=eq.newsletter_subscribe&select=id&limit=2000`, { headers });
          const a = await res.json();
          return Array.isArray(a) ? a.length : 0;
        } catch { return 0; }
      }

      // 빈 referrer 를 user_agent 로 재분류 (메신저/SNS 인앱브라우저는 referrer 를 안 넘겨
      // 전부 '직접'으로 뭉치므로, UA 시그니처로 인앱 채널을 분리한다)
      function classifyInApp(ua) {
        const u = ua || '';
        if (/KAKAOTALK/i.test(u)) return { key: '카카오톡 인앱', kind: 'inapp' };
        if (/Instagram/i.test(u)) return { key: 'Instagram 인앱', kind: 'inapp' };
        if (/FBAN|FBAV|FB_IAB/i.test(u)) return { key: 'Facebook 인앱', kind: 'inapp' };
        if (/Line\//i.test(u)) return { key: 'LINE 인앱', kind: 'inapp' };
        if (/NAVER\(inapp/i.test(u)) return { key: 'Naver 앱', kind: 'inapp' };
        if (/DaumApps|DaumDevice/i.test(u)) return { key: 'Daum 앱', kind: 'inapp' };
        if (/BAND\//i.test(u)) return { key: 'Band 인앱', kind: 'inapp' };
        if (/Threads/i.test(u)) return { key: 'Threads 인앱', kind: 'inapp' };
        // 참조 없음 + 알려진 인앱 아님 → WebView 시그니처면 '앱 내(무참조)', 아니면 '직접/북마크'
        //  · Android WebView: UA 에 "; wv)" 토큰  · iOS 앱 WKWebView: iPhone/iPad + Mobile/ 인데 Safari 토큰 없음(브라우저는 항상 Safari 포함)
        if (/;\s?wv\)/.test(u) || (/(iPhone|iPad)/.test(u) && /Mobile\//.test(u) && !/Safari/.test(u))) return { key: '앱 내(무참조)', kind: 'appref' };
        return { key: '직접/북마크', kind: 'direct' };
      }

      // utm_source 문자열 → 채널 (수집단이 UTM 을 넘긴 신규 트래픽용, 최고 신뢰도)
      function classifyUtm(src) {
        const s = String(src).toLowerCase();
        if (/newsletter|email|mail/.test(s)) return { key: '이메일', kind: 'email' };
        if (/google|bing|yahoo|duckduckgo/.test(s)) return { key: s === 'google' ? 'Google' : src, kind: 'search' };
        if (/naver/.test(s)) return { key: 'Naver', kind: 'search' };
        if (/daum/.test(s)) return { key: 'Daum', kind: 'search' };
        if (/kakao/.test(s)) return { key: '카카오톡', kind: 'inapp' };
        if (/line/.test(s)) return { key: 'LINE', kind: 'inapp' };
        if (/band/.test(s)) return { key: 'Band', kind: 'inapp' };
        if (/facebook|instagram|threads|twitter|^x$|linkedin|youtube|reddit/.test(s)) return { key: src, kind: 'social' };
        return { key: src, kind: 'referral' };
      }

      // 유입경로 분류 — 우선순위: UTM > referrer 호스트 > (빈 referrer)UA 인앱감지 > 직접
      function classifyReferrer(ref, ua, utm) {
        if (utm) return classifyUtm(utm);
        if (!ref || ref === 'direct') return classifyInApp(ua);
        let host = ref;
        try { host = new URL(ref).hostname.replace(/^www\./, ''); } catch {}
        const h = host.toLowerCase();
        // 로컬/개발 트래픽
        if (h === 'localhost' || h === '127.0.0.1' || /^192\.168\.|^10\.|^172\.(1[6-9]|2\d|3[01])\./.test(h) || h.endsWith('.local')) return { key: '로컬/개발', kind: 'internal' };
        // 자기 도메인(내부 이동) → 직접 유입으로 합산(GA self-referral 처리)
        if (h.includes('ai-revenue-blog') || h.includes('life-revenue-blog')) return { key: '사이트 내 이동', kind: 'selfref' };
        if (h.includes('google')) return { key: 'Google', kind: 'search' };
        if (h.includes('naver')) return { key: 'Naver', kind: 'search' };
        if (h.includes('daum') || h.includes('kakao')) return { key: 'Daum/Kakao', kind: 'search' };
        if (h.includes('bing')) return { key: 'Bing', kind: 'search' };
        if (/facebook|instagram|t\.co|twitter|x\.com|threads|linkedin|youtube|reddit/.test(h)) return { key: host, kind: 'social' };
        return { key: host || '기타', kind: 'referral' };
      }

      // user_agent 파싱 → 기기/브라우저/OS
      function parseUA(ua) {
        ua = ua || '';
        let device = 'Desktop';
        if (/iPad|Tablet/i.test(ua)) device = 'Tablet';
        else if (/Mobi|iPhone|Android/i.test(ua)) device = 'Mobile';
        let browser = '기타';
        if (/Edg\//.test(ua)) browser = 'Edge';
        else if (/SamsungBrowser/.test(ua)) browser = 'Samsung';
        else if (/KAKAOTALK/i.test(ua)) browser = 'KakaoTalk';
        else if (/FBAN|FBAV|Instagram/.test(ua)) browser = 'In-App';
        else if (/Firefox\//.test(ua)) browser = 'Firefox';
        else if (/Chrome\//.test(ua)) browser = 'Chrome';
        else if (/Safari\//.test(ua)) browser = 'Safari';
        let os = '기타';
        if (/Windows/.test(ua)) os = 'Windows';
        else if (/iPhone|iPad|iOS/.test(ua)) os = 'iOS';
        else if (/Mac OS X/.test(ua)) os = 'macOS';
        else if (/Android/.test(ua)) os = 'Android';
        else if (/Linux/.test(ua)) os = 'Linux';
        return { device, browser, os };
      }

      // 막대 랭킹 렌더 (공용): items=[{name,count,color?}]
      function renderRankBars(containerId, items, opts) {
        const el = document.getElementById(containerId);
        if (!el) return;
        opts = opts || {};
        if (!items.length) { el.innerHTML = `<div class="no-data">${opts.empty || '데이터 없음'}</div>`; return; }
        const total = items.reduce((s, x) => s + x.count, 0) || 1;
        const max = items[0].count || 1;
        el.innerHTML = items.map(it => {
          const pct = Math.round(it.count / total * 100);
          const barPct = Math.max(Math.round(it.count / max * 100), 3);
          const color = it.color || opts.color || '#60a5fa';
          const nm = it.name.length > 14 ? it.name.slice(0,14)+'…' : it.name;
          return `<div class="cat-traffic-row">
            <span class="cat-traffic-name" title="${escHtml(it.name)}">${escHtml(nm)}</span>
            <div class="cat-traffic-bar-wrap"><div class="cat-traffic-bar" style="width:${barPct}%;background:${color}"></div></div>
            <span class="cat-traffic-value">${fmt(it.count)}</span>
            <span class="cat-traffic-share">${pct}%</span>
          </div>`;
        }).join('');
      }

      // SVG 도넛 (세그먼트 호버 가능, 큰 사이즈, 중앙 총합 텍스트)
      const DONUT_PALETTE = ['#60a5fa', '#4ade80', '#c084fc', '#facc15', '#f472b6', '#22d3ee', '#fb7185', '#94a3b8'];
      function donutArc(cx, cy, rO, rI, a0, a1) {
        const P = (r, a) => [cx + r * Math.cos(a), cy + r * Math.sin(a)];
        const large = (a1 - a0) > Math.PI ? 1 : 0;
        const [x0, y0] = P(rO, a0), [x1, y1] = P(rO, a1), [x2, y2] = P(rI, a1), [x3, y3] = P(rI, a0);
        return `M${x0.toFixed(2)} ${y0.toFixed(2)} A${rO} ${rO} 0 ${large} 1 ${x1.toFixed(2)} ${y1.toFixed(2)} L${x2.toFixed(2)} ${y2.toFixed(2)} A${rI} ${rI} 0 ${large} 0 ${x3.toFixed(2)} ${y3.toFixed(2)} Z`;
      }
      function renderDonut(containerId, items, opts) {
        const el = document.getElementById(containerId);
        if (!el) return;
        opts = opts || {};
        const list = items.filter(x => x.count > 0);
        if (!list.length) { el.innerHTML = `<div class="no-data">${opts.empty || '데이터 없음'}</div>`; return; }
        const total = list.reduce((s, x) => s + x.count, 0);
        const cx = 50, cy = 50, rO = 46, rI = 30;
        let a0 = -Math.PI / 2, segs = '';
        list.forEach((c, i) => {
          const color = c.color || DONUT_PALETTE[i % DONUT_PALETTE.length];
          const frac = c.count / total;
          const pctTxt = Math.round(frac * 100);
          const attrs = `class="donut-seg" data-name="${escHtml(c.name)}" data-val="${c.count}" data-pct="${pctTxt}" data-color="${color}"`;
          if (list.length === 1) {
            segs += `<circle cx="${cx}" cy="${cy}" r="${(rO + rI) / 2}" fill="none" stroke="${color}" stroke-width="${rO - rI}" ${attrs}/>`;
          } else {
            const a1 = a0 + frac * 2 * Math.PI;
            const gap = 0.028;
            segs += `<path d="${donutArc(cx, cy, rO, rI, a0 + gap, a1 - gap)}" fill="${color}" ${attrs}/>`;
            a0 = a1;
          }
        });
        const legend = list.map((c, i) => {
          const color = c.color || DONUT_PALETTE[i % DONUT_PALETTE.length];
          const nm = c.name.length > 14 ? c.name.slice(0, 14) + '…' : c.name;
          return `<div class="cat-legend-item">
            <span class="cat-legend-dot" style="background:${color}"></span>
            <span class="cat-legend-name" title="${escHtml(c.name)}">${escHtml(nm)}</span>
            <span class="cat-legend-count">${fmt(c.count)}</span>
            <span class="cat-legend-pct">${Math.round(c.count / total * 100)}%</span>
          </div>`;
        }).join('');
        el.innerHTML = `<div class="cat-donut-wrap">
          <div class="donut-svg-wrap">
            <svg viewBox="0 0 100 100" class="donut-svg">${segs}</svg>
            <div class="donut-center"><span class="donut-num">${fmt(total)}</span><span class="donut-label">${opts.label || ''}</span></div>
          </div>
          <div class="cat-legend">${legend}</div>
        </div>`;
        // 세그먼트 호버 툴팁 (직접 바인딩)
        const tip = ensureDonutTip();
        el.querySelectorAll('.donut-seg').forEach(seg => {
          seg.addEventListener('mouseenter', () => {
            tip.innerHTML = `<span class="dt-dot" style="background:${seg.dataset.color}"></span><b>${escHtml(seg.dataset.name)}</b> ${fmt(+seg.dataset.val)} · ${seg.dataset.pct}%`;
            tip.style.display = 'flex';
          });
          seg.addEventListener('mousemove', (e) => {
            tip.style.left = (e.clientX + 14) + 'px';
            tip.style.top = (e.clientY + 14) + 'px';
          });
          seg.addEventListener('mouseleave', () => { tip.style.display = 'none'; });
        });
      }

      function ensureDonutTip() {
        let tip = document.getElementById('donut-tip');
        if (!tip) { tip = document.createElement('div'); tip.id = 'donut-tip'; tip.className = 'donut-tip'; document.body.appendChild(tip); }
        return tip;
      }

      const REF_COLORS = { direct: '#94a3b8', search: '#60a5fa', social: '#f472b6', referral: '#4ade80', internal: '#64748b', inapp: '#fbbf24', selfref: '#a78bfa', appref: '#fb923c', email: '#818cf8' };
      const DEV_COLORS = { Mobile: '#60a5fa', Desktop: '#c084fc', Tablet: '#facc15' };
      const OS_COLORS = { Windows: '#60a5fa', macOS: '#c084fc', Android: '#4ade80', iOS: '#f472b6', Linux: '#facc15', 기타: '#94a3b8' };
      const BR_COLORS = { Chrome: '#60a5fa', Safari: '#4ade80', Edge: '#22d3ee', Firefox: '#fb923c', Samsung: '#c084fc', KakaoTalk: '#facc15', 'In-App': '#f472b6', 기타: '#94a3b8' };

      let _audDist = { device: [], browser: [], os: [] };
      let _audActive = 'device';
      const AUD_LABEL = { device: '기기', browser: '브라우저', os: 'OS' };

      // 소스 토글 — 블로그(analytics: referrer·user_agent 파싱)와 뭉게(GA4 차원)는 분류
      // 기준이 달라 한 도넛에 섞으면 오해를 부른다. '전체'는 두 집계를 합쳐 보여주되
      // 각각만 보고 싶을 때 분리할 수 있게 한다.
      let _refSrc = 'all';   // all | blog | mg
      let _audSrc = 'all';

      // ga4_daily 의 dim 을 도넛 입력 모양({name,count,color})으로 변환
      function mgDonutArr(dim, colors, koFn) {
        if (!Array.isArray(_ga4Rows)) return [];
        return mgAgg(dim)
          .filter((r) => r.key && r.key !== '(not set)')
          .map((r) => {
            const name = koFn ? koFn(r.key) : r.key;
            return { name, count: r.views || r.sessions, color: colors && colors[name] };
          })
          .filter((r) => r.count > 0);
      }

      // 같은 이름끼리 합산 후 상위 N — 블로그+뭉게 '전체' 병합용
      function mergeDonut(a, b, limit) {
        const acc = {};
        for (const r of [...a, ...b]) {
          const cur = (acc[r.name] ||= { name: r.name, count: 0, color: r.color });
          cur.count += r.count;
          if (!cur.color && r.color) cur.color = r.color;
        }
        return Object.values(acc).sort((x, y) => y.count - x.count).slice(0, limit);
      }

      function renderAudience(rows) {
        if (rows !== undefined) _audienceRows = Array.isArray(rows) ? rows : [];
        // 유입경로 도넛
        const refBy = {};
        _audienceRows.forEach(r => {
          const c = classifyReferrer(r.ref, r.ua, r.utm);
          if (!refBy[c.key]) refBy[c.key] = { name: c.key, count: 0, color: REF_COLORS[c.kind] };
          refBy[c.key].count++;
        });
        const blogRef = Object.values(refBy).sort((a, b) => b.count - a.count);
        const mgRef = mgDonutArr('channel', null, (k) => (typeof ga4ChKo === 'function' ? ga4ChKo(k) : k));
        const refArr = _refSrc === 'blog' ? blogRef.slice(0, 8)
          : _refSrc === 'mg' ? mgRef.slice(0, 8)
          : mergeDonut(blogRef, mgRef, 8);
        renderDonut('ref-bars', refArr, { empty: '유입 데이터 없음', label: '유입' });
        // 기기/브라우저/OS 집계 저장 후 활성 항목만 도넛
        const dev = {}, br = {}, os = {};
        _audienceRows.forEach(r => {
          const p = parseUA(r.ua);
          dev[p.device] = (dev[p.device] || 0) + 1;
          br[p.browser] = (br[p.browser] || 0) + 1;
          os[p.os] = (os[p.os] || 0) + 1;
        });
        const toArr = (o, colors) => Object.entries(o).map(([name, count]) => ({ name, count, color: colors && colors[name] })).sort((a, b) => b.count - a.count);
        const blogDist = { device: toArr(dev, DEV_COLORS), browser: toArr(br, BR_COLORS), os: toArr(os, OS_COLORS) };
        // GA4 표기를 블로그 쪽 라벨과 맞춘다(desktop→Desktop 등). 안 맞추면 같은 기기가 두 조각이 된다.
        const cap = (s) => String(s || '').charAt(0).toUpperCase() + String(s || '').slice(1);
        const mgDist = {
          device: mgDonutArr('device', DEV_COLORS, cap),
          browser: mgDonutArr('browser', BR_COLORS, null),
          os: mgDonutArr('os', OS_COLORS, null),
        };
        const pick = (k, limit) => _audSrc === 'blog' ? blogDist[k].slice(0, limit)
          : _audSrc === 'mg' ? mgDist[k].slice(0, limit)
          : mergeDonut(blogDist[k], mgDist[k], limit);
        _audDist = { device: pick('device', 8), browser: pick('browser', 7), os: pick('os', 7) };
        renderAudienceDonut();
      }

      function renderAudienceDonut() {
        renderDonut('audience-donut', _audDist[_audActive] || [], { empty: '데이터 없음', label: AUD_LABEL[_audActive] });
      }

      // === 전환 퍼널 + 목표 ===
      function renderFunnelGoals() {
        const pv = _funnelCounts.pageviews || 0;
        const cc = _funnelCounts.coupang || 0;
        const nl = _funnelCounts.newsletter || 0;
        const pdc = _funnelCounts.paperdoc || 0;
        const el = document.getElementById('funnel-steps');
        if (el) {
          // 전환율이 1% 미만이라 비례 막대는 사실상 안 보임 → 숫자 중심 세로 플로우로 표시
          // (페이지뷰 → 전환율 → 쿠팡 클릭). 각 수치를 크게, 단계 사이에 전환율을 배지로.
          const cvr = pv > 0 ? (cc / pv * 100) : 0;
          el.innerHTML = `
            <div class="funnel-flow2">
              <div class="funnel-steps-left">
                <div class="funnel-node">
                  <div class="funnel-node-count">${fmt(pv)}</div>
                  <div class="funnel-node-label">페이지뷰</div>
                </div>
                <span class="funnel-arrow2">→</span>
                <div class="funnel-node">
                  <div class="funnel-node-count" style="color:#f59e0b">${fmt(cc)}</div>
                  <div class="funnel-node-label">쿠팡 클릭</div>
                </div>
              </div>
              <div class="funnel-rate-box">
                <div class="funnel-rate-val">${cvr.toFixed(2)}%</div>
                <div class="funnel-rate-cap">전환율</div>
              </div>
            </div>`;
        }
        const gc = document.getElementById('goal-cards');
        if (gc) {
          const goals = [
            { name: '쿠팡 클릭', count: cc, color: '#facc15' },
            { name: '페이퍼닥 클릭', count: pdc, color: '#60a5fa' },
            { name: '뉴스레터 구독', count: nl, color: '#4ade80' },
          ];
          gc.innerHTML = goals.map(g => {
            const rate = pv > 0 ? (g.count / pv * 100).toFixed(2) : '0.00';
            return `<div class="goal-card">
              <div class="goal-name">${g.name}</div>
              <div class="goal-val" style="color:${g.color}">${fmt(g.count)}</div>
              <div class="goal-rate">전환율 ${rate}%</div>
            </div>`;
          }).join('');
        }
      }

      // === AI 인사이트 한 줄 (규칙 기반) ===
      function computeInsight() {
        const el = document.getElementById('ai-insight');
        if (!el) return;
        const map = {};
        _trafficDetail.forEach(d => { if (d.day) map[d.day] = Number(d.views) || 0; });
        const sum = (start, len) => { let s = 0; for (let i = 0; i < len; i++) { const k = new Date(Date.now() + 9 * 3600000 - (start + i) * 86400000).toISOString().split('T')[0]; s += map[k] || 0; } return s; };
        const last7 = sum(0, 7), prev7 = sum(7, 7);
        let trend;
        if (prev7 > 0) { const p = Math.round((last7 - prev7) / prev7 * 100); trend = p >= 0 ? `지난주 대비 <b style="color:#4ade80">+${p}%</b>` : `지난주 대비 <b style="color:#f87171">${p}%</b>`; }
        else trend = '<b>집계 초기</b>';
        let topRef = '';
        if (_audienceRows.length) {
          const by = {}; _audienceRows.forEach(r => { const c = classifyReferrer(r.ref, r.ua, r.utm); by[c.key] = (by[c.key] || 0) + 1; });
          const top = Object.entries(by).sort((a, b) => b[1] - a[1])[0];
          if (top) topRef = ` · 최다 유입 <b>${top[0]}</b>`;
        }
        const pv = _funnelCounts.pageviews || 0, cc = _funnelCounts.coupang || 0;
        const cvr = pv > 0 ? (cc / pv * 100).toFixed(2) : '0.00';
        const bulb = '<svg viewBox="0 0 24 24" fill="none" stroke="#facc15" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:1.05rem;height:1.05rem;flex-shrink:0"><path d="M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7c.6.5 1 1.3 1 2.1V17h6v-.2c0-.8.4-1.6 1-2.1A7 7 0 0 0 12 2z"/></svg>';
        el.innerHTML = `${bulb}<span>최근 7일 조회 <b>${fmt(last7)}</b> (${trend})${topRef} · 쿠팡 전환율 <b>${cvr}%</b></span>`;
      }

      // === CSV 내보내기 (현재 방문 추이 기간) ===
      function exportTrafficCSV() {
        const buckets = _trafficBuckets || [];
        if (!buckets.length) return;
        const head = ['기간', '조회수', '방문자', 'TF', 'LF', '웹', '모바일'];
        const lines = [head.join(',')].concat(
          buckets.slice().reverse().map(b => [b.label, b.views, b.visitors, b.tf, b.lf, b.web || 0, b.mobile || 0].join(','))
        );
        const blob = new Blob(['﻿' + lines.join('\n')], { type: 'text/csv;charset=utf-8' });
        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `traffic-${_trafficPeriod}-${new Date().toISOString().split('T')[0]}.csv`;
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(a.href);
      }

      // === 쿠팡 상품별 클릭 (analytics 테이블 직접 조회 → metadata.product 집계) ===
      // 과거 인라인 링크는 affiliate_click 으로 기록됐어서(트래커 통일 전) 두 타입 모두 조회
      async function fetchCoupangProducts() {
        try {
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/analytics?or=(event_type.eq.coupang_click,event_type.eq.affiliate_click)&metadata->>__probe=is.null&select=metadata,source,created_at&order=created_at.desc&limit=2000`,
            { headers }
          );
          if (!res.ok) return [];
          const rows = await res.json();
          // affiliate_click 중 쿠팡 외 대상 제외 + 필드 정규화(label/href → product/url)
          return (Array.isArray(rows) ? rows : []).filter(r => {
            const m = r.metadata || {};
            return m.target === undefined || m.target === 'coupang';
          }).map(r => {
            const m = r.metadata || {};
            return { ...r, metadata: { ...m, product: m.product || m.label || '', url: m.url || m.href || '' } };
          });
        } catch { return []; }
      }

      function renderCoupangProducts(rows) {
        const container = document.getElementById('coupang-products');
        const totalEl = document.getElementById('coup-prod-total');
        if (!container) return;
        const list = Array.isArray(rows) ? rows : [];
        if (!list.length) {
          container.innerHTML = '<div class="no-data">아직 상품 클릭 데이터가 없습니다. 🛒</div>';
          if (totalEl) totalEl.textContent = '';
          return;
        }
        const by = {};
        const todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().split('T')[0];
        list.forEach(r => {
          const m = r.metadata || {};
          const p = m.product || '(상품 미상)';
          if (!by[p]) by[p] = { product: p, count: 0, today: 0, url: m.url || '' };
          by[p].count++;
          const day = new Date(new Date(r.created_at).getTime() + 9 * 3600 * 1000).toISOString().split('T')[0];
          if (day === todayKst) by[p].today++;
        });
        const arr = Object.values(by).sort((a, b) => b.count - a.count);
        const total = arr.reduce((s, x) => s + x.count, 0);
        if (totalEl) totalEl.textContent = `(총 ${fmt(total)}클릭 · ${arr.length}종)`;
        const max = arr[0].count || 1;
        container.innerHTML = arr.map((p, i) => {
          const barPct = Math.max(Math.round((p.count / max) * 100), 4);
          const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}`;
          const name = p.product.length > 42 ? p.product.slice(0, 42) + '…' : p.product;
          const safe = safeUrl(p.url);
          const nameEl = safe
            ? `<a href="${escHtml(safe)}" target="_blank" rel="noopener" class="top-page-title" title="${escHtml(p.product)}">${escHtml(name)}</a>`
            : `<span class="top-page-title" title="${escHtml(p.product)}">${escHtml(name)}</span>`;
          const todayBadge = p.today > 0 ? `<span class="delta-chip up" style="margin-left:0;">오늘 +${p.today}</span>` : '';
          return `<div class="like-top-item">
            <span class="top-page-rank">${medal}</span>
            ${nameEl}
            ${todayBadge}
            <div class="like-bar-wrap"><div class="like-bar-fill" style="width:${barPct}%;background:linear-gradient(90deg,#ea580c,#facc15)"></div></div>
            <span class="like-top-count" style="color:#facc15">${fmt(p.count)}</span>
          </div>`;
        }).join('');
      }

      // === 쿠팡 클릭 트래킹 피드 (어떤 포스팅에서 어떤 링크를 클릭했는지 상세) ===
      function renderCoupangFeed(rows) {
        const container = document.getElementById('coupang-events');
        if (!container) return;
        const list = (Array.isArray(rows) ? rows : []).slice(0, 20);
        if (!list.length) {
          container.innerHTML = '<div class="no-data">아직 쿠팡 클릭 데이터가 없습니다.</div>';
          return;
        }
        container.innerHTML = list.map(r => {
          const m = r.metadata || {};
          const prod = m.product || '(상품 미상)';
          const postTitle = getPageTitle({ title: m.title, slug: m.slug, path: m.path });
          const path = m.path || (m.slug ? `/blog/${m.slug}/` : '');
          const src = r.source === 'lifeflow' ? 'lifeflow' : 'blog';
          const prodTxt = escHtml(prod.length > 44 ? prod.slice(0,44)+'…' : prod);
          const safe = safeUrl(m.url);
          const prodEl = safe
            ? `<a href="${escHtml(safe)}" target="_blank" rel="noopener" class="event-action" style="color:#facc15" title="${escHtml(m.url)}">🔗 ${prodTxt}</a>`
            : `<div class="event-action" style="color:#facc15">${prodTxt}</div>`;
          return `<div class="event-item">
            <span class="event-icon coupang_click">🛒</span>
            <div class="event-content">
              ${prodEl}
              <div class="event-page-title" title="${escHtml(path)}">${sourceBadge(src)} 📄 ${escHtml(postTitle.length > 40 ? postTitle.slice(0,40)+'…' : postTitle)}</div>
            </div>
            <span class="event-time">${timeAgo(r.created_at)}</span>
          </div>`;
        }).join('');
      }

      // === 페이퍼닥 프로모 클릭 (analytics 직접 조회 → source·placement 집계) ===
      async function fetchPaperdocClicks() {
        try {
          const res = await fetch(
            `${SUPABASE_URL}/rest/v1/analytics?event_type=eq.paperdoc_click&metadata->>__probe=is.null&select=metadata,source,created_at&order=created_at.desc&limit=2000`,
            { headers }
          );
          if (!res.ok) return [];
          const rows = await res.json();
          return Array.isArray(rows) ? rows : [];
        } catch { return []; }
      }

      const PD_PLACE_LABEL = { popup: '홈 팝업', banner: '가로 배너', side: '사이드 배너', other: '기타' };
      const PD_PERIOD_LABEL = { day: '일간', week: '주간', month: '월간', all: '전체' };
      const PD_PERIOD_DETAIL = { day: '오늘', week: '최근 7일', month: '최근 30일', all: '누적' };

      // 기간 필터: KST 자정 기준 오늘 / 최근 7일 / 최근 30일 / 전체
      let _paperdocRows = [];
      let _paperdocPeriod = 'all';

      function paperdocInWindow(ts, period) {
        if (period === 'all') return true;
        const nowMs = Date.now();
        if (period === 'week') return new Date(ts).getTime() >= nowMs - 7 * 86400000;
        if (period === 'month') return new Date(ts).getTime() >= nowMs - 30 * 86400000;
        // day = KST 오늘
        const todayKst = new Date(nowMs + 9 * 3600 * 1000).toISOString().split('T')[0];
        const dayOf = new Date(new Date(ts).getTime() + 9 * 3600 * 1000).toISOString().split('T')[0];
        return dayOf === todayKst;
      }

      // 기간 토글 진입점: rows/period 갱신 후 카드·위치·피드 일괄 재렌더
      function renderPaperdoc(rows, period) {
        if (rows !== undefined) _paperdocRows = Array.isArray(rows) ? rows : [];
        if (period !== undefined) _paperdocPeriod = period;
        renderPaperdocSummary();   // 전체요약 상단 카드(누적·오늘) — 기간 토글 무관
        const filtered = _paperdocRows.filter(r => paperdocInWindow(r.created_at, _paperdocPeriod));
        renderPaperdocStats(filtered);
        renderPaperdocPlacements(filtered);
        renderPaperdocFeed(filtered);
      }

      // 전체요약 탭 상단 요약 카드: 누적 클릭 + 오늘 증분
      function renderPaperdocSummary() {
        const todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().split('T')[0];
        const dayOf = (ts) => new Date(new Date(ts).getTime() + 9 * 3600 * 1000).toISOString().split('T')[0];
        let total = 0, today = 0;
        _paperdocRows.forEach(r => { total++; if (dayOf(r.created_at) === todayKst) today++; });
        const clicksEl = document.getElementById('pd-summary-clicks');
        const subEl = document.getElementById('pd-summary-sub');
        if (clicksEl) clicksEl.textContent = fmt(total);
        if (subEl) subEl.textContent = today > 0 ? `today +${fmt(today)}` : 'Waiting...';
        setDeltaChip('pd-summary-delta', today, null, today > 0 ? `+${fmt(today)} today` : '—');
      }

      function renderPaperdocStats(list) {
        const bySrc = { blog: 0, lifeflow: 0, gameflow: 0 };
        let total = 0;
        (list || []).forEach(r => { total++; if (bySrc[r.source] !== undefined) bySrc[r.source]++; });
        const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
        const share = (n) => total > 0 ? `${Math.round(n / total * 100)}%` : '0%';
        set('pd-total-label', `${PD_PERIOD_LABEL[_paperdocPeriod]} 클릭 수`);
        set('pd-total-detail', `${PD_PERIOD_DETAIL[_paperdocPeriod]} 페이퍼닥 클릭`);
        set('pd-total-clicks', fmt(total));
        set('pd-tf-clicks', fmt(bySrc.blog));
        set('pd-lf-clicks', fmt(bySrc.lifeflow));
        set('pd-gf-clicks', fmt(bySrc.gameflow));
        set('pd-tf-detail', `비중 ${share(bySrc.blog)}`);
        set('pd-lf-detail', `비중 ${share(bySrc.lifeflow)}`);
        set('pd-gf-detail', `비중 ${share(bySrc.gameflow)}`);
      }

      function renderPaperdocPlacements(rows) {
        const container = document.getElementById('paperdoc-placements');
        const totalEl = document.getElementById('pd-place-total');
        if (!container) return;
        const list = Array.isArray(rows) ? rows : [];
        if (!list.length) {
          container.innerHTML = '<div class="no-data">아직 페이퍼닥 클릭 데이터가 없습니다. 📄</div>';
          if (totalEl) totalEl.textContent = '';
          return;
        }
        const by = {};
        list.forEach(r => {
          const p = (r.metadata && r.metadata.placement) || 'other';
          by[p] = (by[p] || 0) + 1;
        });
        const arr = Object.entries(by).map(([k, v]) => ({ key: k, count: v })).sort((a, b) => b.count - a.count);
        const total = arr.reduce((s, x) => s + x.count, 0);
        if (totalEl) totalEl.textContent = `(총 ${fmt(total)}클릭 · ${arr.length}종)`;
        const max = arr[0].count || 1;
        container.innerHTML = arr.map((p, i) => {
          const barPct = Math.max(Math.round((p.count / max) * 100), 4);
          const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}`;
          const name = escHtml(PD_PLACE_LABEL[p.key] || p.key);
          return `<div class="like-top-item">
            <span class="top-page-rank">${medal}</span>
            <span class="top-page-title" title="${name}">${name}</span>
            <div class="like-bar-wrap"><div class="like-bar-fill" style="width:${barPct}%;background:linear-gradient(90deg,#a855f7,#facc15)"></div></div>
            <span class="like-top-count" style="color:#d8b4fe">${fmt(p.count)}</span>
          </div>`;
        }).join('');
      }

      function renderPaperdocFeed(rows) {
        const container = document.getElementById('paperdoc-events');
        if (!container) return;
        const list = (Array.isArray(rows) ? rows : []).slice(0, 20);
        if (!list.length) {
          container.innerHTML = '<div class="no-data">아직 페이퍼닥 클릭 데이터가 없습니다.</div>';
          return;
        }
        container.innerHTML = list.map(r => {
          const m = r.metadata || {};
          const place = escHtml(PD_PLACE_LABEL[m.placement] || m.placement || '기타');
          const postTitle = getPageTitle({ title: m.title, slug: m.slug, path: m.path });
          const path = m.path || (m.slug ? `/blog/${m.slug}/` : '');
          return `<div class="event-item">
            <span class="event-icon paperdoc_click">📄</span>
            <div class="event-content">
              <div class="event-action" style="color:#d8b4fe">${place}</div>
              <div class="event-page-title" title="${escHtml(path)}">${sourceBadge(r.source)} 📄 ${escHtml(postTitle.length > 40 ? postTitle.slice(0,40)+'…' : postTitle)}</div>
            </div>
            <span class="event-time">${timeAgo(r.created_at)}</span>
          </div>`;
        }).join('');
      }

      // === 추천 TOP 렌더링 ===
      function renderTopLikedPosts(data) {
        const container = document.getElementById('top-liked-posts');
        const totalEl = document.getElementById('like-top-total');
        if (!container) return;

        const list = Array.isArray(data) ? data : [];

        if (list.length === 0) {
          container.innerHTML = '<div class="no-data">아직 추천 데이터가 없습니다 &#10084;</div>';
          if (totalEl) totalEl.textContent = '';
          return;
        }

        const totalLikes = list.reduce((s, p) => s + Number(p.like_count || 0), 0);
        if (totalEl) totalEl.textContent = `(총 ${fmt(totalLikes)}개)`;

        container.innerHTML = list.map((p, i) => {
          const title = p.title && p.title !== 'null'
            ? p.title.split(' | ')[0].split(' - ')[0]
            : decodeSlug(p.slug || p.path || '');
          const displayTitle = title.length > 40 ? title.substring(0, 40) + '…' : title;
          const count = Number(p.like_count || 0);
          const maxCount = Number(list[0].like_count || 1);
          const barPct = Math.max(Math.round((count / maxCount) * 100), 4);
          const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}`;
          return `<div class="like-top-item">
            <span class="top-page-rank">${medal}</span>
            ${sourceBadge(p.source)}
            <span class="top-page-title" title="${escHtml(title)}">${escHtml(displayTitle) || '(홈)'}</span>
            <div class="like-bar-wrap">
              <div class="like-bar-fill" style="width:${barPct}%"></div>
            </div>
            <span class="like-top-count">&#10084; ${fmt(count)}</span>
          </div>`;
        }).join('');
      }

      // === 카테고리별 트래픽 렌더링 ===
      function renderCategoryTraffic() {
        const tfColors = { 'AI': '#3b82f6', 'Dev': '#16a34a', 'Review': '#bf8700', 'Game': '#a855f7' };
        const lfColors = {
          'Lifestyle': '#ec4899', 'Finance': '#3b82f6',
          'Health': '#16a34a', 'Education': '#a855f7', 'Travel': '#ea580c',
        };

        const tfCatViews = {};
        const lfCatViews = {};

        _topPagesData.forEach(p => {
          const rawSlug = (p.slug || p.path || '').replace(/^\/blog\//, '').replace(/\/$/, '');
          const slug = decodeURIComponent(rawSlug);

          // TechFlow 매칭: TF_SLUG_CAT에서 찾기
          const tfCat = TF_SLUG_CAT[slug] || TF_SLUG_CAT[rawSlug];
          if (tfCat) {
            tfCatViews[tfCat] = (tfCatViews[tfCat] || 0) + (p.views || 0);
            return;
          }

          // LifeFlow 매칭: 빌드타임 slug→category 맵 우선, 그 뒤 최신 RSS 데이터
          const rssPost = lfRssData.find(rp => {
            const rssSlug = (rp.link || '').split('/').filter(Boolean).pop() || '';
            return slug.includes(rssSlug) || rssSlug.includes(slug);
          });
          const lfCat = LF_SLUG_CAT[slug] || LF_SLUG_CAT[rawSlug] || rssPost?.category || '';
          if (lfCat) {
            const capCat = lfCat.charAt(0).toUpperCase() + lfCat.slice(1);
            lfCatViews[capCat] = (lfCatViews[capCat] || 0) + (p.views || 0);
          }
        });

        // TechFlow 바 렌더링
        const tfContainer = document.getElementById('tf-cat-traffic-bars');
        if (tfContainer) {
          const tfEntries = Object.entries(tfCatViews).sort((a, b) => b[1] - a[1]);
          const tfMax = tfEntries.length > 0 ? tfEntries[0][1] : 1;
          const tfTotal = tfEntries.reduce((s, [, v]) => s + v, 0);

          if (tfEntries.length === 0) {
            tfContainer.innerHTML = '<div class="no-data">아직 트래픽 데이터가 없습니다</div>';
          } else {
            tfContainer.innerHTML = tfEntries.map(([cat, views]) => {
              const pct = Math.max((views / tfMax) * 100, 8);
              const color = tfColors[cat] || '#94a3b8';
              const share = tfTotal > 0 ? Math.round(views / tfTotal * 100) : 0;
              return `<div class="cat-traffic-row">
                <span class="cat-traffic-name">${cat}</span>
                <div class="cat-traffic-bar-wrap">
                  <div class="cat-traffic-bar" style="width:${pct}%;background:${color}"></div>
                </div>
                <span class="cat-traffic-value">${fmt(views)}회</span>
                <span class="cat-traffic-share">${share}%</span>
              </div>`;
            }).join('');
          }
        }

        // LifeFlow 바 렌더링
        const lfContainer = document.getElementById('lf-cat-traffic-bars');
        if (lfContainer) {
          const lfEntries = Object.entries(lfCatViews).sort((a, b) => b[1] - a[1]);
          const lfMax = lfEntries.length > 0 ? lfEntries[0][1] : 1;
          const lfTotal = lfEntries.reduce((s, [, v]) => s + v, 0);

          if (lfEntries.length === 0) {
            lfContainer.innerHTML = '<div class="no-data">아직 트래픽 데이터가 없습니다</div>';
          } else {
            lfContainer.innerHTML = lfEntries.map(([cat, views]) => {
              const pct = Math.max((views / lfMax) * 100, 8);
              const color = lfColors[cat] || '#94a3b8';
              const share = lfTotal > 0 ? Math.round(views / lfTotal * 100) : 0;
              return `<div class="cat-traffic-row">
                <span class="cat-traffic-name">${cat}</span>
                <div class="cat-traffic-bar-wrap">
                  <div class="cat-traffic-bar" style="width:${pct}%;background:${color}"></div>
                </div>
                <span class="cat-traffic-value">${fmt(views)}회</span>
                <span class="cat-traffic-share">${share}%</span>
              </div>`;
            }).join('');
          }
        }
      }

      // === Event Feed 전역 데이터 & 필터 ===
      let _eventsData = [];
      let _eventsFilter = 'all';

      // 이벤트 → 해당 글 URL. ?admin=1 을 붙여 내 확인 방문이 집계에 잡히지 않게 한다
      // (BaseLayout 트래커가 admin=1 을 보면 localStorage 에 notrack 플래그를 저장)
      const SITE_BY_SOURCE = {
        blog: 'https://ai-revenue-blog.vercel.app',
        lifeflow: 'https://life-revenue-blog.vercel.app',
        vip: 'https://virtual-in-playing.vercel.app',
        mg: 'https://mungge.com',
      };

      function eventLink(e) {
        const base = SITE_BY_SOURCE[e.source] || SITE_BY_SOURCE.blog;
        const m = e.metadata || {};
        let path = e.path || m.path || '';
        if (!path) {
          const slug = e.slug || m.slug || '';
          path = slug ? `/blog/${slug}/` : '/';
        }
        if (!path.startsWith('/')) path = '/' + path;
        return `${base}${path}${path.includes('?') ? '&' : '?'}admin=1`;
      }

      function renderEventFeed(data, filter) {
        if (data !== undefined) _eventsData = data || [];
        if (filter !== undefined) _eventsFilter = filter;

        const container = document.getElementById('event-feed');
        if (!container) return;

        let filtered = _eventsData;
        if (_eventsFilter !== 'all') {
          filtered = filtered.filter(e => e.source === _eventsFilter);
        }

        if (filtered.length === 0) {
          container.innerHTML = '<div class="no-data">No events yet. Visit the blog to generate data!</div>';
          return;
        }

        container.innerHTML = filtered.slice(0, 12).map(e => {
          const icon = EVENT_ICONS[e.event_type] || '\u2022';
          const label = EVENT_LABELS[e.event_type] || e.event_type;
          const title = getPageTitle(e);
          const shortTitle = title.length > 35 ? title.substring(0, 35) + '…' : title;
          const srcBadge = sourceBadge(e.source);
          // 이메일(뉴스레터) 유입 표시 — utm_source=newsletter 인 방문
          const utmSrc = (e.metadata && e.metadata.utm_source) || e.utm || '';
          const emailTag = /newsletter|email|mail/i.test(utmSrc)
            ? '<span class="ev-email-tag">📧 이메일</span>'
            : '';
          const isCoup = e.event_type === 'coupang_click';
          const prod = isCoup ? (e.product || (e.metadata && e.metadata.product) || '') : '';
          // 색인 측정은 페이지가 없다 → 글 제목 자리에 실제 측정값을 넣고 링크도 걸지 않는다
          const isIdx = e.event_type === 'naver_index';
          const idx = isIdx ? naverIndexAt(e.created_at) : null;
          const detail = isIdx
            ? `<div class="event-page-title" style="color:#fbbf24">${idx ? `색인 ${fmt(idx.indexed)}건` : '색인 측정'} · 사이트 전체</div>`
            : isCoup && prod
            ? `<div class="event-page-title" title="${escHtml(prod)}" style="color:#facc15">🛒 ${escHtml(prod.length > 30 ? prod.slice(0,30)+'…' : prod)}</div>`
            : `<div class="event-page-title" title="${escHtml(title)}">${escHtml(shortTitle) || '홈페이지'}</div>`;

          // 유입 원문 — "네이버 블로그 어느 글에서 왔나"가 여기 남는다.
          // 같은 사이트 내부 이동과 direct 는 노이즈라 제외한다.
          const ref = String(e.referrer || (e.metadata && e.metadata.referrer) || '');
          const refHost = /^https?:\/\//.test(ref) ? ref.replace(/^https?:\/\//, '').split('/')[0] : '';
          const isSelf = refHost && Object.values(SITE_BY_SOURCE || {}).some((s) => String(s).includes(refHost));
          const refLine = refHost && !isSelf
            ? `<div class="event-ref" title="${escHtml(ref)}">↩ ${escHtml(ref.length > 46 ? ref.slice(0, 46) + '…' : ref)}</div>`
            : '';

          const inner = `<span class="event-icon ${escHtml(e.event_type)}">${icon}</span>
            <div class="event-content">
              <div class="event-action">${srcBadge} ${escHtml(label)}${emailTag}</div>
              ${detail}${refLine}
            </div>
            <span class="event-time">${timeAgo(e.created_at)}</span>`;
          return isIdx
            ? `<div class="event-item" title="네이버 site: 검색 결과 수 — 글 단위가 아니라 사이트 전체 집계">${inner}</div>`
            : `<a class="event-item event-link" href="${escHtml(safeUrl(eventLink(e)))}" target="_blank" rel="noopener" title="글 열기 (집계 제외)">${inner}</a>`;
        }).join('');
      }

      // 소스 필터 탭 이벤트
      document.getElementById('top-pages-tabs')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.source-tab');
        if (!btn) return;
        document.querySelectorAll('#top-pages-tabs .source-tab').forEach(b => b.className = 'source-tab');
        const f = btn.dataset.filter;
        btn.className = 'source-tab ' + (f === 'blog' ? 'active-tf' : f === 'lifeflow' ? 'active-lf' : f === 'vip' ? 'active-vip' : f === 'mg' ? 'active-mg' : 'active');
        renderTopPages(undefined, f);
      });

      // Top Pages 기간 토글 (전체/일/주/월)
      document.getElementById('top-pages-period')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        document.querySelectorAll('#top-pages-period .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        renderTopPages(undefined, undefined, btn.dataset.tp);
      });

      document.getElementById('pd-period')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        document.querySelectorAll('#pd-period .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        renderPaperdoc(undefined, btn.dataset.pd);
      });

      document.getElementById('tools-period')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        document.querySelectorAll('#tools-period .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        renderTools(btn.dataset.tp);
      });

      document.getElementById('event-tabs')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.source-tab');
        if (!btn) return;
        document.querySelectorAll('#event-tabs .source-tab').forEach(b => b.className = 'source-tab');
        const f = btn.dataset.filter;
        btn.className = 'source-tab ' + (f === 'blog' ? 'active-tf' : f === 'lifeflow' ? 'active-lf' : f === 'vip' ? 'active-vip' : f === 'mg' ? 'active-mg' : 'active');
        renderEventFeed(undefined, f);
      });

      // 방문 추이 지표 토글 (조회수/방문자) — 일/주/월 라인 & 시간대 막대 공통
      document.getElementById('traffic-metric')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        _trafficMetric = btn.dataset.metric;
        document.querySelectorAll('#traffic-metric .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        const activePeriod = document.querySelector('#traffic-period .seg-btn.active')?.dataset.period;
        if (activePeriod === 'hourly') renderHourlyChart();
        else renderTrafficPanel();
      });

      // 방문 추이 기간 토글 (일간/주간/월간)
      // 방문 추이 뷰 토글 (일간/주간/월간 + 시간대/히트맵)
      const TRAFFIC_NOTE = '※ 방문자 = 고유 브라우저(User-Agent) 기준 추정치. 방문자 TF/LF는 조회 비율로 안분한 추정. 주간·월간은 일자 합산이라 실제 순방문자보다 클 수 있음.';
      document.getElementById('traffic-period')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        const period = btn.dataset.period;
        document.querySelectorAll('#traffic-period .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        const isTime = period === 'hourly' || period === 'heatmap';
        // 뷰 전환
        const split = document.querySelector('.traffic-split');
        const hv = document.getElementById('tp-hourly-view');
        const mv = document.getElementById('tp-heatmap-view');
        if (split) split.style.display = isTime ? 'none' : '';
        if (hv) hv.style.display = period === 'hourly' ? '' : 'none';
        if (mv) mv.style.display = period === 'heatmap' ? '' : 'none';
        // 토글/컨트롤 위치 고정: 숨김은 visibility(공간 유지)로 → 레이아웃 안 밀림
        const metricT = document.getElementById('traffic-metric'); if (metricT) metricT.style.visibility = period === 'heatmap' ? 'hidden' : 'visible';
        // 날짜기반 전용 컨트롤(범위/CSV/비교): 시간대·히트맵에선 숨김(공간 유지)
        const vis = isTime ? 'hidden' : 'visible';
        const dr = document.querySelector('.date-range'); if (dr) dr.style.visibility = vis;
        const csv = document.getElementById('csv-export'); if (csv) csv.style.visibility = vis;
        const cmp = document.getElementById('traffic-compare'); if (cmp) cmp.style.visibility = vis;
        const total = document.getElementById('traffic-total');
        const note = document.getElementById('traffic-note');
        if (isTime) {
          if (period === 'hourly') {
            if (total) total.textContent = '오늘(KST) 시간대별';
            if (note) note.textContent = '※ 오늘(KST) 시간대별. TF/LF 막대 분리. 방문자는 고유 UA 기준(당일 계산).';
            renderHourlyChart();
          } else {
            if (total) total.textContent = _heatmapMode === 'weekly' ? '요일 × 시간대 (14일 누적)' : '최근 14일 × 시간대';
            if (note) note.textContent = '※ 날짜/요일 × 시간대(KST) 페이지뷰 밀도. 색이 진할수록 많음.';
            drawHeatmap();
          }
        } else {
          _trafficPeriod = period;
          _trafficCustom = null;
          const rf = document.getElementById('range-from'); const rt = document.getElementById('range-to');
          if (rf) rf.value = ''; if (rt) rt.value = '';
          const rc = document.getElementById('range-clear'); if (rc) rc.style.display = 'none';
          if (note) note.textContent = TRAFFIC_NOTE;
          renderTrafficPanel();
        }
      });

      // 커스텀 날짜 범위
      function applyCustomRange() {
        const from = document.getElementById('range-from')?.value;
        const to = document.getElementById('range-to')?.value;
        if (!from || !to) return;
        _trafficCustom = { from: from <= to ? from : to, to: from <= to ? to : from };
        document.querySelectorAll('#traffic-period .seg-btn').forEach(b => b.classList.remove('active'));
        const rc = document.getElementById('range-clear'); if (rc) rc.style.display = '';
        renderTrafficPanel();
      }
      document.getElementById('range-from')?.addEventListener('change', applyCustomRange);
      document.getElementById('range-to')?.addEventListener('change', applyCustomRange);
      document.getElementById('range-clear')?.addEventListener('click', () => {
        _trafficCustom = null;
        const rf = document.getElementById('range-from'); const rt = document.getElementById('range-to');
        if (rf) rf.value = ''; if (rt) rt.value = '';
        document.getElementById('range-clear').style.display = 'none';
        const daily = document.querySelector('#traffic-period .seg-btn[data-period="daily"]');
        document.querySelectorAll('#traffic-period .seg-btn').forEach(b => b.classList.toggle('active', b === daily));
        _trafficPeriod = 'daily';
        renderTrafficPanel();
      });
      document.getElementById('csv-export')?.addEventListener('click', exportTrafficCSV);

      // 기기/브라우저/OS 토글
      document.getElementById('audience-toggle')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        _audActive = btn.dataset.aud;
        document.querySelectorAll('#audience-toggle .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        renderAudienceDonut();
      });

      // 유입경로 / 기기 패널의 소스(블로그·뭉게) 토글
      document.getElementById('ref-src')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        _refSrc = btn.dataset.rs;
        document.querySelectorAll('#ref-src .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        renderAudience();
      });
      document.getElementById('audience-src')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        _audSrc = btn.dataset.as;
        document.querySelectorAll('#audience-src .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        renderAudience();
      });

      // 히트맵 일간/주간 토글
      document.getElementById('heatmap-mode')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.seg-btn');
        if (!btn) return;
        _heatmapMode = btn.dataset.hm;
        document.querySelectorAll('#heatmap-mode .seg-btn').forEach(b => b.classList.toggle('active', b === btn));
        drawHeatmap();
        const total = document.getElementById('traffic-total');
        if (total) total.textContent = _heatmapMode === 'weekly' ? '요일 × 시간대 (14일 누적)' : '최근 14일 × 시간대';
      });

      // 방문 추이 실시간 새로고침
      document.getElementById('refresh-traffic-panel')?.addEventListener('click', () => {
        const btn = document.getElementById('refresh-traffic-panel');
        if (btn) { btn.textContent = '갱신 중…'; btn.disabled = true; }
        Promise.resolve(loadTraffic(true)).finally(() => {
          setTimeout(() => { if (btn) { btn.textContent = '↻ 새로고침'; btn.disabled = false; } }, 400);
        });
      });

      async function loadTraffic(force) {
        try {
          // 초기 로드·수동 새로고침 시 봇 트래픽 선정리(같은 UA 반복접속·선언형 봇 제외) — 폴링마다는 생략
          if (force) {
            try { await rpc('flag_bot_pageviews'); } catch {}
            try { await rpc('flag_excluded_pageviews'); } catch {}   // 내 방문(UA) 제외목록 소급 플립
          }
          const [summary, hourly, topPages, events, topLiked, dailyDetail, heatmap, deviceTrend] = await Promise.all([
            rpc('get_traffic_summary'),
            rpc('get_hourly_views'),
            rpc('get_top_pages', { p_limit: 50 }),
            rpc('get_recent_events', { p_limit: 20 }),
            rpc('get_top_liked_posts', { p_limit: 10 }),
            rpc('get_daily_detail', { p_days: 180 }),
            rpc('get_daily_hourly_heatmap', { p_days: 14 }),
            rpc('get_daily_device_trend', { p_days: 180 }).catch(() => [])   // 미설치 시 무시
          ]);

          // Metrics
          const tv = Number(summary?.today_views) || 0;
          const yv = Number(summary?.yesterday_views) || 0;
          const tc = Number(summary?.today_clicks) || 0;
          const tl = Number(summary?.today_likes) || 0;
          const ts = Number(summary?.today_subscribers) || 0;

          // 상단 KPI 카드: 금일 방문자/조회수 (전일 대비 델타칩) — 다른 카드와 동일 규격
          const todayKstStr = new Date(Date.now() + 9 * 3600e3).toISOString().split('T')[0];
          const ydayKstStr = new Date(Date.now() + 9 * 3600e3 - 86400e3).toISOString().split('T')[0];
          const ddArr = Array.isArray(dailyDetail) ? dailyDetail : [];
          const todayVis = Number(ddArr.find((d) => d.day === todayKstStr)?.visitors) || 0;
          const ydayVis = Number(ddArr.find((d) => d.day === ydayKstStr)?.visitors) || 0;
          const setKpiDelta = (id, cur, prev, better = 'up') => {
            const el = document.getElementById(id); if (!el) return;
            const dd = cur - prev;
            if (!prev && !cur) { el.className = 'delta-chip flat'; el.textContent = '–'; return; }
            const good = better === 'up' ? dd >= 0 : dd <= 0;
            el.className = 'delta-chip ' + (dd === 0 ? 'flat' : (good ? 'up' : 'down'));
            el.textContent = dd === 0 ? '–' : `${dd > 0 ? '▲' : '▼'} ${fmt(Math.abs(dd))}`;
          };
          const kv = document.getElementById('kpi-today-visitors'); if (kv) kv.textContent = fmt(todayVis);
          setKpiDelta('kpi-tv-delta', todayVis, ydayVis);
          const kvs = document.getElementById('kpi-today-visitors-sub'); if (kvs) kvs.textContent = `어제 ${fmt(ydayVis)}명 · KST`;
          const kw = document.getElementById('kpi-today-views'); if (kw) kw.textContent = fmt(tv);
          setKpiDelta('kpi-tw-delta', tv, yv);
          const kws = document.getElementById('kpi-today-views-sub'); if (kws) kws.textContent = `어제 ${fmt(yv)}회 · KST`;

          document.getElementById('t-today-views').textContent = fmt(tv);
          const vd = deltaText(tv, yv);
          const vdEl = document.getElementById('t-views-delta');
          vdEl.textContent = vd.text;
          vdEl.className = `metric-delta ${vd.cls}`;

          document.getElementById('t-today-clicks').textContent = fmt(tc);
          const cdEl = document.getElementById('t-clicks-delta');
          cdEl.textContent = `total: ${fmt(Number(summary?.total_clicks) || 0)}`;
          cdEl.className = 'metric-delta neutral';

          document.getElementById('t-today-likes').textContent = fmt(tl);
          document.getElementById('t-likes-total').textContent = `total: ${fmt(Number(summary?.total_likes) || 0)}`;

          document.getElementById('t-subscribers').textContent = fmt(Number(summary?.total_subscribers) || 0);
          document.getElementById('t-subs-today').textContent = `today: +${ts}`;

          // Source breakdown
          const tfTv = Number(summary?.tf_today_views) || 0;
          const lfTv = Number(summary?.lf_today_views) || 0;
          const vipTv = Number(summary?.vip_today_views) || 0;
          const vipTotal = Number(summary?.vip_total_views) || 0;
          const tfTc = Number(summary?.tf_today_clicks) || 0;
          const lfTc = Number(summary?.lf_today_clicks) || 0;

          const vbEl = document.getElementById('t-views-breakdown');
          if (vbEl) vbEl.innerHTML = `<span><i class="dot-tf"></i> TF: ${fmt(tfTv)}</span><span><i class="dot-lf"></i> LF: ${fmt(lfTv)}</span><span><i class="dot-vip"></i> VIP: ${fmt(vipTv)}</span>`;

          const cbEl = document.getElementById('t-clicks-breakdown');
          if (cbEl) cbEl.innerHTML = `<span><i class="dot-tf"></i> TF: ${fmt(tfTc)}</span><span><i class="dot-lf"></i> LF: ${fmt(lfTc)}</span>`;

          // Also update summary cards
          document.getElementById('total-views').textContent = fmt(Number(summary?.total_views) || 0);
          document.getElementById('views-sub').textContent = tv > 0 ? `today +${tv} (TF +${tfTv} / LF +${lfTv})` : 'Collecting...';
          document.getElementById('total-clicks').textContent = fmt(Number(summary?.total_clicks) || 0);
          document.getElementById('clicks-sub').textContent = tc > 0 ? `today +${tc}` : 'Waiting...';

          // KPI 델타 칩 (오늘 vs 어제) — 색+화살표 이중 인코딩
          setDeltaChip('views-delta-chip', tv, yv);
          setDeltaChip('clicks-delta-chip', tc, null, tc > 0 ? `+${fmt(tc)} today` : '—');

          // Summary card source split
          const tfTotal = Number(summary?.tf_total_views) || 0;
          const lfTotal = Number(summary?.lf_total_views) || 0;
          const totalV = Number(summary?.total_views) || 1;
          const tfTotalEl = document.getElementById('tf-total-views');
          const lfTotalEl = document.getElementById('lf-total-views');
          if (tfTotalEl) tfTotalEl.textContent = fmt(tfTotal);
          if (lfTotalEl) lfTotalEl.textContent = fmt(lfTotal);

          // Animated split bar
          const splitTfEl = document.getElementById('views-split-tf');
          const splitLfEl = document.getElementById('views-split-lf');
          const splitVipEl = document.getElementById('views-split-vip');
          if (splitTfEl) splitTfEl.style.width = Math.round(tfTotal / totalV * 100) + '%';
          if (splitLfEl) splitLfEl.style.width = Math.round(lfTotal / totalV * 100) + '%';
          if (splitVipEl) splitVipEl.style.width = Math.round(vipTotal / totalV * 100) + '%';

          // 뭉게 합류용 스냅샷 — analytics 측 원본 수치를 남겨야 GA4 를 더해도 폴링마다
          // 값이 누적되지 않는다(applyMungge 는 항상 이 원본 + 뭉게로 다시 계산).
          _traffic = {
            todayVis, ydayVis, tv, yv, setKpiDelta,
            totalViews: Number(summary?.total_views) || 0,
            tfTotal, lfTotal, vipTotal,
            tfTv, lfTv, vipTv,
            postBase: (TF_POST_COUNT || 0) + (LF_POST_COUNT || 0) + (VIP_POST_COUNT || 0),
            postCounts: { tf: TF_POST_COUNT || 0, lf: LF_POST_COUNT || 0, vip: VIP_POST_COUNT || 0 },
          };
          applyMungge();

          // VIP(playcast) 조회수 — RPC get_traffic_summary 의 vip_ 필드 사용
          const vipEl = document.getElementById('vip-total-views');
          if (vipEl) vipEl.textContent = fmt(vipTotal) + (vipTv > 0 ? ` (+${vipTv})` : '');
          // VIP 독립 탭 KPI
          const vipTabViews = document.getElementById('vip-tab-views');
          if (vipTabViews) vipTabViews.textContent = fmt(vipTotal);
          const vipTabSub = document.getElementById('vip-tab-views-sub');
          if (vipTabSub) vipTabSub.textContent = vipTv > 0 ? `오늘 +${vipTv}` : `총 ${fmt(vipTotal)}회`;

          // === 탭별 데이터 업데이트 ===
          // TechFlow 탭
          const tfTabViewsEl = document.getElementById('tf-tab-views');
          const tfTabClicksEl = document.getElementById('tf-tab-clicks');
          const tfTabCvrEl = document.getElementById('tf-tab-cvr');
          if (tfTabViewsEl) tfTabViewsEl.textContent = fmt(tfTotal);
          if (tfTabClicksEl) tfTabClicksEl.textContent = fmt(Number(summary?.tf_total_clicks) || 0);
          if (tfTabCvrEl) {
            const tfCvr = tfTotal > 0 ? ((Number(summary?.tf_total_clicks) || 0) / tfTotal * 100).toFixed(2) : 0;
            tfTabCvrEl.textContent = tfCvr + '%';
          }
          const tfTabViewsSubEl = document.getElementById('tf-tab-views-sub');
          const tfTabClicksSubEl = document.getElementById('tf-tab-clicks-sub');
          if (tfTabViewsSubEl) tfTabViewsSubEl.textContent = tfTv > 0 ? `오늘 +${fmt(tfTv)}` : '수집 중...';
          if (tfTabClicksSubEl) tfTabClicksSubEl.textContent = tfTc > 0 ? `오늘 +${fmt(tfTc)}` : '대기 중...';

          // LifeFlow 탭
          const lfTabViewsEl = document.getElementById('lf-tab-views');
          const lfTabClicksEl = document.getElementById('lf-tab-clicks');
          const lfTabCvrEl = document.getElementById('lf-tab-cvr');
          if (lfTabViewsEl) lfTabViewsEl.textContent = fmt(lfTotal);
          if (lfTabClicksEl) lfTabClicksEl.textContent = fmt(Number(summary?.lf_total_clicks) || 0);
          if (lfTabCvrEl) {
            const lfCvr = lfTotal > 0 ? ((Number(summary?.lf_total_clicks) || 0) / lfTotal * 100).toFixed(2) : 0;
            lfTabCvrEl.textContent = lfCvr + '%';
          }
          const lfTabViewsSubEl = document.getElementById('lf-tab-views-sub');
          const lfTabClicksSubEl = document.getElementById('lf-tab-clicks-sub');
          if (lfTabViewsSubEl) lfTabViewsSubEl.textContent = lfTv > 0 ? `오늘 +${fmt(lfTv)}` : '수집 중...';
          if (lfTabClicksSubEl) lfTabClicksSubEl.textContent = lfTc > 0 ? `오늘 +${fmt(lfTc)}` : '대기 중...';

          // 쿠팡 탭
          const coupTotalClicksEl = document.getElementById('coup-total-clicks');
          const coupTodayClicksEl = document.getElementById('coup-today-clicks');
          const coupCtrEl = document.getElementById('coup-ctr');
          const coupTfCtrEl = document.getElementById('coup-tf-ctr');
          const coupLfCtrEl = document.getElementById('coup-lf-ctr');
          const totalClicks = Number(summary?.total_clicks) || 0;
          if (coupTotalClicksEl) coupTotalClicksEl.textContent = fmt(totalClicks);
          if (coupTodayClicksEl) coupTodayClicksEl.textContent = fmt(tc);
          if (coupCtrEl) {
            const overallCtr = totalV > 0 ? (totalClicks / totalV * 100).toFixed(2) : 0;
            coupCtrEl.textContent = overallCtr + '%';
          }
          if (coupTfCtrEl) {
            const tfCtr = tfTotal > 0 ? ((Number(summary?.tf_total_clicks) || 0) / tfTotal * 100).toFixed(2) : 0;
            coupTfCtrEl.textContent = tfCtr + '%';
          }
          if (coupLfCtrEl) {
            const lfCtr = lfTotal > 0 ? ((Number(summary?.lf_total_clicks) || 0) / lfTotal * 100).toFixed(2) : 0;
            coupLfCtrEl.textContent = lfCtr + '%';
          }
          const coupTfDetailEl = document.getElementById('coup-tf-detail');
          const coupLfDetailEl = document.getElementById('coup-lf-detail');
          if (coupTfDetailEl) coupTfDetailEl.textContent = `${fmt(Number(summary?.tf_total_clicks) || 0)} / ${fmt(tfTotal)}`;
          if (coupLfDetailEl) coupLfDetailEl.textContent = `${fmt(Number(summary?.lf_total_clicks) || 0)} / ${fmt(lfTotal)}`;

          // 쿠팡 클릭 피드는 fetchCoupangProducts → renderCoupangFeed 가 전담
          // (get_recent_events 20건 기반 구 렌더링은 상세 피드를 덮어써서 제거)

          // Charts & feeds
          _hourlyViews = Array.isArray(hourly) ? hourly : [];
          renderHourlyChart();
          renderTopPages(topPages);
          renderVipRecentPosts(); // VIP 목록 조회수 채우기(topPages 로드 후)
          renderEventFeed(events);
          _trafficDetail = Array.isArray(dailyDetail) ? dailyDetail : [];
          // RPC 응답으로 통째 교체되므로 뭉게 일별 수치를 매번 다시 얹는다(30초 폴링)
          mergeMgIntoDetail();
          // 웹/모바일 일별 집계 병합 (get_daily_device_trend — KST 일자 기준으로 daily_detail 과 동일)
          _deviceDataReady = Array.isArray(deviceTrend) && deviceTrend.length > 0;
          if (_deviceDataReady) {
            const dm = {};
            deviceTrend.forEach(d => { if (d.day) dm[d.day] = d; });
            _trafficDetail.forEach(d => {
              const m = dm[d.day] || {};
              d.web_views = Number(m.web_views) || 0;
              d.mobile_views = Number(m.mobile_views) || 0;
              d.web_visitors = Number(m.web_visitors) || 0;
              d.mobile_visitors = Number(m.mobile_visitors) || 0;
            });
          }
          renderTrafficPanel();
          renderHeatmap(heatmap);
          renderCategoryTraffic();
          renderTopLikedPosts(topLiked);
          // 오디언스(유입경로·기기) + 쿠팡 + 뉴스레터 → 퍼널·인사이트 일괄 렌더
          _funnelCounts.pageviews = Number(summary?.total_views) || 0;   // 퍼널 분모=실제 총 페이지뷰
          // 무거운 원시행 조회(오디언스 5000 · 쿠팡/뉴스레터/페이퍼닥 각 2000행)는 느리게 변하므로
          // 30초 라이트 틱마다 재요청하지 않고 약 4.5분 간격(또는 수동 새로고침 force)에만 재조회한다.
          const doHeavy = force || (Date.now() - _lastHeavy > 270000);
          if (doHeavy) {
            _lastHeavy = Date.now();
            Promise.all([fetchAudience(), fetchCoupangProducts(), fetchNewsletterCount(), fetchPaperdocClicks()]).then(([aud, coup, nl, pd]) => {
              renderAudience(aud);
              _hourlyVisitors = computeHourlyVisitors(aud);   // 시간대 방문자(방문자 모드용)
              if (_trafficMetric === 'visitors') renderHourlyChart();
              if (_topPagesPeriod !== 'all') renderTopPages();   // 기간별 Top Pages는 오디언스 로드 후 갱신
              renderCoupangProducts(coup);
              renderCoupangFeed(coup);
              renderPaperdoc(pd, _paperdocPeriod);
              _funnelCounts.coupang = Array.isArray(coup) ? coup.length : 0;
              _funnelCounts.newsletter = nl;
              _funnelCounts.paperdoc = Array.isArray(pd) ? pd.length : 0;
              renderFunnelGoals();
              computeInsight();
            });
            // 도구 탭을 이미 연 적 있으면(로드됨) 무거운 틱마다 갱신
            if (_toolRows !== null) {
              fetchToolPageviews().then(rows => { _toolRows = Array.isArray(rows) ? rows : []; renderTools(); });
            }
          } else {
            // 라이트 틱: 캐시된 오디언스/전환 데이터로 파생 지표(퍼널 분모·인사이트)만 재계산
            renderFunnelGoals();
            computeInsight();
          }
          document.getElementById('last-updated').textContent =
            `Updated: ${new Date().toLocaleString('ko-KR')}`;

        } catch (e) {
          console.error('Traffic load error:', e);
        }
      }

      document.getElementById('refresh-traffic')?.addEventListener('click', () => {
        loadTraffic(true);
        fetchGscStats().then(renderGsc);
      });

      // GSC 검색 실적 초기 로드 (전체요약 KPI 카드)
      fetchGscStats().then(renderGsc);

      // 요약 카드 클릭 → 뭉게 유입 탭 열기
      document.getElementById('mg-sum-card')?.addEventListener('click', () => {
        document.querySelector('.main-tab[data-tab="ga4"]')?.click();
      });
      // 요약 카드 클릭 → 검색(GSC) 상세 탭 열기
      document.getElementById('gsc-sum-card')?.addEventListener('click', () => {
        document.querySelector('.main-tab[data-tab="gsc"]')?.click();
      });

      // === 탭 전환 로직 ===
      const mainTabs = document.querySelectorAll('.main-tab');
      const tabContents = document.querySelectorAll('.tab-content');

      mainTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const targetTab = tab.dataset.tab;

          // 모든 탭 비활성화
          mainTabs.forEach(t => {
            t.classList.remove('active', 'active-tf', 'active-lf', 'active-coupang', 'active-paperdoc', 'active-comments', 'active-vip');
          });

          // 클릭한 탭 활성화
          if (targetTab === 'techflow') {
            tab.classList.add('active-tf');
          } else if (targetTab === 'lifeflow') {
            tab.classList.add('active-lf');
          } else if (targetTab === 'coupang') {
            tab.classList.add('active-coupang');
          } else if (targetTab === 'paperdoc') {
            tab.classList.add('active-paperdoc');
          } else if (targetTab === 'comments') {
            tab.classList.add('active-comments');
            loadCommentDashboard();
          } else if (targetTab === 'vip') {
            tab.classList.add('active-vip');
          } else if (targetTab === 'gsc') {
            tab.classList.add('active');
            loadGscDetail();
          } else if (targetTab === 'ga4') {
            tab.classList.add('active');
            loadGa4Detail();
          } else if (targetTab === 'tools') {
            tab.classList.add('active');
            if (_toolRows === null) {
              fetchToolPageviews().then(rows => { _toolRows = Array.isArray(rows) ? rows : []; renderTools(); });
            } else {
              renderTools();
            }
          } else {
            tab.classList.add('active');
          }

          // 모든 탭 콘텐츠 숨김
          tabContents.forEach(content => {
            content.classList.remove('active');
          });

          // 선택한 탭 콘텐츠 표시
          const targetContent = document.getElementById(`tab-${targetTab}`);
          if (targetContent) {
            targetContent.classList.add('active');
          }
        });
      });

      // ========== 댓글 관리 ==========
      let adminKey = localStorage.getItem('dash-admin-key') || '';
      let allComments = [];
      let currentFilter = 'all';

      // 관리자 인증
      document.getElementById('admin-key-submit')?.addEventListener('click', verifyAdminKey);
      document.getElementById('admin-key-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') verifyAdminKey();
      });

      // 서버 검증: 존재하지 않는 id로 admin_delete_comment 호출 → 키만 확인(부작용 없음)
      const ADMIN_VALIDATE_ID = '00000000-0000-0000-0000-000000000000';
      async function checkAdminKey(key) {
        if (!key) return false;
        try {
          const res = await rpc('admin_delete_comment', { p_id: ADMIN_VALIDATE_ID, p_admin_key: key });
          return !!(res && res.success);
        } catch { return false; }
      }

      async function verifyAdminKey() {
        const input = document.getElementById('admin-key-input');
        const errEl = document.getElementById('auth-error');
        const btn = document.getElementById('admin-key-submit');
        const key = input?.value?.trim();
        if (!key) return;
        if (btn) { btn.disabled = true; btn.textContent = '확인 중…'; }
        const ok = await checkAdminKey(key);
        if (btn) { btn.disabled = false; btn.textContent = '인증'; }
        if (ok) {
          adminKey = key;
          localStorage.setItem('dash-admin-key', key);
          if (errEl) errEl.style.display = 'none';
          showCommentDashboard();
        } else {
          adminKey = '';
          localStorage.removeItem('dash-admin-key');
          if (errEl) { errEl.textContent = '관리자 키가 올바르지 않습니다.'; errEl.style.display = 'block'; }
        }
      }

      function showCommentDashboard() {
        const gate = document.getElementById('comment-auth');
        const dash = document.getElementById('comment-dashboard');
        if (gate) gate.style.display = 'none';
        if (dash) dash.style.display = 'block';
        loadCommentData();
      }

      // 페이지 진입 시 이미 인증했으므로 댓글 탭은 별도 인증 없이 바로 연다
      async function loadCommentDashboard() {
        showCommentDashboard();
      }

      async function loadCommentData() {
        try {
          // 통계 + 목록 + 트렌드 병렬 로드
          const [stats, comments, trend] = await Promise.all([
            rpc('get_comment_stats'),
            rpc('get_all_comments', { p_limit: 100, p_offset: 0 }),
            rpc('get_comment_trend')
          ]);

          // 통계 카드 업데이트
          if (stats && typeof stats === 'object') {
            document.getElementById('cm-total').textContent = fmt(stats.total || 0);
            document.getElementById('cm-today').textContent = fmt(stats.today || 0);
            document.getElementById('cm-reports').textContent = fmt(stats.reports || 0);
            document.getElementById('cm-by-source').textContent =
              `TechFlow ${stats.blog_count || 0} / LifeFlow ${stats.lifeflow_count || 0} / VIP ${stats.vip_count || 0}`;
          }

          // 댓글 목록 저장 + 렌더
          allComments = Array.isArray(comments) ? comments : [];
          renderComments();

          // 트렌드 차트
          renderTrend(Array.isArray(trend) ? trend : []);

        } catch (e) {
          console.error('Comment data load error:', e);
        }
      }

      function renderComments() {
        const container = document.getElementById('comment-list');
        if (!container) return;

        let filtered = allComments;
        if (currentFilter === 'blog') {
          filtered = allComments.filter(c => c.source === 'blog');
        } else if (currentFilter === 'lifeflow') {
          filtered = allComments.filter(c => c.source === 'lifeflow');
        } else if (currentFilter === 'reported') {
          filtered = allComments.filter(c => (c.report_count || 0) > 0);
        }

        if (filtered.length === 0) {
          container.innerHTML = '<div class="no-data">표시할 댓글이 없습니다.</div>';
          return;
        }

        container.innerHTML = filtered.map(c => {
          const srcClass = c.source === 'blog' ? 'tf' : 'lf';
          const srcLabel = c.source === 'blog' ? 'TF' : 'LF';
          const date = new Date(c.created_at).toLocaleString('ko-KR', {
            month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
          });
          const reportBadge = (c.report_count || 0) > 0
            ? `<span class="cm-report-badge">신고 ${c.report_count}</span>` : '';
          const adminBadge = c.is_admin
            ? '<span class="cm-admin-badge">관리자</span>' : '';
          const parentNote = c.parent_id
            ? '<span style="color:var(--dash-cyan);">↩ 답글</span>' : '';

          const postHref = c.source === 'vip'
            ? 'https://virtual-in-playing.vercel.app/watch/' + encodeURIComponent(c.post_slug) + '/'
            : (c.source === 'lifeflow' ? 'https://life-revenue-blog.vercel.app' : '') + '/blog/' + encodeURIComponent(c.post_slug) + '/';
          return `
            <div class="cm-item" data-id="${c.id}" data-slug="${escHtml(c.post_slug)}" data-source="${escHtml(c.source)}">
              <span class="cm-source ${srcClass}">${srcLabel}</span>
              <div class="cm-body">
                <div class="cm-meta">
                  <span class="cm-nickname">${escHtml(c.nickname)}</span>
                  ${adminBadge}${reportBadge}${parentNote}
                  <span>${date}</span>
                </div>
                <div class="cm-content cm-goto" onclick="window.open('${postHref}','_blank','noopener')" title="글로 이동 ↗">${escHtml(c.content)}</div>
                <a class="cm-slug" href="${postHref}" target="_blank" rel="noopener" title="글로 이동">📄 ${escHtml(c.post_slug)} <span class="cm-goto-arrow">↗</span></a>
              </div>
              <div class="cm-actions">
                <button class="cm-btn" onclick="toggleReplyForm('${c.id}')">💬 답변</button>
                <button class="cm-btn danger" onclick="adminDeleteComment('${c.id}')">🗑 삭제</button>
              </div>
            </div>
          `;
        }).join('');
      }

      function escHtml(s) {
        if (!s) return '';
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // 답변 폼 토글
      window.toggleReplyForm = function(commentId) {
        const item = document.querySelector(`.cm-item[data-id="${commentId}"]`);
        if (!item) return;
        const existing = item.querySelector('.cm-reply-form');
        if (existing) { existing.remove(); return; }

        const body = item.querySelector('.cm-body');
        const form = document.createElement('div');
        form.className = 'cm-reply-form';
        form.innerHTML = `
          <input type="text" placeholder="관리자 답변 입력..." id="reply-input-${commentId}" />
          <button onclick="submitAdminReply('${commentId}')">전송</button>
        `;
        body.appendChild(form);
        form.querySelector('input').focus();
      };

      // 관리자 답변 전송
      window.submitAdminReply = async function(commentId) {
        const input = document.getElementById(`reply-input-${commentId}`);
        const content = input?.value?.trim();
        if (!content) return;
        // content CHECK 제약: 2~500자 (초과/미만이면 comments_content_check 위반)
        if (content.length < 2) { alert('답변은 2자 이상 입력해 주세요.'); return; }
        if (content.length > 500) { alert(`답변은 500자 이내여야 합니다. (현재 ${content.length}자 — ${content.length - 500}자 초과)`); return; }

        const item = document.querySelector(`.cm-item[data-id="${commentId}"]`);
        // dataset이 없으면 로드된 댓글 데이터에서 보완
        const c = (allComments || []).find(x => String(x.id) === String(commentId));
        const slug = item?.dataset.slug || c?.post_slug || '';
        const source = item?.dataset.source || c?.source || 'blog';

        try {
          const result = await rpc('admin_reply', {
            p_parent_id: commentId,
            p_slug: slug,
            p_source: source,
            p_content: content,
            p_admin_key: adminKey
          });

          if (result && (result.success || result.id)) {
            if (input) input.value = '';
            loadCommentData();
          } else if (result?.error === 'unauthorized') {
            alert('관리자 키가 올바르지 않습니다. 다시 인증해 주세요.');
            localStorage.removeItem('dash-admin-key');
            adminKey = '';
            document.getElementById('comment-auth').style.display = 'flex';
            document.getElementById('comment-dashboard').style.display = 'none';
          } else {
            const msg = result?.message || result?.error || result?.hint || JSON.stringify(result);
            alert('답변 전송 실패: ' + msg);
            console.error('admin_reply 실패:', result);
          }
        } catch (e) {
          alert('답변 전송 중 오류: ' + (e?.message || e));
          console.error(e);
        }
      };

      // 관리자 삭제
      window.adminDeleteComment = async function(commentId) {
        if (!confirm('이 댓글을 삭제하시겠습니까? (답글도 함께 삭제됩니다)')) return;
        try {
          const result = await rpc('admin_delete_comment', {
            p_id: commentId,
            p_admin_key: adminKey
          });

          if (result?.success) {
            // SECURITY DEFINER 적용 후엔 deleted 행수 반환. 0이면 서버 미적용 안내.
            if (result.deleted === 0) {
              alert('삭제 요청은 처리됐으나 실제로 지워지지 않았습니다.\nSupabase에 admin 함수 SECURITY DEFINER 마이그레이션이 필요합니다.');
            }
            loadCommentData();
          } else if (result?.error === 'unauthorized') {
            alert('관리자 키가 올바르지 않습니다.');
            localStorage.removeItem('dash-admin-key');
            adminKey = '';
          } else {
            const msg = result?.message || result?.error || JSON.stringify(result);
            alert('삭제 실패: ' + msg);
            console.error('admin_delete_comment 실패:', result);
          }
        } catch (e) {
          alert('삭제 중 오류: ' + (e?.message || e));
          console.error(e);
        }
      };

      // 트렌드 차트 렌더
      function renderTrend(data) {
        const container = document.getElementById('comment-trend-chart');
        if (!container) return;

        if (data.length === 0) {
          container.innerHTML = '<div class="no-data">최근 7일간 댓글이 없습니다.</div>';
          return;
        }

        const maxCount = Math.max(...data.map(d => d.count), 1);
        const maxH = 120;

        const barsHtml = data.map(d => {
          const tfH = Math.max((d.blog_count / maxCount) * maxH, 4);
          const lfH = Math.max((d.lf_count / maxCount) * maxH, 4);
          const vipH = d.vip_count > 0 ? Math.max((d.vip_count / maxCount) * maxH, 4) : 0;
          const dayLabel = new Date(d.day).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' });
          return `
            <div class="trend-bar-group">
              <div class="trend-count">${d.count}</div>
              <div class="trend-bars">
                <div class="trend-bar tf" style="height:${tfH}px" title="TF: ${d.blog_count}"></div>
                <div class="trend-bar lf" style="height:${lfH}px" title="LF: ${d.lf_count}"></div>
                <div class="trend-bar vip" style="height:${vipH}px" title="VIP: ${d.vip_count || 0}"></div>
              </div>
              <div class="trend-label">${dayLabel}</div>
            </div>
          `;
        }).join('');

        container.innerHTML = barsHtml +
          '<div class="trend-legend"><span class="leg-tf">TechFlow</span><span class="leg-lf">LifeFlow</span></div>';
      }

      // 필터 버튼
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentFilter = btn.dataset.source;
          renderComments();
        });
      });

      // 새로고침 버튼
      document.getElementById('refresh-comments')?.addEventListener('click', () => {
        loadCommentData();
      });

      // === 페이지 진입 인증 ===
      // 대시보드 전체를 관리자 비밀번호로 잠근다. 인증값(=DB 관리자 키)은 localStorage 에
      // 저장돼 다음 접속엔 바로 열리고, 댓글 탭도 이 값을 그대로 써서 따로 인증하지 않는다.
      let _inited = false;

      function initDashboard() {
        if (_inited) return;
        _inited = true;
        fetchLifeFlowRSS();
        fetchVipRSS();
        loadTraffic();
        checkSupabase();
        checkMungge();
        loadMunggeAll();
        // 뭉게 실시간 방문 폴링 — GA4 배치와 달리 지금 보고 있는 페이지가 바로 반영된다
        setInterval(() => {
          refreshMgLive().then(() => {
            renderTopPages();
            if (_ga4Init) renderGa4Detail();
          });
        }, 30000);
        initChartHover();
        initHeatmapHover();
        initExcludeControls();
        enableDragScroll(document.getElementById('traffic-list'));
        enableDragScroll(document.getElementById('hourly-hot'));
        setInterval(loadTraffic, 30000);
      }

      // ── 내 방문 제외 ─────────────────────────────────────
      const NOTRACK_KEY = '__notrack';   // BaseLayout 트래커와 동일 키(동일 오리진 = TechFlow)
      function initExcludeControls() {
        // A) 이 브라우저 즉시 제외 토글 (localStorage.__notrack)
        const tBtn = document.getElementById('notrack-toggle');
        const tSt = document.getElementById('notrack-status');
        const syncNotrack = () => {
          let on = false;
          try { on = localStorage.getItem(NOTRACK_KEY) === '1'; } catch {}
          if (tBtn) { tBtn.textContent = on ? '제외 켜짐 — 끄기' : '이 브라우저 제외하기'; tBtn.classList.toggle('on', on); }
          if (tSt) tSt.textContent = on ? '이 브라우저의 TechFlow 방문은 기록되지 않아요.' : '지금은 이 브라우저 방문도 집계에 잡혀요.';
        };
        tBtn?.addEventListener('click', () => {
          try {
            const on = localStorage.getItem(NOTRACK_KEY) === '1';
            if (on) localStorage.removeItem(NOTRACK_KEY); else localStorage.setItem(NOTRACK_KEY, '1');
          } catch {}
          syncNotrack();
        });
        syncNotrack();

        // B) UA 기준 서버 제외
        const uaNow = document.getElementById('my-ua-now');
        const myUa = navigator.userAgent || '';
        if (uaNow) uaNow.textContent = myUa || '(User-Agent 없음)';
        document.getElementById('ua-add-btn')?.addEventListener('click', addMyDeviceExclusion);
        refreshExcludedUaList();
      }

      // UA 라벨: 긴 UA 대신 사람이 알아볼 짧은 이름 추정
      function uaLabel(ua) {
        const s = String(ua || '');
        let os = /iPhone/.test(s) ? 'iPhone' : /iPad/.test(s) ? 'iPad' : /Android/.test(s) ? 'Android'
          : /Windows/.test(s) ? 'Windows' : /Mac OS X|Macintosh/.test(s) ? 'Mac' : /Linux/.test(s) ? 'Linux' : '기기';
        let br = /Edg\//.test(s) ? 'Edge' : /OPR\/|Opera/.test(s) ? 'Opera' : /SamsungBrowser/.test(s) ? 'Samsung'
          : /Whale/.test(s) ? 'Whale' : /Firefox\//.test(s) ? 'Firefox' : /Chrome\//.test(s) ? 'Chrome'
          : /Safari\//.test(s) ? 'Safari' : '브라우저';
        return `${os} · ${br}`;
      }

      async function addMyDeviceExclusion() {
        const btn = document.getElementById('ua-add-btn');
        const st = document.getElementById('ua-add-status');
        const ua = navigator.userAgent || '';
        if (!ua) { if (st) st.textContent = 'User-Agent를 읽을 수 없어요.'; return; }
        if (btn) { btn.disabled = true; btn.textContent = '추가 중…'; }
        try {
          const r = await rpc('admin_add_excluded_ua', { p_ua: ua, p_note: uaLabel(ua), p_admin_key: adminKey });
          if (r && r.success) {
            if (st) st.textContent = `추가됨 · 과거 방문 ${fmt(Number(r.flagged) || 0)}건 소급 제외`;
            await refreshExcludedUaList();
            loadTraffic(true);   // 집계 즉시 갱신
          } else if (r && r.error === 'unauthorized') {
            if (st) st.textContent = '관리자 키 인증이 필요해요(재로그인).';
          } else {
            if (st) st.textContent = '추가 실패 — SQL 미설치일 수 있어요.';
            showUaSetupHint();
          }
        } catch {
          if (st) st.textContent = '추가 실패 — SQL 미설치일 수 있어요.';
          showUaSetupHint();
        } finally {
          if (btn) { btn.disabled = false; btn.textContent = '＋ 이 기기 제외 추가'; }
        }
      }

      function showUaSetupHint() {
        const h = document.getElementById('ua-setup-hint');
        if (h) h.style.display = 'block';
      }

      async function refreshExcludedUaList() {
        const box = document.getElementById('ua-list');
        if (!box) return;
        let list = null;
        try { list = await rpc('admin_list_excluded_uas', { p_admin_key: adminKey }); } catch { list = null; }
        if (!Array.isArray(list)) { box.innerHTML = '<div class="exclude-empty">목록을 불러오지 못했어요.</div>'; showUaSetupHint(); return; }
        if (!list.length) { box.innerHTML = '<div class="exclude-empty">아직 제외한 기기가 없어요.</div>'; return; }
        const myUa = navigator.userAgent || '';
        box.innerHTML = list.map((e) => {
          const isMe = e.ua === myUa ? ' <span style="color:#4ade80">(현재 기기)</span>' : '';
          const label = escHtml((e.note && String(e.note)) || uaLabel(e.ua));
          return `<div class="exclude-item">
            <span class="ua-txt" title="${escHtml(e.ua)}">${label}${isMe} — ${escHtml(String(e.ua).slice(0, 60))}…</span>
            <span class="ua-cnt">${fmt(Number(e.flagged) || 0)}건 제외</span>
            <button class="ua-del" data-ua="${escHtml(e.ua)}">제거</button>
          </div>`;
        }).join('');
        box.querySelectorAll('.ua-del').forEach((b) => b.addEventListener('click', () => removeExcludedUa(b.getAttribute('data-ua'))));
      }

      async function removeExcludedUa(ua) {
        if (!ua) return;
        try {
          const r = await rpc('admin_remove_excluded_ua', { p_ua: ua, p_admin_key: adminKey });
          if (r && r.success) { await refreshExcludedUaList(); loadTraffic(true); }
        } catch {}
      }

      function unlockDashboard() {
        const gate = document.getElementById('page-auth');
        if (gate) gate.style.display = 'none';
        document.body.classList.remove('locked');
        initDashboard();
      }

      async function submitPageAuth() {
        const input = document.getElementById('page-auth-input');
        const errEl = document.getElementById('page-auth-error');
        const btn = document.getElementById('page-auth-submit');
        const key = input?.value?.trim();
        if (!key) return;
        if (btn) { btn.disabled = true; btn.textContent = '확인 중…'; }
        const ok = await checkAdminKey(key);
        if (btn) { btn.disabled = false; btn.textContent = '입장'; }
        if (ok) {
          adminKey = key;
          localStorage.setItem('dash-admin-key', key);
          if (errEl) errEl.style.display = 'none';
          unlockDashboard();
        } else {
          if (errEl) { errEl.textContent = '비밀번호가 올바르지 않습니다.'; errEl.style.display = 'block'; }
          if (input) { input.value = ''; input.focus(); }
        }
      }

      document.getElementById('page-auth-submit')?.addEventListener('click', submitPageAuth);
      document.getElementById('page-auth-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') submitPageAuth();
      });
      document.getElementById('logout-btn')?.addEventListener('click', () => {
        localStorage.removeItem('dash-admin-key');
        location.reload();
      });

      // 저장된 값이 있으면 서버 재검증 후 자동 입장
      (async () => {
        if (adminKey && await checkAdminKey(adminKey)) {
          unlockDashboard();
        } else {
          adminKey = '';
          localStorage.removeItem('dash-admin-key');
          document.getElementById('page-auth-input')?.focus();
        }
      })();
    </script>
  </body>
</html>
