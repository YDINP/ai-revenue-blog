        </div>

        <div class="blog-section">
          <div class="section-header">
            <div class="section-title">TechFlow 콘텐츠</div>
            <span class="section-badge badge-tf">{tfPostCount}편</span>
          </div>
          <div class="section-body">
            <div class="cat-donut-wrap">
              <div class="cat-donut" style={`background: conic-gradient(${tfCategoryStats.map((c, i) => {
                const pctBefore = tfCategoryStats.slice(0, i).reduce((s, x) => s + x.count, 0) / tfPostCount * 100;
                const pct = c.count / tfPostCount * 100;
                const g = tfCategoryStats.length > 1 ? Math.min(1, pct / 4) : 0;
                return `#1e293b ${pctBefore}% ${pctBefore + g}%, ${tfCatColor(c.name)} ${pctBefore + g}% ${pctBefore + pct}%`;
              }).join(', ')})`}>
                <div class="cat-donut-hole">
                  <span class="donut-num">{tfPostCount}</span>
