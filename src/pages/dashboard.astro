      function timeAgo(dateStr) {
        const diff = (Date.now() - new Date(dateStr).getTime()) / 1000;
        if (diff < 60) return `${Math.floor(diff)}s ago`;
        if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
        return `${Math.floor(diff / 86400)}d ago`;
      }

      function deltaText(today, yesterday) {
        if (yesterday === 0) return { text: today > 0 ? `+${today} new` : 'No data yet', cls: today > 0 ? 'up' : 'neutral' };
        const pct = Math.round(((today - yesterday) / yesterday) * 100);
        if (pct > 0) return { text: `+${pct}% vs yesterday`, cls: 'up' };
        if (pct < 0) return { text: `${pct}% vs yesterday`, cls: 'down' };
        return { text: 'Same as yesterday', cls: 'neutral' };
      }

      // 날짜별 상세 테이블 (최근 30일)
      function renderDailyDetail(data) {
        const body = document.getElementById('daily-detail-body');
        const totalEl = document.getElementById('daily-detail-total');
        if (!body) return;
        if (!data || data.length === 0) {
          body.innerHTML = '<tr><td colspan="6" class="no-data">데이터 없음</td></tr>';
          if (totalEl) totalEl.textContent = '0';
          return;
        }
        const todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().split('T')[0];
        const maxV = Math.max(...data.map(d => Number(d.views) || 0), 1);
        let sumViews = 0, sumVisitors = 0;
        body.innerHTML = data.map(d => {
          const views = Number(d.views) || 0;
          const visitors = Number(d.visitors) || 0;
          const tf = Number(d.tf_views) || 0;
          const lf = Number(d.lf_views) || 0;
          sumViews += views; sumVisitors += visitors;
          const dObj = new Date(d.day + 'T00:00:00');
          const wd = ['일','월','화','수','목','금','토'][dObj.getDay()];
          const label = `${dObj.getMonth()+1}/${dObj.getDate()} (${wd})`;
          const barW = Math.max(Math.round((views / maxV) * 110), 2);
          const isToday = d.day === todayKst;
          return `<tr class="${isToday ? 'dd-today' : ''}">
            <td>${label}${isToday ? ' ·오늘' : ''}</td>
            <td class="dd-views">${fmt(views)}</td>
            <td class="dd-visitors">${fmt(visitors)}</td>
            <td>${fmt(tf)}</td>
            <td>${fmt(lf)}</td>
            <td class="dd-bar-col"><span class="dd-minibar" style="width:${barW}px"></span></td>
          </tr>`;
        }).join('');
        if (totalEl) totalEl.textContent = `${fmt(sumViews)} 조회 / ${fmt(sumVisitors)} 방문자`;
      }

      // 날짜 x 시간대 히트맵 (최근 14일)
      function renderHeatmap(data) {
        const wrap = document.getElementById('heatmap-wrap');
        if (!wrap) return;
        if (!data || data.length === 0) {
          wrap.innerHTML = '<div class="no-data">데이터 없음</div>';
          return;
        }
        // {day, hour, views} -> map[day][hour]
        const dayMap = {};
        let maxV = 1;
        data.forEach(d => {
          const day = d.day, hour = Number(d.hour), v = Number(d.views) || 0;
          if (!dayMap[day]) dayMap[day] = {};
          dayMap[day][hour] = v;
          if (v > maxV) maxV = v;
        });
        // 최근 14일 날짜 목록 (오늘 KST 기준, 최신이 위로)
        const todayKst = new Date(Date.now() + 9 * 3600 * 1000);
        const days = [];
        for (let i = 0; i < 14; i++) {
          const dt = new Date(todayKst.getTime() - i * 86400000);
          days.push(dt.toISOString().split('T')[0]);
        }
        const level = (v) => {
          if (!v) return 0;
          const r = v / maxV;
          if (r <= 0.15) return 1;
          if (r <= 0.4) return 2;
          if (r <= 0.7) return 3;
          return 4;
        };
        // 시간 헤더 (0,3,6,...,21)
        let hourHead = '<div class="hm-hourhead">';
        for (let h = 0; h < 24; h++) hourHead += `<span class="hm-hourlabel">${h % 3 === 0 ? h : ''}</span>`;
        hourHead += '</div>';
        let rows = '';
        days.forEach(day => {
          const dObj = new Date(day + 'T00:00:00');
          const wd = ['일','월','화','수','목','금','토'][dObj.getDay()];
          const label = `${dObj.getMonth()+1}/${dObj.getDate()}(${wd})`;
          let cells = '';
          for (let h = 0; h < 24; h++) {
            const v = (dayMap[day] && dayMap[day][h]) || 0;
            cells += `<i class="hm-cell l${level(v)}" title="${label} ${h}시: ${v}회"></i>`;
          }
          rows += `<div class="hm-row"><span class="hm-rowlabel">${dObj.getMonth()+1}/${dObj.getDate()}</span>${cells}</div>`;
        });
        wrap.innerHTML = `<div class="heatmap-grid">${hourHead}${rows}</div>`;
      }

      function renderHourlyChart(data) {
        const container = document.getElementById('hourly-chart');
        if (!container) return;

        if (!data || data.length === 0) {
          container.innerHTML = '<div class="no-data" style="width:100%">No pageviews today yet</div>';
          return;
        }

        const hourMap = {};
        data.forEach(d => {
          hourMap[d.hour] = { total: d.views || 0, tf: d.tf_views || 0, lf: d.lf_views || 0 };
        });
        const maxViews = Math.max(...Object.values(hourMap).map(h => h.total), 1);

        let html = '';
        for (let h = 0; h < 24; h++) {
          const d = hourMap[h] || { total: 0, tf: 0, lf: 0 };
          const totalH = d.total > 0 ? Math.max((d.total / maxViews) * 90, 4) : 2;
          const tfH = d.total > 0 ? (d.tf / d.total) * totalH : 0;
          const lfH = d.total > 0 ? (d.lf / d.total) * totalH : 0;
          const otherH = totalH - tfH - lfH;
          const opacity = d.total > 0 ? 1 : 0.2;
          html += `<div class="chart-bar-col">
            <div class="chart-bar-tooltip">${h}:00 — TF:${d.tf} LF:${d.lf} (${d.total})</div>
            <div class="chart-bar-stack" style="height:${totalH}px; opacity:${opacity}">
              ${lfH > 0 ? `<div class="bar-lf" style="height:${lfH}px"></div>` : ''}
              ${tfH > 0 ? `<div class="bar-tf" style="height:${tfH}px"></div>` : ''}
              ${otherH > 0 ? `<div style="height:${otherH}px;background:#475569;"></div>` : ''}
            </div>
            <span class="chart-bar-label">${h % 3 === 0 ? h : ''}</span>
          </div>`;
        }
        container.innerHTML = html;
      }

      // 7-Day Trend Bar Chart
      function renderTrendChart(rawData) {
        const container = document.getElementById('trend-chart');
        const totalEl = document.getElementById('trend-total-num');
        if (!container) return;

        if (!rawData || rawData.length === 0) {
          container.innerHTML = '<div class="no-data">No trend data yet</div>';
          return;
        }

        // 7일치 데이터로 패딩
        const dataMap = {};
        rawData.forEach(d => { if (d.day) dataMap[d.day] = d; });
        const data = [];
        const today = new Date().toISOString().split('T')[0];
        for (let i = 6; i >= 0; i--) {
          const date = new Date();
          date.setDate(date.getDate() - i);
          const key = date.toISOString().split('T')[0];
          data.push(dataMap[key] || { day: key, views: 0, tf_views: 0, lf_views: 0 });
        }

        const total7d = data.reduce((s, d) => s + (d.views || 0), 0);
        if (totalEl) totalEl.textContent = fmt(total7d);

        const maxV = Math.max(...data.map(d => d.views || 0), 1);

        container.innerHTML = data.map(d => {
          const day = d.day ? new Date(d.day) : null;
          const dateStr = day ? `${day.getMonth()+1}/${day.getDate()}` : '';
          const views = d.views || 0;
          const tf = d.tf_views || 0;
          const lf = d.lf_views || 0;
          const pct = views > 0 ? Math.max((views / maxV) * 100, 8) : 4;
          const tfPct = views > 0 ? (tf / views) * 100 : 0;
          const lfPct = views > 0 ? (lf / views) * 100 : 0;
          const isToday = d.day === today;

          return `<div class="trend-bar-col">
            <div class="trend-bar-wrap">
              <div class="trend-bar-stack ${isToday ? 'trend-bar-today' : ''}" style="height:${pct}%;opacity:${views > 0 ? 1 : 0.25}">
                ${lfPct > 0 ? `<div class="trend-bar-lf" style="height:${lfPct}%"></div>` : ''}
                ${tfPct > 0 ? `<div class="trend-bar-tf" style="height:${tfPct}%"></div>` : ''}
                ${views === 0 ? `<div style="height:100%;background:#334155;border-radius:6px 6px 0 0;"></div>` : ''}
              </div>
            </div>
            <div class="trend-bar-label">
              <span class="trend-bar-date">${dateStr}</span>
              <span class="trend-bar-count">${views > 0 ? views : '-'}</span>
              ${views > 0 ? `<span class="trend-bar-split"><span style="color:#60a5fa">${tf}</span><span style="color:var(--dash-text-dim)">/</span><span style="color:#4ade80">${lf}</span></span>` : ''}
            </div>
          </div>`;
        }).join('');
      }

      // Slug을 읽기 좋은 제목으로 변환
      function decodeSlug(slug) {
        if (!slug) return '';
        try {
          let decoded = decodeURIComponent(slug);
          // 날짜 접두사 제거 (2026-02-13-)
          decoded = decoded.replace(/^\d{4}-\d{2}-\d{2}-/, '');
          // 하이픈을 공백으로
          decoded = decoded.replace(/-/g, ' ');
          // 카테고리 접두사 제거 (ai/, dev/ 등)
          decoded = decoded.replace(/^(ai|dev|review|game|lifestyle|finance|health|education|travel)\//i, '');
          return decoded;
        } catch {
          return slug;
        }
      }

      // 페이지 제목 가져오기: title 필드 우선, 없으면 slug 디코딩
      function getPageTitle(item) {
        if (item.title && item.title !== 'null' && !item.title.startsWith('TechFlow') && !item.title.startsWith('LifeFlow')) {
          // "포스트 제목 | TechFlow - AI & 테크 인사이트" 형태에서 제목만 추출
          return item.title.split(' | ')[0].split(' - ')[0];
        }
        const raw = decodeSlug(item.slug || item.path || '');
        // "/" 또는 빈 경로는 홈페이지로 표시
        if (!raw || raw === '/' || raw === '/blog' || raw === '/blog/') return '홈페이지';
        return raw;
      }

      function sourceBadge(source) {
        if (source === 'blog') return '<span class="src-badge tf">TF</span>';
        if (source === 'lifeflow') return '<span class="src-badge lf">LF</span>';
        return '';
      }

      // === Top Pages 전역 데이터 & 필터 ===
      let _topPagesData = [];
      let _topPagesFilter = 'all';

      function renderTopPages(data, filter) {
        if (data !== undefined) _topPagesData = data || [];
        if (filter !== undefined) _topPagesFilter = filter;

        const container = document.getElementById('top-pages');
        if (!container) return;

        let filtered = _topPagesData;
        if (_topPagesFilter !== 'all') {
          filtered = filtered.filter(p => p.source === _topPagesFilter);
        }

        if (filtered.length === 0) {
          container.innerHTML = '<div class="no-data">No page data yet</div>';
          return;
        }

        container.innerHTML = filtered.slice(0, 8).map((p, i) => {
          const title = getPageTitle(p);
          const displayTitle = title.length > 40 ? title.substring(0, 40) + '…' : title;
          return `<div class="top-page-item">
            <span class="top-page-rank">${i + 1}</span>
            ${sourceBadge(p.source)}
            <span class="top-page-title" title="${title}">${displayTitle || '(home)'}</span>
            <span class="top-page-views">${p.views}회</span>
          </div>`;
        }).join('');
      }

      // === 추천 TOP 렌더링 ===
      function renderTopLikedPosts(data) {
        const container = document.getElementById('top-liked-posts');
        const totalEl = document.getElementById('like-top-total');
        if (!container) return;

        const list = Array.isArray(data) ? data : [];

        if (list.length === 0) {
          container.innerHTML = '<div class="no-data">아직 추천 데이터가 없습니다 &#10084;</div>';
          if (totalEl) totalEl.textContent = '';
          return;
        }

        const totalLikes = list.reduce((s, p) => s + Number(p.like_count || 0), 0);
        if (totalEl) totalEl.textContent = `(총 ${fmt(totalLikes)}개)`;

        container.innerHTML = list.map((p, i) => {
          const title = p.title && p.title !== 'null'
            ? p.title.split(' | ')[0].split(' - ')[0]
            : decodeSlug(p.slug || p.path || '');
          const displayTitle = title.length > 40 ? title.substring(0, 40) + '…' : title;
          const count = Number(p.like_count || 0);
          const maxCount = Number(list[0].like_count || 1);
          const barPct = Math.max(Math.round((count / maxCount) * 100), 4);
          const medal = i === 0 ? '🥇' : i === 1 ? '🥈' : i === 2 ? '🥉' : `${i + 1}`;
          return `<div class="like-top-item">
            <span class="top-page-rank">${medal}</span>
            ${sourceBadge(p.source)}
            <span class="top-page-title" title="${title}">${displayTitle || '(홈)'}</span>
            <div class="like-bar-wrap">
              <div class="like-bar-fill" style="width:${barPct}%"></div>
            </div>
            <span class="like-top-count">&#10084; ${fmt(count)}</span>
          </div>`;
        }).join('');
      }

      // === 카테고리별 트래픽 렌더링 ===
      function renderCategoryTraffic() {
        const tfColors = { 'AI': '#3b82f6', 'Dev': '#22c55e', 'Review': '#eab308', 'Game': '#a855f7' };
        const lfColors = {
          'Lifestyle': '#ec4899', 'Finance': '#3b82f6',
          'Health': '#22c55e', 'Education': '#a855f7', 'Travel': '#f97316',
        };

        const tfCatViews = {};
        const lfCatViews = {};

        _topPagesData.forEach(p => {
          const rawSlug = (p.slug || p.path || '').replace(/^\/blog\//, '').replace(/\/$/, '');
          const slug = decodeURIComponent(rawSlug);

          // TechFlow 매칭: TF_SLUG_CAT에서 찾기
          const tfCat = TF_SLUG_CAT[slug] || TF_SLUG_CAT[rawSlug];
          if (tfCat) {
            tfCatViews[tfCat] = (tfCatViews[tfCat] || 0) + (p.views || 0);
            return;
          }

          // LifeFlow 매칭: LF_POSTS 또는 RSS 데이터에서 카테고리 매핑
          const lfPost = LF_POSTS.find(lp => slug.includes(lp.slug) || rawSlug.includes(lp.slug));
          const rssPost = lfRssData.find(rp => {
            const rssSlug = (rp.link || '').split('/').filter(Boolean).pop() || '';
            return slug.includes(rssSlug) || rssSlug.includes(slug);
          });
          const lfCat = lfPost?.category || rssPost?.category || '';
          if (lfCat) {
            const capCat = lfCat.charAt(0).toUpperCase() + lfCat.slice(1);
            lfCatViews[capCat] = (lfCatViews[capCat] || 0) + (p.views || 0);
          }
        });

        // TechFlow 바 렌더링
        const tfContainer = document.getElementById('tf-cat-traffic-bars');
        if (tfContainer) {
          const tfEntries = Object.entries(tfCatViews).sort((a, b) => b[1] - a[1]);
          const tfMax = tfEntries.length > 0 ? tfEntries[0][1] : 1;
          const tfTotal = tfEntries.reduce((s, [, v]) => s + v, 0);

          if (tfEntries.length === 0) {
            tfContainer.innerHTML = '<div class="no-data">아직 트래픽 데이터가 없습니다</div>';
          } else {
            tfContainer.innerHTML = tfEntries.map(([cat, views]) => {
              const pct = Math.max((views / tfMax) * 100, 8);
              const color = tfColors[cat] || '#94a3b8';
              const share = tfTotal > 0 ? Math.round(views / tfTotal * 100) : 0;
              return `<div class="cat-traffic-row">
                <span class="cat-traffic-name">${cat}</span>
                <div class="cat-traffic-bar-wrap">
                  <div class="cat-traffic-bar" style="width:${pct}%;background:${color}"></div>
                </div>
                <span class="cat-traffic-value">${fmt(views)}회</span>
                <span class="cat-traffic-share">${share}%</span>
              </div>`;
            }).join('');
          }
        }

        // LifeFlow 바 렌더링
        const lfContainer = document.getElementById('lf-cat-traffic-bars');
        if (lfContainer) {
          const lfEntries = Object.entries(lfCatViews).sort((a, b) => b[1] - a[1]);
          const lfMax = lfEntries.length > 0 ? lfEntries[0][1] : 1;
          const lfTotal = lfEntries.reduce((s, [, v]) => s + v, 0);

          if (lfEntries.length === 0) {
            lfContainer.innerHTML = '<div class="no-data">아직 트래픽 데이터가 없습니다</div>';
          } else {
            lfContainer.innerHTML = lfEntries.map(([cat, views]) => {
              const pct = Math.max((views / lfMax) * 100, 8);
              const color = lfColors[cat] || '#94a3b8';
              const share = lfTotal > 0 ? Math.round(views / lfTotal * 100) : 0;
              return `<div class="cat-traffic-row">
                <span class="cat-traffic-name">${cat}</span>
                <div class="cat-traffic-bar-wrap">
                  <div class="cat-traffic-bar" style="width:${pct}%;background:${color}"></div>
                </div>
                <span class="cat-traffic-value">${fmt(views)}회</span>
                <span class="cat-traffic-share">${share}%</span>
              </div>`;
            }).join('');
          }
        }
      }

      // === Event Feed 전역 데이터 & 필터 ===
      let _eventsData = [];
      let _eventsFilter = 'all';

      function renderEventFeed(data, filter) {
        if (data !== undefined) _eventsData = data || [];
        if (filter !== undefined) _eventsFilter = filter;

        const container = document.getElementById('event-feed');
        if (!container) return;

        let filtered = _eventsData;
        if (_eventsFilter !== 'all') {
          filtered = filtered.filter(e => e.source === _eventsFilter);
        }

        if (filtered.length === 0) {
          container.innerHTML = '<div class="no-data">No events yet. Visit the blog to generate data!</div>';
          return;
        }

        container.innerHTML = filtered.slice(0, 12).map(e => {
          const icon = EVENT_ICONS[e.event_type] || '\u2022';
          const label = EVENT_LABELS[e.event_type] || e.event_type;
          const title = getPageTitle(e);
          const shortTitle = title.length > 35 ? title.substring(0, 35) + '…' : title;
          const srcBadge = sourceBadge(e.source);

          return `<div class="event-item">
            <span class="event-icon ${e.event_type}">${icon}</span>
            <div class="event-content">
              <div class="event-action">${srcBadge} ${label}</div>
              <div class="event-page-title" title="${title}">${shortTitle || '홈페이지'}</div>
            </div>
            <span class="event-time">${timeAgo(e.created_at)}</span>
          </div>`;
        }).join('');
      }

      // 소스 필터 탭 이벤트
      document.getElementById('top-pages-tabs')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.source-tab');
        if (!btn) return;
        document.querySelectorAll('#top-pages-tabs .source-tab').forEach(b => b.className = 'source-tab');
        const f = btn.dataset.filter;
        btn.className = 'source-tab ' + (f === 'blog' ? 'active-tf' : f === 'lifeflow' ? 'active-lf' : 'active');
        renderTopPages(undefined, f);
      });

      document.getElementById('event-tabs')?.addEventListener('click', (e) => {
        const btn = e.target.closest('.source-tab');
        if (!btn) return;
        document.querySelectorAll('#event-tabs .source-tab').forEach(b => b.className = 'source-tab');
        const f = btn.dataset.filter;
        btn.className = 'source-tab ' + (f === 'blog' ? 'active-tf' : f === 'lifeflow' ? 'active-lf' : 'active');
        renderEventFeed(undefined, f);
      });

      async function loadTraffic() {
        try {
          const [summary, hourly, topPages, events, trend, topLiked, dailyDetail, heatmap] = await Promise.all([
            rpc('get_traffic_summary'),
            rpc('get_hourly_views'),
            rpc('get_top_pages', { p_limit: 50 }),
            rpc('get_recent_events', { p_limit: 20 }),
            rpc('get_daily_trend'),
            rpc('get_top_liked_posts', { p_limit: 10 }),
            rpc('get_daily_detail', { p_days: 30 }),
            rpc('get_daily_hourly_heatmap', { p_days: 14 })
          ]);

          // Metrics
          const tv = Number(summary?.today_views) || 0;
          const yv = Number(summary?.yesterday_views) || 0;
          const tc = Number(summary?.today_clicks) || 0;
          const tl = Number(summary?.today_likes) || 0;
          const ts = Number(summary?.today_subscribers) || 0;

          document.getElementById('t-today-views').textContent = fmt(tv);
          const vd = deltaText(tv, yv);
          const vdEl = document.getElementById('t-views-delta');
          vdEl.textContent = vd.text;
          vdEl.className = `metric-delta ${vd.cls}`;

          document.getElementById('t-today-clicks').textContent = fmt(tc);
          const cdEl = document.getElementById('t-clicks-delta');
          cdEl.textContent = `total: ${fmt(Number(summary?.total_clicks) || 0)}`;
          cdEl.className = 'metric-delta neutral';

          document.getElementById('t-today-likes').textContent = fmt(tl);
          document.getElementById('t-likes-total').textContent = `total: ${fmt(Number(summary?.total_likes) || 0)}`;

          document.getElementById('t-subscribers').textContent = fmt(Number(summary?.total_subscribers) || 0);
          document.getElementById('t-subs-today').textContent = `today: +${ts}`;

          // Source breakdown
          const tfTv = Number(summary?.tf_today_views) || 0;
          const lfTv = Number(summary?.lf_today_views) || 0;
          const tfTc = Number(summary?.tf_today_clicks) || 0;
          const lfTc = Number(summary?.lf_today_clicks) || 0;

          const vbEl = document.getElementById('t-views-breakdown');
          if (vbEl) vbEl.innerHTML = `<span><i class="dot-tf"></i> TF: ${fmt(tfTv)}</span><span><i class="dot-lf"></i> LF: ${fmt(lfTv)}</span>`;

          const cbEl = document.getElementById('t-clicks-breakdown');
          if (cbEl) cbEl.innerHTML = `<span><i class="dot-tf"></i> TF: ${fmt(tfTc)}</span><span><i class="dot-lf"></i> LF: ${fmt(lfTc)}</span>`;

          // Also update summary cards
          document.getElementById('total-views').textContent = fmt(Number(summary?.total_views) || 0);
          document.getElementById('views-sub').textContent = tv > 0 ? `today +${tv}` : 'Collecting...';
          document.getElementById('total-clicks').textContent = fmt(Number(summary?.total_clicks) || 0);
          document.getElementById('clicks-sub').textContent = tc > 0 ? `today +${tc}` : 'Waiting...';

          // Summary card source split
          const tfTotal = Number(summary?.tf_total_views) || 0;
          const lfTotal = Number(summary?.lf_total_views) || 0;
          const totalV = Number(summary?.total_views) || 1;
          const tfTotalEl = document.getElementById('tf-total-views');
          const lfTotalEl = document.getElementById('lf-total-views');
          if (tfTotalEl) tfTotalEl.textContent = fmt(tfTotal);
          if (lfTotalEl) lfTotalEl.textContent = fmt(lfTotal);

          // Animated split bar
          const splitTfEl = document.getElementById('views-split-tf');
          const splitLfEl = document.getElementById('views-split-lf');
          if (splitTfEl) splitTfEl.style.width = Math.round(tfTotal / totalV * 100) + '%';
          if (splitLfEl) splitLfEl.style.width = Math.round(lfTotal / totalV * 100) + '%';

          // === 탭별 데이터 업데이트 ===
          // TechFlow 탭
          const tfTabViewsEl = document.getElementById('tf-tab-views');
          const tfTabClicksEl = document.getElementById('tf-tab-clicks');
          const tfTabCvrEl = document.getElementById('tf-tab-cvr');
          if (tfTabViewsEl) tfTabViewsEl.textContent = fmt(tfTotal);
          if (tfTabClicksEl) tfTabClicksEl.textContent = fmt(Number(summary?.tf_total_clicks) || 0);
          if (tfTabCvrEl) {
            const tfCvr = tfTotal > 0 ? ((Number(summary?.tf_total_clicks) || 0) / tfTotal * 100).toFixed(2) : 0;
            tfTabCvrEl.textContent = tfCvr + '%';
          }
          const tfTabViewsSubEl = document.getElementById('tf-tab-views-sub');
          const tfTabClicksSubEl = document.getElementById('tf-tab-clicks-sub');
          if (tfTabViewsSubEl) tfTabViewsSubEl.textContent = tfTv > 0 ? `오늘 +${fmt(tfTv)}` : '수집 중...';
          if (tfTabClicksSubEl) tfTabClicksSubEl.textContent = tfTc > 0 ? `오늘 +${fmt(tfTc)}` : '대기 중...';

          // LifeFlow 탭
          const lfTabViewsEl = document.getElementById('lf-tab-views');
          const lfTabClicksEl = document.getElementById('lf-tab-clicks');
          const lfTabCvrEl = document.getElementById('lf-tab-cvr');
          if (lfTabViewsEl) lfTabViewsEl.textContent = fmt(lfTotal);
          if (lfTabClicksEl) lfTabClicksEl.textContent = fmt(Number(summary?.lf_total_clicks) || 0);
          if (lfTabCvrEl) {
            const lfCvr = lfTotal > 0 ? ((Number(summary?.lf_total_clicks) || 0) / lfTotal * 100).toFixed(2) : 0;
            lfTabCvrEl.textContent = lfCvr + '%';
          }
          const lfTabViewsSubEl = document.getElementById('lf-tab-views-sub');
          const lfTabClicksSubEl = document.getElementById('lf-tab-clicks-sub');
          if (lfTabViewsSubEl) lfTabViewsSubEl.textContent = lfTv > 0 ? `오늘 +${fmt(lfTv)}` : '수집 중...';
          if (lfTabClicksSubEl) lfTabClicksSubEl.textContent = lfTc > 0 ? `오늘 +${fmt(lfTc)}` : '대기 중...';

          // 쿠팡 탭
          const coupTotalClicksEl = document.getElementById('coup-total-clicks');
          const coupTodayClicksEl = document.getElementById('coup-today-clicks');
          const coupCtrEl = document.getElementById('coup-ctr');
          const coupTfCtrEl = document.getElementById('coup-tf-ctr');
          const coupLfCtrEl = document.getElementById('coup-lf-ctr');
          const totalClicks = Number(summary?.total_clicks) || 0;
          if (coupTotalClicksEl) coupTotalClicksEl.textContent = fmt(totalClicks);
          if (coupTodayClicksEl) coupTodayClicksEl.textContent = fmt(tc);
          if (coupCtrEl) {
            const overallCtr = totalV > 0 ? (totalClicks / totalV * 100).toFixed(2) : 0;
            coupCtrEl.textContent = overallCtr + '%';
          }
          if (coupTfCtrEl) {
            const tfCtr = tfTotal > 0 ? ((Number(summary?.tf_total_clicks) || 0) / tfTotal * 100).toFixed(2) : 0;
            coupTfCtrEl.textContent = tfCtr + '%';
          }
          if (coupLfCtrEl) {
            const lfCtr = lfTotal > 0 ? ((Number(summary?.lf_total_clicks) || 0) / lfTotal * 100).toFixed(2) : 0;
            coupLfCtrEl.textContent = lfCtr + '%';
          }
          const coupTfDetailEl = document.getElementById('coup-tf-detail');
          const coupLfDetailEl = document.getElementById('coup-lf-detail');
          if (coupTfDetailEl) coupTfDetailEl.textContent = `${fmt(Number(summary?.tf_total_clicks) || 0)} / ${fmt(tfTotal)}`;
          if (coupLfDetailEl) coupLfDetailEl.textContent = `${fmt(Number(summary?.lf_total_clicks) || 0)} / ${fmt(lfTotal)}`;

          // 쿠팡 클릭 이벤트 필터
          const coupangEvents = events.filter(e => e.event_type === 'coupang_click');
          const coupangEventsEl = document.getElementById('coupang-events');
          if (coupangEventsEl) {
            if (coupangEvents.length === 0) {
              coupangEventsEl.innerHTML = '<div class="no-data">아직 쿠팡 클릭 데이터가 없습니다.</div>';
            } else {
              coupangEventsEl.innerHTML = coupangEvents.slice(0, 15).map(e => {
                const icon = '🛒';
                const title = getPageTitle(e);
                const shortTitle = title.length > 40 ? title.substring(0, 40) + '…' : title;
                const srcBadge = sourceBadge(e.source);
                return `<div class="event-item">
                  <span class="event-icon coupang_click">${icon}</span>
                  <div class="event-content">
                    <div class="event-action">${srcBadge} Coupang Click</div>
                    <div class="event-page-title" title="${title}">${shortTitle || '홈페이지'}</div>
                  </div>
                  <span class="event-time">${timeAgo(e.created_at)}</span>
                </div>`;
              }).join('');
            }
          }

          // Charts & feeds
          renderHourlyChart(hourly);
          renderTopPages(topPages);
          renderEventFeed(events);
          renderTrendChart(trend);
          renderDailyDetail(dailyDetail);
          renderHeatmap(heatmap);
          renderCategoryTraffic();
          renderTopLikedPosts(topLiked);

          document.getElementById('last-updated').textContent =
            `Updated: ${new Date().toLocaleString('ko-KR')}`;

        } catch (e) {
          console.error('Traffic load error:', e);
        }
      }

      document.getElementById('refresh-traffic')?.addEventListener('click', () => {
        loadTraffic();
      });

      // === 탭 전환 로직 ===
      const mainTabs = document.querySelectorAll('.main-tab');
      const tabContents = document.querySelectorAll('.tab-content');

      mainTabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const targetTab = tab.dataset.tab;

          // 모든 탭 비활성화
          mainTabs.forEach(t => {
            t.classList.remove('active', 'active-tf', 'active-lf', 'active-coupang');
          });

          // 클릭한 탭 활성화
          if (targetTab === 'techflow') {
            tab.classList.add('active-tf');
          } else if (targetTab === 'lifeflow') {
            tab.classList.add('active-lf');
          } else if (targetTab === 'coupang') {
            tab.classList.add('active-coupang');
          } else if (targetTab === 'comments') {
            tab.classList.add('active-comments');
            loadCommentDashboard();
          } else {
            tab.classList.add('active');
          }

          // 모든 탭 콘텐츠 숨김
          tabContents.forEach(content => {
            content.classList.remove('active');
          });

          // 선택한 탭 콘텐츠 표시
          const targetContent = document.getElementById(`tab-${targetTab}`);
          if (targetContent) {
            targetContent.classList.add('active');
          }
        });
      });

      // ========== 댓글 관리 ==========
      let adminKey = localStorage.getItem('dash-admin-key') || '';
      let allComments = [];
      let currentFilter = 'all';

      // 관리자 인증
      document.getElementById('admin-key-submit')?.addEventListener('click', verifyAdminKey);
      document.getElementById('admin-key-input')?.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') verifyAdminKey();
      });

      function verifyAdminKey() {
        const input = document.getElementById('admin-key-input');
        const key = input?.value?.trim();
        if (!key) return;
        adminKey = key;
        localStorage.setItem('dash-admin-key', key);
        showCommentDashboard();
      }

      function showCommentDashboard() {
        const gate = document.getElementById('comment-auth');
        const dash = document.getElementById('comment-dashboard');
        if (gate) gate.style.display = 'none';
        if (dash) dash.style.display = 'block';
        loadCommentData();
      }

      // 저장된 키가 있으면 자동 인증
      function loadCommentDashboard() {
        if (adminKey) {
          showCommentDashboard();
        }
      }

      async function loadCommentData() {
        try {
          // 통계 + 목록 + 트렌드 병렬 로드
          const [stats, comments, trend] = await Promise.all([
            rpc('get_comment_stats'),
            rpc('get_all_comments', { p_limit: 100, p_offset: 0 }),
            rpc('get_comment_trend')
          ]);

          // 통계 카드 업데이트
          if (stats && typeof stats === 'object') {
            document.getElementById('cm-total').textContent = fmt(stats.total || 0);
            document.getElementById('cm-today').textContent = fmt(stats.today || 0);
            document.getElementById('cm-reports').textContent = fmt(stats.reports || 0);
            document.getElementById('cm-by-source').textContent =
              `TechFlow ${stats.blog_count || 0} / LifeFlow ${stats.lifeflow_count || 0}`;
          }

          // 댓글 목록 저장 + 렌더
          allComments = Array.isArray(comments) ? comments : [];
          renderComments();

          // 트렌드 차트
          renderTrend(Array.isArray(trend) ? trend : []);

        } catch (e) {
          console.error('Comment data load error:', e);
        }
      }

      function renderComments() {
        const container = document.getElementById('comment-list');
        if (!container) return;

        let filtered = allComments;
        if (currentFilter === 'blog') {
          filtered = allComments.filter(c => c.source === 'blog');
        } else if (currentFilter === 'lifeflow') {
          filtered = allComments.filter(c => c.source === 'lifeflow');
        } else if (currentFilter === 'reported') {
          filtered = allComments.filter(c => (c.report_count || 0) > 0);
        }

        if (filtered.length === 0) {
          container.innerHTML = '<div class="no-data">표시할 댓글이 없습니다.</div>';
          return;
        }

        container.innerHTML = filtered.map(c => {
          const srcClass = c.source === 'blog' ? 'tf' : 'lf';
          const srcLabel = c.source === 'blog' ? 'TF' : 'LF';
          const date = new Date(c.created_at).toLocaleString('ko-KR', {
            month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit'
          });
          const reportBadge = (c.report_count || 0) > 0
            ? `<span class="cm-report-badge">신고 ${c.report_count}</span>` : '';
          const adminBadge = c.is_admin
            ? '<span class="cm-admin-badge">관리자</span>' : '';
          const parentNote = c.parent_id
            ? '<span style="color:var(--dash-cyan);">↩ 답글</span>' : '';

          return `
            <div class="cm-item" data-id="${c.id}" data-slug="${c.post_slug}" data-source="${c.source}">
              <span class="cm-source ${srcClass}">${srcLabel}</span>
              <div class="cm-body">
                <div class="cm-meta">
                  <span class="cm-nickname">${escHtml(c.nickname)}</span>
                  ${adminBadge}${reportBadge}${parentNote}
                  <span>${date}</span>
                </div>
                <div class="cm-content">${escHtml(c.content)}</div>
                <div class="cm-slug">📄 ${escHtml(c.post_slug)}</div>
              </div>
              <div class="cm-actions">
                <button class="cm-btn" onclick="toggleReplyForm('${c.id}')">💬 답변</button>
                <button class="cm-btn danger" onclick="adminDeleteComment('${c.id}')">🗑 삭제</button>
              </div>
            </div>
          `;
        }).join('');
      }

      function escHtml(s) {
        if (!s) return '';
        return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      // 답변 폼 토글
      window.toggleReplyForm = function(commentId) {
        const item = document.querySelector(`.cm-item[data-id="${commentId}"]`);
        if (!item) return;
        const existing = item.querySelector('.cm-reply-form');
        if (existing) { existing.remove(); return; }

        const body = item.querySelector('.cm-body');
        const form = document.createElement('div');
        form.className = 'cm-reply-form';
        form.innerHTML = `
          <input type="text" placeholder="관리자 답변 입력..." id="reply-input-${commentId}" />
          <button onclick="submitAdminReply('${commentId}')">전송</button>
        `;
        body.appendChild(form);
        form.querySelector('input').focus();
      };

      // 관리자 답변 전송
      window.submitAdminReply = async function(commentId) {
        const input = document.getElementById(`reply-input-${commentId}`);
        const content = input?.value?.trim();
        if (!content) return;

        const item = document.querySelector(`.cm-item[data-id="${commentId}"]`);
        const slug = item?.dataset.slug;
        const source = item?.dataset.source;

        try {
          const result = await rpc('admin_reply', {
            p_parent_id: commentId,
            p_slug: slug,
            p_source: source || 'blog',
            p_content: content,
            p_admin_key: adminKey
          });

          if (result?.success) {
            loadCommentData();
          } else if (result?.error === 'unauthorized') {
            alert('관리자 키가 올바르지 않습니다. 다시 인증해 주세요.');
            localStorage.removeItem('dash-admin-key');
            adminKey = '';
            document.getElementById('comment-auth').style.display = 'flex';
            document.getElementById('comment-dashboard').style.display = 'none';
          } else {
            alert('답변 전송 실패: ' + (result?.error || 'unknown'));
          }
        } catch (e) {
          alert('답변 전송 중 오류가 발생했습니다.');
          console.error(e);
        }
      };

      // 관리자 삭제
      window.adminDeleteComment = async function(commentId) {
        if (!confirm('이 댓글을 삭제하시겠습니까?')) return;
        try {
          const result = await rpc('admin_delete_comment', {
            p_id: commentId,
            p_admin_key: adminKey
          });

          if (result?.success) {
            loadCommentData();
          } else if (result?.error === 'unauthorized') {
            alert('관리자 키가 올바르지 않습니다.');
            localStorage.removeItem('dash-admin-key');
            adminKey = '';
          } else {
            alert('삭제 실패: ' + (result?.error || 'unknown'));
          }
        } catch (e) {
          alert('삭제 중 오류가 발생했습니다.');
          console.error(e);
        }
      };

      // 트렌드 차트 렌더
      function renderTrend(data) {
        const container = document.getElementById('comment-trend-chart');
        if (!container) return;

        if (data.length === 0) {
          container.innerHTML = '<div class="no-data">최근 7일간 댓글이 없습니다.</div>';
          return;
        }

        const maxCount = Math.max(...data.map(d => d.count), 1);
        const maxH = 120;

        const barsHtml = data.map(d => {
          const tfH = Math.max((d.blog_count / maxCount) * maxH, 4);
          const lfH = Math.max((d.lf_count / maxCount) * maxH, 4);
          const dayLabel = new Date(d.day).toLocaleDateString('ko-KR', { month: 'numeric', day: 'numeric' });
          return `
            <div class="trend-bar-group">
              <div class="trend-count">${d.count}</div>
              <div class="trend-bars">
                <div class="trend-bar tf" style="height:${tfH}px" title="TF: ${d.blog_count}"></div>
                <div class="trend-bar lf" style="height:${lfH}px" title="LF: ${d.lf_count}"></div>
              </div>
              <div class="trend-label">${dayLabel}</div>
            </div>
          `;
        }).join('');

        container.innerHTML = barsHtml +
          '<div class="trend-legend"><span class="leg-tf">TechFlow</span><span class="leg-lf">LifeFlow</span></div>';
      }

      // 필터 버튼
      document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          currentFilter = btn.dataset.source;
          renderComments();
        });
      });

      // 새로고침 버튼
      document.getElementById('refresh-comments')?.addEventListener('click', () => {
        loadCommentData();
      });

      // Init
      fetchLifeFlowRSS();
      loadTraffic();
      checkSupabase();
      setInterval(loadTraffic, 30000);
    </script>
  </body>
</html>
