            </a>
            <a href="https://analytics.google.com" target="_blank" rel="noopener" class="link-btn">
              <span class="link-icon">&#128200;</span>
              Google Analytics
            </a>
          </div>
        </div>
      </div>
      </div>
      <!-- End Tab: 전체 요약 -->

      <!-- Tab: TechFlow -->
      <div class="tab-content" id="tab-techflow">
        <div class="summary-grid">
          <div class="summary-card accent-blue">
            <div class="label">TechFlow Posts</div>
            <div class="value">{tfPostCount}</div>
            <div class="sub">{tfCategoryStats.length} 카테고리</div>
          </div>
          <div class="summary-card accent-purple">
            <div class="label">조회수</div>
