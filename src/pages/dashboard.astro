          <div class="source-split-bar" id="views-split-bar">
            <div class="split-tf" id="views-split-tf" style="width:50%"></div>
            <div class="split-lf" id="views-split-lf" style="width:50%"></div>
          </div>
          <div class="split-legend">
            <span>TF: <b id="tf-total-views">--</b></span>
            <span>LF: <b id="lf-total-views">--</b></span>
          </div>
        </div>
        <div class="summary-card accent-purple color-purple">
          <div class="kpi-top">
            <span class="kpi-chip"><svg class="ico" viewBox="0 0 24 24" set:html={ICONS['file-text']}></svg></span>
            <div class="label">Paperdoc Clicks</div>
          </div>
          <div class="kpi-value-row">
            <div class="value" id="pd-summary-clicks">--</div>
            <span class="delta-chip flat" id="pd-summary-delta">--</span>
          </div>
          <div class="sub" id="pd-summary-sub">추적 중...</div>
        </div>
        <div class="summary-card accent-yellow color-amber">
          <div class="kpi-top">
            <span class="kpi-chip"><svg class="ico" viewBox="0 0 24 24" set:html={ICONS['cart']}></svg></span>
            <div class="label">Coupang Clicks</div>
          </div>
          <div class="kpi-value-row">
            <div class="value" id="total-clicks">--</div>
            <span class="delta-chip flat" id="clicks-delta-chip">--</span>
          </div>
          <div class="sub" id="clicks-sub">추적 중...</div>
        </div>
      </div>


      <!-- ══ Row 2: 방문 추이 (일간/주간/월간 토글) ══ -->
      <div class="trend-section">
        <div class="trend-header">
