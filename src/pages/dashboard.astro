            <span class="delta-chip flat" id="traffic-compare" title="이전 동기간 대비">--</span>
            <div class="trend-total"><b id="traffic-total">--</b></div>
          </div>
        </div>
        <div class="traffic-split">
          <div class="traffic-chart-wrap">
            <div class="chart-tip" id="chart-tip"></div>
            <div class="trend-chart line-chart" id="traffic-chart">
              <div class="no-data">Loading...</div>
            </div>
            <div class="trend-legend" id="traffic-legend">
              <span class="leg-tf">TechFlow</span>
              <span class="leg-lf">LifeFlow</span>
            </div>
          </div>
          <div class="traffic-table-wrap">
            <div class="traffic-list-head">
              <span id="tl-col0">날짜</span>
              <span id="tl-metric-label">조회수</span>
            </div>
            <div class="traffic-list" id="traffic-list">
