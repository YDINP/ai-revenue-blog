              <div class="cat-legend">
                {tfCategoryStats.map((c) => (
                  <div class="cat-legend-item">
                    <span class="cat-legend-dot" style={`background:${tfCatColor(c.name)}`}></span>
                    <span class="cat-legend-name">{c.name}</span>
                    <span class="cat-legend-count">{c.count}</span>
                    <span class="cat-legend-pct">{Math.round(c.count / tfPostCount * 100)}%</span>
