---
import '../styles/global.css';
import { getCollection } from 'astro:content';

// TechFlow 실제 블로그 포스트 파일 기반 통계 (빌드 타임)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const tfPostCount = allPosts.length;
// 슬러그→현재 제목 맵 — topPages가 analytics에 저장된(옛) 제목 대신 현재 제목을 쓰게(제목 변경 즉시 반영)
const slugTitles: Record<string, string> = {};
for (const p of allPosts) slugTitles[String(p.id).replace(/\.mdx?$/, '')] = p.data.title;

// TechFlow 카테고리별 포스트 수
const tfCategoryMap: Record<string, number> = {};
for (const post of allPosts) {
  const cat = post.data.category;
  tfCategoryMap[cat] = (tfCategoryMap[cat] || 0) + 1;
}

// 카테고리 고정 색상 (엔티티 기준 — 정렬 순서가 바뀌어도 색은 따라가지 않음)
// 다크 서피스(#1e293b) 대비 검증 통과 팔레트
const TF_CAT_COLORS: Record<string, string> = {
  AI: '#3b82f6',
  Dev: '#16a34a',
  Review: '#bf8700',
  Game: '#a855f7',
};
const CAT_FALLBACK_COLORS = ['#ea580c', '#ec4899', '#0891b2'];

const tfCategoryStats = Object.entries(tfCategoryMap)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

// 고정 매핑에 없는 카테고리는 이름순으로 폴백 색상 할당 (결정적)
{
  const unknown = tfCategoryStats
    .filter(c => !TF_CAT_COLORS[c.name])
    .map(c => c.name)
    .sort();
  unknown.forEach((name, i) => {
    TF_CAT_COLORS[name] = CAT_FALLBACK_COLORS[i % CAT_FALLBACK_COLORS.length];
  });
}
const tfCatColor = (name: string) => TF_CAT_COLORS[name] || '#94a3b8';

// TechFlow 최근 포스트 (최신 5개)
const tfRecentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5)
  .map(p => ({
    title: p.data.title,
    category: p.data.category,
    pubDate: p.data.pubDate.toISOString().split('T')[0],
    slug: p.id,
  }));

// LifeFlow 데이터: 별도 레포/사이트라 파일을 직접 읽을 수 없어 RSS 로 집계한다.
// 빌드 타임에 한 번 파싱 → 모든 섹션(KPI·도넛·범례)이 실제 편수를 렌더.
// 빌드 중 RSS 를 못 받으면 0 으로 두고, 브라우저의 fetchLifeFlowRSS() 가 채운다.
const LF_CAT_COLORS: Record<string, string> = {
  Lifestyle: '#ec4899',
  Finance: '#3b82f6',
  Health: '#16a34a',
  Education: '#a855f7',
  Travel: '#ea580c',
};
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

type LfPost = { title: string; slug: string; category: string; date: string };
let lfPosts: LfPost[] = [];
try {
  const res = await fetch('https://life-revenue-blog.vercel.app/rss.xml');
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
  const xml = await res.text();
  lfPosts = xml.split('<item>').slice(1).map((item) => {
    const pick = (tag: string) =>
      item.match(new RegExp(`<${tag}>(?:<!\\[CDATA\\[)?([\\s\\S]*?)(?:\\]\\]>)?</${tag}>`))?.[1]?.trim() || '';
    const link = pick('link');
    return {
      title: pick('title'),
      slug: link.split('/').filter(Boolean).pop() || '',
      // 첫 <category> 만 frontmatter.category, 뒤따르는 것들은 태그다
      category: cap(pick('category')),
      date: pick('pubDate'),
    };
  });
} catch (e) {
  console.warn('[dashboard] LifeFlow RSS 빌드타임 로드 실패 — 클라이언트 로드에 위임:', e);
}

const lfCategoryMap: Record<string, number> = {};
for (const p of lfPosts) {
  if (p.category) lfCategoryMap[p.category] = (lfCategoryMap[p.category] || 0) + 1;
}
const lfCategories = Object.entries(lfCategoryMap)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count, color: LF_CAT_COLORS[name] || '#94a3b8' }));
const lfPostCount = lfPosts.length;
const lfCategoryCount = lfCategories.length;

// 통합 통계 (분모 0 방지 — RSS 실패 시에도 레이아웃이 깨지지 않게)
// VIP(playcast)는 별도 Vercel 레포라 빌드타임 파일 카운트 불가 → 발행 글 수 수동 상수
const vipPostCount = 12;
const totalPosts = tfPostCount + lfPostCount + vipPostCount;
const totalCategories = tfCategoryStats.length + lfCategoryCount;
const pctBase = totalPosts || 1;
const lfBase = lfPostCount || 1;

// 라인 아이콘 (Lucide 계열, 24x24 stroke) — set:html로 <svg>에 주입
const ICONS: Record<string, string> = {
  'file-text': '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><line x1="10" y1="9" x2="8" y2="9"/>',
  'layers': '<polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/>',
  'eye': '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
  'cart': '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>',
  'trending-up': '<polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/>',
  'clock': '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  'bar-chart': '<line x1="6" y1="20" x2="6" y2="14"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="18" y1="20" x2="18" y2="10"/>',
  'grid': '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>',
  'list': '<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/>',
  'activity': '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
  'heart': '<path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 1 0-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 0 0 0-7.78z"/>',
  'pie': '<path d="M21.21 15.89A10 10 0 1 1 8 2.83"/><path d="M22 12A10 10 0 0 0 12 2v10z"/>',
  'table': '<rect x="3" y="3" width="18" height="18" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="3" y1="15" x2="21" y2="15"/><line x1="12" y1="3" x2="12" y2="21"/>',
  'server': '<rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>',
  'link': '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/>',
  'percent': '<line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/>',
  'message': '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  'calendar': '<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>',
  'alert': '<path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
};
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Dashboard | TechFlow + LifeFlow</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css" rel="stylesheet" />
    <style is:global>
      /* ============================================================
         Dashboard 스타일 시스템 — 2026 리모델 (단일 패스)
         원칙: 뉴트럴 다크 / 헤어라인 보더 / 플랫(그라데이션·섀도 없음)
               애니메이션 없음(스피너 제외) / KPI 우선 계층 / tabular-nums
         팔레트: 다크 서피스(#131316) 대비 validator 통과본
         ============================================================ */
      :root {
        --bg: #0a0a0c;
        --surface: #131316;
        --surface-2: #1b1b20;
        --border: rgba(255, 255, 255, 0.08);
        --border-strong: rgba(255, 255, 255, 0.14);
        --text: #ededf0;
        --text-2: #a1a1aa;
        --text-3: #7c7c87;
        --accent: #3b82f6;
        --tf: #3b82f6;
        --lf: #16a34a;
        /* 뭉게(mungge.com) — TF 파랑·LF 초록·VIP 민트와 안 겹치도록 앰버 */
        --mg: #f59e0b;
        --good: #22c55e;
        --warn: #eab308;
        --bad: #ef4444;
        --like: #e11d48;
        --r: 12px;
        --r-sm: 8px;
        /* 구형 변수명 호환 (인라인 스타일에서 참조) */
        --dash-bg: var(--bg);
        --dash-surface: var(--surface);
        --dash-surface-hover: var(--surface-2);
        --dash-border: var(--border);
        --dash-text: var(--text);
        --dash-text-dim: var(--text-2);
        --dash-accent: var(--accent);
        --dash-green: var(--lf);
        --dash-yellow: var(--warn);
        --dash-red: var(--bad);
        --dash-purple: #a855f7;
        --dash-orange: #ea580c;
        --dash-pink: #ec4899;
        --dash-cyan: #0891b2;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Pretendard Variable', 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        flex-direction: column; /* global.css의 body{display:flex} 대응 */
      }

      ::selection { background: rgba(59, 130, 246, 0.35); }

      button { font-family: inherit; }

      button:focus-visible, a:focus-visible, input:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      /* ── 헤더 ─────────────────────────────────────────── */
      .dash-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(10, 10, 12, 0.88);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid var(--border);
        padding: 0.875rem 1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        min-width: 0;
        width: 100%;
      }

      .dash-header h1 {
        font-size: 1rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        letter-spacing: -0.01em;
      }

      .logo-tf { color: var(--tf); }
      .logo-lf { color: #4ade80; }
      .logo-sep { color: var(--text-3); font-weight: 400; }

      .dash-header .meta {
        font-size: 0.8125rem;
        color: var(--text-2);
        display: flex;
        align-items: center;
        gap: 0.875rem;
      }

      .live-dot {
        width: 7px;
        height: 7px;
        background: var(--good);
        border-radius: 50%;
      }

      /* ── 레이아웃 ─────────────────────────────────────── */
      .dash-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem;
        min-width: 0;
        width: 100%;
      }

      /* ── 배너 ─────────────────────────────────────────── */
      .data-banner {
        padding: 0.875rem 1.125rem;
        border-radius: var(--r-sm);
        margin-bottom: 1.25rem;
        font-size: 0.8125rem;
        line-height: 1.6;
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        border: 1px solid;
      }

      .data-banner.info {
        background: rgba(59, 130, 246, 0.08);
        border-color: rgba(59, 130, 246, 0.25);
        color: #93bbfd;
      }

      .data-banner.warning {
        background: rgba(234, 179, 8, 0.08);
        border-color: rgba(234, 179, 8, 0.25);
        color: #fde68a;
      }

      .data-banner .banner-icon { flex-shrink: 0; margin-top: 1px; }

      /* ── 메인 탭 ──────────────────────────────────────── */
      .main-tabs {
        display: flex;
        gap: 0.375rem;
        margin-bottom: 1.25rem;
        border-bottom: 1px solid var(--border);
        padding-bottom: 0;
      }

      .main-tab {
        padding: 0.5rem 0.875rem 0.625rem;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        border-bottom: 2px solid transparent;
        margin-bottom: -1px;
        background: transparent;
        color: var(--text-2);
      }

      .main-tab:hover { color: var(--text); }

      .main-tab.active,
      .main-tab.active-tf,
      .main-tab.active-lf,
      .main-tab.active-coupang,
      .main-tab.active-paperdoc,
      .main-tab.active-comments,
      .main-tab.active-vip {
        color: var(--text);
        border-bottom-color: var(--accent);
      }

      .tab-content { display: none; }
      .tab-content.active { display: block; }

      /* ── GSC 상세 탭 ─────────────────────────────────── */
      .gsc-controls { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-bottom: 1rem; }
      .gsc-seg { display: inline-flex; background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
      .gsc-seg button { border: none; background: transparent; color: var(--text-2); font-size: 0.75rem; font-weight: 600; padding: 0.35rem 0.7rem; cursor: pointer; }
      .gsc-seg button.active { background: var(--accent); color: #fff; }
      .gsc-updated { font-size: 0.7rem; color: var(--text-3); margin-left: auto; }
      .gsc-kpi-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.6rem; margin-bottom: 1.25rem; }
      .gsc-kpi-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 0.75rem 0.85rem; }
      .gsc-kpi-k { font-size: 0.72rem; color: var(--text-2); margin-bottom: 0.25rem; }
      .gsc-kpi-v { font-size: 1.35rem; font-weight: 800; font-variant-numeric: tabular-nums; margin-bottom: 0.3rem; }
      .gsc-sec-title { font-weight: 800; font-size: 0.9rem; margin-bottom: 0.6rem; }
      .gsc-sec-title span { font-weight: 500; color: var(--text-2); font-size: 0.72rem; }
      .gsc-metric-tabs { display: inline-flex; flex-wrap: wrap; gap: 0.25rem; margin-bottom: 0.75rem; }
      .gsc-metric-tabs button { border: 1px solid var(--border); background: var(--surface-2); color: var(--text-2); font-size: 0.72rem; font-weight: 600; padding: 0.3rem 0.65rem; border-radius: 999px; cursor: pointer; }
      .gsc-metric-tabs button.active { background: var(--accent); color: #fff; border-color: var(--accent); }
      .gsc-chart-wrap { width: 100%; position: relative; }
      .gsc-chart-wrap svg { max-width: 100%; }
      .gsc-tip { position: absolute; z-index: 5; pointer-events: none; background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem 0.6rem; font-size: 0.72rem; min-width: 120px; box-shadow: 0 4px 16px rgba(0,0,0,0.3); }
      .gsc-tip-d { font-weight: 700; margin-bottom: 0.3rem; color: var(--text); }
      .gsc-tip-r { display: flex; justify-content: space-between; gap: 0.75rem; color: var(--text-2); line-height: 1.5; }
      .gsc-tip-r b { color: var(--text); font-variant-numeric: tabular-nums; }
      .gsc-help { font-size: 0.72rem; color: var(--text-2); line-height: 1.55; margin-top: 0.6rem; padding: 0.55rem 0.7rem; background: var(--surface-2); border: 1px solid var(--border); border-radius: 8px; }
      .gsc-help b { color: var(--text); }
      .gsc-source-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin: 1.25rem 0; }
      .gsc-src-card { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 0.85rem; }
      .gsc-src-head { font-weight: 700; font-size: 0.83rem; margin-bottom: 0.5rem; }
      .gsc-src-head span { font-weight: 500; color: var(--text-2); font-size: 0.72rem; display: block; margin-top: 0.2rem; }
      .gsc-src-row { display: flex; justify-content: space-between; gap: 0.6rem; font-size: 0.74rem; padding: 0.2rem 0; border-bottom: 1px solid var(--border); }
      .gsc-src-row span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .gsc-src-row span:last-child { color: var(--text-2); white-space: nowrap; }
      .gsc-src-row.ga4-pick { cursor: pointer; }
      .gsc-src-row.ga4-pick:hover span:first-child { color: var(--accent); }
      .gsc-src-row.ga4-pick.on span:first-child { color: var(--accent); font-weight: 700; }
      .ga4-live { color: #4ade80; font-size: 0.68rem; font-weight: 700; }
      .ga4-chip { display: inline-flex; align-items: center; gap: 6px; background: rgba(59,130,246,0.15); border: 1px solid var(--accent); color: var(--accent); border-radius: 999px; padding: 1px 9px; font-size: 0.7rem; font-weight: 600; cursor: pointer; }
      #gsc-page-search { width: 100%; max-width: 320px; margin-bottom: 0.6rem; padding: 0.4rem 0.6rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface-2); color: var(--text); font-size: 0.78rem; }
      .gsc-table-wrap { overflow-x: auto; }
      .gsc-table { width: 100%; border-collapse: collapse; font-size: 0.76rem; }
      .gsc-table th { text-align: left; color: var(--text-2); font-weight: 700; padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border); cursor: pointer; white-space: nowrap; user-select: none; }
      .gsc-table th.num { text-align: right; }
      .gsc-table th.sorted { color: var(--text); }
      .gsc-table td { padding: 0.4rem 0.5rem; border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums; }
      .gsc-table td.num { text-align: right; white-space: nowrap; }
      .gsc-page-cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .gsc-badge { display: inline-block; font-size: 0.6rem; font-weight: 700; padding: 0.05rem 0.3rem; border-radius: 4px; margin-right: 0.35rem; }
      .gsc-badge-blog { background: rgba(96,165,250,0.16); color: #60a5fa; }
      .gsc-badge-lifeflow { background: rgba(74,222,128,0.16); color: #4ade80; }
      .gsc-badge-playcast { background: rgba(87,230,195,0.16); color: #57e6c3; }
      /* 기기·브라우저·OS 3열 — 2열 그리드(gsc-source-grid)에 3장을 넣으면 마지막 장만 아래로 떨어진다 */
      .gsc-source-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }
      @media (max-width: 640px) {
        .gsc-kpi-row { grid-template-columns: repeat(2, 1fr); }
        .gsc-source-grid { grid-template-columns: 1fr; }
        .gsc-source-grid.cols-3 { grid-template-columns: 1fr; }
      }

      /* ── 카드 공통 ────────────────────────────────────── */
      .summary-card,
      .blog-section,
      .trend-section,
      .traffic-section,
      .status-section,
      .links-section,
      .coupang-card,
      .auth-box,
      .metric-box {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
      }

      /* ── KPI 요약 카드 ────────────────────────────────── */
      .summary-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
      }

      .summary-card { padding: 1.125rem 1rem; }

      .summary-card .label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-2);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.625rem;
      }

      .summary-card .value {
        font-size: 1.75rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        margin-bottom: 0.375rem;
      }

      .summary-card .sub {
        font-size: 0.75rem;
        color: var(--text-2);
        font-variant-numeric: tabular-nums;
      }

      .source-split-bar {
        display: flex;
        height: 6px;
        border-radius: 3px;
        overflow: hidden;
        margin-top: 0.625rem;
        background: var(--surface-2);
      }

      .split-tf { background: var(--tf); }
      .split-lf { background: var(--lf); margin-left: 2px; }
      .split-vip { background: #57e6c3; margin-left: 2px; }
      .split-mg { background: var(--mg); margin-left: 2px; }

      .split-legend {
        display: flex;
        justify-content: space-between;
        font-size: 0.6875rem;
        color: var(--text-2);
        margin-top: 0.375rem;
        font-variant-numeric: tabular-nums;
      }

      /* ── 섹션 카드 공통 헤더 ──────────────────────────── */
      .trend-section { padding: 1.125rem 1.25rem; margin-bottom: 1.25rem; }

      .trend-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
      }

      .trend-header h3 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        flex-shrink: 0;
      }

      .trend-total {
        font-size: 0.75rem;
        color: var(--text-2);
        font-variant-numeric: tabular-nums;
      }

      .trend-total b { color: var(--text); font-size: 0.9375rem; }

      /* ── 7일 트렌드 차트 ──────────────────────────────── */
      .trend-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 140px;
        padding: 0 0.25rem;
      }

      .trend-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        height: 100%;
      }

      .trend-bar-wrap {
        flex: 1;
        width: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: center;
      }

      .trend-bar-stack {
        width: 60%;
        max-width: 44px;
        border-radius: 4px 4px 0 0;
        overflow: hidden;
      }

      .trend-bar-today {
        outline: 1px solid var(--accent);
        outline-offset: 2px;
        border-radius: 4px;
      }

      .trend-bar-tf { background: var(--tf); }
      .trend-bar-lf { background: var(--lf); }

      /* 스택 세그먼트 사이 2px 서피스 갭 */
      .trend-bar-stack > div + div,
      .chart-bar-stack > div + div {
        box-shadow: inset 0 2px 0 var(--surface);
      }

      .trend-bar-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        flex-shrink: 0;
      }

      .trend-bar-date { font-size: 0.6875rem; color: var(--text-2); }

      .trend-bar-count {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--text);
        font-variant-numeric: tabular-nums;
      }

      .trend-bar-split { font-size: 0.625rem; font-variant-numeric: tabular-nums; }

      .trend-legend {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 0.625rem;
        font-size: 0.6875rem;
        color: var(--text-2);
      }

      .trend-legend span { display: flex; align-items: center; gap: 0.3125rem; }

      .trend-legend span::before {
        content: '';
        display: inline-block;
        width: 8px;
        height: 8px;
        border-radius: 2px;
      }

      .trend-legend .leg-tf::before { background: var(--tf); }
      .trend-legend .leg-lf::before { background: var(--lf); }

      .dot-tf { width: 7px; height: 7px; border-radius: 50%; background: var(--tf); display: inline-block; }
      .dot-lf { width: 7px; height: 7px; border-radius: 50%; background: var(--lf); display: inline-block; }
      .dot-vip { width: 7px; height: 7px; border-radius: 50%; background: #57e6c3; display: inline-block; }
      .dot-mg { width: 7px; height: 7px; border-radius: 50%; background: var(--mg); display: inline-block; }

      /* ── 날짜별 상세 테이블 ───────────────────────────── */
      .daily-detail-wrap {
        max-height: 340px;
        overflow-y: auto;
        overflow-x: auto;
        border-radius: var(--r-sm);
        border: 1px solid var(--border);
      }

      .daily-detail-table {
        width: 100%;
        min-width: 560px;
        border-collapse: collapse;
        font-size: 0.8125rem;
        font-variant-numeric: tabular-nums;
      }

      .daily-detail-table thead th {
        position: sticky;
        top: 0;
        background: var(--surface-2);
        color: var(--text-2);
        text-align: right;
        padding: 8px 12px;
        font-weight: 600;
        font-size: 0.75rem;
        z-index: 1;
      }

      .daily-detail-table thead th:first-child { text-align: left; }

      .daily-detail-table tbody td {
        padding: 7px 12px;
        text-align: right;
        border-top: 1px solid var(--border);
        color: var(--text);
        white-space: nowrap;
      }

      .daily-detail-table tbody td:first-child { text-align: left; color: var(--text-2); }
      .daily-detail-table tbody tr:hover td { background: rgba(59, 130, 246, 0.06); }
      .daily-detail-table tr.dd-today td { background: rgba(59, 130, 246, 0.10); font-weight: 700; }
      .dd-views { color: #60a5fa; font-weight: 600; }
      .dd-visitors { color: #4ade80; font-weight: 600; }
      .dd-minibar { display: inline-block; height: 6px; background: var(--tf); border-radius: 3px; min-width: 2px; }
      .dd-bar-col { width: 120px; }
      .dd-note { margin: 8px 2px 0; font-size: 0.72rem; color: var(--text-3); }

      /* ── 내 방문 제외 카드 ─────────────────────────────── */
      .exclude-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 12px; }
      @media (max-width: 860px) { .exclude-row { grid-template-columns: 1fr; } }
      .exclude-block { background: var(--surface-2, rgba(255,255,255,0.02)); border: 1px solid var(--border, rgba(255,255,255,0.08)); border-radius: 12px; padding: 14px 16px; }
      .exclude-block-title { font-size: 0.9rem; font-weight: 700; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
      .exclude-tag { font-size: 0.62rem; font-weight: 600; color: #4ade80; border: 1px solid rgba(74,222,128,0.4); border-radius: 999px; padding: 1px 8px; }
      .exclude-tag.warn { color: #fbbf24; border-color: rgba(251,191,36,0.4); }
      .exclude-desc { font-size: 0.72rem; color: var(--text-3); margin: 8px 0 0; line-height: 1.5; }
      .exclude-warn { color: #fbbf24; }
      .exclude-actions { display: flex; align-items: center; gap: 10px; margin-top: 10px; flex-wrap: wrap; }
      .ex-btn { font-size: 0.75rem; font-weight: 600; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--border, rgba(255,255,255,0.15)); background: transparent; color: var(--text-1, #e5e7eb); cursor: pointer; transition: background .15s, border-color .15s; }
      .ex-btn:hover { background: rgba(255,255,255,0.06); }
      .ex-btn.primary { background: #ef4444; border-color: #ef4444; color: #fff; }
      .ex-btn.primary:hover { background: #dc2626; }
      .ex-btn.on { background: #4ade80; border-color: #4ade80; color: #0b0f14; }
      .ex-btn:disabled { opacity: .55; cursor: default; }
      .exclude-status { font-size: 0.72rem; color: var(--text-3); }
      .exclude-links { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
      .ex-link { font-size: 0.7rem; padding: 4px 10px; border-radius: 999px; border: 1px solid rgba(96,165,250,0.4); color: #60a5fa; text-decoration: none; }
      .ex-link.off { border-color: rgba(255,255,255,0.2); color: var(--text-3); }
      .ex-link:hover { background: rgba(96,165,250,0.12); }
      .exclude-ua-now { font-size: 0.66rem; color: var(--text-3); background: rgba(0,0,0,0.25); border-radius: 8px; padding: 8px 10px; margin-top: 10px; word-break: break-all; font-family: ui-monospace, monospace; line-height: 1.45; }
      .exclude-list-head { font-size: 0.72rem; font-weight: 700; color: var(--text-2, #9ca3af); margin: 14px 0 6px; }
      .exclude-list { display: flex; flex-direction: column; gap: 6px; }
      .exclude-item { display: flex; align-items: center; gap: 10px; background: rgba(0,0,0,0.2); border-radius: 8px; padding: 7px 10px; }
      .exclude-item .ua-txt { flex: 1; min-width: 0; font-size: 0.66rem; color: var(--text-2, #9ca3af); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: ui-monospace, monospace; }
      .exclude-item .ua-cnt { font-size: 0.66rem; color: #fb7185; white-space: nowrap; }
      .exclude-item .ua-del { font-size: 0.7rem; padding: 3px 9px; border-radius: 7px; border: 1px solid rgba(255,255,255,0.15); background: transparent; color: var(--text-3); cursor: pointer; }
      .exclude-item .ua-del:hover { border-color: #ef4444; color: #ef4444; }
      .exclude-empty { font-size: 0.7rem; color: var(--text-3); padding: 4px 2px; }

      /* ── 히트맵 ───────────────────────────────────────── */
      .heatmap-wrap { overflow-x: auto; padding-bottom: 6px; }
      .heatmap-grid { display: inline-block; min-width: 100%; }
      .hm-row { display: flex; align-items: center; gap: 3px; margin-bottom: 3px; }
      .hm-rowlabel {
        width: 46px; flex: 0 0 46px;
        font-size: 0.72rem; color: var(--text-2);
        text-align: right; padding-right: 6px;
        font-variant-numeric: tabular-nums;
      }
      .hm-hourhead { display: flex; gap: 3px; margin: 0 0 5px 52px; }
      .hm-cell {
        width: 21px; height: 21px; flex: 0 0 21px;
        border-radius: 4px;
        display: inline-block;
      }
      /* 단일 색상(블루) 순차 램프 — 밝기 단조 증가 */
      .hm-cell.l0 { background: var(--surface-2); }
      .hm-cell.l1 { background: #1e3a8a; }
      .hm-cell.l2 { background: #1d4ed8; }
      .hm-cell.l3 { background: #3b82f6; }
      .hm-cell.l4 { background: #93c5fd; }
      .hm-hourlabel {
        width: 21px; flex: 0 0 21px;
        font-size: 0.625rem; color: var(--text-3);
        text-align: center;
      }
      .heatmap-legend {
        display: flex; align-items: center; gap: 3px;
        font-size: 0.72rem; color: var(--text-2);
      }
      .heatmap-legend .hm-cell { width: 13px; height: 13px; flex: 0 0 13px; }

      /* ── 실시간 트래픽 ────────────────────────────────── */
      .traffic-section { margin-bottom: 1.25rem; overflow: hidden; }

      .traffic-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      .traffic-header h3 {
        font-size: 0.875rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .refresh-btn {
        background: transparent;
        border: 1px solid var(--border-strong);
        color: var(--text-2);
        padding: 0.3125rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        cursor: pointer;
      }

      .refresh-btn:hover { border-color: var(--accent); color: var(--text); }

      .traffic-body { padding: 1.25rem; }

      .metric-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
      }

      .metric-box {
        background: var(--surface-2);
        border: none;
        border-radius: var(--r-sm);
        padding: 0.875rem;
        text-align: center;
      }

      .metric-box .metric-label {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-2);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.375rem;
      }

      .metric-box .metric-value {
        font-size: 1.375rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        margin-bottom: 0.25rem;
      }

      .metric-box .metric-delta { font-size: 0.6875rem; font-variant-numeric: tabular-nums; }
      .metric-delta.up { color: var(--good); }
      .metric-delta.down { color: var(--bad); }
      .metric-delta.neutral { color: var(--text-2); }

      .metric-breakdown {
        display: flex;
        justify-content: center;
        gap: 0.625rem;
        margin-top: 0.375rem;
        font-size: 0.6875rem;
        color: var(--text-2);
        font-variant-numeric: tabular-nums;
      }

      .metric-breakdown span { display: flex; align-items: center; gap: 0.25rem; }

      /* ── 시간대별 차트 ────────────────────────────────── */
      .hourly-chart { margin-bottom: 1.25rem; }

      .hourly-chart h4 {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.75rem;
      }

      /* .hourly-chart 스코프로 특이도 상향 — global.css의 블로그용
         .chart-bars{flex-direction:column} 충돌을 번들 순서와 무관하게 이김 */
      .hourly-chart .chart-bars {
        display: flex;
        flex-direction: row;
        align-items: flex-end;
        gap: 2px;
        height: 100px;
        padding: 0 0 1.5rem;
        position: relative;
      }

      .chart-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        position: relative;
      }

      .chart-bar-stack {
        display: flex;
        flex-direction: column;
        width: 100%;
        border-radius: 3px 3px 0 0;
        overflow: hidden;
      }

      .bar-tf { background: var(--tf); }
      .bar-lf { background: var(--lf); }
      .bar-vip { background: #57e6c3; }

      .chart-bar-label {
        position: absolute;
        bottom: -1.25rem;
        font-size: 0.625rem;
        color: var(--text-3);
      }

      .chart-bar-tooltip {
        display: none;
        position: absolute;
        top: -1.75rem;
        background: var(--surface-2);
        border: 1px solid var(--border-strong);
        padding: 0.1875rem 0.5rem;
        border-radius: 4px;
        font-size: 0.6875rem;
        white-space: nowrap;
        z-index: 10;
        font-variant-numeric: tabular-nums;
      }

      .chart-bar-col:hover .chart-bar-tooltip { display: block; }

      /* ── Top Pages / Live Feed ────────────────────────── */
      .traffic-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
      }

      .traffic-panel h4 {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
      }

      .source-tabs { display: flex; gap: 0.375rem; margin-bottom: 0.75rem; }

      .source-tab {
        padding: 0.3125rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--text-2);
      }

      .source-tab:hover { color: var(--text); }
      .source-tab.active { background: var(--surface-2); border-color: var(--border-strong); color: var(--text); }
      .source-tab.active-tf { background: rgba(59, 130, 246, 0.15); border-color: var(--tf); color: #93bbfd; }
      .source-tab.active-lf { background: rgba(22, 163, 74, 0.15); border-color: var(--lf); color: #6ee7a5; }
      .source-tab.active-vip { background: rgba(87, 230, 195, 0.15); border-color: #57e6c3; color: #7fe9d0; }
      .source-tab.active-mg { background: rgba(245, 158, 11, 0.15); border-color: var(--mg); color: #fbbf24; }

      .top-page-list, .event-feed { display: flex; flex-direction: column; }

      .top-page-item, .like-top-item, .event-item, .recent-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.375rem;
        margin: 0 -0.375rem;
        border-radius: 6px;
        border-bottom: 1px solid var(--border);
        font-size: 0.8125rem;
      }

      .top-page-item:last-child, .like-top-item:last-child,
      .event-item:last-child, .recent-item:last-child { border-bottom: none; }
      /* 피드 항목을 링크로 (레이아웃은 기존 flex 행 그대로) */
      a.event-link { text-decoration: none; color: inherit; cursor: pointer; }
      a.event-link:hover .event-page-title { text-decoration: underline; }

      .top-page-item:hover, .like-top-item:hover,
      .event-item:hover, .recent-item:hover { background: var(--surface-2); }

      .top-page-rank, .recent-rank {
        font-weight: 700;
        color: var(--text-3);
        width: 20px;
        text-align: center;
        flex-shrink: 0;
        font-size: 0.75rem;
        font-variant-numeric: tabular-nums;
      }

      .top-page-title, .top-page-slug, .recent-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.75rem;
      }

      .recent-title { font-size: 0.8125rem; }

      .top-page-views {
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--text);
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      /* 도구 탭: 카테고리 칩 + 점유율 바 */
      .tool-cat {
        display: inline-block;
        font-size: 0.625rem;
        font-weight: 700;
        padding: 0.05rem 0.4rem;
        border-radius: 999px;
        background: var(--surface-2);
        color: var(--text-2);
        flex-shrink: 0;
      }
      .tool-emoji { font-size: 0.95rem; flex-shrink: 0; }
      .tool-share {
        flex-shrink: 0;
        width: 68px;
        height: 5px;
        border-radius: 999px;
        background: var(--surface-2);
        overflow: hidden;
      }
      .tool-share > i {
        display: block;
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, #16a34a, #4ade80);
      }

      .recent-date {
        font-size: 0.6875rem;
        color: var(--text-3);
        white-space: nowrap;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .src-badge {
        display: inline-block;
        padding: 0.0625rem 0.375rem;
        border-radius: 3px;
        font-size: 0.625rem;
        font-weight: 700;
        flex-shrink: 0;
        letter-spacing: 0.02em;
      }

      .src-badge.tf { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .src-badge.lf { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }
      .src-badge.gf { background: rgba(168, 85, 247, 0.15); color: #d8b4fe; }
      .src-badge.vip { background: rgba(87, 230, 195, 0.15); color: #7fe9d0; }
      .src-badge.mg { background: rgba(245, 158, 11, 0.15); color: #fbbf24; }
      .event-ref { font-size: 0.66rem; color: var(--text-3); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .mg-untracked { color: #fbbf24; opacity: 0.85; }

      /* ── 추천 TOP ─────────────────────────────────────── */
      .like-top-panel { margin-top: 1.25rem; }

      .like-top-total {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--text-2);
        margin-left: 0.25rem;
        font-variant-numeric: tabular-nums;
      }

      .like-bar-wrap {
        flex: 1;
        height: 5px;
        background: var(--surface-2);
        border-radius: 3px;
        overflow: hidden;
      }

      .like-bar-fill { height: 100%; background: var(--like); border-radius: 3px; }

      .like-top-count {
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--text);
        flex-shrink: 0;
        min-width: 48px;
        text-align: right;
        font-variant-numeric: tabular-nums;
      }

      /* ── 이벤트 피드 ──────────────────────────────────── */
      .event-item { min-height: 36px; font-size: 0.75rem; }

      .event-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6875rem;
        flex-shrink: 0;
      }

      .event-icon.pageview { background: rgba(59, 130, 246, 0.15); }
      .event-icon.like { background: rgba(225, 29, 72, 0.15); }
      .event-icon.coupang_click { background: rgba(234, 88, 12, 0.15); }
      .event-icon.newsletter_subscribe { background: rgba(22, 163, 74, 0.15); }

      .event-content {
        flex: 1;
        overflow: hidden;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .event-action {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.3;
      }
      .ev-email-tag {
        display: inline-block;
        margin-left: 5px;
        padding: 1px 6px;
        border-radius: 999px;
        font-size: 0.625rem;
        font-weight: 700;
        color: #fff;
        background: #818cf8;
        vertical-align: middle;
      }

      .event-page-title {
        font-size: 0.6875rem;
        color: var(--text-2);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.3;
      }

      .event-time {
        font-size: 0.6875rem;
        color: var(--text-3);
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .no-data {
        text-align: center;
        padding: 2rem;
        color: var(--text-3);
        font-size: 0.8125rem;
      }

      /* ── 블로그 섹션 (도넛/최근 글) ───────────────────── */
      .blog-sections {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1.25rem;
        margin-bottom: 1.25rem;
      }

      .blog-section { overflow: hidden; }

      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--border);
      }

      .section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
      }

      .section-badge {
        font-size: 0.6875rem;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
      }

      .badge-tf { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .badge-lf { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }

      .section-body { padding: 1.125rem 1.25rem; }

      .cat-donut-wrap {
        display: flex;
        align-items: center;
        gap: 1.25rem;
        margin-bottom: 1rem;
      }

      .cat-donut {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        position: relative;
        flex-shrink: 0;
      }

      .cat-donut-hole {
        position: absolute;
        inset: 22%;
        border-radius: 50%;
        background: var(--surface);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
      }

      .cat-donut-hole .donut-num {
        font-size: 1.25rem;
        font-weight: 700;
        line-height: 1;
        font-variant-numeric: tabular-nums;
      }

      .cat-donut-hole .donut-label { font-size: 0.625rem; color: var(--text-2); }

      .cat-legend { display: flex; flex-direction: column; gap: 0.3125rem; flex: 1; }

      .cat-legend-item {
        display: flex;
        align-items: center;
        gap: 0.4375rem;
        font-size: 0.75rem;
      }

      .cat-legend-dot { width: 8px; height: 8px; border-radius: 2px; flex-shrink: 0; }
      .cat-legend-name { flex: 1; }
      .cat-legend-count { font-weight: 700; min-width: 20px; text-align: right; font-variant-numeric: tabular-nums; }
      .cat-legend-pct { color: var(--text-2); font-size: 0.6875rem; min-width: 32px; text-align: right; font-variant-numeric: tabular-nums; }

      /* 카테고리 배지 (텍스트 칩) */
      .cat-badge {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        font-size: 0.625rem;
        font-weight: 600;
        flex-shrink: 0;
      }

      .cat-ai { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .cat-dev { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }
      .cat-review { background: rgba(191, 135, 0, 0.18); color: #f5cf5a; }
      .cat-game { background: rgba(168, 85, 247, 0.15); color: #c9a4f5; }
      .cat-lifestyle { background: rgba(236, 72, 153, 0.15); color: #f4a8cd; }
      .cat-finance { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .cat-health { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }
      .cat-education { background: rgba(168, 85, 247, 0.15); color: #c9a4f5; }
      .cat-travel { background: rgba(234, 88, 12, 0.18); color: #f2a172; }

      /* 카테고리별 트래픽 바 */
      .cat-traffic-section {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border);
        margin-bottom: 1rem;
      }

      .cat-traffic-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.75rem;
      }

      .cat-traffic-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }

      .cat-traffic-name {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text);
        min-width: 64px;
        flex-shrink: 0;
      }

      .cat-traffic-bar-wrap {
        flex: 1;
        height: 12px;
        background: var(--surface-2);
        border-radius: 6px;
        overflow: hidden;
      }

      .cat-traffic-bar { height: 100%; border-radius: 6px; min-width: 4px; }

      .cat-traffic-value {
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--text);
        min-width: 48px;
        text-align: right;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .cat-traffic-share {
        font-size: 0.6875rem;
        color: var(--text-2);
        min-width: 28px;
        text-align: right;
        flex-shrink: 0;
        font-variant-numeric: tabular-nums;
      }

      .recent-list { display: flex; flex-direction: column; }

      /* ── 시스템 상태 ──────────────────────────────────── */
      .status-section, .links-section { padding: 1.125rem 1.25rem; margin-bottom: 1.25rem; }

      .status-section h3, .links-section h3 {
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--text);
      }

      .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.625rem;
      }

      .status-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.625rem 0.75rem;
        background: var(--surface-2);
        border-radius: var(--r-sm);
        font-size: 0.8125rem;
      }

      .status-badge {
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.6875rem;
        font-weight: 600;
      }

      /* 상태 = 색 + 점 + 텍스트 (색 단독 의미 전달 금지) */
      .status-badge::before {
        content: '';
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        margin-right: 0.375rem;
        vertical-align: middle;
        background: currentColor;
      }

      .status-badge.online { background: rgba(34, 197, 94, 0.15); color: #4ade80; }
      .status-badge.pending { background: rgba(234, 179, 8, 0.15); color: #facc15; }
      .status-badge.offline { background: rgba(239, 68, 68, 0.15); color: #f87171; }

      /* ── 바로가기 ─────────────────────────────────────── */
      .links-grid { display: flex; flex-wrap: wrap; gap: 0.625rem; }

      .link-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.875rem;
        border-radius: var(--r-sm);
        background: var(--surface-2);
        border: 1px solid var(--border);
        color: var(--text);
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
      }

      .link-btn:hover { border-color: var(--accent); }
      .link-btn .link-icon { font-size: 0.9375rem; }
      .link-btn .link-label { color: var(--text-2); font-size: 0.6875rem; margin-left: 0.25rem; }

      /* ── 쿠팡 탭 ──────────────────────────────────────── */
      .coupang-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 0.875rem;
        margin-bottom: 1.25rem;
      }

      .coupang-card { padding: 1.125rem 1.25rem; }

      .coupang-card h4 {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--text-2);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 0.625rem;
      }

      .conversion-rate {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text);
        line-height: 1;
        letter-spacing: -0.02em;
        font-variant-numeric: tabular-nums;
        margin-bottom: 0.375rem;
      }

      .coupang-card .sub { font-size: 0.75rem; color: var(--text-2); }

      /* ── 댓글 탭 ──────────────────────────────────────── */
      /* 페이지 진입 인증 오버레이 — 인증 전 대시보드 내용 노출 차단 */
      .page-auth {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg, #0b1020);
      }
      body.locked { overflow: hidden; }
      body.locked .dash-header,
      body.locked .dash-container { filter: blur(6px); pointer-events: none; user-select: none; }
      #logout-btn {
        background: none;
        border: 1px solid var(--border);
        color: var(--text-3);
        border-radius: 6px;
        padding: 0.2rem 0.5rem;
        font-size: 0.75rem;
        cursor: pointer;
      }
      #logout-btn:hover { color: var(--text); border-color: var(--text-3); }

      .comment-auth-gate {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 300px;
      }

      .auth-box {
        padding: 2.5rem;
        text-align: center;
        max-width: 400px;
        width: 100%;
      }

      .auth-box h3 { font-size: 1.125rem; margin-bottom: 0.5rem; }

      .auth-box p {
        color: var(--text-2);
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
      }

      .auth-input-row { display: flex; gap: 0.5rem; }

      .auth-input-row input {
        flex: 1;
        padding: 0.625rem 1rem;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: var(--r-sm);
        color: var(--text);
        font-size: 0.875rem;
        outline: none;
      }

      .auth-input-row input:focus { border-color: var(--accent); }

      .auth-input-row button {
        padding: 0.625rem 1.25rem;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: var(--r-sm);
        font-weight: 600;
        cursor: pointer;
      }

      .auth-input-row button:hover { background: #2563eb; }

      .auth-error { color: var(--bad); font-size: 0.8125rem; margin-top: 0.75rem; }

      .comment-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.875rem;
      }

      .comment-filters { display: flex; gap: 0.375rem; }

      .filter-btn {
        padding: 0.3125rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--text-2);
      }

      .filter-btn:hover { color: var(--text); }
      .filter-btn.active { background: var(--surface-2); border-color: var(--accent); color: var(--text); }

      .comment-trend-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 160px;
        padding: 1rem 0;
      }

      .trend-bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        height: 100%;
        justify-content: flex-end;
      }

      .trend-bars {
        display: flex;
        gap: 2px;
        align-items: flex-end;
        width: 100%;
        justify-content: center;
      }

      .trend-bar {
        width: 14px;
        border-radius: 3px 3px 0 0;
        min-height: 4px;
      }

      .trend-bar.tf { background: var(--tf); }
      .trend-bar.lf { background: var(--lf); }
      .trend-bar.vip { background: #57e6c3; }

      .trend-label { font-size: 0.6875rem; color: var(--text-2); }
      .trend-count { font-size: 0.6875rem; font-weight: 700; color: var(--text); font-variant-numeric: tabular-nums; }

      .comment-list { max-height: 600px; overflow-y: auto; }

      .cm-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        border-bottom: 1px solid var(--border);
      }

      .cm-item:hover { background: var(--surface-2); }

      .cm-source {
        font-size: 0.625rem;
        font-weight: 700;
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
        white-space: nowrap;
        flex-shrink: 0;
        margin-top: 0.125rem;
      }

      .cm-source.tf { background: rgba(59, 130, 246, 0.15); color: #93bbfd; }
      .cm-source.lf { background: rgba(22, 163, 74, 0.15); color: #6ee7a5; }

      .cm-body { flex: 1; min-width: 0; }

      .cm-meta {
        font-size: 0.75rem;
        color: var(--text-2);
        margin-bottom: 0.25rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .cm-nickname { font-weight: 700; color: var(--text); }

      .cm-admin-badge {
        font-size: 0.625rem;
        background: var(--accent);
        color: #fff;
        padding: 0 0.375rem;
        border-radius: 4px;
        font-weight: 600;
      }

      .cm-report-badge {
        font-size: 0.625rem;
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        padding: 0 0.375rem;
        border-radius: 4px;
        font-weight: 600;
      }

      .cm-content {
        font-size: 0.875rem;
        color: var(--text);
        line-height: 1.5;
        word-break: break-word;
      }
      .cm-content.cm-goto { cursor: pointer; }
      .cm-content.cm-goto:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }

      .cm-slug {
        display: inline-flex; align-items: center; gap: 0.2rem;
        font-size: 0.6875rem; color: var(--text-3); margin-top: 0.25rem;
        text-decoration: none;
      }
      .cm-slug:hover { color: var(--accent); }
      .cm-goto-arrow { font-size: 0.75rem; }

      .cm-actions {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        flex-shrink: 0;
      }

      .cm-btn {
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.6875rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--border-strong);
        background: transparent;
        color: var(--text-2);
        white-space: nowrap;
      }

      .cm-btn:hover { border-color: var(--accent); color: var(--text); }
      .cm-btn.danger { color: #f87171; }
      .cm-btn.danger:hover { background: rgba(239, 68, 68, 0.1); border-color: var(--bad); }

      .cm-reply-form { margin-top: 0.5rem; display: flex; gap: 0.375rem; }

      .cm-reply-form input {
        flex: 1;
        padding: 0.375rem 0.625rem;
        background: var(--bg);
        border: 1px solid var(--border-strong);
        border-radius: 6px;
        color: var(--text);
        font-size: 0.8125rem;
        outline: none;
      }

      .cm-reply-form input:focus { border-color: var(--accent); }

      .cm-reply-form button {
        padding: 0.375rem 0.75rem;
        background: var(--accent);
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8125rem;
        cursor: pointer;
      }

      /* ── 로딩 (유일한 애니메이션 = 기능적 스피너) ─────── */
      .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60px;
        color: var(--text-2);
        font-size: 0.8125rem;
      }

      .spinner {
        width: 18px;
        height: 18px;
        border: 2px solid var(--border-strong);
        border-top-color: var(--accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 0.5rem;
      }

      @keyframes spin { to { transform: rotate(360deg); } }

      /* ── 스크롤바 ─────────────────────────────────────── */
      .daily-detail-wrap, .comment-list, .heatmap-wrap, .main-tabs, .traffic-list {
        scrollbar-width: thin;
        scrollbar-color: rgba(161, 161, 170, 0.35) transparent;
      }

      .daily-detail-wrap::-webkit-scrollbar,
      .comment-list::-webkit-scrollbar,
      .heatmap-wrap::-webkit-scrollbar,
      .main-tabs::-webkit-scrollbar,
      .traffic-list::-webkit-scrollbar { width: 9px; height: 9px; }

      .daily-detail-wrap::-webkit-scrollbar-thumb,
      .comment-list::-webkit-scrollbar-thumb,
      .heatmap-wrap::-webkit-scrollbar-thumb,
      .main-tabs::-webkit-scrollbar-thumb,
      .traffic-list::-webkit-scrollbar-thumb {
        background: rgba(161, 161, 170, 0.32);
        border-radius: 5px;
        border: 2px solid transparent;
        background-clip: padding-box;
      }
      .traffic-list::-webkit-scrollbar-thumb:hover { background: rgba(161, 161, 170, 0.55); background-clip: padding-box; }

      .daily-detail-wrap::-webkit-scrollbar-track,
      .comment-list::-webkit-scrollbar-track,
      .heatmap-wrap::-webkit-scrollbar-track,
      .main-tabs::-webkit-scrollbar-track,
      .traffic-list::-webkit-scrollbar-track { background: transparent; }

      /* ── 반응형 ───────────────────────────────────────── */
      @media (max-width: 1100px) and (min-width: 769px) {
        .summary-grid { grid-template-columns: repeat(2, 1fr); }
        .metric-row { grid-template-columns: repeat(2, 1fr); }
      }

      @media (max-width: 768px) {
        .summary-grid { grid-template-columns: 1fr; }
        .blog-sections { grid-template-columns: 1fr; }
        .dash-header { flex-direction: column; gap: 0.5rem; align-items: flex-start; }
        .metric-row { grid-template-columns: 1fr 1fr; }
        .traffic-grid { grid-template-columns: 1fr; }
        .main-tabs {
          overflow-x: auto;
          flex-wrap: nowrap;
          -webkit-overflow-scrolling: touch;
        }
        .main-tab { white-space: nowrap; flex-shrink: 0; }
        .coupang-stats { grid-template-columns: 1fr; }
        .comment-stats-grid { grid-template-columns: 1fr; }
        .comment-filters { flex-wrap: wrap; }
        .cm-item { flex-direction: column; gap: 0.5rem; }
        .cm-actions { flex-direction: row; }
        .summary-card .value { font-size: 1.5rem; }
      }

      /* ── 벤토 그리드 (12컬럼 재구성) ───────────────────── */
      .dash-grid {
        display: grid;
        grid-template-columns: repeat(12, 1fr);
        gap: 1.25rem;
        margin-bottom: 1.25rem;
        align-items: stretch;
      }
      /* 그리드 셀은 자체 margin-bottom 제거(간격은 gap이 담당) + 축소 허용 */
      .dash-grid > * { margin-bottom: 0; min-width: 0; }

      .col-3 { grid-column: span 3; }
      .col-4 { grid-column: span 4; }
      .col-6 { grid-column: span 6; }
      .col-7 { grid-column: span 7; }
      .col-8 { grid-column: span 8; }
      .col-12 { grid-column: span 12; }

      /* 범용 패널 카드 — 독립 셀이 된 위젯에 카드 크롬 부여 */
      .panel {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--r);
        padding: 1.125rem 1.25rem;
        display: flex;
        flex-direction: column;
      }

      .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1rem;
      }

      .panel-head h3, .panel-head h4 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text);
      }

      .panel > .source-tabs { margin-top: -0.25rem; }
      .panel .hourly-chart { margin-bottom: 0; }
      .panel .top-page-list, .panel .event-feed { flex: 1; }

      /* 오늘 현황 = 2x2 스탯 그리드 */
      .today-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0.75rem;
        flex: 1;
      }
      /* 전폭 오늘 현황: 4열 스트립 */
      .today-panel { margin-bottom: 1.25rem; }
      .today-grid-4 { grid-template-columns: repeat(4, 1fr); }
      @media (max-width: 900px) { .today-grid-4 { grid-template-columns: 1fr 1fr; } }
      @media (max-width: 520px) { .today-grid-4 { grid-template-columns: 1fr; } }

      .today-grid .metric-box {
        display: flex;
        flex-direction: column;
        justify-content: center;
      }

      /* 태블릿(≤1100): 벤토 해제 → 단일 컬럼(가독성 우선) */
      @media (max-width: 1100px) {
        .col-3 { grid-column: span 6; }
        .col-4, .col-6, .col-7, .col-8 { grid-column: span 12; }
      }

      @media (max-width: 768px) {
        .dash-grid { grid-template-columns: 1fr; gap: 1rem; }
        .dash-grid > * { grid-column: 1 / -1; }
      }

      /* ══ 컬러풀 다크 리디자인 (아이콘·델타·스파크라인) ══ */
      /* 라인 아이콘 공통 */
      .ico {
        width: 1em; height: 1em;
        stroke: currentColor; fill: none;
        stroke-width: 2; stroke-linecap: round; stroke-linejoin: round;
        flex-shrink: 0;
      }

      /* KPI 아이콘 칩 (틴트 배경 + 컬러 라인 아이콘) */
      .summary-card { position: relative; overflow: hidden; }
      .summary-card::after {
        /* 카드 우상단 은은한 컬러 글로우 */
        content: '';
        position: absolute;
        top: -40px; right: -40px;
        width: 120px; height: 120px;
        border-radius: 50%;
        opacity: 0.12;
        pointer-events: none;
        background: radial-gradient(circle, currentColor 0%, transparent 70%);
      }
      .kpi-top {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.875rem;
        position: relative;
        z-index: 1;
      }
      .kpi-chip {
        width: 32px; height: 32px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        flex-shrink: 0;
      }
      .kpi-top .label { margin-bottom: 0; }
      .summary-card .value, .summary-card .sub, .summary-card .source-split-bar,
      .summary-card .split-legend { position: relative; z-index: 1; }

      /* KPI 값 + 델타 인라인 행 */
      .kpi-value-row { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.375rem; }
      .kpi-value-row .value { margin-bottom: 0; }

      /* 델타 칩 */
      .delta-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.15rem;
        font-size: 0.6875rem;
        font-weight: 700;
        padding: 0.1rem 0.45rem 0.1rem 0.35rem;
        border-radius: 9999px;
        font-variant-numeric: tabular-nums;
        line-height: 1.4;
        white-space: nowrap;
      }
      .delta-chip .ico { width: 0.8em; height: 0.8em; stroke-width: 2.5; }
      .delta-chip.up { background: rgba(34,197,94,0.16); color: #4ade80; }
      .delta-chip.down { background: rgba(239,68,68,0.16); color: #f87171; }
      .delta-chip.flat { background: var(--surface-2); color: var(--text-2); }

      /* 색상별 아이콘 칩 배경 + 컬러 수치(가독성 유지 밝은 톤) */
      .color-blue   .kpi-chip { background: rgba(59,130,246,0.16); color: #60a5fa; }
      .color-blue   .value    { color: #7cb0fb; }
      .color-blue::after       { color: #3b82f6; }
      .color-green  .kpi-chip { background: rgba(22,163,74,0.18); color: #4ade80; }
      .color-green  .value    { color: #5eead4; }
      .color-green::after      { color: #16a34a; }
      .color-purple .kpi-chip { background: rgba(168,85,247,0.18); color: #c084fc; }
      .color-purple .value    { color: #cba6f7; }
      .color-purple::after     { color: #a855f7; }
      .color-amber  .kpi-chip { background: rgba(234,179,8,0.18); color: #facc15; }
      .color-amber  .value    { color: #f6cf57; }
      .color-amber::after      { color: #eab308; }
      .color-cyan   .kpi-chip { background: rgba(6,182,212,0.18); color: #22d3ee; }
      .color-cyan   .value    { color: #5bd4e8; }
      .color-cyan::after       { color: #06b6d4; }
      .color-red    .kpi-chip { background: rgba(239,68,68,0.18); color: #fb7185; }
      .color-red    .value    { color: #fb8b98; }
      .color-red::after        { color: #ef4444; }


      /* 섹션/패널 헤더 라인 아이콘 */
      .sec-ico {
        width: 1.05rem; height: 1.05rem;
        flex-shrink: 0;
      }
      .trend-header h3, .status-section h3, .links-section h3 {
        display: flex; align-items: center; gap: 0.5rem;
      }
      /* 섹션 아이콘 색(테마별) — 컬러 강조 */
      .sec-ico.i-blue { color: #60a5fa; }
      .sec-ico.i-green { color: #4ade80; }
      .sec-ico.i-purple { color: #c084fc; }
      .sec-ico.i-amber { color: #facc15; }
      .sec-ico.i-cyan { color: #22d3ee; }
      .sec-ico.i-pink { color: #f472b6; }
      .sec-ico.i-red { color: #fb7185; }

      /* ── 세그먼트 토글 (일/주/월, 오늘/14일) ── */
      .th-right { display: flex; align-items: center; gap: 0.875rem; flex-wrap: wrap; width: 100%; }
      /* 합계 텍스트를 우측 끝으로 밀어 토글 위치를 고정(텍스트 길이 변해도 안 밀림) */
      .th-right .trend-total { margin-left: auto; text-align: right; }
      /* 방문추이 헤더: 제목(좌상단 고정) 위 / 토글 영역 아래 별도 라인 */
      .trend-header:has(.th-right) {
        flex-direction: column;
        align-items: stretch;
        gap: 0.7rem;
      }
      .trend-header:has(.th-right) h3 { align-self: flex-start; }
      .seg-toggle {
        display: inline-flex;
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 2px;
        gap: 2px;
      }
      .seg-btn {
        padding: 0.3rem 0.7rem;
        font-size: 0.75rem;
        font-weight: 600;
        border: none;
        background: transparent;
        color: var(--text-2);
        border-radius: 6px;
        cursor: pointer;
        white-space: nowrap;
      }
      .seg-btn:hover { color: var(--text); }
      .seg-btn.active { background: var(--accent); color: #fff; }
      /* 소형 세그먼트 토글 (Top Pages 기간 등) */
      .seg-sm { padding: 1px; }
      .seg-sm .seg-btn { padding: 0.2rem 0.45rem; font-size: 0.6875rem; }
      .panel-head { flex-wrap: wrap; }

      /* ── 방문 추이: 차트 | 표 2단 ── */
      .traffic-split {
        display: grid;
        grid-template-columns: 1.55fr 1fr;
        gap: 1.25rem;
        align-items: start;
      }
      .traffic-chart-wrap { min-width: 0; position: relative; }
      .traffic-table-wrap { min-width: 0; }
      .traffic-table-wrap .daily-detail-wrap { max-height: 268px; }
      .tp-view { min-width: 0; }

      /* 라인 차트: 막대용 flex/height 오버라이드 + 살짝 아래로 */
      .line-chart { display: block; height: auto; padding: 0; margin-top: 0.9rem; }

      /* 차트 호버 툴팁 */
      .chart-tip {
        display: none;
        position: absolute;
        top: 6px;
        z-index: 20;
        pointer-events: none;
        background: var(--surface-2);
        border: 1px solid var(--border-strong);
        border-radius: 8px;
        padding: 0.5rem 0.625rem;
        font-size: 0.75rem;
        min-width: 116px;
        box-shadow: 0 6px 18px rgba(0,0,0,0.45);
      }
      .chart-tip .ct-date { font-weight: 700; color: var(--text); margin-bottom: 0.35rem; font-size: 0.75rem; }
      .chart-tip .ct-row { display: flex; align-items: center; gap: 0.4rem; color: var(--text-2); line-height: 1.7; }
      .chart-tip .ct-row i { width: 9px; height: 9px; border-radius: 2px; flex-shrink: 0; }
      .chart-tip .ct-row b { margin-left: auto; color: var(--text); font-variant-numeric: tabular-nums; }
      .chart-tip .ct-total { border-top: 1px solid var(--border); margin-top: 0.25rem; padding-top: 0.25rem; }
      .chart-tip .ct-total b { color: var(--text); }

      /* 우측 날짜별 리스트 (표 → 2줄 리스트) */
      .traffic-list-head {
        display: flex; justify-content: space-between;
        font-size: 0.6875rem; font-weight: 700; color: var(--text-2);
        text-transform: uppercase; letter-spacing: 0.04em;
        padding: 0 0.4rem 0.5rem; border-bottom: 1px solid var(--border); margin-bottom: 0.15rem;
      }
      .traffic-list { max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; }
      .tl-row { padding: 0.55rem 0.4rem; border-bottom: 1px solid var(--border); }
      .tl-row:last-child { border-bottom: none; }
      .tl-row.tl-cur { background: rgba(59,130,246,0.09); border-radius: 6px; }
      .tl-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.35rem; }
      .tl-date { font-size: 0.8125rem; color: var(--text-2); font-weight: 600; }
      .tl-val { font-size: 1.0625rem; font-weight: 800; font-variant-numeric: tabular-nums; }
      .tl-bar { height: 5px; background: var(--surface-2); border-radius: 3px; overflow: hidden; margin-bottom: 0.3rem; }
      .tl-fill { height: 100%; border-radius: 3px; min-width: 3px; }
      .tl-sub { font-size: 0.6875rem; color: var(--text-3); font-variant-numeric: tabular-nums; }

      /* 방문 추이: 모든 뷰 세로높이 고정(뷰 전환 시 패널 안 줄어듦) */
      .traffic-split { height: 400px; }
      #tp-heatmap-view { height: 400px; display: flex; flex-direction: column; }
      .traffic-list { max-height: 352px; }

      /* 시간대 그룹 막대 (TF/LF 분리) — 2줄로 채움 */
      #tp-hourly-view .traffic-chart-wrap { display: flex; flex-direction: column; justify-content: center; }
      .hourly-2row { display: flex; flex-direction: column; gap: 0.5rem; width: 100%; }
      .hourly-2row .chart-bars { height: 128px; padding-bottom: 1.35rem; }
      .hourly-grouped { align-items: flex-end; }
      .hourly-grouped .chart-bar-col { justify-content: flex-end; }
      .hbar-group { display: flex; align-items: flex-end; justify-content: center; gap: 1px; width: 100%; height: 96px; }
      .hbar { width: 42%; max-width: 11px; border-radius: 2px 2px 0 0; }
      .hbar.bar-tf { background: var(--tf); }
      .hbar.bar-lf { background: var(--lf); }
      .hbar.bar-vip { background: #57e6c3; }

      /* 히트맵 컨트롤 + 고정 프레임(내부 스크롤) */
      .hm-controls { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; margin-bottom: 0.85rem; flex-wrap: wrap; }
      .heatmap-fixed {
        flex: 1;
        overflow-y: auto;
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: var(--r-sm);
        padding: 0.85rem 0.85rem;
        background: rgba(0,0,0,0.12);
      }
      #tp-heatmap-view { position: relative; }

      /* 히트맵 호버 팝업 */
      .hm-tip {
        display: none;
        position: absolute;
        z-index: 30;
        pointer-events: none;
        background: var(--surface-2);
        border: 1px solid var(--border-strong);
        border-radius: 8px;
        padding: 0.45rem 0.6rem;
        font-size: 0.75rem;
        box-shadow: 0 6px 18px rgba(0,0,0,0.45);
        white-space: nowrap;
      }

      /* 방문추이 우측 리스트: 드래그 스크롤 */
      .traffic-list { cursor: grab; }
      .traffic-list.dragging { cursor: grabbing; user-select: none; }

      /* 도넛 compact (기기/브라우저/OS 3열) */
      .cat-donut-wrap.donut-compact { flex-direction: column; align-items: center; gap: 0.55rem; }
      .donut-compact .cat-donut { width: 84px; height: 84px; }
      .donut-compact .cat-legend { width: 100%; gap: 0.2rem; }
      .donut-compact .cat-legend-name { font-size: 0.6875rem; }

      /* SVG 도넛 (큰 사이즈 + 중앙 총합 텍스트 안겹침 + 세그먼트 호버) */
      .donut-svg-wrap { position: relative; width: 150px; height: 150px; flex-shrink: 0; }
      .donut-svg { width: 150px; height: 150px; display: block; transform: rotate(0deg); }
      .donut-seg { cursor: pointer; }
      .donut-seg:hover { opacity: 0.82; }
      .donut-center {
        position: absolute; inset: 0;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        pointer-events: none;
      }
      .donut-center .donut-num { font-size: 1.375rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
      .donut-center .donut-label { font-size: 0.6875rem; color: var(--text-2); margin-top: 2px; }

      /* 도넛 세그먼트 호버 툴팁 */
      .donut-tip {
        display: none; position: fixed; z-index: 90; pointer-events: none;
        align-items: center; gap: 0.4rem;
        background: var(--surface-2); border: 1px solid var(--border-strong);
        border-radius: 8px; padding: 0.4rem 0.6rem; font-size: 0.75rem;
        box-shadow: 0 6px 18px rgba(0,0,0,0.45); white-space: nowrap;
      }
      .donut-tip .dt-dot { width: 9px; height: 9px; border-radius: 2px; flex-shrink: 0; }
      .donut-tip b { color: var(--text); font-weight: 700; }

      /* 오디언스 도넛 패널: 도넛 왼쪽 + 범례 오른쪽, 세로 중앙 */
      #audience-donut .cat-donut-wrap, #ref-bars .cat-donut-wrap { align-items: center; gap: 1.5rem; min-height: 158px; }

      /* Top Pages 클릭 이동 */
      a.top-page-item { text-decoration: none; color: inherit; }
      .tp-go { color: var(--text-3); font-size: 0.75rem; margin-left: 0.15rem; }
      a.top-page-item:hover .top-page-title { color: var(--accent); }
      a.top-page-item:hover .tp-go { color: var(--accent); }
      @media (max-width: 900px) {
        .traffic-split { grid-template-columns: 1fr; }
      }

      /* ── 고도화: AI 인사이트 / 퍼널 / 목표 / 스켈레톤 / 날짜범위 ── */
      .ai-insight {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(90deg, rgba(234,179,8,0.10), rgba(59,130,246,0.06));
        border: 1px solid rgba(234,179,8,0.22);
        border-radius: var(--r);
        padding: 0.75rem 1rem;
        margin-bottom: 1.25rem;
        font-size: 0.875rem;
        color: var(--text);
      }
      .ai-insight b { color: var(--text); font-weight: 700; }

      /* 날짜 범위 입력 */
      .date-range { display: inline-flex; align-items: center; gap: 0.375rem; color: var(--text-2); font-size: 0.75rem; }
      .date-range input[type=date] {
        background: var(--surface-2);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text);
        font-size: 0.72rem;
        padding: 0.28rem 0.4rem;
        font-family: inherit;
        color-scheme: dark;
      }
      .date-range input[type=date]:focus { border-color: var(--accent); outline: none; }

      /* 오디언스 3열(기기/브라우저/OS) */
      .audience-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem; }
      .mini-title { font-size: 0.6875rem; font-weight: 700; color: var(--text-2); text-transform: uppercase; letter-spacing: 0.04em; margin-bottom: 0.5rem; }
      @media (max-width: 640px) { .audience-3 { grid-template-columns: 1fr; } }

      /* 전환 퍼널 */
      .funnel-split { display: grid; grid-template-columns: 1.6fr 1fr; gap: 1.25rem; align-items: start; }
      @media (max-width: 720px) { .funnel-split { grid-template-columns: 1fr; } }
      .funnel-step { margin-bottom: 0.875rem; }
      .funnel-step-head { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.375rem; }
      .funnel-step-label { font-size: 0.8125rem; font-weight: 600; color: var(--text); }
      .funnel-step-count { font-size: 0.9375rem; font-weight: 800; color: var(--text); font-variant-numeric: tabular-nums; }
      .funnel-rate { font-size: 0.6875rem; font-weight: 700; color: #facc15; margin-left: auto; }
      .funnel-bar-wrap { height: 14px; background: var(--surface-2); border-radius: 7px; overflow: hidden; }
      .funnel-bar { height: 100%; border-radius: 7px; min-width: 4px; }
      /* 숫자 중심 퍼널 플로우 (전환율 <1% 라 비례막대 대신) — 단계는 좌측, 전환율은 우측 단독 */
      .funnel-flow2 { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 0; flex-wrap: wrap; }
      .funnel-steps-left { display: flex; align-items: center; gap: 1.1rem; flex: 1; min-width: 0; }
      .funnel-node { text-align: center; }
      .funnel-node-count { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
      .funnel-node-label { font-size: 0.8125rem; color: var(--text-2); margin-top: 0.3rem; }
      .funnel-arrow2 { color: var(--text-3); font-size: 1.1rem; }
      .funnel-rate-box { text-align: center; padding-left: 1.1rem; border-left: 1px solid var(--surface-2); flex-shrink: 0; }
      .funnel-rate-val { font-size: 1.9rem; font-weight: 800; color: #facc15; letter-spacing: -0.02em; line-height: 1; }
      .funnel-rate-cap { font-size: 0.75rem; color: var(--text-2); margin-top: 0.3rem; }

      /* 목표 카드 */
      .goal-cards { display: flex; flex-direction: column; gap: 0.75rem; }
      .goal-card { background: var(--surface-2); border-radius: var(--r-sm); padding: 0.75rem 0.875rem; }
      .goal-name { font-size: 0.75rem; color: var(--text-2); margin-bottom: 0.25rem; }
      .goal-val { font-size: 1.25rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
      .goal-rate { font-size: 0.6875rem; color: var(--text-3); margin-top: 0.25rem; }

      /* 스켈레톤 (정적, 무애니메이션) */
      .skeleton { display: inline-block; background: var(--surface-2); border-radius: 5px; }
      .skel-list { display: flex; flex-direction: column; gap: 0.6rem; padding: 0.4rem 0; }
      .skel-row { height: 0.85rem; width: 100%; }
      .skel-row:nth-child(2) { width: 82%; }
      .skel-row:nth-child(3) { width: 66%; }
    </style>
  </head>
