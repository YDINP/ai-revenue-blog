                return `#1e293b ${pctBefore}% ${pctBefore + g}%, ${c.color} ${pctBefore + g}% ${pctBefore + pct}%`;
              }).join(', ')})`}>
                <div class="cat-donut-hole">
                  <span class="donut-num">{lfPostCount}</span>
                  <span class="donut-label">포스트</span>
                </div>
              </div>
              <div class="cat-legend" id="lf-cat-legend">
                {lfCategories.map(c => (
                  <div class="cat-legend-item">
                    <span class="cat-legend-dot" style={`background:${c.color}`}></span>
                    <span class="cat-legend-name">{c.name}</span>
                    <span class="cat-legend-count">{c.count}</span>
                    <span class="cat-legend-pct">{Math.round(c.count / lfPostCount * 100)}%</span>
