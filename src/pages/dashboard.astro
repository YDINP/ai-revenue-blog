---
import '../styles/global.css';
import { getCollection } from 'astro:content';

// TechFlow 실제 블로그 포스트 파일 기반 통계 (빌드 타임)
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const tfPostCount = allPosts.length;

// TechFlow 카테고리별 포스트 수
const tfCategoryMap: Record<string, number> = {};
for (const post of allPosts) {
  const cat = post.data.category;
  tfCategoryMap[cat] = (tfCategoryMap[cat] || 0) + 1;
}

const tfCategoryStats = Object.entries(tfCategoryMap)
  .sort((a, b) => b[1] - a[1])
  .map(([name, count]) => ({ name, count }));

// TechFlow 최근 포스트 (최신 5개)
const tfRecentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 5)
  .map(p => ({
    title: p.data.title,
    category: p.data.category,
    pubDate: p.data.pubDate.toISOString().split('T')[0],
    slug: p.id,
  }));

// LifeFlow 데이터: RSS 피드에서 가져오기 (클라이언트 사이드)
// 빌드 타임에는 기본값 사용, 브라우저에서 실시간 로드
const lfCategories = [
  { name: 'Lifestyle', count: 4, icon: 'sparkles', color: '#ec4899' },
  { name: 'Finance', count: 4, icon: 'banknotes', color: '#3b82f6' },
  { name: 'Health', count: 3, icon: 'heart', color: '#22c55e' },
  { name: 'Education', count: 3, icon: 'book', color: '#a855f7' },
  { name: 'Travel', count: 3, icon: 'plane', color: '#f97316' },
];
const lfPostCount = 17; // RSS에서 동적 로드
const lfCategoryCount = lfCategories.length;

// 통합 통계
const totalPosts = tfPostCount + lfPostCount;
const totalCategories = tfCategoryStats.length + lfCategoryCount;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Blog Dashboard | TechFlow + LifeFlow</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root {
        --dash-bg: #0f172a;
        --dash-surface: #1e293b;
        --dash-surface-hover: #334155;
        --dash-border: #334155;
        --dash-text: #f1f5f9;
        --dash-text-dim: #94a3b8;
        --dash-accent: #3b82f6;
        --dash-green: #22c55e;
        --dash-yellow: #eab308;
        --dash-red: #ef4444;
        --dash-purple: #a855f7;
        --dash-orange: #f97316;
        --dash-pink: #ec4899;
        --dash-cyan: #06b6d4;
      }

      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
        background: var(--dash-bg);
        color: var(--dash-text);
        min-height: 100vh;
      }

      /* Header */
      .dash-header {
        background: var(--dash-surface);
        border-bottom: 1px solid var(--dash-border);
        padding: 1rem 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }

      .dash-header h1 {
        font-size: 1.25rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .dash-header .logo-tf { color: var(--dash-accent); }
      .dash-header .logo-lf { color: var(--dash-green); }
      .dash-header .logo-sep { color: var(--dash-text-dim); font-weight: 400; }

      .dash-header .meta {
        font-size: 0.8125rem;
        color: var(--dash-text-dim);
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .live-dot {
        width: 8px; height: 8px;
        background: var(--dash-green);
        border-radius: 50%;
        animation: pulse 2s infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.4; }
      }

      .dash-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 1.5rem;
      }

      /* Summary Cards - 상단 통합 요약 */
      .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .summary-card {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        padding: 1.25rem;
        position: relative;
        overflow: hidden;
      }

      .summary-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
      }

      .summary-card.accent-blue::before { background: var(--dash-accent); }
      .summary-card.accent-green::before { background: var(--dash-green); }
      .summary-card.accent-purple::before { background: var(--dash-purple); }
      .summary-card.accent-yellow::before { background: var(--dash-yellow); }
      .summary-card.accent-red::before { background: var(--dash-red); }
      .summary-card.accent-cyan::before { background: var(--dash-cyan); }

      .summary-card .label {
        font-size: 0.75rem;
        color: var(--dash-text-dim);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 0.5rem;
      }

      .summary-card .value {
        font-size: 2rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.25rem;
      }

      .summary-card .sub {
        font-size: 0.7rem;
        color: var(--dash-text-dim);
      }

      /* Blog Sections - 블로그별 탭 */
      .blog-sections {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .blog-section {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        overflow: hidden;
      }

      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--dash-border);
      }

      .section-header .section-title {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9375rem;
        font-weight: 700;
      }

      .section-header .section-badge {
        font-size: 0.6875rem;
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-weight: 600;
      }

      .badge-tf { background: rgba(59,130,246,0.2); color: #60a5fa; }
      .badge-lf { background: rgba(34,197,94,0.2); color: #4ade80; }

      .section-body { padding: 1rem 1.25rem; }

      /* Category Grid */
      .cat-grid {
        display: grid;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .cat-grid-4 { grid-template-columns: repeat(4, 1fr); }
      .cat-grid-5 { grid-template-columns: repeat(5, 1fr); }

      .cat-item {
        text-align: center;
        padding: 0.75rem 0.5rem;
        border-radius: 8px;
        background: var(--dash-surface-hover);
        transition: transform 0.15s;
      }

      .cat-item:hover { transform: translateY(-2px); }

      .cat-item .cat-name {
        font-size: 0.6875rem;
        color: var(--dash-text-dim);
        margin-bottom: 0.25rem;
      }

      .cat-item .cat-count {
        font-size: 1.25rem;
        font-weight: 800;
      }

      .cat-item .cat-pct {
        font-size: 0.625rem;
        color: var(--dash-text-dim);
      }

      /* Recent Posts */
      .recent-list { display: flex; flex-direction: column; gap: 0; }

      .recent-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.625rem 0;
        border-bottom: 1px solid var(--dash-border);
        font-size: 0.8125rem;
      }

      .recent-item:last-child { border-bottom: none; }

      .recent-rank {
        font-weight: 700;
        color: var(--dash-accent);
        width: 20px;
        text-align: center;
        flex-shrink: 0;
      }

      .recent-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .cat-badge {
        display: inline-block;
        padding: 0.125rem 0.5rem;
        border-radius: 4px;
        font-size: 0.625rem;
        font-weight: 600;
        flex-shrink: 0;
      }

      .cat-ai { background: rgba(59,130,246,0.2); color: #60a5fa; }
      .cat-dev { background: rgba(34,197,94,0.2); color: #4ade80; }
      .cat-review { background: rgba(234,179,8,0.2); color: #facc15; }
      .cat-game { background: rgba(168,85,247,0.2); color: #c084fc; }
      .cat-lifestyle { background: rgba(236,72,153,0.2); color: #f472b6; }
      .cat-finance { background: rgba(59,130,246,0.2); color: #60a5fa; }
      .cat-health { background: rgba(34,197,94,0.2); color: #4ade80; }
      .cat-education { background: rgba(168,85,247,0.2); color: #c084fc; }
      .cat-travel { background: rgba(249,115,22,0.2); color: #fb923c; }

      .recent-date {
        font-size: 0.6875rem;
        color: var(--dash-text-dim);
        white-space: nowrap;
        flex-shrink: 0;
      }

      /* Supabase Status Section */
      .status-section {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
      }

      .status-section h3 {
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--dash-text-dim);
      }

      .status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 0.75rem;
      }

      .status-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.625rem 0.75rem;
        background: var(--dash-surface-hover);
        border-radius: 8px;
        font-size: 0.8125rem;
      }

      .status-badge {
        padding: 0.125rem 0.5rem;
        border-radius: 9999px;
        font-size: 0.6875rem;
        font-weight: 600;
      }

      .status-badge.online { background: rgba(34,197,94,0.2); color: #4ade80; }
      .status-badge.pending { background: rgba(234,179,8,0.2); color: #facc15; }
      .status-badge.offline { background: rgba(239,68,68,0.2); color: #f87171; }

      /* Quick Links */
      .links-section {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
      }

      .links-section h3 {
        font-size: 0.875rem;
        font-weight: 600;
        margin-bottom: 1rem;
        color: var(--dash-text-dim);
      }

      .links-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .link-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1rem;
        border-radius: 8px;
        background: var(--dash-surface-hover);
        border: 1px solid var(--dash-border);
        color: var(--dash-text);
        text-decoration: none;
        font-size: 0.8125rem;
        font-weight: 500;
        transition: border-color 0.2s, background 0.2s;
      }

      .link-btn:hover {
        border-color: var(--dash-accent);
        background: rgba(59,130,246,0.1);
      }

      .link-btn .link-icon { font-size: 1rem; }
      .link-btn .link-label { color: var(--dash-text-dim); font-size: 0.6875rem; margin-left: 0.25rem; }

      /* Banner */
      .data-banner {
        padding: 1rem 1.25rem;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        font-size: 0.85rem;
        line-height: 1.6;
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
      }

      .data-banner.info {
        background: rgba(59,130,246,0.1);
        border: 1px solid rgba(59,130,246,0.25);
        color: #93bbfd;
      }

      .data-banner.warning {
        background: rgba(234,179,8,0.1);
        border: 1px solid rgba(234,179,8,0.25);
        color: #fde68a;
      }

      .data-banner .banner-icon { font-size: 1.25rem; flex-shrink: 0; margin-top: 1px; }

      /* Traffic Section */
      .traffic-section {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        margin-bottom: 1.5rem;
        overflow: hidden;
      }

      .traffic-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1rem 1.25rem;
        border-bottom: 1px solid var(--dash-border);
      }

      .traffic-header h3 {
        font-size: 0.9375rem;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 0.5rem;
      }

      .refresh-btn {
        background: var(--dash-surface-hover);
        border: 1px solid var(--dash-border);
        color: var(--dash-text-dim);
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        cursor: pointer;
        transition: all 0.2s;
      }

      .refresh-btn:hover { border-color: var(--dash-accent); color: var(--dash-text); }

      .traffic-body { padding: 1.25rem; }

      /* Metric Row */
      .metric-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
      }

      .metric-box {
        background: var(--dash-surface-hover);
        border-radius: 8px;
        padding: 0.875rem;
        text-align: center;
      }

      .metric-box .metric-label {
        font-size: 0.6875rem;
        color: var(--dash-text-dim);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 0.375rem;
      }

      .metric-box .metric-value {
        font-size: 1.5rem;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 0.25rem;
      }

      .metric-box .metric-delta {
        font-size: 0.625rem;
      }

      .metric-delta.up { color: var(--dash-green); }
      .metric-delta.down { color: var(--dash-red); }
      .metric-delta.neutral { color: var(--dash-text-dim); }

      /* Hourly Chart */
      .hourly-chart {
        margin-bottom: 1.25rem;
      }

      .hourly-chart h4 {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--dash-text-dim);
        margin-bottom: 0.75rem;
      }

      .chart-bars {
        display: flex;
        flex-direction: row;
        align-items: flex-end;
        gap: 2px;
        height: 100px;
        padding: 0 0 1.5rem;
        position: relative;
      }

      .chart-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        position: relative;
      }

      .chart-bar {
        width: 100%;
        min-height: 2px;
        background: linear-gradient(to top, var(--dash-accent), #60a5fa);
        border-radius: 3px 3px 0 0;
        transition: height 0.4s ease;
        position: relative;
      }

      .chart-bar:hover { opacity: 0.8; }

      .chart-bar-label {
        position: absolute;
        bottom: -1.25rem;
        font-size: 0.5625rem;
        color: var(--dash-text-dim);
      }

      .chart-bar-tooltip {
        display: none;
        position: absolute;
        top: -1.5rem;
        background: var(--dash-bg);
        border: 1px solid var(--dash-border);
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
        font-size: 0.625rem;
        white-space: nowrap;
        z-index: 10;
      }

      .chart-bar-col:hover .chart-bar-tooltip { display: block; }

      /* Traffic Grid: Top Pages + Live Feed */
      .traffic-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .traffic-panel h4 {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--dash-text-dim);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
      }

      .top-page-list, .event-feed { display: flex; flex-direction: column; gap: 0; }

      .top-page-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(51,65,85,0.5);
        font-size: 0.8125rem;
      }

      .top-page-item:last-child { border-bottom: none; }

      .top-page-rank {
        font-weight: 700;
        color: var(--dash-accent);
        width: 18px;
        text-align: center;
        flex-shrink: 0;
        font-size: 0.75rem;
      }

      .top-page-slug {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.75rem;
      }

      .top-page-views {
        font-weight: 700;
        font-size: 0.75rem;
        color: var(--dash-cyan);
        flex-shrink: 0;
      }

      /* 추천 TOP 패널 */
      .like-top-panel {
        margin-top: 1rem;
      }

      .like-top-total {
        font-size: 0.75rem;
        font-weight: 400;
        color: var(--dash-text-dim);
        margin-left: 0.25rem;
      }

      .like-top-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(51,65,85,0.5);
        font-size: 0.8125rem;
      }

      .like-top-item:last-child { border-bottom: none; }

      .like-bar-wrap {
        flex: 1;
        height: 6px;
        background: rgba(51,65,85,0.6);
        border-radius: 3px;
        overflow: hidden;
      }

      .like-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #ef4444, #f97316);
        border-radius: 3px;
        transition: width 0.4s ease;
      }

      .like-top-count {
        font-weight: 700;
        font-size: 0.75rem;
        color: #ef4444;
        flex-shrink: 0;
        min-width: 48px;
        text-align: right;
      }

      /* Event Feed */
      .event-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0;
        border-bottom: 1px solid rgba(51,65,85,0.3);
        font-size: 0.75rem;
        min-height: 36px;
      }

      .event-item:last-child { border-bottom: none; }

      .event-icon {
        width: 22px;
        height: 22px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6875rem;
        flex-shrink: 0;
      }

      .event-icon.pageview { background: rgba(59,130,246,0.2); }
      .event-icon.like { background: rgba(239,68,68,0.2); }
      .event-icon.coupang_click { background: rgba(249,115,22,0.2); }
      .event-icon.newsletter_subscribe { background: rgba(34,197,94,0.2); }

      .event-detail {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        color: var(--dash-text-dim);
      }

      .event-time {
        font-size: 0.625rem;
        color: var(--dash-text-dim);
        flex-shrink: 0;
      }

      .no-data {
        text-align: center;
        padding: 2rem;
        color: var(--dash-text-dim);
        font-size: 0.8125rem;
      }

      /* Source Filter Tabs */
      .source-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1rem;
      }

      .source-tab {
        padding: 0.375rem 0.875rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--dash-border);
        background: transparent;
        color: var(--dash-text-dim);
        transition: all 0.2s;
      }

      .source-tab:hover { border-color: var(--dash-accent); color: var(--dash-text); }
      .source-tab.active { background: var(--dash-accent); border-color: var(--dash-accent); color: #fff; }
      .source-tab.active-tf { background: var(--dash-accent); border-color: var(--dash-accent); color: #fff; }
      .source-tab.active-lf { background: var(--dash-green); border-color: var(--dash-green); color: #fff; }

      /* Source Badge in traffic items */
      .src-badge {
        display: inline-block;
        padding: 0.0625rem 0.375rem;
        border-radius: 3px;
        font-size: 0.5625rem;
        font-weight: 700;
        flex-shrink: 0;
        letter-spacing: 0.02em;
      }

      .src-badge.tf { background: rgba(59,130,246,0.2); color: #60a5fa; }
      .src-badge.lf { background: rgba(34,197,94,0.2); color: #4ade80; }

      /* Source breakdown row under metric */
      .metric-breakdown {
        display: flex;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 0.375rem;
        font-size: 0.5625rem;
      }

      .metric-breakdown span {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      .dot-tf { width: 6px; height: 6px; border-radius: 50%; background: var(--dash-accent); display: inline-block; }
      .dot-lf { width: 6px; height: 6px; border-radius: 50%; background: var(--dash-green); display: inline-block; }

      /* Improved top-page-title */
      .top-page-title {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.75rem;
      }

      /* Improved event detail */
      .event-content {
        flex: 1;
        overflow: hidden;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 1px;
      }

      .event-action {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--dash-text);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.3;
      }

      .event-page-title {
        font-size: 0.625rem;
        color: var(--dash-text-dim);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        line-height: 1.3;
      }

      /* ====== VISUAL ENHANCEMENTS ====== */

      /* Source Split Bar */
      .source-split-bar {
        display: flex;
        height: 8px;
        border-radius: 4px;
        overflow: hidden;
        margin-top: 0.5rem;
        background: var(--dash-surface-hover);
      }

      .split-tf {
        background: linear-gradient(90deg, #3b82f6, #60a5fa);
        transition: width 0.6s ease;
      }

      .split-lf {
        background: linear-gradient(90deg, #22c55e, #4ade80);
        transition: width 0.6s ease;
      }

      .split-legend {
        display: flex;
        justify-content: space-between;
        font-size: 0.625rem;
        color: var(--dash-text-dim);
        margin-top: 0.25rem;
      }

      /* Category Donut (CSS) */
      .cat-donut-wrap {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
      }

      .cat-donut {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        position: relative;
        flex-shrink: 0;
      }

      .cat-donut-hole {
        position: absolute;
        inset: 20%;
        border-radius: 50%;
        background: var(--dash-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
      }

      .cat-donut-hole .donut-num {
        font-size: 1.25rem;
        font-weight: 800;
        line-height: 1;
      }

      .cat-donut-hole .donut-label {
        font-size: 0.5625rem;
        color: var(--dash-text-dim);
      }

      .cat-legend {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        flex: 1;
      }

      .cat-legend-item {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.6875rem;
      }

      .cat-legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        flex-shrink: 0;
      }

      .cat-legend-name {
        flex: 1;
      }

      .cat-legend-count {
        font-weight: 700;
        min-width: 20px;
        text-align: right;
      }

      .cat-legend-pct {
        color: var(--dash-text-dim);
        font-size: 0.5625rem;
        min-width: 30px;
        text-align: right;
      }

      /* Category Traffic */
      .cat-traffic-section {
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--dash-border);
      }
      .cat-traffic-title {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--dash-text);
        margin-bottom: 0.75rem;
        letter-spacing: 0.03em;
      }
      .cat-traffic-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.5rem;
      }
      .cat-traffic-name {
        font-size: 0.6875rem;
        font-weight: 600;
        color: var(--dash-text);
        min-width: 64px;
        flex-shrink: 0;
      }
      .cat-traffic-bar-wrap {
        flex: 1;
        height: 18px;
        background: var(--dash-bg);
        border-radius: 9px;
        overflow: hidden;
      }
      .cat-traffic-bar {
        height: 100%;
        border-radius: 9px;
        transition: width 0.6s ease;
        min-width: 4px;
      }
      .cat-traffic-value {
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--dash-text);
        min-width: 48px;
        text-align: right;
        flex-shrink: 0;
      }
      .cat-traffic-share {
        font-size: 0.625rem;
        color: var(--dash-text-dim);
        min-width: 28px;
        text-align: right;
        flex-shrink: 0;
      }

      /* 7-Day Trend Chart */
      .trend-section {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        padding: 1.25rem;
        margin-bottom: 1.5rem;
      }

      .trend-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 0.75rem;
      }

      .trend-header h3 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--dash-text-dim);
      }

      .trend-total {
        font-size: 0.75rem;
        color: var(--dash-text-dim);
      }

      .trend-total b { color: var(--dash-text); font-size: 1rem; }

      .trend-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 140px;
        padding: 0 0.5rem;
      }

      .trend-bar-col {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        height: 100%;
      }

      .trend-bar-wrap {
        flex: 1;
        width: 100%;
        display: flex;
        align-items: flex-end;
        justify-content: center;
      }

      .trend-bar-stack {
        width: 70%;
        max-width: 48px;
        border-radius: 6px 6px 0 0;
        overflow: hidden;
        transition: all 0.4s ease;
        position: relative;
      }

      .trend-bar-stack:hover {
        filter: brightness(1.2);
        transform: scaleX(1.1);
      }

      .trend-bar-tf {
        background: linear-gradient(to top, #2563eb, #60a5fa);
      }

      .trend-bar-lf {
        background: linear-gradient(to top, #16a34a, #4ade80);
      }

      .trend-bar-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1px;
        flex-shrink: 0;
      }

      .trend-bar-date {
        font-size: 0.625rem;
        color: var(--dash-text-dim);
      }

      .trend-bar-count {
        font-size: 0.75rem;
        font-weight: 700;
        color: var(--dash-text);
      }

      .trend-bar-split {
        font-size: 0.5625rem;
        opacity: 0.8;
      }

      .trend-bar-today {
        box-shadow: 0 0 12px rgba(59, 130, 246, 0.4);
      }

      .trend-legend {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 0.5rem;
        font-size: 0.6875rem;
      }

      .trend-legend span {
        display: flex;
        align-items: center;
        gap: 0.25rem;
      }

      /* Stacked hourly bars */
      .chart-bar-stack {
        display: flex;
        flex-direction: column;
        width: 100%;
        border-radius: 3px 3px 0 0;
        overflow: hidden;
      }

      .bar-tf {
        background: linear-gradient(to top, #3b82f6, #60a5fa);
        transition: height 0.4s ease;
      }

      .bar-lf {
        background: linear-gradient(to top, #22c55e, #4ade80);
        transition: height 0.4s ease;
      }

      /* Summary card icon */
      .card-icon {
        font-size: 1.5rem;
        position: absolute;
        right: 1rem;
        top: 1rem;
        opacity: 0.15;
      }

      /* Loading / Empty */
      .loading {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60px;
        color: var(--dash-text-dim);
        font-size: 0.8125rem;
      }

      .spinner {
        width: 20px; height: 20px;
        border: 2px solid var(--dash-border);
        border-top-color: var(--dash-accent);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        margin-right: 0.5rem;
      }

      @keyframes spin { to { transform: rotate(360deg); } }

      /* Main Tabs */
      .main-tabs {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        flex-wrap: wrap;
      }

      .main-tab {
        padding: 0.625rem 1.25rem;
        border-radius: 8px;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--dash-border);
        background: var(--dash-surface);
        color: var(--dash-text-dim);
        transition: all 0.2s;
      }

      .main-tab:hover {
        border-color: var(--dash-accent);
        color: var(--dash-text);
      }

      .main-tab.active {
        background: var(--dash-accent);
        border-color: var(--dash-accent);
        color: #fff;
      }

      .main-tab.active-tf {
        background: var(--dash-accent);
        border-color: var(--dash-accent);
        color: #fff;
      }

      .main-tab.active-lf {
        background: var(--dash-green);
        border-color: var(--dash-green);
        color: #fff;
      }

      .main-tab.active-coupang {
        background: var(--dash-orange);
        border-color: var(--dash-orange);
        color: #fff;
      }

      .main-tab.active-comments {
        background: var(--dash-cyan);
        border-color: var(--dash-cyan);
        color: #fff;
      }

      .tab-content {
        display: none;
      }

      .tab-content.active {
        display: block;
      }

      /* Coupang Tab 전용 스타일 */
      .coupang-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .coupang-card {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 12px;
        padding: 1.25rem;
      }

      .coupang-card h4 {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--dash-text-dim);
        margin-bottom: 0.75rem;
      }

      .conversion-rate {
        font-size: 2rem;
        font-weight: 800;
        color: var(--dash-orange);
        line-height: 1;
        margin-bottom: 0.5rem;
      }

      /* Comment Tab 전용 스타일 */
      .comment-auth-gate {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 300px;
      }

      .auth-box {
        background: var(--dash-surface);
        border: 1px solid var(--dash-border);
        border-radius: 16px;
        padding: 2.5rem;
        text-align: center;
        max-width: 400px;
        width: 100%;
      }

      .auth-box h3 {
        font-size: 1.25rem;
        margin-bottom: 0.5rem;
      }

      .auth-box p {
        color: var(--dash-text-dim);
        font-size: 0.875rem;
        margin-bottom: 1.5rem;
      }

      .auth-input-row {
        display: flex;
        gap: 0.5rem;
      }

      .auth-input-row input {
        flex: 1;
        padding: 0.625rem 1rem;
        background: var(--dash-bg);
        border: 1px solid var(--dash-border);
        border-radius: 8px;
        color: var(--dash-text);
        font-size: 0.875rem;
        outline: none;
      }

      .auth-input-row input:focus {
        border-color: var(--dash-cyan);
      }

      .auth-input-row button {
        padding: 0.625rem 1.25rem;
        background: var(--dash-cyan);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s;
      }

      .auth-input-row button:hover {
        opacity: 0.85;
      }

      .auth-error {
        color: var(--dash-red);
        font-size: 0.8125rem;
        margin-top: 0.75rem;
      }

      .comment-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
      }

      .comment-filters {
        display: flex;
        gap: 0.375rem;
      }

      .filter-btn {
        padding: 0.375rem 0.75rem;
        border-radius: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--dash-border);
        background: var(--dash-surface);
        color: var(--dash-text-dim);
        transition: all 0.2s;
      }

      .filter-btn:hover {
        border-color: var(--dash-cyan);
        color: var(--dash-text);
      }

      .filter-btn.active {
        background: var(--dash-cyan);
        border-color: var(--dash-cyan);
        color: #fff;
      }

      .comment-trend-chart {
        display: flex;
        align-items: flex-end;
        gap: 0.75rem;
        height: 160px;
        padding: 1rem 0;
      }

      .trend-bar-group {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.25rem;
        height: 100%;
        justify-content: flex-end;
      }

      .trend-bars {
        display: flex;
        gap: 2px;
        align-items: flex-end;
        width: 100%;
        justify-content: center;
      }

      .trend-bar {
        width: 14px;
        border-radius: 3px 3px 0 0;
        min-height: 4px;
        transition: height 0.3s;
      }

      .trend-bar.tf { background: var(--dash-accent); }
      .trend-bar.lf { background: var(--dash-green); }

      .trend-label {
        font-size: 0.625rem;
        color: var(--dash-text-dim);
      }

      .trend-count {
        font-size: 0.6875rem;
        font-weight: 700;
        color: var(--dash-text);
      }

      .comment-list {
        max-height: 600px;
        overflow-y: auto;
      }

      .cm-item {
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        padding: 1rem;
        border-bottom: 1px solid var(--dash-border);
        transition: background 0.2s;
      }

      .cm-item:hover {
        background: var(--dash-surface-hover);
      }

      .cm-source {
        font-size: 0.625rem;
        font-weight: 700;
        padding: 0.125rem 0.375rem;
        border-radius: 4px;
        white-space: nowrap;
        flex-shrink: 0;
        margin-top: 0.125rem;
      }

      .cm-source.tf {
        background: rgba(59, 130, 246, 0.15);
        color: var(--dash-accent);
      }

      .cm-source.lf {
        background: rgba(34, 197, 94, 0.15);
        color: var(--dash-green);
      }

      .cm-body {
        flex: 1;
        min-width: 0;
      }

      .cm-meta {
        font-size: 0.75rem;
        color: var(--dash-text-dim);
        margin-bottom: 0.25rem;
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .cm-nickname {
        font-weight: 700;
        color: var(--dash-text);
      }

      .cm-admin-badge {
        font-size: 0.625rem;
        background: var(--dash-accent);
        color: #fff;
        padding: 0 0.375rem;
        border-radius: 4px;
        font-weight: 600;
      }

      .cm-report-badge {
        font-size: 0.625rem;
        background: rgba(239, 68, 68, 0.15);
        color: var(--dash-red);
        padding: 0 0.375rem;
        border-radius: 4px;
        font-weight: 600;
      }

      .cm-content {
        font-size: 0.875rem;
        color: var(--dash-text);
        line-height: 1.5;
        word-break: break-word;
      }

      .cm-slug {
        font-size: 0.6875rem;
        color: var(--dash-text-dim);
        margin-top: 0.25rem;
      }

      .cm-actions {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
        flex-shrink: 0;
      }

      .cm-btn {
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        font-size: 0.6875rem;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid var(--dash-border);
        background: var(--dash-surface);
        color: var(--dash-text-dim);
        transition: all 0.2s;
        white-space: nowrap;
      }

      .cm-btn:hover { border-color: var(--dash-cyan); color: var(--dash-text); }
      .cm-btn.danger { color: var(--dash-red); }
      .cm-btn.danger:hover { background: rgba(239, 68, 68, 0.1); border-color: var(--dash-red); }

      .cm-reply-form {
        margin-top: 0.5rem;
        display: flex;
        gap: 0.375rem;
      }

      .cm-reply-form input {
        flex: 1;
        padding: 0.375rem 0.625rem;
        background: var(--dash-bg);
        border: 1px solid var(--dash-border);
        border-radius: 6px;
        color: var(--dash-text);
        font-size: 0.8125rem;
        outline: none;
      }

      .cm-reply-form input:focus { border-color: var(--dash-cyan); }

      .cm-reply-form button {
        padding: 0.375rem 0.75rem;
        background: var(--dash-cyan);
        color: #fff;
        border: none;
        border-radius: 6px;
        font-weight: 600;
        font-size: 0.8125rem;
        cursor: pointer;
      }

      .trend-legend {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 0.5rem;
        font-size: 0.6875rem;
        color: var(--dash-text-dim);
      }

      .trend-legend span::before {
        content: '';
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        margin-right: 0.25rem;
        vertical-align: middle;
      }

      .trend-legend .leg-tf::before { background: var(--dash-accent); }
      .trend-legend .leg-lf::before { background: var(--dash-green); }

      /* 날짜별 상세 테이블 */
      .daily-detail-wrap {
        max-height: 340px;
        overflow-y: auto;
        border-radius: 8px;
        border: 1px solid rgba(148,163,184,0.15);
      }
      .daily-detail-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
      }
      .daily-detail-table thead th {
        position: sticky;
        top: 0;
        background: #1e293b;
        color: var(--dash-text-dim, #94a3b8);
        text-align: right;
        padding: 8px 12px;
        font-weight: 600;
        z-index: 1;
      }
      .daily-detail-table thead th:first-child { text-align: left; }
      .daily-detail-table tbody td {
        padding: 7px 12px;
        text-align: right;
        border-top: 1px solid rgba(148,163,184,0.1);
        color: var(--dash-text, #e2e8f0);
        white-space: nowrap;
      }
      .daily-detail-table tbody td:first-child { text-align: left; color: var(--dash-text-dim, #94a3b8); }
      .daily-detail-table tbody tr:hover td { background: rgba(59,130,246,0.08); }
      .daily-detail-table tr.dd-today td { background: rgba(59,130,246,0.12); font-weight: 700; }
      .dd-views { color: #60a5fa; font-weight: 600; }
      .dd-visitors { color: #4ade80; font-weight: 600; }
      .dd-minibar { display: inline-block; height: 8px; background: linear-gradient(90deg,#3b82f6,#60a5fa); border-radius: 4px; min-width: 2px; }
      .dd-bar-col { width: 120px; }
      .dd-note { margin: 8px 2px 0; font-size: 0.72rem; color: var(--dash-text-dim, #94a3b8); }

      /* 날짜 x 시간대 히트맵 */
      .heatmap-wrap { overflow-x: auto; padding-bottom: 6px; }
      .heatmap-grid { display: inline-block; min-width: 100%; }
      .hm-row { display: flex; align-items: center; gap: 2px; margin-bottom: 2px; }
      .hm-rowlabel { width: 44px; flex: 0 0 44px; font-size: 0.7rem; color: var(--dash-text-dim, #94a3b8); text-align: right; padding-right: 6px; }
      .hm-hourhead { display: flex; gap: 2px; margin: 0 0 4px 50px; }
      .hm-cell {
        width: 15px; height: 15px; flex: 0 0 15px; border-radius: 3px;
        background: #1e293b; display: inline-block;
      }
      .hm-cell.l0 { background: #1e293b; }
      .hm-cell.l1 { background: #1e3a8a; }
      .hm-cell.l2 { background: #2563eb; }
      .hm-cell.l3 { background: #3b82f6; }
      .hm-cell.l4 { background: #93c5fd; }
      .hm-hourlabel { width: 15px; flex: 0 0 15px; font-size: 0.6rem; color: var(--dash-text-dim, #94a3b8); text-align: center; }
      .heatmap-legend { display: flex; align-items: center; gap: 3px; font-size: 0.72rem; color: var(--dash-text-dim, #94a3b8); }
      .heatmap-legend .hm-cell { width: 13px; height: 13px; flex: 0 0 13px; }

      /* Responsive */
      @media (max-width: 768px) {
        .summary-grid { grid-template-columns: 1fr; }
        .blog-sections { grid-template-columns: 1fr; }
        .cat-grid-4 { grid-template-columns: repeat(2, 1fr); }
        .cat-grid-5 { grid-template-columns: repeat(2, 1fr); }
        .dash-header { flex-direction: column; gap: 0.5rem; align-items: flex-start; }
        .metric-row { grid-template-columns: 1fr; }
        .traffic-grid { grid-template-columns: 1fr; }
        .main-tabs {
          overflow-x: auto;
          flex-wrap: nowrap;
          -webkit-overflow-scrolling: touch;
        }
        .main-tab {
          white-space: nowrap;
          flex-shrink: 0;
        }
        .coupang-stats { grid-template-columns: 1fr; }
        .comment-stats-grid { grid-template-columns: 1fr; }
        .comment-filters { flex-wrap: wrap; }
        .cm-item { flex-direction: column; gap: 0.5rem; }
        .cm-actions { flex-direction: row; }
        .summary-card .value { font-size: 1.5rem; }
        .summary-card .sub { font-size: 0.6875rem; }
      }
    </style>
  </head>
  <body>
    <header class="dash-header">
      <h1>
        <span class="logo-tf">TechFlow</span>
        <span class="logo-sep">+</span>
        <span class="logo-lf">LifeFlow</span>
        Dashboard
      </h1>
      <div class="meta">
        <span class="live-dot"></span>
        <span id="last-updated">Loading...</span>
        <a href="/" style="color: var(--dash-accent); text-decoration: none; font-size: 0.8125rem;">Blog &rarr;</a>
      </div>
    </header>

    <div class="dash-container">
      <!-- Data Status Banner -->
      <div id="data-banner" class="data-banner" style="display:none;"></div>

      <!-- Main Tabs -->
      <div class="main-tabs">
        <button class="main-tab active" data-tab="all">📊 전체 요약</button>
        <button class="main-tab" data-tab="techflow">💻 TechFlow</button>
        <button class="main-tab" data-tab="lifeflow">🌱 LifeFlow</button>
        <button class="main-tab" data-tab="coupang">🛒 쿠팡</button>
